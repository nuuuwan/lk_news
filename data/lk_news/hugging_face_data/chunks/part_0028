    "description": "\u0db6\u0daf\u0dd4\u0dbd\u0dbd\u0dda \u0db1\u0dcf\u0dba\u0dba\u0dd1\u0db8\u0dda \u0d85\u0db0\u0dd2\u0d85\u0dc0\u0db0\u0dcf\u0db1\u0db8\u0dca \u0d9a\u0dbd\u0dcf\u0db4 \u0dc0\u0dbd \u0d89\u0db1\u0dca\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd3\u0db8\u0d9a\u0dca",
