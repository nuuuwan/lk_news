    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dc4\u0db8\u0d9c\u0db8-\u0db4\u0dbb-\u0dc3\u0db7\u0db4\u0dad\u0da7\u0dad-\u0db8\u0dbb\u0dab-\u0dad\u0dbb\u0da2\u0db1/1-682302",
