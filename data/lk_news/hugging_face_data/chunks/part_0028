    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0dad\u0dc3\u0db6-\u0d9a\u0dc2-\u0d9a\u0db8\u0da7\u0dc0\u0da7-\u0da0\u0db1\u0dba\u0db1-\u0db4\u0da9\u0db8\u0d9a/1-682320",
