    "url_metadata": "https://www.lankadeepa.lk/news/\u0daf\u0db1\u0dad-\u0dc0\u0daf\u0dba-\u0dc3\u0d9c\u0db8\u0dba-\u0db1\u0dc0-\u0dc3\u0db7\u0db4\u0dad-\u0db4\u0dad\u0dc0/101-681663",
