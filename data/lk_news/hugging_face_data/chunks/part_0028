    "description": "\u0db8\u0dd9\u0dbd\u0dca\u0db6\u0dbb\u0dca\u0db1\u0dca \u0db0\u0db8\u0dca\u0db8 \u0dc3\u0dbb\u0dab \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dba\u0dda \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db1\u0dcf\u0d94\u0da7\u0dd4\u0db1\u0dca\u0db1\u0dda \u0dc0\u0dd2\u0da2\u0dd2\u0dad \u0dc4\u0dd2\u0db8\u0dd2  \u0d9c\u0dd0\u0dc4\u0dd0\u0db1\u0dd4 \u0dc5\u0db8\u0dd4\u0db1\u0dca 6 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dbd\u0dd2\u0d82\u0d9c\u0dd2\u0d9a \u0d85\u0db4\u0dba\u0ddd\u0da2\u0db1\u0dba\u0da7 \u0dc0\u0dbb\u0daf\u0d9a\u0dbb\u0dd4 \u0dc0\u0dd9\u0dba\u0dd2",
