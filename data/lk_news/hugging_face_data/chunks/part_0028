    "description": "\u0ba4\u0b99\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bb5\u0bbf\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0bb5\u0bc0\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf",
    "url_metadata": "https://www.virakesari.lk/article/228884",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1761639060.0,
