    "chunk_text": "\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d86\u0db4\u0daf\u0dcf\u0dc0\u0d9a\u0dca \u0db1\u0db8\u0dca \u0db8\u0dd9\u0db1\u0dca\u0db1  \u2018\u0dc4\u0dd9\u0dcf\u0da7\u0dca \u0dbd\u0dba\u0dd2\u0db1\u0dca\u2019 \u0d91\u0d9a\n\n\u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0d86\u0db4\u0daf\u0dcf \u0dad\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d86\u0db4\u0daf\u0dcf\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca \u0dc4\u0ddd \u00a0\u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0d86\u0db0\u0dcf\u0dbb \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u00a0\u0db1\u0db8\u0dca \u00a0\u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca\u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0da2\u0dba\u0dda \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0d9c\u0dda \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd0\u0dba\u00a024\u00a0\u0db4\u0dd4\u0dbb\u0dcf \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0daf\u0dd4\u0dbb\u0d9a\u0dad\u0db1 \u0d85\u0d82\u0d9a\u0dba\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd9\u0db1\u0dd4 \u0dbd\u0dd0\u0db6 \u00a0\u00a0\u0d87\u0dad.\n\n\u0d86\u0db4\u0daf\u0dcf \u0dad\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d86\u0db4\u0daf\u0dcf\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dca\u0db1\u0db8\u0dca \u0dc3\u0dc4 \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0d86\u0db0\u0dcf\u0dbb \u0d85\u0dc0\u0dca\u0dc1\u0dca\u200d\u0dba \u00a0\u0db1\u0db8\u0dca \u0d89\u0dc4\u0dad \u0daf\u0dd4\u0dbb\u0d9a\u0dad\u0db1 . \u0d85\u0d82\u0d9a\u0dba\u0da7 \u0d95\u0db1\u0dd1\u0db8 \u0db8\u0ddc\u0dc4\u0ddc\u0dad\u0d9a \u0d85\u0db8\u0dad\u0db1 \u0dbd\u0dd9\u0dc3 \u00a0\u0dbb\u0da2\u0dba\u0dda \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca\u0d9c\u0dda \u0dc3\u0d82\u0d9c\u0db8\u0d