    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc4\u0daf\u0dba\u0db1\u0d9c-\u0db1\u0dbd-\u0d87\u0db3\u0db8-\u0dc0\u0db1\u0dc3\u0d9a-\u0db1/101-682477",
