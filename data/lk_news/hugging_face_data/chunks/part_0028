    "description": "\u0db8\u0da7\u0dad\u0dca \u0dc5\u0db8\u0dba\u0dd2 \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf, \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0db1\u0dad\u0dbb \u0dc0\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1",
