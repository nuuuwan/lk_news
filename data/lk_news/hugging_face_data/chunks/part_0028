    "description": "\u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0db1\u0dd2\u0db4 \u0d9a\u0ddc\u0dc5\u0db9 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0db0\u0dd6\u0dbb\u0dba\u0da7 \u0dc6\u0dba\u0dd2\u0dc3\u0dbb\u0dca \u0db8\u0dd4\u0dc3\u0dca\u0dad\u0dcf\u0db4\u0dcf",
