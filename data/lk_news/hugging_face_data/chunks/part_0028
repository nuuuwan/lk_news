    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbb\u0da2\u0dbb\u0da7-\u0db8\u0dc4\u0da0\u0dbb\u0dba\u0dc0\u0dbb\u0dba\u0da7-\u0dc3\u0db8\u0db8\u0db1\u0dba\u0d9a/1-681961",
