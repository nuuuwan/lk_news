    "description": "\u0dc3\u0dba\u0dd2\u0db6\u0dbb\u0dca \u0d85\u0db4\u0dbb\u0dcf\u0db0 \u0db8\u0da9\u0dd2\u0db1 \u0dc3\u0db8\u0dca\u0db8\u0dd4\u0dad\u0dd2\u0dba\u0da7 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0d9f \u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dc3\u0dba\u0db6\u0dbb-\u0d85\u0db4\u0dbb\u0db0-\u0db8\u0da9\u0db1-\u0dc3\u0db8\u0db8\u0dad\u0dba\u0da7-\u0dbd\u0d9a\u0dc0\u0dad-\u0d91\u0d9a\u0d9f-\u0dc0\u0dba/1-681893",
