    "url_metadata": "https://www.lankadeepa.lk/news/\u0daf\u0dbd\u0dad\u0d9c-\u0db4\u0d9a\u0dc2\u0da7-\u0db8\u0dc4\u0dba\u0db8-\u0db4\u0dbb\u0db0\u0db1\u0dba\u0d9a/101-681996",
