    "url_metadata": "https://www.lankadeepa.lk/features/\u0db8\u0db1\u0dc0-\u0dc4\u0db8\u0d9a\u0db8-\u0db1\u0db8\u0d9a-\u0db1\u0dad-\u0db4\u0dbb\u0dc1\u0db1\u0dba\u0d9a\u0daf/2-682015",
