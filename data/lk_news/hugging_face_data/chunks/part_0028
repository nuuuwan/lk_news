    "description": "\u0dc0\u0dda\u0dba\u0db1\u0dca\u0d9c\u0ddc\u0da9\u0da7 \u0db6\u0dc4\u0dd4\u0dc0\u0dd2\u0db0 \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1 \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0dca",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc0\u0dba\u0db1\u0d9c\u0da9\u0da7-\u0db6\u0dc4\u0dc0\u0db0-\u0db7\u0dab\u0da9-\u0db4\u0dbb\u0dc0\u0dc4\u0db1-\u0db8\u0db0\u0dba\u0dc3\u0dae\u0db1\u0dba\u0d9a/101-682305",
