  {
    "doc_type": "lk_news",
    "doc_id": "2025-11-01-islandlk-39fc4e67",
    "num": "islandlk-39fc4e67",
    "date_str": "2025-11-01",
    "description": "My friendship with Wijetunga used as a bridge for Gamini D to return to UNP",
    "url_metadata": "http://island.lk/my-friendship-with-wijetunga-used-as-a-bridge-for-gamini-d-to-return-to-unp/",
    "lang": "en",
    "newspaper_id": "islandlk",
