    "description": "\u0d85\u0db4\u0db1\u0dba\u0db1 \u0d85\u0d82\u0dc1\u0dba 2025 \u0db8\u0dd4\u0dbd\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dd4 \u0dad\u0dd4\u0db1\u0da7 \u0d87.\u0da9\u0ddc.\u0db6\u0dd2. 13\u0d9a \u0d86\u0daf\u0dcf\u0dba\u0db8\u0d9a\u0dca",
    "url_metadata": "https://www.ada.lk/business/\u0d85\u0db4\u0db1\u0dba\u0db1-\u0d85\u0d82\u0dc1\u0dba-2025-\u0db8\u0dd4\u0dbd\u0dca-\u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dd4-\u0dad\u0dd4\u0db1\u0da7-\u0d87-\u0da9\u0ddc-\u0db6\u0dd2--13\u0d9a-\u0d86\u0daf\u0dcf\u0dba\u0db8\u0d9a\u0dca/7-419298",
