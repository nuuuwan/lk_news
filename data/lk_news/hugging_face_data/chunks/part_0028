    "chunk_index": 0,
    "language": "si",
    "md5": "e8bcd4205efe45c0f64d953025ce891e",
    "chunk_size_bytes": 1358,
    "chunk_text": "\u0db8\u0d82 \u0db8\u0dd0\u0dbb\u0dd4\u0dc0\u0ddc\u0dad\u0dca \u0dc4\u0ddc\u0dbd\u0dca\u0db8\u0db1\u0d9a\u0dca \u0dc0\u0dd9\u0dbd\u0dcf \u0db4\u0dbd\u0dd2 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf\n\n\u0d87\u0db8\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0db8\u0dca \u0d85\u0db4\u0dd2 \u0db8\u0dbb\u0db1\u0dca\u0db1 \u0dc4\u0ddc\u0dbd\u0dca\u0db8\u0db1\u0d9a\u0dca \u0dc0\u0dd9\u0dbd\u0dcf \u0dc4\u0dbb\u0dd2 \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0db4\u0dbd\u0dd2 \u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dba\u0dd0\u0dba\u0dd2 \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0da0\u0dcf\u0db8\u0dbb \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0daf\u0dc3\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf:-(\u0db1.\u0db4\u0dca\u200d\u0dbb.\u0db4\u0dd9) \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba.\n\n\u0d85\u0db4\u0dd2 \u0d94\u0dba\u0dcf\u0d9c\u0dda \u0db4\u0dc3\u0dca\u0dc3\u0dd9\u0db1\u0dca \u0d89\u0db1\u0dca\u0db1\u0dc0\u0dcf.\u0d85\u0db4\u0dd2 \u0d92\u0dc0\u0da7 \u0db6\u0dba \u0db1\u0dd1.\u0d85\u0db4\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0d85\u0dba\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0dbd\u0dcf \u0d94\u0dba\u0dcf\u0dbd\u0dcf \u0dc4\u0dd2\u0dad\u0dcf\u0d9c\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db1\u0dda \u0d85\u0db4\u0dd2\u0dad\u0dca \u0db8\u0dbb\u0db1\u0dca\u0db1\u0daf?\n\n\u0d94\u0db6\u0dad\u0dd4\u0db8\u0dcf\u0da7\u0dad\u0dca \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dba\u0dda\u0daf\u0dd3 \u0d86\u0db1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0da2\u0dda\u0db4\u0dcf\u0dbd \u0db1\u0ddc\u0dc4\u0ddc\u0dad\u0dca.... \u0db8\u0db8 \u0d89\u0dad\u0dd4\u0dbb\u0dd4 \u0db1\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dd9 \u0db1\u0dd1. \u0d85\u0daf \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba\u0dda \u0d87\u0db8\u0dad\u0dd2 \u0dc0\u0dd9\u0dbd\u0dcf \u0d89\u0db1\u0dca\u0db1\u0dda \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d85\u0db1\u0dd4\u0dc0 \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0d91\u0dc5\u0dc0\u0db4\u0dd4 \u0d9a\u0dd9\u0db1\u0dd9\u0d9a\u0dca.\u0d85\u0db9\u0db1\u0dca\u0db4\u0ddc\u0dc5, \u0d9c\u0dbd\u0dca\u0d9c\u0db8\u0dd4\u0dc0 \u0dad\u0db9\u0dd4\u0dad\u0dca\u0dad\u0dda\u0d9c\u0db8 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0d95\u0dc0\u0dcf \u0daf\u0db1\u0dca\u0db1\u0dc0\u0dcf \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca\u0daf \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dcf \u0d9a\u0dd3\u0dba."
  },
