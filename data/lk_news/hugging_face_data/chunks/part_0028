    "description": "Why governments bet on long-term sports tourism partnerships",
    "url_metadata": "https://www.ft.lk/opinion/Why-governments-bet-on-long-term-sports-tourism-partnerships/14-783699",
    "lang": "en",
    "newspaper_id": "dailyftlk",
