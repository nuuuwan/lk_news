    "chunk_text": "\u0da0\u0db8\u0dbb\u0dd2 \u0d85\u0dad\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dd3 \u0d9a\u0da9\u0dba\u0dd2\u0db8\u0d9a\u0dca \u0db4\u0dc3\u0dd4 \u0d9a\u0dbb\u0dba\u0dd2\n\n2025 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dbd\u0dcf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db6\u0d82\u0d9c\u0dca\u0dbd\u0dcf\u0daf\u0dda\u0dc1\u0dba \u0d85\u0dad\u0dbb \u0dad\u0dbb\u0d9c\u0dba \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dda.\n\n\u0dad\u0dbb\u0d9c\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dbb\u0daf\u0dd9\u0db1 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb 11\u0d9a\u0dca \u0d85\u0dc0\u0dc3\u0dcf\u0db1\u0dba\u0dda \u0d91\u0d9a\u0dca \u0d9a\u0da9\u0dd4\u0dbd\u0dca\u0dbd\u0d9a\u0dca \u0daf\u0dd0\u0dc0\u0dd3 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 69\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dc4.\n\n\u0db8\u0dd9\u0db8 \u0dad\u0dbb\u0d9c\u0dba\u0dda\u0daf\u0dd3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dcf\u0dba\u0dd2\u0d9a\u0dcf \u0da0\u0db8\u0dbb\u0dd2 \u0d85\u0dad\u0db4\u0dad\u0dca\u0dad\u0dd4 \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dd3 \u0d9a\u0da9\u0dba\u0dd2\u0db8\u0d9a\u0dca \u0db4\u0dc3\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0dba.\n\n\u0d92, \u0d91\u0d9a\u0dca\u0daf\u0dd2\u0db1 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 4000 \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0db4\u0dc3\u0dd4 \u0d9a\u0dc5 \u0db4\u0dc5\u0db8\u0dd4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dd2\u0d9a\u0dcf\u0dc0 \u0dbd\u0dd9\u0dc3\u0dba.\n\n\u0d91\u0db8\u0dd9\u0db1\u0dca\u0db8 \u0da0\u0db8\u0dbb\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d85\u0dad\u0dbb\u0da7 \u0d91\u0d9a\u0dca \u0dc0\u0dd4\u0dab\u0dda \u0d91\u0db8 \u0d9a\u0da9\u0dba\u0dd2\u0db8 \u0db4\u0dc3\u0dd4 \u0d9a\u0dc5 \u0dc3\u0dd2\u0dc0\u0dca\u0dc0\u0db1 \u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0db4\u0dd2\u0dad\u0dd2\u0d9a\u0dcf\u0dbb\u0dd2\u0db1\u0dd2\u0dba \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca\u0dba."
  },
