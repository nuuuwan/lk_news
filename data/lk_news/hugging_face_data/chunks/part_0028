    "chunk_text": "\u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0dbb\u0dd0\u0da2\u0db1\u0d9c\u0dda \u0d85\u0db7\u0dcf\u0dc0\u0dba\u0da7 \u0dc3\u0ddc\u0dc0 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dba\u0dba\u0dd2\n\n\u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0dba\u0dda (Sirikit) \u0dc3\u0dd2\u0dbb\u0dd2\u0d9a\u0dd2\u0dad\u0dca \u0dbb\u0dd0\u0da2\u0db1\u0dd2\u0dba\u0d9c\u0dda \u0d85\u0db7\u0dcf\u0dc0\u0dba \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0ddc\u0dc0 \u0db4\u0dc5 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0da7 \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dbb\u0db1\u0dd2\u0dbd\u0dca \u0dc0\u0dd2\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf \u0d9a\u0ddc\u0dc5\u0db9 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0dad\u0dcf\u0db1\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda\u0daf\u0dd3 \u0d85\u0daf (31)\u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9c\u0dde\u0dbb\u0dc0 \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0dba.\n\n93 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0dba\u0dd9\u0dc4\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd6 \u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0dbb\u0dd0\u0da2\u0db1 \u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0dda \u0d89\u0dad\u0dcf \u0d9c\u0dde\u0dbb\u0dc0\u0dba\u0da7 \u0db4\u0dcf\u0dad\u0dca\u200d\u0dbb \u0dc0\u0dd6 \u0da0\u0dbb\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0dc4\u0dd0\u0db3\u0dd2\u0db1\u0dca\u0dc0\u0dd9\u0dba\u0dd2.\n\n\u0d87\u0dba \u0d89\u0d9a\u0dd4\u0dad\u0dca 24 \u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dcf\u00a0 \u0d85\u0db7\u0dcf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dca\u0dad \u0dc0\u0dd6\u0dc0\u0dcf\u0dba. \u0d87\u0d9c\u0dda \u0db4\u0dd4\u0dad\u0dca \u0dc0\u0da2\u0dd2\u0dbb\u0dbd\u0ddc\u0db1\u0dca\u0d9a\u0ddd\u0db1\u0dca \u0dbb\u0da2\u0dd4 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dbb\u0dd0\u0da2\u0db1\u0d9c\u0dda \u0d85\u0db7\u0dcf\u0dc0\u0dba \u0db1\u0dd2\u0db8\u0dd2\u0dad\u0dca\u0dad\u0dd9\u0db1\u0dca\u00a0 \u0dc0\u0dc3\u0dbb\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0dcf \u0dc1\u0ddd\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0dad\u0dbb, \u0d86\u0daf\u0dcf\u0dc4\u0db1\u0dba\u0da7 \u0db4\u0dd9\u0dbb \u0d87\u0d9c\u0dda \u0daf\u0dda\u0dc4\u0dba \u0db8\u0dc4\u0dcf \u0db8\u0dcf\u0dbd\u0dd2\u0d9c\u0dcf\u0dc0\u0dda \u0dad\u0dd0\u0db1\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0db6\u0dda."
  },
