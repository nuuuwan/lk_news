    "description": "\u0db8\u0dd9\u0dcf\u0db1\u0dca\u0da7\u0dd2\u0dc3\u0dd9\u0dcf\u0dca\u0dbb\u0dd2\u0dc0\u0dbd\u0da7  \u0dbd\u0db6\u0db1 \u0dc0\u0dc3\u0dbb\u0dd9\u0dca \u0dc3\u0dd2\u0da7  \u0d91\u0d9a\u0db8 \u0dc0\u0dd2\u0dc2\u0dba \u0db8\u0dcf\u0dbd\u0dcf\u0dc0\u0d9a\u0dca",
