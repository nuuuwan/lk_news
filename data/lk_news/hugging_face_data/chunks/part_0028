    "description": "\u0b87\u0ba9\u0bcd\u0bb1\u0bc8\u0baf \u0bb5\u0bbe\u0ba9\u0bbf\u0bb2\u0bc8",
    "url_metadata": "https://www.virakesari.lk/article/228242",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1761010620.0,
