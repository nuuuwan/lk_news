 \u0d92 \u0db6\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0d9a\u0dc5\u0dda, \u0dc3\u0dd2\u0dc0\u0dca \u0dc0\u0db1 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0da2\u0dca\u200d\u0dba\u0dd9\u0dc2\u0dca\u0da8 \u0db8\u0dbd\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc1\u0dd6\u0dbb\u0dad\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb \u0d85\u0daf (\u0d94\u0d9a\u0dca: 28) \u0dba\u0dc5\u0dd2 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba\u0dc0\u0dda\u0daf\u0dd3\u0db1\u0dca \u0d85\u0db8\u0dad\u0db8\u0dd2\u0db1\u0dd2.\n\n\u0dc3\u0dd2\u0dc0\u0dca \u0dc0\u0db1 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0da2\u0dca\u200d\u0dba\u0dd9\u0dc2\u0dca\u0da8 \u0db8\u0dbd\u0dbd \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0dc1\u0dd6\u0dbb\u0dad\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda\u0daf\u0dd3 \u0dbb\u0db1\u0dca \u0db4\u0daf\u0d9a\u0dca\u0d9a\u0db8\u0dca 16\u0d9a\u0dca, \u0dbb\u0dd2\u0daf\u0dd3 \u0db4\u0daf\u0d9a\u0dca\u0d9a\u0db8\u0dca 14\u0d9a\u0dca, \u0dbd\u0ddd\u0d9a\u0da9 \u0db4\u0daf\u0d9a\u0dca\u0d9a\u0db8\u0dca 10\u0d9a\u0dca \u0daf \u0dc3\u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db8\u0dd4\u0dc5\u0dd4 \u0db4\u0daf\u0d9a\u0dca\u0d9a\u0db8\u0dca 40\u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0d85\u0db1\u0dd4\u0dc1\u0dd6\u0dbb\u0dad\u0dcf\u0dc0 \u0dc4\u0dd2\u0db8\u0dd2 \u0d9a\u0dbb \u0d9c\u0dad\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0d85\u0daf  \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dba\u0dda \u0dba.\n\n\u0db8\u0dd9\u0db8 \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda\u0daf\u0dd3 \u0dc3\u0dc6\u0dd2\u0dba\u0dcf \u0dba\u0dcf\u0db8\u0dd2\u0d9a\u0dca \u0db8\u0dd3\u0da7\u0dbb\u0dca 100, \u0db8\u0dd3\u0da7\u0dbb\u0dca 200 \u0dc3\u0dc4 \u0db8\u0dd3\u0da7\u0dbb\u0dca 100 \u0dc3\u0dc4\u0dba \u0daf\u0dd2\u0dc0\u0dd3\u0db8 \u0dba\u0db1 \u0d89\u0dc3\u0dc0\u0dca \u0dad\u0dd4\u0db1\u0dd9\u0db1\u0dca \u0db8 \u0dbb\u0db1\u0dca \u0db4\u0daf\u0d9a\u0dca\u0d9a\u0db8\u0dca \u0daf\u0dd2\u0db1\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0dba.\n\n\u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0daf \u0dc3\u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d87\u0dba \u0db8\u0dd3\u0da7\u0dbb\u0dca 200 \u0dad\u0dbb\u0d9c \u0d89\u0dc3\u0dc0\u0dca\u0dc0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dc5\u0dda, \u0dad\u0dad\u0dca\u0db4\u0dbb 23.58\u0d9a \u0daf\u0d9a\u0dca\u0dc2\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dd2.\n\n\u0d87\u0dba \u0db6\u0dd2\u0db3 \u0daf\u0dd0\u0db8\u0dd4\u0dc0\u0dda, \u0dc0\u0dc3\u0dbb 27\u0d9a\u0da7 \u0db4\u0dd9\u0dbb \u0d89\u0db1\u0dca\u0daf\u0dd3\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dd2\u0d9a\u0dcf \u0db4\u0dd3.\u0da7\u0dd3. \u0d8c\u0dc2\u0dcf \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd4\u0dc0\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 \u0dba\u0dd2."
