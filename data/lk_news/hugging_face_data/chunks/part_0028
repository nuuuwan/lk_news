    "chunk_text": "\u0db8\u0dd9\u0db8 \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca\u0dc0 \u0d91\u0dc5\u0dd2 \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca Kia \u0db8\u0ddd\u0da7\u0dbb\u0dca\u0dc3\u0dca \u0dbd\u0d82\u0d9a\u0dcf \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dba\u0dda \u0d85\u0dad\u0dd3\u0dad\u0dba \u0dc3\u0db8\u0d9f \u0d91\u0dc4\u0dd2 \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dd4\u0dad\u0dca \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0 \u0d9a\u0dbb\u0dba\u0dd2. 2026 Sorento Hybrid \u0dbb\u0dae\u0dba Kia \u0dc4\u0dd2 \u0db6\u0dbd\u0dc0\u0dad\u0dca \u0dc0\u0dd6\u0dad\u0dca, \u0da2\u0db1\u0dad\u0dcf \u0d9a\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dd3\u0dba \u0dc0\u0dd6\u0dad\u0dca SUV \u0dbb\u0dae\u0dc0\u0dbd \u0d8b\u0dbb\u0dd4\u0db8\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db9\u0dd2\u0db9\u0dd4 \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb\u0db8, EV5 \u0dbb\u0dae\u0dba \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0db8\u0dad\u0dca, \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dd2\u0dad \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dd4\u0dad\u0dca \u0db0\u0dcf\u0dc0\u0db1\u0dba\u0dda \u0db1\u0dc0 \u0dba\u0dd4\u0d9c\u0dba \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0dba\u0dd2. \u0dc3\u0db8\u0dc3\u0dca\u0dad\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dc3, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dda\u0dba \u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dbb\u0dae \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca \u0dc4\u0da7 \u0dc0\u0dd2\u0dbd\u0dcf\u0dc3\u0dd2\u0dad\u0dcf\u0dc0, \u0dc4\u0dbb\u0dba \u0dc3\u0dc4 \u0dad\u0dd2\u0dbb\u0dc3\u0dcf\u0dbb\u0db7\u0dcf\u0dc0\u0dba \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0 \u0dc0\u0dd6 \u0dc0\u0dcf\u0dc4\u0db1 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7 Kia \u0dc4\u0dd2 \u0d87\u0dad\u0dd2 \u0daf\u0dd2\u0d9c\u0dd4\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0d9a\u0dd0\u0db4\u0dc0\u0dd3\u0db8 \u0db8\u0dd9\u0db8 \u0db1\u0dc0 \u0db8\u0dcf\u0daf\u0dd2\u0dbd\u0dd2 \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db8\u0db1\u0dcf\u0dc0 \u0db4\u0dd9\u0db1\u0dca\u0db1\u0dd4\u0db8\u0dca \u0d9a\u0dbb\u0dba\u0dd2."
  },
