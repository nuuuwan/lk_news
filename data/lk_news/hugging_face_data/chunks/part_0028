    "url_metadata": "https://www.ada.lk/international/\u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca-\u0dc4\u0dcf-\u0dc2\u0dd3-\u0d85\u0dad\u0dbb-\u0dc3\u0dcf\u0d9a\u0da0\u0dca\u0da1\u0dcf-\u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a\u0dba\u0dd2/3-419422",
