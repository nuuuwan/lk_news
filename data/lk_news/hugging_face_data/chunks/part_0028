    "chunk_id": "2025-11-01-lankadeepalk-5a2af8cd-0000",
    "chunk_index": 0,
    "language": "si",
    "md5": "9324e46c1008352468fee2a4a7a868e6",
    "chunk_size_bytes": 2038,
    "chunk_text": "\u0d85\u0dbd\u0dd4\u0dad\u0dca \u0db1\u0dd2. \u0d87\u0db8\u0dad\u0dd2\u0dbd\u0dcf \u0dc4\u0dba \u0daf\u0dd9\u0db1\u0dcf\u0dad\u0dca  \u0db8\u0dd0\u0dad\u0dd2\u0dc3\u0db6\u0dda \u0dad\u0dd9\u0dbd\u0dca \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dad\u0dd2\n\n\u0db8\u0dd1\u0dad\u0d9a\u0daf\u0dd3 \u0db4\u0dad\u0dca \u0d9a\u0dd9\u0dbb\u0dd4\u0dab\u0dd4 \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc4\u0dba \u0daf\u0dd9\u0db1\u0dcf\u0daf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dd9\u0d9a\u0dd4 \u0dbd\u0dd9\u0dc3 \u0dbd\u0db6\u0dcf\u0daf\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db1\u0ddc\u0dc0\u0db1 \u0db6\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dd3\u0db1\u0dca\u0da7 \u0dbd\u0dd2\u0d9b\u0dd2\u0dad\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca\u0daf\u0dd3 \u0d87\u0dad.\n\n\u0db8\u0dda \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dd2\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0da7 \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0 \u0db4\u0db8\u0dab\u0d9a\u0dd2.\n\n\u0d91\u0dbb\u0d82\u0d9c \u0d9c\u0dd4\u0dab\u0dc3\u0dda\u0d9a\u0dbb, \u0d85\u0dbb\u0dc0\u0dd2\u0db1\u0dca\u0daf \u0dc3\u0dd9\u0db1\u0dbb\u0dad\u0dca, \u0daf\u0dd2\u0db1\u0dd2\u0db3\u0dd4 \u0dc3\u0db8\u0db1\u0dca \u0d9a\u0dd4\u0db8\u0dcf\u0dbb, \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad \u0da2\u0dba\u0dc0\u0dd3\u0dbb, \u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0d9a\u0dde\u0dc1\u0dbd\u0dca\u200d\u0dba\u0dcf \u0d86\u0dbb\u0dd2\u0dba\u0dbb\u0dad\u0dca\u0db1 \u0dc3\u0dc4 \u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca \u0d85\u0dba\u0dd2 \u0d85\u0dbb\u0dca\u0d9a\u0db8\u0dca \u0db8\u0dd9\u0dc3\u0dda \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0db1\u0ddc\u0dc0\u0db1 \u0db6\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0dc0\u0dd9\u0dad\u0dd2.\n\n\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dbb\u0da2\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0dc3\u0dc4 \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4 \u0db6\u0ddc\u0dc4\u0ddd \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dca \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db0\u0dd6\u0dbb\u0dba\u0da7 \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dd9\u0d9a\u0dd4\u0da7 \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0\u0daf\u00a0 \u0dbd\u0db6\u0dcf \u0d9c\u0dad\u0dca\u0dc4.\n\n\u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0db1\u0dd2\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca 48 \u0daf\u0dd9\u0db1\u0d9a\u0dd4 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0d89\u0db1\u0dca\u0db0\u0db1 \u0daf\u0dd3\u0db8\u0db1\u0dcf\u0dc0 \u0db8\u0dd3\u0da7 \u0db4\u0dd9\u0dbb \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0d9a\u0dca\u0dc2\u0dda\u0db4 \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd2\u0dab."
