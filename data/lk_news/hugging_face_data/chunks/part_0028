    "description": "Ashika Gunasena honoured for outstanding contribution to Women MSME Empowerment",
    "url_metadata": "https://www.ft.lk/business/Ashika-Gunasena-honoured-for-outstanding-contribution-to-Women-MSME-Empowerment/34-783355",
    "lang": "en",
    "newspaper_id": "dailyftlk",
