    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db4\u0dc3-\u0d9a\u0dab\u0da9\u0dba\u0d9a\u0da7-\u0dba\u0da7\u0dc0-\u0d85\u0dba\u0d9a-\u0db8\u0dbb\u0da7/1-681681",
