    "url_metadata": "https://www.ada.lk/sports/\u0db8\u0dda-\u0dc0\u0dc3\u0dbb\u0dda-LPL-\u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba-\u0db1\u0dd1/9-419268",
