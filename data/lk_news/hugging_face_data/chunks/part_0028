    "date_str": "2025-10-21",
    "description": "The new Cold War is made of gold: A weapon against the dollar",
    "url_metadata": "http://island.lk/the-new-cold-war-is-made-of-gold-a-weapon-against-the-dollar/",
    "lang": "en",
    "newspaper_id": "islandlk",
