    "description": "\u0db8\u0dd2\u0dbb\u0dd2\u0dc3\u0dca \u0db8\u0ddd\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0dbb\u0db9\u0dcf \u0dbd\u0ddc\u0dc0\u0d9a\u0dca \u0da2\u0dba\u0d9c\u0dad\u0dca  \u0dc6\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dad\u0dd8 \u0dc4\u0dd9\u0da7 \u0daf\u0dd0\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dd4\u0d9c\u0db1\u0dd2\u0dba\u0dd2",
