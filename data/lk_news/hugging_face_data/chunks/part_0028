    "url_metadata": "https://www.lankadeepa.lk/news/\u0d8b\u0dc3\u0dc3-\u0db4\u0dc5-\u0db4\u0db1\u0dad-\u0dc3\u0db8\u0db8\u0db1\u0dad\u0dbb\u0dab-4-\u0dc0\u0db1\u0daf\u0dba\u0db1-\u0db4\u0dc3-\u0dad\u0dc4\u0db1\u0db8/101-682489",
