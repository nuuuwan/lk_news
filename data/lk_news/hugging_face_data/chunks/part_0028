    "description": "\u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dc0\u0dbd \u0dc3\u0dd2\u0dbb\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca 300% \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dba\u0dd2: \u0dc3\u0dd2\u0dbb\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0da7 \u0db1\u0dd2\u0daf\u0dc4\u0dc3 \u0d89\u0dbd\u0dca\u0dbd\u0dba\u0dd2",
