    "url_metadata": "https://www.lankadeepa.lk/news/\u0db8\u0dba\u0d9c\u0dba-\u0d9a\u0d9a\u0dc5\u0dc0\u0db1-\u0dad\u0dbb\u0db8\u0dbd-\u0dc0\u0dbb\u0dba/101-682404",
