    "description": "\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0 \u0dbb\u0dd0\u0dc3\u0dca \u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0da2\u0dad\u0d9a-\u0dc3\u0d9b\u0dba-\u0dc3\u0dc0\u0dbb\u0db0\u0db1-\u0d9a\u0db8\u0da7\u0dc0-\u0dbb\u0dc3-\u0dc0\u0dba/1-682375",
