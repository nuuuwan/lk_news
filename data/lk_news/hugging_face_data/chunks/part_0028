    "description": "Africa\u2019s coup contagion:Lessons for others",
    "url_metadata": "http://island.lk/africas-coup-contagionlessons-for-others/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1760980020.0,
    "chunk_id": "2025-10-20-islandlk-8a86f0aa-0000",
    "chunk_index": 0,
