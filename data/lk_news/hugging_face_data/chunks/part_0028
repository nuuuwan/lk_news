    "chunk_text": "\u0d9c\u0dcf\u0dbd\u0dd4 \u0d9a\u0ddc\u0da7\u0dd4\u0dc0\u0dda \u0dbb\u0da2\u0dba\u0dda \u0d89\u0da9\u0db8\u0dca \u0db4\u0dd4\u0daf\u0d9c\u0dbd\u0dba\u0db1\u0dca 17\u0d9a\u0dca \u0db6\u0dbd\u0dd9\u0db1\u0dca \u0d85\u0dbd\u0dca\u0dbd\u0dcf\u0d9c\u0dd9\u0db1\n\n\u0dbd\u0ddd\u0d9a \u0d8b\u0dbb\u0dd4\u0db8 \u0d9c\u0dcf\u0dbd\u0dd4\u0d9a\u0ddc\u0da7\u0dd4\u0dc0\u00a0 \u0dad\u0dd4\u0dc5 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dbb\u0da2\u0dba\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d89\u0da9\u0db8\u0dca \u0dc0\u0dbd\u0dd2\u0db1\u0dca\u00a0 \u0db4\u0dbb\u0dca\u0da0\u0dc3\u0dca 21.83 \u0d9a\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dd2\u0db1\u0dca 17 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0d85\u0db1\u0dc0\u0dc3\u0dbb\u0dba\u0dd9\u0db1\u0dca\u00a0 \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0db4\u0dbb\u0dd2\u0dc4\u0dbb\u0dab\u0dba \u0dc3\u0daf\u0dc4\u0dcf \u0dba\u0ddc\u0daf\u0dcf\u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dd2 \u0db1\u0dc0\u0dad\u0db8 \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u0dc0\u0dd2 \u0d87\u0dad.\n\n\u0d91\u0db8 \u0d89\u0da9\u0db8\u0dca \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u00a0 \u0dad\u0dd4\u0dbd\u0daf\u0dd2 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb\u0db1\u0ddc\u0dad\u0dd2\u0db6\u0dd4 \u0db6\u0dc0\u0daf \u0dc0\u0dd2\u0d9c\u0dab\u0db1 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0dda \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dda. \u0d85\u0daf\u0dcf\u0dc5 \u0d86\u0dba\u0dad\u0db1 \u0dc3\u0db8\u0d9c \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0dc0\u0dd2\u00a0 \u0dbb\u0da2\u0dba\u0da7 \u0d85\u0dba\u