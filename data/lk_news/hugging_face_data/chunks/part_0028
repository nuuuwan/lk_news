    "description": "Govt. sets up National Commission on Women to address issues on women",
    "url_metadata": "https://www.ft.lk/news/Govt-sets-up-National-Commission-on-Women-to-address-issues-on-women/56-783669",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1761783636.0,
