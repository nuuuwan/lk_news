    "description": "\u0db1\u0dcf \u0d8b\u0dba\u0db1 \u0d86\u0dbb\u0dab\u0dca\u200d\u0dba \u0dc3\u0dd9\u0db1\u0dc3\u0dd4\u0db1\u0dda \u0d85\u0db1\u0dad\u0dd4\u0dbb \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0db0\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0db8\u0dbb\u0dca\u0dc1\u0db1\u0dba\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 - \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0dd9\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\u0d9c",
