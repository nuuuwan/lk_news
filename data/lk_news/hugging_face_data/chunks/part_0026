    "description": "Recognising Palestine A Farce: Elegant Way Of Doing Nothing",
    "url_metadata": "https://www.colombotelegraph.com/index.php/recognising-palestine-a-farce-elegant-way-of-doing-nothing/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
