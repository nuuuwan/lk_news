    "description": "\u0d85\u0dbd\u0dd2\u0dba\u0dcf \u0d85\u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0da7 \u0dc3\u0dc4 \u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dc3\u0dd3\u0db8\u0dcf \u0dc0\u0dd6\u0dba\u0dda \u0d87\u0dba\u0dd2? \u0d9c\u0ddc\u0da9\u0db6\u0dd2\u0db8 \u0daf\u0dd0\u0dc0\u0db1\u0dca\u0dad\u0dba\u0dcf\u0d9c\u0dda \u0db4\u0dbb\u0dd2\u0dab\u0dcf\u0db8\u0dba\u0dda \u0d9a\u0dad\u0dcf\u0dc0",
