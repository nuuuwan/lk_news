    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0baa\u0bbe\u0b99\u0bcd\u0b95\u0bca\u0b95\u0bcd\u0b95\u0bbf\u0bb2\u0bcd-\u0baa\u0bbe\u0bb0\u0bbf\u0baf-\u0b85\u0ba9\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bcd-\u0bb5\u0bc0\u0b9f\u0bbf\u0baf\u0bcb-\u0b87\u0ba3\u0bc8\u0baa\u0bcd\u0baa\u0bc1/50-365216",
