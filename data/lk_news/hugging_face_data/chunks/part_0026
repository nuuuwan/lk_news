    "description": "\u0d96\u0dc2\u0db0 \u0dc4\u0dd2\u0d9c\u0dba\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dba\u0db8\u0dca \u0dc3\u0dd9\u0dc0\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc3\u0db8\u0dc4\u0dbb \u0db1\u0dd3\u0dad\u0dd2 \u0d8a\u0dad\u0dd2\u0dad\u0dca \u0db6\u0dcf\u0db0\u0dcf\u0dba\u0dd2",
