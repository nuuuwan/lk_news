    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0daf\u0dc1\u0db4\u0dbd\u0db1-\u0d9c\u0dad-\u0dbb\u0da2\u0dba-\u0dc3\u0dc0\u0dba-\u0d85\u0dc0\u0dc3\u0db1/1-680419",
    "lang": "si",
