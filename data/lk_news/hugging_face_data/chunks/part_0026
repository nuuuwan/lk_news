    "description": "\u0db1\u0dcf \u0d8b\u0dba\u0db1 \u0d86\u0dbb\u0dab\u0dca\u200d\u0dba \u0dc3\u0dda\u0db1\u0dcf\u0dc3\u0db1\u0dba\u0dda \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0d9a\u0dca -\u00a0 \u0db7\u0dd2\u0d9a\u0dca\u0dc2\u0dd6\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc3\u0dda\u0dbd\u0dcf 5\u0d9a\u0dca \u0d85\u0db4\u0dc0\u0dad\u0dca \u0dc0\u0dd9\u0dad\u0dd2",
