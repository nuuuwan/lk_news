    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbd\u0dc0\u0db8-\u0d9c\u0dbd\u0dbd-\u0dc3\u0dbd\u0dbd-\u0db8\u0dbd\u0dbd/1-680447",
    "lang": "si",
