    "description": "\u0d9c\u0dcf\u0dbd\u0dca\u0dbd\u0dda \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0da2\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd9\u0dba\u0dd2",
