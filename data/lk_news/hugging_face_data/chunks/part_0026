    "description": "Drone activity confirmed at multiple Denmark airports",
    "url_metadata": "https://www.adaderana.lk/news/112904/drone-activity-confirmed-at-multiple-denmark-airports",
    "lang": "en",
    "newspaper_id": "adaderanalk",
