    "description": "\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0dc3\u0da7\u0db1\u0da7",
