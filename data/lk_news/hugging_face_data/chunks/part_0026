    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0baa\u0bca\u0b9f\u0bbf-\u0bae\u0bc6\u0ba9\u0bbf\u0b95\u0bcd\u0b95\u0bc7-\u0b9a\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0baf-\u0baa\u0bc6\u0ba3\u0bcd/76-365416",
