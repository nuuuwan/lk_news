    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db1-\u0d8b\u0dba\u0db1-\u0d86\u0dbb\u0dab\u0dba\u0dba-\u0d9b\u0daf\u0dc0\u0da0\u0d9a\u0dba-\u0d9c\u0db1-\u0db8\u0dc4\u0db1\u0daf-\u0daf\u0d9a-\u0dc0\u0dba/1-680216",
