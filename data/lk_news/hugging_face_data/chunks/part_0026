    "url_metadata": "https://www.lankadeepa.lk/news/\u0daf\u0dc4\u0dc0\u0dbd-\u0dc0\u0da9-\u0dad\u0db6\u0db8-\u0db4\u0daf\u0d9a\u0dbb-\u0d85\u0dad\u0d85\u0da9\u0d9c\u0dc0\u0da7/101-680710",
