    "description": "SLFFA calls for urgent policy rethink on SVAT",
    "url_metadata": "https://www.ft.lk/business/SLFFA-calls-for-urgent-policy-rethink-on-SVAT/34-782383",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1759177233.0,
    "chunk_id": "2025-09-30-dailyftlk-88f3e004-0000",
    "chunk_index": 0,
