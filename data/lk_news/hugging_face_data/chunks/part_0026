    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d9a\u0db4-\u0d9a\u0db8\u0da7\u0dc0\u0db1-\u0dc0\u0daf\u0dbd\u0dba\u0da7-\u0dbb\u0dad-\u0d91\u0dc5\u0dba\u0d9a/1-680434",
