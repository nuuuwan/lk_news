    "description": "BASL defends lawyers\u2019 car passes, says Gazette does not apply",
    "url_metadata": "https://www.ft.lk/news/BASL-defends-lawyers-car-passes-says-Gazette-does-not-apply/56-782389",
    "lang": "en",
    "newspaper_id": "dailyftlk",
