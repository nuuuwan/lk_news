    "md5": "190ca47fc0bca69917cbfb0f9c080fa9",
    "chunk_size_bytes": 3644,
    "chunk_text": "\u0b87\u0ba4\u0bc1 \u0b87\u0bb5\u0bcd\u00ad\u0bb5\u0bbe\u00ad\u0bb1\u0bbf\u00ad\u0bb0\u0bc1\u0b95\u0bcd\u0b95 1945 \u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1 \u0b87\u0bb0\u0ba3\u0bcd\u0b9f\u0bbe\u0bae\u0bcd \u0b89\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0bcb\u0bb0\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u00ad\u0bb5\u0bbf\u0bb2\u0bcd, \u0b89\u0bb2\u0b95 \u0b85\u0bae\u0bc8\u00ad\u0ba4\u0bbf\u0baf\u0bc8 \u0ba8\u0bbf\u0bb2\u0bc8\u00ad\u0ba8\u0bbe\u0b9f\u0bcd\u00ad\u0b9f\u0bc1\u0ba4\u0bb2\u0bcd, \u0bae\u0bcb\u0ba4\u0bb2\u0bcd\u00ad\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bc7\u0b9a\u0bcd\u00ad\u0b9a\u0bc1\u00ad\u0bb5\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc8 \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0ba9\u0bbf\u0ba4 \u0b89\u0bb0\u0bbf\u00ad\u0bae\u0bc8\u00ad\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bbe\u0ba4\u0bc1\u00ad\u0b95\u0bbe\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0b86\u0b95\u0bbf\u0baf \u0b89\u0ba9\u0bcd\u00ad\u0ba9\u0ba4 \u0b87\u0bb2\u0b95\u0bcd\u00ad\u0b95\u0bc1\u00ad\u0b95\u00ad\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd \u0b90\u0b95\u0bcd\u00ad\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8 \u0b89\u0bb0\u0bc1\u00ad\u0bb5\u0bbe\u0b95\u0bcd\u00ad\u0b95\u0baa\u0bcd\u00ad\u0baa\u0b9f\u0bcd\u00ad\u0b9f\u0ba4\u0bc1. \u0b85\u0bae\u0bc6\u00ad\u0bb0\u0bbf\u0b95\u0bcd\u00ad\u0b95\u0bbe\u0bb5\u0bbf\u0ba9\u0bcd \u0ba4\u0bb2\u0bc8\u00ad\u0bae\u0bc8\u0ba4\u0bcd\u00ad\u0ba4\u0bc1\u00ad\u0bb5\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0bb1\u0bc1\u00ad\u0bb5\u0baa\u0bcd\u00ad\u0baa\u0b9f\u0bcd\u0b9f \u0b87\u0ba8\u0bcd\u0ba4 \u0b89\u0bb2\u0b95 \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1, 80 \u0b86\u0ba3\u0bcd\u00ad\u0b9f\u0bc1\u00ad\u0b95\u0bb3\u0bc8 \u0ba8\u0bbf\u0bb1\u0bc8\u0bb5\u0bc1 \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1, \u0ba4\u0ba9\u0ba4\u0bc1 80-\u0b86\u0bb5\u0ba4\u0bc1 \u0baa\u0bca\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0baa\u0bc8\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u00ad\u0b9f\u0ba4\u0bcd\u00ad\u0ba4\u0bca\u00ad\u0b9f\u0bb0\u0bc8 (UNGA 80) \u0ba8\u0bbf\u0baf\u0bc2\u0baf\u0bcb\u0bb0\u0bcd\u0b95\u0bcd \u0ba8\u0b95\u0bb0\u0bbf\u0bb2\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u00ad\u0ba4\u0bbf\u00ad\u0baf\u0ba4\u0bc1. \u0b89\u0bb2\u0b95 \u0ba8\u0bbe\u0b9f\u0bc1\u00ad\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba4\u0bb2\u0bc8\u00ad\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbf\u0b9f\u0bcd\u00ad\u0b9f\u0ba4\u0bcd\u00ad\u0ba4\u0b9f\u0bcd\u0b9f \u0b85\u0ba9\u0bc8\u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b92\u0ba9\u0bcd\u00ad\u0bb1\u0bc1\u00ad\u0b95\u0bc2\u00ad\u0b9f\u0bbf\u0baf \u0b87\u0ba8\u0bcd\u0ba4\u0b9a\u0bcd \u0b9a\u0baa\u0bc8, \u0b89\u0bb2\u0b95\u0bbf\u0ba9\u0bcd \u0baa\u0bb2 \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u00ad\u0b9a\u0bbf\u00ad\u0ba9\u0bc8\u00ad\u0b95\u00ad\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bb5\u0bc1 \u0b95\u0bbe\u0ba3\u0bc1\u0bae\u0bcd \u0b92\u0bb0\u0bc1 \u0ba4\u0bb3\u00ad\u0bae\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bb0\u0bc1\u00ad\u0ba4\u0baa\u0bcd\u00ad\u0baa\u00ad\u0b9f\u0bc1\u00ad\u0b95\u0bbf\u00ad\u0bb1\u0ba4\u0bc1. \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u00ad\u0baa\u0bbf\u0ba9\u0bc1\u0bae\u0bcd, \u0b87\u0ba8\u0bcd\u0ba4\u0b95\u0bcd \u0b95\u0bc2\u0b9f\u0bcd\u00ad\u0b9f\u0ba4\u0bcd\u00ad\u0ba4\u0bca\u0b9f\u0bb0\u0bcd, \u0b90.\u0ba8\u0bbe.\u0bb5\u0bbf\u0ba9\u0bcd \u0b9a\u0bc6\u0baf\u0bb2\u0bcd\u00ad\u0baa\u0bbe\u00ad\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba4\u0bbe\u0ba9 \u0b95\u0b9f\u0bc1\u00ad\u0bae\u0bc8\u00ad\u0baf\u0bbe\u0ba9 \u0bb5\u0bbf\u0bae\u0bb0\u0bcd\u00ad\u0b9a\u00ad\u0ba9\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0ba8\u0bbe\u0b9f\u0bc1\u00ad\u0b95\u00ad\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0b9f\u0bc8\u00ad\u0baf\u0bc7\u00ad\u0baf\u0bbe\u0ba9 \u0b85\u0ba4\u0bbf\u00ad\u0b95\u00ad\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0b89\u0b9f\u0ba9\u0bcd\u00ad\u0baa\u0bbe\u00ad\u0b9f\u0bbf\u0ba9\u0bcd\u00ad\u0bae\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b89\u0bb2\u0b95\u0bbf\u0ba9\u0bcd \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0baa\u0bb2\u00ad\u0ba4\u0bc1\u00ad\u0bb0\u0bc1\u00ad\u0bb5\u00ad\u0bae\u00ad\u0baf\u00ad\u0bae\u0bbe\u0b95\u0bcd\u0b95\u0bb2\u0bcd (Multipolarization) \u0baa\u0bcb\u0b95\u0bcd\u0b95\u0bc1 \u0b86\u0b95\u0bbf\u00ad\u0baf\u00ad\u0bb5\u0bb1\u0bcd\u0bb1\u0bbf\u0ba9\u0bcd \u0bb5\u0bc6\u0bb3\u0bbf\u0baa\u0bcd\u00ad\u0baa\u0bbe\u00ad\u0b9f\u0bbe\u00ad\u0b95\u0bb5\u0bc7 \u0b85\u0bae\u0bc8\u0ba8\u0bcd\u00ad\u0ba4\u0ba4\u0bc1.\n\n\u0baf\u0bc1\u0ba4\u0bcd\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0b9f\u0bc8\u0baa\u0bc6\u0bb1\u0bbe\u0bae\u0bb2\u0bcd \u0ba4\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u00ad\u0ba4\u0bbf\u0bb2\u0bcd \u0bb5\u0bc6\u0bb1\u0bcd\u0bb1\u0bbf \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bbe\u0bb2\u0bc1\u0bae\u0bcd, \u0ba4\u0bb1\u0bcd\u0baa\u0bcb\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bcb\u0ba4\u0bb2\u0bcd\u0b95\u0bb3\u0bc8 \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u00ad\u0bb5\u0bb0\u0bc1\u00ad\u0bb5\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd, \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b87\u0b9f\u0bc8\u0baf\u0bc7\u0baf\u0bbe\u0ba9 \u0baa\u0bbf\u0bb0\u0b9a\u0bcd\u0b9a\u0bbf\u0ba9\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bcd \u0baa\u0bc7\u0b9a\u0bcd\u0b9a\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc8 \u0bae\u0bc2\u0bb2\u0bae\u0bcd \u0ba4\u0bc0\u0bb0\u0bcd\u0bb5\u0bc1 \u0b95\u0bbe\u0ba3\u0bcd\u0baa\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bc7\u0bb1\u0bcd\u0bb1\u0bae\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bc8 \u0b8e\u0ba9\u0bcd\u0bb1 \u0bb5\u0bbf\u0bae\u0bb0\u0bcd\u0b9a\u0ba9\u0bae\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.\n\n\u0b90\u0b95\u0bcd\u0b95\u0bbf\u0baf \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bcd \u0b9a\u0baa\u0bc8\u0baf\u0bbf\u0ba9\u0bcd 80-\u0b86\u0bb5\u0ba4\u0bc1 \u0baa\u0bca\u0ba4\u0bc1\u0b9a\u0bcd \u0b9a\u0baa\u0bc8 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bca\u0b9f\u0bb0\u0bcd, \u0b89\u0bb2\u0b95\u0bae\u0bcd \u0b92\u0bb0\u0bc7 \u0bae\u0bc1\u0b95\u0bbe\u0bae\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0bb2\u0b95\u0bbf\u0baa\u0bcd \u0baa\u0bb2\u0ba4\u0bc1\u0bb0\u0bc1\u0bb5\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0baf\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd, \u0b90.\u0ba8\u0bbe. \u0ba4\u0ba9\u0ba4\u0bc1 \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0bb5\u0b95\u0bbf\u0baa\u0bbe\u0b95\u0ba4\u0bcd\u0ba4\u0bc8 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0baf\u0bae\u0bc8\u0b95\u0bcd\u0b95 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0bb2\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0bb0\u0b95\u0bcd\u0b95\u0b9a\u0bcd \u0b9a\u0bca\u0ba9\u0bcd\u0ba9\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc7 \u0baf\u0ba4\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd."
