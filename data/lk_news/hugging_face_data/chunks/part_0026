    "date_str": "2025-10-03",
    "description": "Alcohol and tobacco usage in SL decline, reveal latest surveys",
    "url_metadata": "https://www.ft.lk/opinion/Alcohol-and-tobacco-usage-in-SL-decline-reveal-latest-surveys/14-782584",
    "lang": "en",
    "newspaper_id": "dailyftlk",
