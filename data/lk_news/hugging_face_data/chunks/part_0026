    "url_metadata": "https://www.lankadeepa.lk/news/\u0db6\u0dbd-\u0da2\u0dba-\u0d9a\u0dc4\u0dbd-\u0dba\u0db4-\u0db4\u0da7\u0db1/101-680780",
