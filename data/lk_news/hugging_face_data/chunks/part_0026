    "description": "\u0db1\u0dcf \u00a0\u0d8b\u0dba\u0db1 \u0d9a\u0dda\u0db6\u0dbd\u0dca \u0da9\u0d9a\u0dca\u0d9a\u0dd4 \u0d85\u0db1\u0dad\u0dd4\u0dbb \u0d9c\u0dd0\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db1\u0dd2\u0dba\u0ddd\u0d9c\u0dba\u0d9a\u0dca",
