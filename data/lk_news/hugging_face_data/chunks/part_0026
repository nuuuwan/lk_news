    "url_metadata": "https://www.lankadeepa.lk/news/\u0da2\u0db1\u0db4\u0dad-\u0db6\u0d9c\u0dbd-\u0db1\u0da9\u0dad\u0dad\u0dc0\u0da7-\u0d9a\u0da7-\u0d85\u0da7\u0d9a-\u0d9c\u0dc0\u0dbd/101-680727",
