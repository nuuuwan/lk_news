    "description": "\u0dad\u0dcf\u0da2\u0dd4\u0da9\u0dd3\u0db1\u0dca \u0d9d\u0dcf\u0dad\u0db1\u0dba \u0dc0\u0dd6 \u0daf\u0dd2\u0db1 \u0db4\u0dc3\u0dd4\u0db4\u0dc3\u0dd2\u0db1\u0dca \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dc5 \u0dc0\u0dcf\u0dc4\u0db1\u0dba\u0dda \u0d9a\u0da2\u0dca\u0da2\u0dcf \u0d89\u0daf\u0dbd\u0dcf",
