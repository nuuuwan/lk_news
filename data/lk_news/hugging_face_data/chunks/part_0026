    "description": "\u0db8\u0db1\u0dd4\u0dc2\u0da7 \u0dc4\u0dd9\u0da7 \u0d85\u0dbd\u0dca\u0dbd\u0dc3\u0dca \u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0d9a\u0dd0\u0db3\u0dc0\u0dd3\u0db8\u0d9a\u0dca",
