    "num": "colombotelegraphcom-a399c545",
    "date_str": "2025-09-25",
    "description": "The JVP: Marxist Lullaby Or Tamils\u2019 Red Hope?",
    "url_metadata": "https://www.colombotelegraph.com/index.php/the-jvp-marxist-lullaby-or-tamils-red-hope/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
    "time_ut": 1758770077.0,
