    "description": "Lara De Zoysa launches Ceylon Tea Market in UK",
    "url_metadata": "https://www.ft.lk/business/Lara-De-Zoysa-launches-Ceylon-Tea-Market-in-UK/34-782309",
    "lang": "en",
    "newspaper_id": "dailyftlk",
