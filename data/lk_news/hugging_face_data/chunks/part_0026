    "description": "\u0db8\u0dcf\u0db1\u0dc0 \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dad\u0dd4\u0dc5\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dd0\u0da7\u0dca \u0d9a\u0dd0\u0dbd\u0dab\u0dd2 \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca\u0dc0 \u0da2\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dba\u0dd2!",
