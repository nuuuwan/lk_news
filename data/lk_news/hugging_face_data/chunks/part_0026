    "description": "One Nation, One Future: Ending Divisions In Education & Media",
    "url_metadata": "https://www.colombotelegraph.com/index.php/one-nation-one-future-ending-divisions-in-education-media/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
    "time_ut": 1759416277.0,
