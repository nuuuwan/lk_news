    "description": "\u0db1\u0dda\u0db4\u0dcf\u0dbd\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0db7\u0dd6\u0d9a\u0db8\u0dca\u0db4\u0db1\u0dba\u0d9a\u0dca - \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0 \u0dc3\u0dd9\u0dbd\u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/205108",
