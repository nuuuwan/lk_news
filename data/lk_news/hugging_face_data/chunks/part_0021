    "description": "\u0dc3\u0db8\u0dca\u0db6\u0dcf\u0dc4\u0db1 \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0da7 \u0d9c\u0ddc\u0dc3\u0dca \u0dba\u0d9a\u0dcf \u0db1\u0dd0\u0da7\u0dd6 SI\u0dbd\u0dcf\u0d9c\u0dda \u0dc0\u0dd0\u0da9 \u0dad\u0dc4\u0db1\u0db8\u0dca",
