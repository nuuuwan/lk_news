    "description": "Owner of Hambantota Bird Park arrested over illegal import of motorcycles",
    "url_metadata": "https://www.adaderana.lk/news/110573/owner-of-hambantota-bird-park-arrested-over-illegal-import-of-motorcycles",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1752744120.0,
