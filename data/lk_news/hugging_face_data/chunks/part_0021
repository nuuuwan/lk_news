    "description": "Senior business leader Ajit M. De S. Jayaratne no more",
    "url_metadata": "https://www.ft.lk/business/Senior-business-leader-Ajit-M-De-S-Jayaratne-no-more/34-778853",
    "lang": "en",
    "newspaper_id": "dailyftlk",
