    "description": "Sri Lanka government firm can make a lower cost arrack for people: Minister",
    "url_metadata": "https://economynext.com/sri-lanka-government-firm-can-make-a-lower-cost-arrack-for-people-minister-197946/",
    "lang": "en",
    "newspaper_id": "economynextcom",
    "time_ut": 1735980540.0,
