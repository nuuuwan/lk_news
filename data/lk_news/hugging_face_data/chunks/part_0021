    "description": "\u0daf\u0dc0\u0dc3\u0dd2\u0db1\u0dca \u0daf\u0dd9\u0d9a\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0db6\u0dd2\u0dbd \u0d85\u0da9\u0dd4 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d85\u0db4\u0dd2 \u0d9a\u0ddc\u0dc4\u0dda\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dbd \u0db1\u0dd1",
