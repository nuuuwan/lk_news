    "description": "Star Garments Group wins Gold at NCE Export Awards 2024",
    "url_metadata": "https://www.ft.lk/business/Star-Garments-Group-wins-Gold-at-NCE-Export-Awards-2024/34-771496",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1736197367.0,
