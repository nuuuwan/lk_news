    "description": "\u0d9a\u0ddc\u0dc0\u0dd2\u0da9\u0dca \u0dc0\u0dc3\u0d82\u0d9c\u0dad\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dd4 \u0da0\u0dd3\u0db1\u0dba\u0dda \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0ddb\u0dbb\u0dc3\u0dba\u0d9a\u0dca",
    "url_metadata": "http://sinhala.adaderana.lk/news/204984",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1735878180.0,
    "chunk_id": "2025-01-03-adaderanasinhalalk-c8b31ab4-0000",
    "chunk_index": 0,
    "language": "si",
