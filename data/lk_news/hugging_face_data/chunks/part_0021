    "num": "dailyftlk-7d2fc220",
    "date_str": "2025-07-11",
    "description": "Don\u2019t panic: Sri Lanka\u2019s fertility decline is temporary, not a demographic collapse",
    "url_metadata": "https://www.ft.lk/columns/Don-t-panic-Sri-Lanka-s-fertility-decline-is-temporary-not-a-demographic-collapse/4-778822",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1752173975.0,
    "chunk_id": "2025-07-11-dailyftlk-7d2fc220-0000",
    "chunk_index": 0,
