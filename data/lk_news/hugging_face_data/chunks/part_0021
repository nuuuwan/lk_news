    "description": "Sri Lanka FinTech Summit 2025: A digital bridge to economic recovery",
    "url_metadata": "https://www.ft.lk/business/Sri-Lanka-FinTech-Summit-2025-A-digital-bridge-to-economic-recovery/34-778981",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1752523073.0,
