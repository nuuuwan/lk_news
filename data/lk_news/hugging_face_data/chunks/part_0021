    "chunk_text": "\u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0ddc\u0db8\u0dc3\u0dcf\u0dbb\u0dd2\u0dc3\u0dca \u0dc0\u0dbb\u0dd2\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dc0\u0dcf\u0d9c\u0dca\u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb \u0db8\u0db0\u0dca\u200d\u0dba\u0dd9\u0dba\u0dca \u0db1\u0dd3\u0dae\u0dca\u200d\u0dba\u0dcf\u0db1\u0dd6\u0d9a\u0dd6 \u0dbb\u0dc4\u0dc3\u0dca \u0da1\u0db1\u0dca\u0daf\u0dba\u0d9a\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd4\u0db1 \u0d85\u0dad\u0dbb \u0dbb\u0dc4\u0dc3\u0dca \u0da1\u0db1\u0dca\u0daf\u0dba\u0d9a\u0dca \u0dc3\u0dd4\u0daf\u0dd4\u0dc3\u0dd4 \u0db6\u0dc0\u0da7 \u0da1\u0db1\u0dca\u0daf 12\u0d9a\u0dca \u0db4\u0d9a\u0dca\u0dc2\u0dc0 \u0dbd\u0dd0\u0db6\u0dd4\u0db1 \u0d85\u0dad\u0dbb\u00a0 \u0d8a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd0\u0daf\u0dca\u0db0\u0dc0 \u0da1\u0db1\u0dca\u0daf 09\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0dc0\u0dd2\u0dba. \u0db8\u0dd9\u0dc4\u0dd2\u0daf\u0dd3 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dca\u0dc0\u0dbb\u0dba\u0dcf \u0dad\u0ddd\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dbb\u0dc4\u0dc3\u0dca \u0da1\u0db1\u0dca\u0daf\u0dba\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0da1\u0db1\u0dca\u0daf 13\u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0d9c\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1\u0db6\u0dbd \u0dc0\u0dda\u0d9c\u0dba \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda\u00a0 \u0d91\u0dc3\u0dca \u0da2\u0dda \u0d91\u0db8\u0dca \u0da2\u0dba\u0dbb\u0dad\u0dca\u0db1 \u0da2\u0dba\u0dc3\u0dda\u0d9a\u0dbb \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0db4\u0ddc\u0daf\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dd9\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0dc0\u0dd6 \u0db8\u0dbb\u0dd2\u0dba\u0db1\u0dca \u0dc3\u0dd4\u0db7\u0dcf\u0d9a\u0dbb\u0db1\u0dca\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd4\u0dba\u0dda \u0da1\u0db1\