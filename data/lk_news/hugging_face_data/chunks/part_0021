    "description": "TRCSL warns public over fraudulent text messages",
    "url_metadata": "https://www.adaderana.lk/news/104819/trcsl-warns-public-over-fraudulent-text-messages",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1736307360.0,
    "chunk_id": "2025-01-08-adaderanalk-eb934b2a-0000",
    "chunk_index": 0,
