    "description": "USD 40 million five star resort to be powered entirely by renewable energy",
    "url_metadata": "http://island.lk/usd-40-million-five-star-resort-to-be-powered-entirely-by-renewable-energy/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1735954620.0,
    "chunk_id": "2025-01-04-islandlk-eb8d606e-0000",
    "chunk_index": 0,
