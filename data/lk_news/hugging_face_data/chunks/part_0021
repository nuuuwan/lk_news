    "date_str": "2025-01-02",
    "description": "\u2018Education qualifications alone won\u2019t fix governance\u2019 - Dilith calls for fresh perspectives in politics",
    "url_metadata": "https://www.adaderana.lk/news/104664/education-qualifications-alone-wont-fix-governance-dilith-calls-for-fresh-perspectives-in-politics",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1735803060.0,
    "chunk_id": "2025-01-02-adaderanalk-e38538f3-0000",
    "chunk_index": 0,
