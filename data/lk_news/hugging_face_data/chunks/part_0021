    "description": "China\u2019s digital yuan: Currency, control, and a new world order?",
    "url_metadata": "http://island.lk/chinas-digital-yuan-currency-control-and-a-new-world-order/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1752602940.0,
    "chunk_id": "2025-07-15-islandlk-48268f9a-0000",
    "chunk_index": 0,
