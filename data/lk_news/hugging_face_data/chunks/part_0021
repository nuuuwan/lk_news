    "description": "Rehan resigns from SJB and Weligama organiser role",
    "url_metadata": "https://www.ft.lk/news/Rehan-resigns-from-SJB-and-Weligama-organiser-role/56-771386",
    "lang": "en",
    "newspaper_id": "dailyftlk",
