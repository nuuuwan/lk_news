    "chunk_text": "\"\u0db8\u0dcf\u0db0\u0dca\u200d\u0dba\u0dba\u0dd9\u0db1\u0dca \u0db8\u0dda\u0d9a\u0dd9 \u0db4\u0dc5 \u0dc0\u0db1 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc3\u0db8\u0d9f \u0dbd\u0ddc\u0d9a\u0dd4 \u0d9a\u0dad\u0dcf\u0db6\u0dc4\u0d9a\u0dca \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0dda \u0d87\u0dad\u0dd2 \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dc0\u0dcf. \u0dc4\u0dd0\u0db6\u0dd0\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0db1\u0dca\u0db1\u0dda \u0d92 \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0dad\u0dd4\u0dc5 \u0d87\u0dad\u0dd2\u0dc0\u0db1 \u0d9a\u0dad\u0dcf\u0db6\u0dc4\u0dda\u0daf\u0dd3 \u0db8\u0dda \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0\u0dbd\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dba\u0dd9\u0db1\u0dca\u0db8 \u0d85\u0db0\u0dca\u200d\u0dba\u0db1\u0dba \u0d9a\u0dbb\u0dbd\u0dcf, \u0d92\u0d9a\u0dd9 \u0d91\u0d9a \u0d9a\u0ddc\u0db1\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0dbd\u0dca\u0dbd \u0d9c\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd0\u0dad\u0dd4\u0dc0, \u0d92\u0d9a\u0dd9 \u0dad\u0dd2\u0dba\u0dd9\u0db1 \u0dc3\u0db8\u0dc3\u0dca\u0dad\u0dba \u0daf\u0dd2\u0dc4\u0dcf \u0db6\u0dbd\u0dbd\u0dcf \u0d9a\u0dad\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf.\"\n\n\u0d9a\u0dd9\u0dc3\u0dda\u0dc0\u0dd9\u0dad\u0dad\u0dca \u0db1\u0dc0 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2 \u0dc3\u0d82\u0d9c\u0db8\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d91\u0dbd\u0dca\u0dbd\u0dc0\u0db1\u0dca\u0db1\u0dda \u0daf\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dbb\u0ddd\u0db0\u0dba\u0d9a\u0dd2.\n\n\u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd6 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0dda, \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0da2\u0ddd\u0dc3\u0db4\u0dca \u0dc3\u0dca\u0da7\u0dcf\u0dbd\u0dd2\u0db1\u0dca,"
