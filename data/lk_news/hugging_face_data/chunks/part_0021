    "description": "Syrian caretaker government to hike public sector salaries by 400% next month",
    "url_metadata": "https://www.adaderana.lk/news/104769/syrian-caretaker-government-to-hike-public-sector-salaries-by-400-next-month",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1736166480.0,
    "chunk_id": "2025-01-06-adaderanalk-eb1cddfe-0000",
