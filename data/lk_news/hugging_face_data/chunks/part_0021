    "description": "Influx of Israeli Tourists Leading to  Intensified  Security  in Eastern Arugam Bay area  Creates Fresh Problems for  the Local Residents",
    "url_metadata": "https://dbsjeyaraj.com/dbsj/?p=85679",
    "lang": "en",
    "newspaper_id": "dbsjeyarajcom",
    "time_ut": 1742503920.0,
    "chunk_id": "2025-03-21-dbsjeyarajcom-188369c2-0000",
