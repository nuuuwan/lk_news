    "description": "President Dissanayake\u2019s Agenda For 2025",
    "url_metadata": "https://www.colombotelegraph.com/index.php/president-dissanayakes-agenda-for-2025/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
