    "description": "\u0dc3\u0dc4\u0dbd\u0dca \u0d86\u0db1\u0dba\u0db1\u0dba\u0da7 \u0dad\u0dd2\u0db6\u0dd6 \u0d85\u0dc0\u0dc3\u0dbb\u0dba \u0dc4\u0dd9\u0da7\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca",
