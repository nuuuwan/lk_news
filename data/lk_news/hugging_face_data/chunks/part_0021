    "chunk_text": "\u0da2\u0db1\u0db8\u0dcf\u0db0\u0dca\u200d\u0dba\u0dc0\u0dda\u0daf\u0dd3\u0db1\u0dca, \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dba\u0dd9\u0db1\u0dca \u0dba\u0dd6 \u0da7\u0dd2\u0dba\u0dd4\u0db6\u0dbb\u0dca\u0dc3\u0dca \u0dbd\u0dcf \u0dc4\u0dcf \u0dc3\u0db8\u0dcf\u0da2 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0da2\u0dcf\u0dbd\u0dcf \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9c\u0dd9\u0db1 \u0dba\u0db1 \u0d85\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2\u0da7 \u0db1\u0db8\u0dca \u0d85\u0dad \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d85\u0db1\u0dd2\u0dad\u0dca \u0d85\u0dba\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0dbd\u0dcf \u0dbb\u0da7 \u0dc4\u0daf\u0db1\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba\u0dc0\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf \u0d85\u0db4\u0dd2\u0da7 \u0dc0\u0dd9\u0db1\u0daf\u0dcf \u0dc0\u0d9c\u0dda \u0d89\u0db1\u0dca\u0db1 \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d85\u0db1\u0dd2\u0dad\u0dca \u0d85\u0dba\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0dbd\u0dcf \u0dbb\u0da7 \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0d92\u0d9a \u0d94\u0dba\u0dcf\u0dbd\u0d9c\u0dda \u0dc0\u0d9c\u0d9a\u0dd3\u0db8 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0db8\u0dda \u0dbb\u0da7 \u0dc4\u0daf\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf.\n\n\u0d85\u0db4\u0dd2\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d86\u0dc0\u0ddc\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dc3\u0db8\u0dc4\u0dbb\u0dd4 \u0dad\u0dbb\u0dca\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d9a\u0dc0\u0dd4\u0dbb\u0dd4\u0dc0\u0dad\u0dca \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf. \u0d85\u0db4\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0db4\u0dd2\u0da7 \u0db6\u0dbd\u0dba \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dda \u0d92\u0d9a\u0da7\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d85\u0db1\u0dd2\u0dad\u0dca \u0dad\u0dd0\u0db1\u0dca\u0dc0\u0dbd\u0da7 \u0d85\u0dad \u0dad\u0dd2\u0dba\u0db1\u0dc0\u0dcf.\u201d"
  },
