    "description": "Office to beaches: Rise of digital nomads and Japanese-style workation",
    "url_metadata": "https://www.ft.lk/columns/Office-to-beaches-Rise-of-digital-nomads-and-Japanese-style-workation/4-771327",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1735864075.0,
