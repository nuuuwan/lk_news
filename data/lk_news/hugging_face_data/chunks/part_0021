    "date_str": "2025-01-02",
    "description": "Driver in fatal New Orleans truck ramming may not have acted alone, had Islamic State flag",
    "url_metadata": "https://www.adaderana.lk/news/104659/driver-in-fatal-new-orleans-truck-ramming-may-not-have-acted-alone-had-islamic-state-flag",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1735791180.0,
    "chunk_id": "2025-01-02-adaderanalk-9c79b58e-0000",
    "chunk_index": 0,
