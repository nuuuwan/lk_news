    "date_str": "2025-01-05",
    "description": "Clean minds essential for a Clean Sri Lanka",
    "url_metadata": "https://www.ft.lk/columns/Clean-minds-essential-for-a-Clean-Sri-Lanka/4-771407",
    "lang": "en",
    "newspaper_id": "dailyftlk",
