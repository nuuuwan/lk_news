    "num": "adaderanalk-a84d663b",
    "date_str": "2025-07-16",
    "description": "Israel strikes near the defense ministry in Syria",
    "url_metadata": "https://www.adaderana.lk/news/110546/israel-strikes-near-the-defense-ministry-in-syria",
    "lang": "en",
    "newspaper_id": "adaderanalk",
