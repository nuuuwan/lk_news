    "description": "Russia vows retaliation after saying it downed eight US-made long-range missiles",
    "url_metadata": "https://www.adaderana.lk/news/104722/russia-vows-retaliation-after-saying-it-downed-eight-us-made-long-range-missiles",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1736006640.0,
    "chunk_id": "2025-01-04-adaderanalk-3f86cc25-0000",
    "chunk_index": 0,
