    "description": "Singer opens first-ever Samsung  AI-powered smart store in Sri Lanka",
    "url_metadata": "https://www.ft.lk/business/Singer-opens-first-ever-Samsung-AI-powered-smart-store-in-Sri-Lanka/34-771295",
    "lang": "en",
    "newspaper_id": "dailyftlk",
