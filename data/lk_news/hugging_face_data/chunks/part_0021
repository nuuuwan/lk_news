  {
    "doc_type": "lk_news",
    "doc_id": "2025-01-03-dailyftlk-4ee8515c",
    "num": "dailyftlk-4ee8515c",
    "date_str": "2025-01-03",
    "description": "System change and ushering value-based society",
    "url_metadata": "https://www.ft.lk/columns/System-change-and-ushering-value-based-society/4-771369",
