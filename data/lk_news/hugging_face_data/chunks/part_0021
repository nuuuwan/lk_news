    "description": "\u2018Unbundling\u2019 of electricity sector to figure in sweeping energy reforms",
    "url_metadata": "http://island.lk/unbundling-of-electricity-sector-to-figure-in-sweeping-energy-reforms/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1736322960.0,
    "chunk_id": "2025-01-08-islandlk-1f966852-0000",
