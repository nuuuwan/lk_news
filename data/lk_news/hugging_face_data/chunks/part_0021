    "description": "\u0dc5\u0d9f\u0db8 \u0db4\u0dcf\u0dc3\u0dbd \u0dc4\u0ddc\u0db3\u0db8 \u0db4\u0dcf\u0dc3\u0dbd \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0d9c\u0dd0\u0db1 \u0dad\u0dd3\u0dbb\u0dab\u0dba\u0d9a\u0dca",
