    "url_metadata": "https://www.ada.lk/technology/\u0dc3\u0dca\u0da7\u0dcf\u0dbb\u0dca-\u0dbd\u0dd2\u0db1\u0dca\u0d9a\u0dca-\u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8-\u0dad\u0dc0\u0dad\u0dca-\u0db8\u0dcf\u0dc3-\u0daf\u0dd9\u0d9a\u0d9a\u0dd2\u0db1\u0dca/5-417062",
