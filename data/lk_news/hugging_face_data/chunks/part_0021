    "description": "HMPV \u0dc0\u0ddb\u0dbb\u0dc3\u0dba \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0daf ?",
    "url_metadata": "http://sinhala.adaderana.lk/news/205018",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1735975980.0,
    "chunk_id": "2025-01-04-adaderanasinhalalk-6c90995d-0000",
