    "description": "Policies to uplift construction industry with sustainability",
    "url_metadata": "https://www.ft.lk/columns/Policies-to-uplift-construction-industry-with-sustainability/4-771273",
    "lang": "en",
    "newspaper_id": "dailyftlk",
