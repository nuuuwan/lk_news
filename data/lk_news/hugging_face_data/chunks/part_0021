    "description": "\u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0dca\u0dc0\u0dba\u0dda 20 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dc3\u0dbb\u0da7 \u0db4\u0dcf \u0dad\u0db6\u0db1 TV \u0daf\u0dd9\u0dbb\u0dab",
