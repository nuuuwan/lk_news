    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0b87\u0b9a\u0bc8\u0ba4\u0bcd-\u0ba4\u0bbf\u0bb0\u0bc1\u0bb5\u0bbf\u0bb4\u0bbe-\u0bae\u0bc7\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd-\u0baa\u0bbe\u0bb0\u0bbf\u0baf-\u0ba4\u0bc0-\u0baa\u0bb0\u0bb5\u0bb2\u0bcd/50-361234",
