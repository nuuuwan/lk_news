    "date_str": "2025-02-09",
    "description": "Mavai Senathirajah is an example not only of how a leader of a political party should not act, but also of how a party should not treat its senior leader.",
    "url_metadata": "https://dbsjeyaraj.com/dbsj/?p=85526",
    "lang": "en",
    "newspaper_id": "dbsjeyarajcom",
    "time_ut": 1739043660.0,
