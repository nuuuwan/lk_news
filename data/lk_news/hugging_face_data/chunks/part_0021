    "description": "Suspect arrested with illegally assembled vehicles worth over Rs. 50 mln",
    "url_metadata": "https://www.adaderana.lk/news/104645/suspect-arrested-with-illegally-assembled-vehicles-worth-over-rs-50-mln",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1735725480.0,
    "chunk_id": "2025-01-01-adaderanalk-fcee5a7d-0000",
