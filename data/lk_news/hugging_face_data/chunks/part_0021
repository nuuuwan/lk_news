    "description": "\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0da2\u0dbd\u0dcf\u0dc1 \u0dc0\u0dbd \u0da2\u0dbd \u0db0\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0 86% \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/204996",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1735896960.0,
    "chunk_id": "2025-01-03-adaderanasinhalalk-5c8d884a-0000",
