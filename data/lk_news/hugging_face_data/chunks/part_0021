    "description": "Sri Lanka\u2019s new public debt management office getting ready to sell gilts",
    "url_metadata": "https://economynext.com/sri-lankas-new-public-debt-management-office-getting-ready-to-sell-gilts-230002/",
    "lang": "en",
    "newspaper_id": "economynextcom",
