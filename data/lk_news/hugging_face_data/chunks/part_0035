    "chunk_text": "\u0d85\u0db8\u0dd4 \u0d89\u0d9f\u0dd4\u0dbb\u0dd4 \u0db8\u0dd2\u0dc5 \u0d89\u0dc4\u0dc5\u0da7\n\n\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc0\u0dd9\u0dc5\u0daf\u0db4\u0ddc\u0dbd\u0dda \u0d89\u0dbd\u0dca\u0dbd\u0dd4\u0db8\u0da7 \u0dc3\u0dbb\u0dd2\u0dbd\u0db1 \u0dc3\u0dd0\u0db4\u0dba\u0dd4\u0db8\u0d9a\u0dca \u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db8\u0dd4 \u0d89\u0d9c\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbd\u0ddd\u0dc0\u0d9a \u0db8\u0dd2\u0dbd \u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc4\u0dd0\u0da7\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda \u0d91\u0dbd\u0dc0\u0dbd\u0dd4 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dd2.\n\n\u0d9a\u0dd2\u0dbd\u0ddd\u0dc0\u0d9a\u0dca \u0dbb\u0dd4.300-500\u0d9a\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0dd2\u0dbd\u0d9a\u0da7 \u0d85\u0dbd\u0dd9\u0dc0\u0dd2 \u0dc0\u0dd6 \u0d85\u0db8\u0dd4 \u0d89\u0d9c\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd2\u0dbd\u0ddd\u0dc0\u0d9a\u0dca \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0dbb\u0dd4.1500\u0dad\u0dca-200\u0dad\u0dca \u0d85\u0dad\u0dbb \u0d85\u0db0\u0dd2\u0d9a \u0db8\u0dd2\u0dbd\u0d9a\u0da7 \u0d85\u0dbd\u0dd9\u0dc0\u0dd2 \u0dc0\u0db1 \u0db6\u0dc0\u0dba\u0dd2 \u0d91\u0db8 \u0dc0\u0dd9\u0dc5\u0daf\u0dd4\u0db1\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0db1\u0dda.\n\n\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dcf \u0dc3\u0dd4\u0dbd\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d85\u0db8\u0dd4 \u0d89\u0d9c\u0dd4\u0dbb\u0dd4 \u0dc0\u0d9c\u0dcf\u0dc0 \u0dc0\u0dd2\u0db1\u0dcf\u0dc1 \u0dc0\u0dd6 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dda \u0daf\u0dd2\u0db1\u0dc0\u0dbd \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc0\u0dd9\u0dc5\u0daf\u0db4\u0ddc\u0dbd\u0dda \u0d85\u0db8\u0dd4 \u0d89\u0d9c\u0dd4\u0dbb\u0dd4 \u0dc4\u0dd2\u0d9c\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0\u0dba\u0dd2 \u0