    "description": "\u0dc4\u0dd9\u0da7 \u0dc0\u0dd0\u0dc3\u0dca\u0dc3 \u0d91\u0db1\u0dca\u0db1\u0dda \u0db8\u0dd9\u0dc4\u0dd9\u0db8\u0dba\u0dd2",
