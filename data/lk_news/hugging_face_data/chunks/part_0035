    "chunk_text": "\u0db1\u0dd2\u0dc0\u0dc3\u0d9a \u0d9c\u0dd2\u0db1\u0dca\u0db1\u0d9a\u0da7 \u0dc4\u0dc3\u0dd4\u0dc0\u0dd6 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2\u0dba\u0da7\n\n\u0dc0\u0dda\u0dba\u0db1\u0dca\u0d9c\u0ddc\u0da9 \u0db4\u0dad\u0dca\u0dad\u0dbd\u0d9c\u0dd9\u0daf\u0dbb \u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dc1\u0dba\u0dda \u0db1\u0dd2\u0dc0\u0dc3\u0d9a \u0d87\u0dad\u0dd2\u0dc0\u0dd6 \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0d9c\u0dd2\u0db1\u0dd2 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0da7 \u0dc4\u0dc3\u0dd4\u0dc0\u0dd6 \u0d92\u0db8 \u0db1\u0dd2\u0dc0\u0dc3\u0dda \u0dad\u0db1\u0dd2\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0d9a\u0dd2\u0dba\u0dba\u0dd2. \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 73\u0d9a\u0dca \u0dc0\u0db1 \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db8\u0dd9\u0dc3\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dda."
