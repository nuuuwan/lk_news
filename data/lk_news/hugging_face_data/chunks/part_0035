    "description": "Predictive taxpayers and the future of revenue",
    "url_metadata": "https://www.ft.lk/columns/Predictive-taxpayers-and-the-future-of-revenue/4-787522",
    "lang": "en",
    "newspaper_id": "dailyftlk",
