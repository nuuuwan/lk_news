    "description": "Pathfinder Foundation charts roadmap for Sri Lanka\u2019s critical minerals sector",
    "url_metadata": "http://island.lk/pathfinder-foundation-charts-roadmap-for-sri-lankas-critical-minerals-sector/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1769849520.0,
