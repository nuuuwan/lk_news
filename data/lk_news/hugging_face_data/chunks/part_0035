    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd3\u0dab \u0dc3\u0dd2\u0db1\u0db8\u0dcf\u0dc0\u0dda\u0daf\u0dd3 \u0dc3\u0dda\u0db1 \u0dc3\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0daf\u0dd2\u0dc0\u0dd2\u0dc3\u0dd0\u0dbb\u0dd2\u0dba \u0db1\u0dd2\u0db8 \u0d9a\u0dbb\u0dba\u0dd2\n\n\u0dc3\u0dd2\u0d82\u0dc4\u0dbd \u0dc3\u0dd2\u0db1\u0db8\u0dcf\u0dc0\u0dda \u0d85\u0dad\u0dd2\u0dc1\u0dba \u0da2\u0db1\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7 \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0daf\u0dcf\u0dba\u0d9a \u0dc0\u0dd6 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dd3\u0dab \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7 \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2, \u0dc3\u0dda\u0db1 \u0dc3\u0db8\u0dbb\u0dc3\u0dd2\u0d82\u0dc4 \u0db8\u0dc4\u0dad\u0dcf \u0d85\u0daf(29) \u0d85\u0db7\u0dcf\u0dc0\u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dca\u0dad \u0dc0\u0dd2\u0dba.\n\n\u0dc3\u0daf\u0dc4\u0da7\u0db8 \u0d94\u0db6 \u0db8\u0d9c\u0dda \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7\u0dba\u0dda \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0d9a \u0dbd\u0dd9\u0dc3 \u0dc3\u0dd2\u0db1\u0db8\u0dcf\u0dc0\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd2\u00a0 \u0d92 \u0db8\u0dc4\u0dad\u0dcf\u00a0\u0d9a\u0dc3\u0dca\u0dad\u0dd4\u0dbb\u0dd2 \u0dc3\u0dd4\u0dc0\u0daf\u0dba \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2\u0dab\u0dba\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd2\u0dba\u0dda\u0dba.\n\n\u0db1\u0dd2\u0dbd\u0dca\u0dbd \u0dc3\u0ddc\u0dba\u0dcf, \u0d86\u0dc1\u0dcf \u0daf\u0dd1\u0dc3\u0dd2\u0db1\u0dca, \u0db8\u0dbd\u0dca \u0d9a\u0dd0\u0d9a\u0dd4\u0dc5\u0dd4 \u0da0\u0d82\u0da0\u0dbd \u0dbb\u0dda\u0d9b\u0dcf, \u0d88\u0dad\u0dd2\u0db1\u0dca \u0d88\u0dad\u0da7 \u0dc0\u0dd0\u0db1\u0dd2 \u0d94\u0dc4\u0dd4\u0d9c\u0dda \u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0db4\u0da7 \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dbd \u0d85\u0dad\u0dd2\u0dc1\u0dba \u0da2\u0db1\u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba \u0dc3\u0dd2\u0db1\u0db8\u0dcf \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab \u0dc0\u0dd2\u0dba."
  },
