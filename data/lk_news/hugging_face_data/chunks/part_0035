    "description": "Foreign holdings of rupee Treasuries surges to over two-year high",
    "url_metadata": "https://www.ft.lk/business/Foreign-holdings-of-rupee-Treasuries-surges-to-over-two-year-high/34-787784",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1769994645.0,
