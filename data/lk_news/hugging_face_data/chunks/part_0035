    "chunk_text": "\u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dc3\u0dba\u0dd220 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dcf\u0dbd\u0db1\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0ddc\u0dc5\u0db9\u0da7 \u0dbb\u0dae \u0dc0\u0dcf\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8\u0d9a\u0dca\n\n\u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dc3\u0dba\u0dd220 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dcf\u0dbd\u0db1\u0dba\u0dda \u0d9a\u0ddc\u0dc5\u0db9 \u0d86\u0dbb\u0dca. \u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0daf\u0dcf\u0dc3 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0d82\u0d9c\u0dab\u0dba\u0dda \u0dc4\u0dcf \u0d91\u0dc3\u0dca.\u0d91\u0dc3\u0dca.\u0dc3\u0dd3. \u0db4\u0dd2\u0da7\u0dd2\u0dba\u0dda \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd9\u0db1 \u0dad\u0dbb\u0d9c \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0dbb\u0dae\u0dc0\u0dcf\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8\u0d9a\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db6\u0dc0 \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0db8\u0dd6\u0dbd\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0dba\u0dd2."
  },
