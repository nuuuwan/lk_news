    "chunk_text": "\u0dc3\u0dd6\u0dbb\u0dca\u0dba\u0dc0\u0d82\u0dc1\u0dd2\u0d9c\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9c\u0dad \u0d89\u0db1\u0dd2\u0db8\u0dd9\u0db1\u0dca 19\u0db1\u0dca \u0db4\u0dc4\u0dc5 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dbd\u0dcf\u0db1\u0dba \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0da7\n\n\u0db4\u0db1\u0dca\u0daf\u0dd4 80\u0d9a\u0daf\u0dd3 \u0dc0\u0dd2\u0db7\u0dcf\u0dc0\u0dd2 \u0dc3\u0dd6\u0dbb\u0dca\u0dba\u0dc0\u0d82\u0dc1\u0dd2 \u0dbb\u0dd0\u0dc3\u0dca\u0d9a\u0dc5 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 175\u0d9a \u0db4\u0dca\u200d\u0dbb \u0dc0\u0dda\u0d9c\u0d9a\u0dcf\u0dbb\u0dd2 \u0d89\u0db1\u0dd2\u0db8 \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dd4 19\u0db1\u0dca \u0db4\u0dc4\u0dc5 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dbd\u0dcf\u0db1\u0dba 6 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dbb\u0da7\u0dad\u0dca \u0dad\u0db8\u0db1\u0dca \u0dc3\u0dad\u0dd4 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0d89\u0db1\u0dca\u0daf\u0dd3\u0dba \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0dc3\u0db8\u0dad\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0dc3\u0dd2\u0db8\u0dca\u0db6\u0dcf\u0db6\u0dca\u0dc0\u0dda \u0dc4\u0dbb\u0dcf\u0dbb\u0dda \u0db1\u0dd4\u0dc0\u0dbb \u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad\u0dba \u0dc3\u0db8\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0db8\u0dd9\u0db8 \u0dad\u0dbb\u0d9c\u0dba\u0dda\u0daf\u0dd3 \u0d89\u0db1\u0dca\u0daf\u0dd3\u0dba \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 411\u0d9a\u0dca \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5 \u0d85\u0dad\u0dbb \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0d89\u0db1\u0dd2\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0d9a\u0dc5 \u0d91\u0d82\u0d9c\u0dbd\u0db1\u0dca\u0dad \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u0da7 \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0dd6\u0dba\u0dda \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 311\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dd2.\n\n\u0dc0\u0dd2\u