    "description": "Sri Lanka, US officials discuss expanding trade and investment cooperation",
    "url_metadata": "https://www.ft.lk/business/Sri-Lanka-US-officials-discuss-expanding-trade-and-investment-cooperation/34-787986",
    "lang": "en",
    "newspaper_id": "dailyftlk",
