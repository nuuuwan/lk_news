    "description": "Kala Pola 2026: Sri Lanka\u2019s iconic open-air art fair",
    "url_metadata": "https://www.ft.lk/news/Kala-Pola-2026-Sri-Lanka-s-iconic-open-air-art-fair/56-787987",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1770333741.0,
    "chunk_id": "2026-02-06-dailyftlk-0f31465d-0000",
    "chunk_index": 0,
