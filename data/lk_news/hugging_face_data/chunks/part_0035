    "url_metadata": "https://www.ada.lk/breaking_news/\u0d95\u0db8\u0dcf\u0db1-\u0dba\u0dd4\u0daf-\u0db1\u0dd0\u0dc0\u0d9a\u0dca--\u0d9a\u0ddc\u0dc5\u0db9-\u0dc0\u0dbb\u0dcf\u0dba\u0da7/11-420912",
