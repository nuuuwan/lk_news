    "description": "Nature-based infrastructure is vital to avert Asia\u2019s looming water crisis",
    "url_metadata": "https://www.ft.lk/opinion/Nature-based-infrastructure-is-vital-to-avert-Asia-s-looming-water-crisis/14-787369",
    "lang": "en",
    "newspaper_id": "dailyftlk",
