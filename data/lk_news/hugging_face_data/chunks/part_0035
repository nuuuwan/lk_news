    "url_metadata": "https://www.ada.lk/business/\u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2-\u0dc6\u0dd2\u0db1\u0dd1\u0db1\u0dca\u0dc3\u0dca-\u0db4\u0dd3\u0d91\u0dbd\u0dca\u0dc3\u0dd3-2026-\u0dad\u0dd9\u0dc0\u0dd0\u0db1\u0dd2-\u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dd4\u0dc0\u0dda-\u0d89\u0dc4\u0dc5-\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0d9a\u0dca/7-421103",
