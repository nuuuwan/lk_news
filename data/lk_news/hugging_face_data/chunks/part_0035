    "description": "BCS Sri Lanka Section appoints new Executive Committee at 30th AGM",
    "url_metadata": "https://www.ft.lk/business/BCS-Sri-Lanka-Section-appoints-new-Executive-Committee-at-30th-AGM/34-787981",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1770333141.0,
