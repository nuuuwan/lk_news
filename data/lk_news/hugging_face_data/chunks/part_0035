    "description": "\u0d9c\u0d82\u0d9f\u0dcf\u0dbb\u0dcf\u0db8 \u0db1\u0dc0\u0db8\u0dca \u0db4\u0dd9\u0dbb\u0dc4\u0dbb \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0dbb\u0dae\u0dc0\u0dcf\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8\u0d9a\u0dca",
