    "description": "\u2018GovPAY\u2019 traffic fine payment system rolls out countrywide",
    "url_metadata": "https://www.ft.lk/business/GovPAY-traffic-fine-payment-system-rolls-out-countrywide/34-787985",
    "lang": "en",
    "newspaper_id": "dailyftlk",
