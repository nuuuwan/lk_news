    "url_metadata": "https://www.ada.lk/business/SDB-\u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0\u0da7-\u0db1\u0dc0-\u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dca\u200d\u0dba-\u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1-\u0dc0\u0dd2\u0db0\u0dcf\u0dba\u0d9a-\u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dd9\u0d9a\u0dca/7-420928",
