    "description": "\u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dc3\u0dba\u0dd220 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dcf\u0dbd\u0db1\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0ddc\u0dc5\u0db9\u0da7 \u0dbb\u0dae \u0dc0\u0dcf\u0dc4\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8\u0d9a\u0dca",
