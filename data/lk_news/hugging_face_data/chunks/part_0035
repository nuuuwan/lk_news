    "url_metadata": "https://www.ada.lk/sports/\u0db6\u0dca\u200d\u0dbb\u0dd0\u0da9\u0dca\u0db8\u0db1\u0dca\u0d9c\u0dda-\u0dc4\u0dd2\u0dc3\u0dca-\u0dc0\u0dd0\u0dc3\u0dd4\u0db8\u0d9a\u0dca-\u0dbb\u0dd4--\u0d9a\u0ddd\u0da7\u0dd2-9-8\u0d9a\u0da7-\u0d85\u0dbd\u0dd9\u0dc0\u0dd2-\u0dc0\u0dd9\u0dba\u0dd2/9-420967",
