    "description": "When A Tree Costs The Nation Rs. 900 Million: Lessons From Daraluwa",
    "url_metadata": "https://www.colombotelegraph.com/index.php/when-a-tree-costs-the-nation-rs-900-million-lessons-from-daraluwa/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
