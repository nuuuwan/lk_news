    "description": "Prelates\u2019 wise counsel",
    "url_metadata": "http://island.lk/prelates-wise-counsel/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1769621640.0,
    "chunk_id": "2026-01-28-islandlk-5b8c52cb-0001",
