    "url_metadata": "https://www.ft.lk/business/CBSL-report-on-inflation-deviation-to-be-presented-to-Parliament/34-787317",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1769131114.0,
