    "description": "Empowering the next generation: A vision for students\u2019 leadership in Sri Lanka",
    "url_metadata": "http://island.lk/empowering-the-next-generation-a-vision-for-students-leadership-in-sri-lanka/",
    "lang": "en",
    "newspaper_id": "islandlk",
