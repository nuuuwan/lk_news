    "description": "UNP Working Committee decides to lift bans on members who joined SJB",
    "url_metadata": "https://www.adaderana.lk/news/112609/unp-working-committee-decides-to-lift-bans-on-members-who-joined-sjb",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1758102060.0,
