    "chunk_text": "\u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0db8\u0dc4\u0dad\u0dca\u0dad\u0dba\u0dcf \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0d9c\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0dc3\u0d9a\u0dbb \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dcf \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dad\u0dbb\u0d9a\u0dca \u0dbd\u0d9a\u0dca\u0dc2 \u0db4\u0db1\u0dca\u0daf\u0dc4\u0dc3\u0dca \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0d9c\u0dd2\u0dc4\u0dd2\u0dbd\u0dca\u0dbd\u0dcf.\u0d85\u0db4\u0dd2 \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0d85\u0da9\u0dd4\u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca\u0dbd\u0dcf\u0db7\u0dd3\u0db1\u0dca\u0da7 \u0d9c\u0dd9\u0dc0\u0dbd\u0dca \u0dc4\u0daf\u0dbd \u0daf\u0dd9\u0db1\u0dc0\u0dcf 150 \u0d9a\u0dca \u0d92 150 \u0da7\u0db8 \u0dc0\u0dd0\u0dba \u0d9a\u0dbb\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dca\u0db1\u0dda \u0dbd\u0d9a\u0dca\u0dc2 1400 \u0dba\u0dd2. \u0d94\u0db1\u0dca\u0db1 \u0d95\u0d9a \u0dad\u0db8\u0dba\u0dd2 \u0d87\u0dad\u0dca\u0dad \u0d9a\u0dae\u0dcf\u0dc0.\n\n\u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dd9\u0dad\u0dca \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca. \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0da5\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0db1 \u0d9a\u0dd9\u0db1\u0dcf \u0d8b\u0da9 \u0dad\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0d95\u0db1 \u0db1\u0dd1\u0db1\u0dda, \u0db4\u0dca\u200d\u0dbb\u0db7\u0dd6\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db1\u0d82\u0dc0\u0db1\u0dca\u0db1 \u0d95\u0db1 \u0db1\u0dd1, \u0d94\u0dc4\u0dd4 \u0d85\u0daf\u0dcf\u0dbd \u0d9a\u0dbb\u0dca\u0dad\u0dc0\u0dca\u200d\u0dba\u0dba \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d9a\u0dbb\u0dcf\u0da7 \u0db4\u0dc3\u0dca\u0dc3\u0dda \u0d94\u0dc4\u0dd4 \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0db8\u0db1\u0dd4\u0dc3\u0dca\u0dc3\u0dba\u0dd9\u0d9a\u0dca \u0dc0\u0dd2\u0daf\u0dd2\u0dc4\u0da7 \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc0\u0dd9\u0db1\u0dc0\u0dcf, \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0da7 \u0d8b\u0da9\u0dd2\u0db1\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4\u0db1\u0dca\u0da7 \u0d8b\u0da9\u0dd2\u0db1\u0dca , \u0db8\u0dc4 \u0db4\u0ddc\u0dc5\u0dc0\u0da7 \u0d8b\u0da9\u0dd2\u0db1\u0dca \u0d91\u0dc4\u0dd9\u0db8 \u0d89\u0db1\u0dca\u0db1 \u0d95\u0db1 \u0db1\u0dd1,\u0daf\u0dd0\u0db1\u0dca \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0dba\u0dd2 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db4\u0dad\u0dca \u0dc0\u0dd9\u0dbd\u0dcf \u0d92 \u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db6\u0dbd\u0dcf\u0db4\u0ddc\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd9\u0da0\u0dca\u0da0 \u0db6\u0ddc\u0dc4\u0ddd \u0daf\u0dda\u0dc0\u0dbd\u0dca \u0d85\u0db4\u0dd2 \u0dc0\u0dd9\u0db1\u0dc3\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1, \u0db4\u0dd2\u0dc5\u0dd2\u0dc0\u0dbd\u0d9a\u0dca \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d85\u0dbb\u0db1\u0dca \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.\u201d"
