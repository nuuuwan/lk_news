    "description": "NTB WNPS lecture today to put spotlight on freshwater fishes",
    "url_metadata": "https://www.ft.lk/news/NTB-WNPS-lecture-today-to-put-spotlight-on-freshwater-fishes/56-781830",
    "lang": "en",
    "newspaper_id": "dailyftlk",
