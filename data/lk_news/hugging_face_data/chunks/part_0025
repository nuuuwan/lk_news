    "description": "\u0da2\u0db1\u0dca\u0db8 \u0daf\u0dd2\u0db1\u0dba \u0db1\u0dd2\u0db8\u0dd2\u0dad\u0dca\u0dad\u0dd9\u0db1\u0dca \u0db4\u0dcf.\u0db8 \u0daf\u0dd2\u0dbd\u0dd2\u0dad\u0dca \u0da2\u0dba\u0dc0\u0dd3\u0dbb \u0d86\u0d9c\u0db8\u0dd2\u0d9a \u0dc0\u0dad\u0dcf\u0dc0\u0dad\u0dca\u0dc0\u0dbd\u0da7 \u0d91\u0d9a\u0dca\u0dc0\u0dd9\u0dba\u0dd2",
