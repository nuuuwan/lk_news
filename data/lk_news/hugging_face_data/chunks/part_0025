    "description": "Barefoot and Netherland\u2019s POLSPOTTEN announce landmark design collaboration",
    "url_metadata": "https://www.ft.lk/business/Barefoot-and-Netherland-s-POLSPOTTEN-announce-landmark-design-collaboration/34-781885",
    "lang": "en",
    "newspaper_id": "dailyftlk",
