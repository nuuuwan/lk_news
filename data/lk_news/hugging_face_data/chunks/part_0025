    "description": "Joint briefing session for diplomatic missions abroad to boost investments, exports",
    "url_metadata": "https://www.ft.lk/business/Joint-briefing-session-for-diplomatic-missions-abroad-to-boost-investments-exports/34-781886",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1758241142.0,
