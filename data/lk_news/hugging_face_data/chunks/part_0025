    "description": "\u0d85\u0dba\u0dd2\u0dc3\u0dca \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u0d9a\u0dc5 \u0db6\u0dc0\u0da7 \u0dc3\u0dd0\u0d9a  \u0db1\u0dd2\u0dc0\u0dc3\u0d9a\u0dca \u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\u0da7 \u0db8\u0dba\u0dd4\u0dbb\u0db4\u0dd4\u0dbb\u0dd9\u0db1\u0dca \u0dc4\u0db8\u0dd4\u0dc0\u0dda",
