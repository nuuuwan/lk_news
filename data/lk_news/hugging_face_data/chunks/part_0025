    "description": "Presidents\u2019 Entitlements (Repeal) Bill passed in Parliament",
    "url_metadata": "https://www.ft.lk/news/Presidents-Entitlements-Repeal-Bill-passed-in-Parliament/56-781496",
    "lang": "en",
    "newspaper_id": "dailyftlk",
