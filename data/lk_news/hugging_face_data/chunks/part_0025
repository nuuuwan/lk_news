    "description": "Japanese Ambassador visits Tokyo Cement factory in Trincomalee",
    "url_metadata": "https://www.ft.lk/news/Japanese-Ambassador-visits-Tokyo-Cement-factory-in-Trincomalee/56-781896",
    "lang": "en",
    "newspaper_id": "dailyftlk",
