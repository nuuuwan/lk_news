    "description": "Ex-President Mahinda vacates residence at Wijerama Road",
    "url_metadata": "https://www.adaderana.lk/news/112402/ex-president-mahinda-vacates-residence-at-wijerama-road",
    "lang": "en",
    "newspaper_id": "adaderanalk",
