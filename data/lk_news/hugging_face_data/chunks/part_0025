    "description": "\u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0ddc\u0da7 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0db1\u0ddd\u0daf \u0dc4\u0dcf \u0dad\u0dca\u200d\u0dbb\u0dcf\u0dc3\u0da2\u0db1\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0dc0\u0dbd\u0da7",
