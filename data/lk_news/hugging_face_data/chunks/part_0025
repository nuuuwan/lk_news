    "description": "Netherlands steps up support for rural bridges project with additional \u20ac 730,000 grant",
    "url_metadata": "https://www.ft.lk/news/Netherlands-steps-up-support-for-rural-bridges-project-with-additional-730-000-grant/56-781550",
    "lang": "en",
    "newspaper_id": "dailyftlk",
