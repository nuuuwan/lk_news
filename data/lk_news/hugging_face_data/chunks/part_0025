    "description": "Govt. moves to develop Kahatagaha graphite mine under PPP",
    "url_metadata": "https://www.ft.lk/news/Govt-moves-to-develop-Kahatagaha-graphite-mine-under-PPP/56-781791",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1758071024.0,
