    "description": "India-Sri Lanka Foundation approves new projects to boost economic ties",
    "url_metadata": "https://www.ft.lk/news/India-Sri-Lanka-Foundation-approves-new-projects-to-boost-economic-ties/56-782009",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1758498639.0,
    "chunk_id": "2025-09-22-dailyftlk-41aa3f41-0000",
    "chunk_index": 0,
