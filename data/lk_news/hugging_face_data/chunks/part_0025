    "description": "Clinical training for final-year medical students of Moratuwa University begins at Nagoda Hospital",
    "url_metadata": "https://www.adaderana.lk/news/112541/clinical-training-for-final-year-medical-students-of-moratuwa-university-begins-at-nagoda-hospital",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1757955060.0,
