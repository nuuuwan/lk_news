    "date_str": "2025-09-22",
    "description": "Southern politicians linked to drug and organized crime networks \u2013 Public Security Minister",
    "url_metadata": "https://www.adaderana.lk/news/112784/southern-politicians-linked-to-drug-and-organized-crime-networks-public-security-minister",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1758544440.0,
