    "description": "EUDR in 2025: Is Sri Lanka ready for the EU\u2019s new deforestation rules?",
    "url_metadata": "https://economynext.com/eudr-in-2025-is-sri-lanka-ready-for-the-eus-new-deforestation-rules-240147/",
    "lang": "en",
    "newspaper_id": "economynextcom",
    "time_ut": 1757567220.0,
    "chunk_id": "2025-09-11-economynextcom-c595588a-0000",
    "chunk_index": 0,
