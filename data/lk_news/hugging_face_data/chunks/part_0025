    "description": "Deputy Minister clarifies provisions of Gaming Regulatory Authority Act",
    "url_metadata": "https://www.adaderana.lk/news/112452/deputy-minister-clarifies-provisions-of-gaming-regulatory-authority-act",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1757734560.0,
