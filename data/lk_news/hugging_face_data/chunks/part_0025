    "description": "President to leave for US tomorrow to attend UN General Assembly",
    "url_metadata": "https://www.adaderana.lk/news/112725/president-to-leave-for-us-tomorrow-to-attend-un-general-assembly",
    "lang": "en",
    "newspaper_id": "adaderanalk",
