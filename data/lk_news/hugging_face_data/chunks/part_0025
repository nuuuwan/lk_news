    "description": "India extends Rs. 600M grant for new A&E Unit at Mannar Hospital",
    "url_metadata": "https://www.adaderana.lk/news/112344/india-extends-rs-600m-grant-for-new-ae-unit-at-mannar-hospital",
    "lang": "en",
    "newspaper_id": "adaderanalk",
