    "url_metadata": "https://www.ada.lk/breaking_news/\u0da2\u0db1\u0db4\u0dad\u0dd2-\u0dc4\u0dd9\u0da7-\u0d87\u0db8\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0da7-\u0dba\u0dba\u0dd2/11-418636",
