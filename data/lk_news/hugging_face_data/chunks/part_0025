    "description": "\u0db8\u0dd2\u0dba\u0d9c\u0dd2\u0dba \u0db1\u0dd3\u0dad\u0dd3\u0da5\u0dba\u0dd9\u0d9a\u0dd4\u0d9c\u0dda \u0db1\u0dd2\u0dc0\u0dc3\u0d9a \u0dad\u0dd2\u0db6\u0dd3 \u0d85\u0dc0\u0dd2 \u0d86\u0dba\u0dd4\u0db0 \u0dad\u0ddc\u0d9c\u0dba\u0d9a\u0dca \u0dc4\u0db8\u0dd4\u0dc0\u0dd9\u0dba\u0dd2",
