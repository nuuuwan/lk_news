    "description": "\u0db6\u0dbd\u0dba \u0d87\u0dad\u0dd2 \u0daf\u0dcf \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0db6\u0dbd\u0dba \u0db1\u0dd0\u0dad\u0dd2 \u0daf\u0dcf \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db8\u0dcf \u0dc3\u0db8\u0d9c \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dcf",
