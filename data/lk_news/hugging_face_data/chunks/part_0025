    "description": "Prince Harry vows to help war injured during surprise visit to Ukraine",
    "url_metadata": "https://www.adaderana.lk/news/112437/prince-harry-vows-to-help-war-injured-during-surprise-visit-to-ukraine",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1757668920.0,
