    "doc_type": "lk_news",
    "doc_id": "2025-09-10-dailyftlk-19bf560b",
    "num": "dailyftlk-19bf560b",
    "date_str": "2025-09-10",
    "description": "VAT on Digital Services: Insights from ICCSL webinar",
    "url_metadata": "https://www.ft.lk/business/VAT-on-Digital-Services-Insights-from-ICCSL-webinar/34-781460",
    "lang": "en",
    "newspaper_id": "dailyftlk",
