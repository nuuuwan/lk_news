    "description": "Govt. denies plans to list State banks on Colombo Stock Exchange",
    "url_metadata": "https://www.ft.lk/news/Govt-denies-plans-to-list-State-banks-on-Colombo-Stock-Exchange/56-781789",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1758070927.0,
