    "chunk_text": "\u0d85\u0dc4\u0dc3\u0dca \u0db4\u0dc4\u0db1\u0dca \u0d9a\u0dd6\u0da9\u0dd4 \u0dba\u0dd0\u0dc0\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0d85\u0dc0\u0dc0\u0dcf\u0daf\u0dba\u0d9a\u0dca\n\n\u0d8b\u0dad\u0dca\u0dc3\u0dc0 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd\u0daf\u0dd2 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u00a0\u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dc1\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dc0 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd\u0daf\u0dd3 \u0d85\u0dc4\u0dc3\u0dca \u0db4\u0dc4\u0db1\u0dca \u0d9a\u0dd6\u0da9\u0dd4 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0d85\u0dc0\u0dd2\u0da0\u0dcf\u0dbb\u0dc0\u0dad\u0dca \u0dbd\u0dd9\u0dc3 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0d85\u0db1\u0dca\u0dad\u0dbb\u0dcf\u0daf\u0dcf\u0dba\u0d9a \u0db6\u0dc0 \u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda."
