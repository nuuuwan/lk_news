    "description": "Separating Chairman and CEO roles in PLCs",
    "url_metadata": "https://www.ft.lk/columns/Separating-Chairman-and-CEO-roles-in-PLCs/4-781439",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1757456623.0,
