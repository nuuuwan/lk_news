    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0b95\u0bc1\u0b9f\u0bbf\u0baf\u0bc7\u0bb1\u0bbf\u0b95\u0bb3\u0bc7-\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd-\u0bb2\u0ba3\u0bcd\u0b9f\u0ba9\u0bbf\u0bb2\u0bcd-1-10-\u0bb2\u0b9f\u0bcd\u0b9a\u0bae\u0bcd-\u0baa\u0bc7\u0bb0\u0bcd-\u0baa\u0b99\u0bcd\u0b95\u0bc7\u0bb1\u0bcd\u0bb1-\u0baa\u0bc7\u0bb0\u0ba3\u0bbf-\u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf-\u0b8e\u0ba9\u0bcd\u0ba9/50-364598",
