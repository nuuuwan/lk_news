    "description": "Timor-Leste scraps plan to buy MPs free cars after protests",
    "url_metadata": "https://www.adaderana.lk/news/112620/timor-leste-scraps-plan-to-buy-mps-free-cars-after-protests",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1758119340.0,
    "chunk_id": "2025-09-17-adaderanalk-944da3a9-0000",
