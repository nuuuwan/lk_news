    "description": "First treaty to protect marine life in high seas to take effect in January",
    "url_metadata": "http://island.lk/first-treaty-to-protect-marine-life-in-high-seas-to-take-effect-in-january/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1758431340.0,
    "chunk_id": "2025-09-21-islandlk-7341e5db-0000",
    "chunk_index": 0,
