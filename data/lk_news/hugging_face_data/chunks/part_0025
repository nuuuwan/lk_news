    "url_metadata": "https://www.ada.lk/business/JMEV-EVEASY-\u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2-\u0db8\u0ddd\u0da7\u0dbb\u0dca-\u0dbb\u0dae\u0dba-\u0dc1\u0dca\u200d\u0dbb\u0dd3-\u0dbd\u0d82\u0d9a\u0dcf\u0da7-\u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf-\u0daf\u0dd9\u0dba\u0dd2/7-418670",
