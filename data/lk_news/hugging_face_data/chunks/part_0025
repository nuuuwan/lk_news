    "description": "Sri Lanka secures USD 100 million funding from World Bank to enhance rural economy",
    "url_metadata": "https://www.adaderana.lk/news/112314/sri-lanka-secures-usd-100-million-funding-from-world-bank-to-enhance-rural-economy",
    "lang": "en",
    "newspaper_id": "adaderanalk",
