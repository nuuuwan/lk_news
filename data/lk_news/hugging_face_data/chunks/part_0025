    "description": "CEB unions launch \u2018critical\u2019 protest campaign phase this Sunday",
    "url_metadata": "https://www.ft.lk/news/CEB-unions-launch-critical-protest-campaign-phase-this-Sunday/56-781950",
    "lang": "en",
    "newspaper_id": "dailyftlk",
