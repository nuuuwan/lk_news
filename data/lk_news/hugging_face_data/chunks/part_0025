    "description": "\u0d87\u0dc6\u0dca\u0d9c\u0db1\u0dca \u0dc3\u0dbb\u0dc3\u0dc0\u0dd2\u0dc0\u0dbd \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0db1\u0dca \u0dbd\u0dd2\u0dba\u0db1 \u0dbd\u0daf \u0db4\u0ddc\u0dad\u0dca \u0dad\u0dbd\u0dda\u0db6\u0dcf\u0db1\u0dca\u0dc0\u0dbb\u0dd4 \u0dad\u0dc4\u0db1\u0db8\u0dca \u0d9a\u0dbb\u0dba\u0dd2",
