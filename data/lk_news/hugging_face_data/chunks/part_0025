    "date_str": "2025-09-14",
    "description": "New Nepal PM vows to follow protesters\u2019 demands to \u2018end corruption\u2019",
    "url_metadata": "https://www.adaderana.lk/news/112482/new-nepal-pm-vows-to-follow-protesters-demands-to-end-corruption",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1757835000.0,
