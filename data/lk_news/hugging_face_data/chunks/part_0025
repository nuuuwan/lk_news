    "description": "\u0d85\u0dad\u0dbb\u0db8\u0dd0\u0daf\u0dd2 \u0dc1\u0dca\u200d\u0dbb\u0dda\u0dab\u0dd2 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca  \u0d87\u0dad\u0dd4\u0dc5\u0dad\u0dca \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba\u0d9a\u0dca",
    "url_metadata": "http://sinhala.adaderana.lk/news/214452",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
