    "description": "Sri Lanka\u2019s central bank launches financial literacy month to educate public",
    "url_metadata": "https://economynext.com/sri-lankas-central-bank-launches-financial-literacy-month-to-educate-public-239996/",
    "lang": "en",
    "newspaper_id": "economynextcom",
