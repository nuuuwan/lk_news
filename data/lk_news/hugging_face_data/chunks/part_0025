    "description": "Dambulla Waste Management Facility no longer operational",
    "url_metadata": "https://www.adaderana.lk/news/112649/dambulla-waste-management-facility-no-longer-operational-",
    "lang": "en",
    "newspaper_id": "adaderanalk",
