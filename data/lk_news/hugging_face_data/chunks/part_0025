    "url_metadata": "https://www.lankadeepa.lk/features/\u0dc0\u0da7\u0dc4\u0dbb\u0d9a\u0db1\u0daf-\u0daf\u0dc4\u0dba\u0dba\u0d9c\u0dbd-\u0dc0\u0db1\u0dc3\u0db1-\u0daf\u0dc1\u0db4\u0dbd\u0db1-\u0d85\u0db8\u0db6\u0dbb\u0dc0/2-679900",
