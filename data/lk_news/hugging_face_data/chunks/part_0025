    "description": "Prince Harry meets King Charles for first time in more than a year",
    "url_metadata": "https://www.adaderana.lk/news/112393/prince-harry-meets-king-charles-for-first-time-in-more-than-a-year",
    "lang": "en",
    "newspaper_id": "adaderanalk",
