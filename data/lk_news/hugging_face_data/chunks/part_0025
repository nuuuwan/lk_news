    "description": "\u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0db8\u0db1\u0db8\u0dca\u0db4\u0dda\u0dbb\u0dd2 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0da7 \u0db7\u0dcf\u0dbb\u0dc0\u0dd3\u0db8\u0da7 \u0dc3\u0dd4\u0daf\u0dcf\u0db1\u0db8\u0dca \u0db6\u0dc0 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca\u0daf\u0dd9\u0dba\u0dd2",
