    "date_str": "2025-09-21",
    "description": "King R\u0101van\u0101: Villain, Victim, Or Visionary?",
    "url_metadata": "https://www.colombotelegraph.com/index.php/king-ravana-villain-victim-or-visionary/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
