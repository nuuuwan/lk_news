    "date_str": "2025-09-12",
    "description": "Main problem is Indian illegal fishing, not possession of Katchatheevu",
    "url_metadata": "https://www.ft.lk/columns/Main-problem-is-Indian-illegal-fishing-not-possession-of-Katchatheevu/4-781564",
    "lang": "en",
    "newspaper_id": "dailyftlk",
