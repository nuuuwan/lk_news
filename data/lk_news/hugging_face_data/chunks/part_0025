    "description": "Rajapaksa vacates official residence after Parliament strips ex-Presidential privileges",
    "url_metadata": "https://www.ft.lk/news/Rajapaksa-vacates-official-residence-after-Parliament-strips-ex-Presidential-privileges/56-781552",
    "lang": "en",
    "newspaper_id": "dailyftlk",
