    "description": "Sri Lanka beat Afghanistan to qualify for Asia Cup 2025 Super 4s",
    "url_metadata": "https://www.adaderana.lk/news/112655/sri-lanka-beat-afghanistan-to-qualify-for-asia-cup-2025-super-4s",
    "lang": "en",
    "newspaper_id": "adaderanalk",
