    "date_str": "2025-09-14",
    "description": "\u201cPresident\u2019s Fund which benefited only a limited group has now become a public fund\u201d \u2013 PM Harini",
    "url_metadata": "https://www.adaderana.lk/news/112491/presidents-fund-which-benefited-only-a-limited-group-has-now-become-a-public-fund-pm-harini",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1757846880.0,
    "chunk_id": "2025-09-14-adaderanalk-a573c8ea-0000",
