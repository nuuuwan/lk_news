    "date_str": "2025-09-23",
    "description": "Sri Lanka and EU sign Euro 8 million grant agreement to support economic recovery",
    "url_metadata": "https://www.adaderana.lk/news/112830/sri-lanka-and-european-union-sign-euro-8-million-grant-agreement-to-support-economic-recovery",
    "lang": "en",
    "newspaper_id": "adaderanalk",
