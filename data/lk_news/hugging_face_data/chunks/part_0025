    "description": "\u0d9c\u0db8\u0dca\u0db8\u0db1\u0dca\u0db4\u0dd2\u0dbd\u0d9c\u0dda \u0db4\u0dd9\u0dad\u0dca\u0dc3\u0db8\u0d9a\u0dca \u0dc3\u0dbd\u0d9a\u0dcf\u0db6\u0dd0\u0dbd\u0dd3\u0db8\u0da7 \u0daf\u0dd2\u0db1\u0dba\u0d9a\u0dca \u0daf\u0dd9\u0dba\u0dd2",
