    "description": "\u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf\u0d9c\u0dd9\u0db1\u0dca \u0dc3\u0d82\u0dc0\u0dda\u0daf\u0dd3 \u0dc6\u0dda\u0dc3\u0dca\u0db6\u0dd4\u0d9a\u0dca \u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0dca",
    "url_metadata": "http://sinhala.adaderana.lk/news/214618",
