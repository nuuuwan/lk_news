    "description": "\u0dc0\u0dc3\u0dbb 60\u0d9a\u0da7 \u0db4\u0dc3\u0dd4 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0db1  \u0db4\u0dd2\u0da7\u0d9a\u0ddc\u0da7\u0dd4\u0dc0 \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db6\u0dc3\u0dca \u0db1\u0dd0\u0dc0\u0dad\u0dd4\u0db8\u0dca\u0db4\u0ddc\u0dc5",
