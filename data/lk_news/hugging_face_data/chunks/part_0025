    "description": "\u0db4\u0dbd\u0dc3\u0dca\u0dad\u0dd3\u0db1 \u0da2\u0db1\u0db4\u0dad\u0dd2\u0da7 \u0d85\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0d9a\u0dd4\u0da9\u0db8\u0dca\u0db8\u0dcf\u0d9c\u0dda \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dd2",
