    "description": "What is energy? And why do we need it?",
    "url_metadata": "http://island.lk/what-is-energy-and-why-do-we-need-it/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1757958180.0,
    "chunk_id": "2025-09-15-islandlk-73cb09f1-0000",
