    "description": "73 Sri Lankan pilgrims safely cross Nepal-India border",
    "url_metadata": "https://www.adaderana.lk/news/112346/73-sri-lankan-pilgrims-safely-cross-nepal-india-border",
    "lang": "en",
    "newspaper_id": "adaderanalk",
