    "description": "Over tourism or over visitation?",
    "url_metadata": "https://www.ft.lk/columns/Over-tourism-or-over-visitation/4-781559",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1757637672.0,
