    "description": "\u0dc0\u0dd2\u0da2\u0dda\u0dbb\u0dcf\u0db8\u0dda \u0db1\u0dd2\u0dbd \u0db1\u0dd2\u0dc0\u0dc3\u0da7 \u0dc3\u0db8\u0dd4\u0daf\u0dd4\u0db1\u0dca \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0db8\u0dc4\u0dd2\u0db1\u0dca\u0daf \u0dad\u0dd0\u0db6\u0dd6 \u0dc3\u0da7\u0dc4\u0db1",
