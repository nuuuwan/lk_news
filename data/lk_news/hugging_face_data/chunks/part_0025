    "description": "New directive issued on testing drivers under the influence of narcotics",
    "url_metadata": "https://www.adaderana.lk/news/112740/new-directive-issued-on-testing-drivers-under-the-influence-of-narcotics",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1758458220.0,
