    "description": "\u0db8\u0dcf\u0db1\u0dc0 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0dad\u0dd3\u0dbb\u0dab\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0d82\u0db0\u0dd2\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a",
    "url_metadata": "https://www.lankadeepa.lk/features/\u0db8\u0db1\u0dc0-\u0dc4\u0db8\u0d9a\u0db8-\u0dad\u0dbb\u0dab\u0dad\u0db8\u0d9a-\u0dc3\u0db0\u0dc3\u0dae\u0db1\u0dba\u0d9a/2-679717",
