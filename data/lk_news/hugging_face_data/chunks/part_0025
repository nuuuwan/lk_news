    "description": "Designed for control: Digital infrastructure and public",
    "url_metadata": "https://www.ft.lk/columns/Designed-for-control-Digital-infrastructure-and-public/4-781777",
    "lang": "en",
    "newspaper_id": "dailyftlk",
