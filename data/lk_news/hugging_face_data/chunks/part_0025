    "description": "Immigration Department sees revenue surge amid passport service expansion",
    "url_metadata": "https://www.ft.lk/business/Immigration-Department-sees-revenue-surge-amid-passport-service-expansion/34-781685",
    "lang": "en",
    "newspaper_id": "dailyftlk",
