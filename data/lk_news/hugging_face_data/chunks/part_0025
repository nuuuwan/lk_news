    "chunk_text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0d85\u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0dd2\u0dad \u0dad\u0dad\u0dca\u0dc0\u0dba\u0d9a \u0db4\u0dc3\u0dd4\u0dc0\u0dda. \u0d85\u0dc1\u0dd2\u0dc2\u0dca\u0da7\u0dad\u0dca\u0dc0\u0dba \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0db4\u0dd4\u0dbb\u0dcf \u0db4\u0dd0\u0dad\u0dd2\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0d9a\u0dca \u0daf \u0db1\u0dd2\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dc0\u0dd9\u0dba\u0dd2. \u0db8\u0dda \u0dad\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0dd0\u0db3\u0dd2\u0db1\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0db8\u0dcf \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1 \u0dba\u0dd9\u0daf\u0dd4\u0db8 \u0daf\u0dd4\u0dbb\u0dca\u0dc0\u0dd2\u0db1\u0dd3\u0dad \u0dc3\u0db8\u0dcf\u0da2\u0dba\u2026Unpivil Society \u0dba\u0db1\u0dca\u0db1 \u0dba\u0dd2. \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0dba\u0db1\u0dca\u0db1\u0dd9\u0dc4\u0dd2 \u0d85\u0dbb\u0dca\u0dae\u0dba \u0dc4\u0ddc\u0db3 \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0dba\u0db1\u0dca\u0db1 \u0dba\u0dd2. \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0dc0\u0dd2\u0dbd\u0dca \u0dc0\u0dd3 \u0d85\u0db1\u0dd9\u0d9a\u0dcf\u0d9c\u0dda \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dcf \u0dba\u0dc4\u0db4\u0dad\u0dca \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0da7 \u0d91\u0dc5\u0dd0\u0db9\u0dd4\u0db8 \u0d91\u0dba\u0dd2\u0db1\u0dca \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc0\u0dda. \u0db8\u0dda \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dad\u0dd2\u0dba \u0dc0\u0dd9\u0db1\u0dc3\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dc4\u0dc3\u0dd4 \u0db1\u0dd0\u0dad. \u0d91\u0dc4\u0dd9\u0dad\u0dca \u0d91\u0dba \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba. \u0d91\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d87\u0dad\u0dd2 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0db8\u0dad\u0dd4 \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba."
