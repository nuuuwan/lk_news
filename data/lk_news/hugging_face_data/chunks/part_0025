    "description": "Crafting legacy through collaboration and synergy",
    "url_metadata": "https://www.ft.lk/opinion/Crafting-legacy-through-collaboration-and-synergy/14-781829",
    "lang": "en",
    "newspaper_id": "dailyftlk",
