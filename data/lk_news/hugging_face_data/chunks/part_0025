    "description": "\u0d86\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dab\u0dc1\u0dd3\u0dbd\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0db8\u0dad\u0dca\u0dc3\u0dca\u200d\u0dba \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 4\u0d9a\u0da7 \u0dad\u0dc4\u0db1\u0db8\u0d9a\u0dca - \u0d9c\u0dd0\u0dc3\u0da7\u0dca\u0da7\u0dd4\u0dc0\u0d9a\u0dd4\u0dad\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/214608",
