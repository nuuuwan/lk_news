    "description": "\u0db1\u0db1\u0dca\u0db4\u0dda\u0dbb\u0dd2\u0dba\u0dbd\u0dca \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0dda \u0d9c\u0dd2\u0db1\u0dca\u0db1 \u0db1\u0dd2\u0dc0\u0dd3\u0db8\u0da7 \u0dba\u0dd4\u0daf \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dc0\u0dda \u0daf\u0dd0\u0da9\u0dd2 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4\u0dba\u0d9a\u0dca",
