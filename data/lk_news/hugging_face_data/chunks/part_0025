    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b8e\u0bb2\u0bcd\u0bb2-\u0b95\u0bcb\u0bb0\u0bae\u0bcd-\u0baa\u0bb8\u0bcd\u0bb8\u0bbf\u0ba9\u0bcd-\u0b89\u0bb0\u0bbf\u0bae\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1-\u0baa\u0bbf\u0ba3\u0bc8/76-364362",
