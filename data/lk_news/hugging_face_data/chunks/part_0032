    "url_metadata": "https://www.lankadeepa.lk/news/\u0da2\u0dad\u0d9a-\u0db4\u0dc3-\u0d85\u0dc3\u0dc0\u0db1-\u0d9a\u0dc5\u0db8\u0db1\u0d9a\u0dbb\u0dab-\u0d86\u0dba\u0dad\u0db1\u0dba\u0da7\u0dad-\u0dc0\u0dc3\u0dc3\u0db1-\u0dc4\u0db1/101-685045",
