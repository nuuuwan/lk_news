  {
    "doc_type": "lk_news",
    "doc_id": "2025-12-11-bbccomsinhala-75a1c5eb",
    "num": "bbccomsinhala-75a1c5eb",
    "date_str": "2025-12-11",
    "description": "'\u0db8\u0db8 \u0dbd\u0dab\u0dd4 \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0dc4\u0ddc\u0dba\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dcf \u0d94\u0d9a\u0dca\u0d9a\u0ddc\u0dbd\u0dcf\u0db8 \u0d91\u0d9a\u0da7 \u0d9c\u0dd0\u0da7 \u0d9c\u0dc4\u0db1\u0dca\u0db1, \u0d9c\u0dc4\u0d9c\u0dd9\u0db1 \u0d9c\u0dd2\u0dba\u0ddc\u0dad\u0dca \u0d85\u0db4\u0dd2 29 \u0daf\u0dd9\u0db1\u0dcf\u0db8 \u0d91\u0d9a\u0da7 \u0db8\u0dd0\u0dbb\u0dd9\u0db8\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0dd2 \u0d9a\u0dad\u0dcf \u0dc0\u0dd4\u0dab\u0dda.'",
    "url_metadata": "https://www.bbc.com/sinhala/articles/cy0pk79gd92o",
    "lang": "si",
    "newspaper_id": "bbccomsinhala",
    "time_ut": 1765429566.0,
    "chunk_id": "2025-12-11-bbccomsinhala-75a1c5eb-0000",
