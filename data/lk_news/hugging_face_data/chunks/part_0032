    "num": "islandlk-ea636ace",
    "date_str": "2025-12-13",
    "description": "Why Sri Lanka Still Has No Doppler Radar \u2013 and Who Should Be Held Accountable",
    "url_metadata": "http://island.lk/why-sri-lanka-still-has-no-doppler-radar-and-who-should-be-held-accountable/",
    "lang": "en",
    "newspaper_id": "islandlk",
