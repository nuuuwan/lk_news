    "chunk_text": "\u0db6\u0ddd\u0d9c\u0dc4\u0db4\u0dad\u0db1 \u0d9a\u0db1\u0dca\u0daf \u0db1\u0dcf\u0dba \u0dc3\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0dba \u0dc0\u0dd9\u0dba\u0dd2\n\n\u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0db8\u0dd3\u0d9c\u0dc4\u0d9a\u0dd2\u0dc0\u0dd4\u0dbd\u00a0 \u0db8\u0ddc\u0dbb\u0dc4\u0dd9\u0dbd \u0db6\u0ddd\u0d9c\u0dc4\u0db4\u0dad\u0db1 \u0d9a\u0db1\u0dca\u0daf \u0d85\u0daf(10) \u0d85\u0dbd\u0dd4\u0dba\u0db8 \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0da7 \u0dbd\u0d9a\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb, \u0d92 \u0d85\u0dc0\u0da7 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d86\u0dbb\u0d9a\u0dca\u0dc1\u0dd2\u0dad \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0d9a\u0dbb\u0dcf \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd2\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0db4\u0dab\u0dca\u0da9\u0dd4\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dcf\u0dad\u0dca \u0d85\u0db6\u0dda\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dc0\u0dc3\u0dba\u0dd2 .\n\n\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc0\u0dbb\u0dca\u0dc1\u0dcf\u0dc0\u0dad\u0dca \u0dc3\u0db8\u0d9c \u0db8\u0dd9\u0dc3\u0dda \u0d9a\u0db1\u0dca\u0daf \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0da7 \u0dbd\u0d9a\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca , \u0db8\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0dd9\u0d9a\u0dd4\u0da7 \u0dc4\u0ddd \u0da2\u0dd3\u0dc0\u0dca\u0dad \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0db1\u0dd0\u0dad\u0dba\u0dd2 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0db4\u0dab\u0dca\u0da9\u0dd4\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db7\u0dcf\u0dad\u0dca \u0d85\u0db6\u0dda\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0d9a\u0dbd\u0dda\u0dba ."
