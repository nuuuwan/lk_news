    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc4\u0dbb\u0dba\u0db1-\u0dc3\u0db8\u0d9f-\u0d9a\u0da7\u0db1\u0dba\u0d9a\u0daf-\u0d85\u0dba\u0d9a-\u0db8\u0da7\u0da7/101-685228",
