    "description": "\u0da2\u0db4\u0db1\u0dca \u0d86\u0db4\u0daf\u0dcf \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0da5\u0dba\u0ddd \u0dc3\u0dd4\u0dc0 \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0dc4\u0db8\u0dd4 \u0dc0\u0dd9\u0dad\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0da2\u0db4\u0db1-\u0d86\u0db4\u0daf-\u0dc0\u0dc1\u0dc2\u0da5\u0dba-\u0dc3\u0dc0-\u0dbd\u0d9a\u0db8-\u0dc4\u0db8-\u0dc0\u0dad/1-685320",
