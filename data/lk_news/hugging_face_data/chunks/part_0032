    "description": "\u0db4\u0dbb\u0dd2\u0d9d\u0db1\u0d9a \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4\u0dc0\u0dcf \u0dad\u0dd0\u0db9\u0dd2\u0dbd\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0d87\u0db1 \u0dad\u0dbb\u0dd4\u0dab\u0dba\u0dcf \u0db8\u0dbb\u0dbd\u0dcf",
