    "url_metadata": "https://www.lankadeepa.lk/news/\u0da2\u0dbd-\u0dc3\u0db8\u0db4\u0daf\u0db1-\u0d9a\u0dbb\u0db8-99\u0d9a-\u0dba\u0dae-\u0dad\u0dad\u0dc0\u0dba\u0da7/101-685032",
