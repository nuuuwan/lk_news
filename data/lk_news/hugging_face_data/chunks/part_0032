    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc3\u0dba\u0dbd-\u0da2\u0dbd\u0dc1\u0dc0\u0dbd-\u0d85\u0dc0\u0daf\u0db1\u0db8-\u0d89\u0dc0\u0dbb\u0dba/101-684881",
