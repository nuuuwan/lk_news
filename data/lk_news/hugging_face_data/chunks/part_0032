    "md5": "65a0a6d2a886f7cd990a74a68fbd1ab5",
    "chunk_size_bytes": 1823,
    "chunk_text": "\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d87\u0db8\u0dd0\u0dad\u0dd2 \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8 \u0dbb\u0ddd\u0dc4\u0dbd\u0da7\n\n\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dc4\u0dcf \u0da2\u0db1\u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0d87\u0db8\u0dad\u0dd2 \u0db1\u0dbd\u0dd2\u0db1\u0dca\u0daf \u0da2\u0dba\u0dad\u0dd2\u0dc3\u0dca\u0dc3 \u0db8\u0dc4\u0dad\u0dcf \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\u0dc1 \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd3\u0dc4\u0dd4 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb\u0da7 \u0dc4\u0dc3\u0dd4\u0dc0 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0daf\u0dd1 \u0dc0\u0dd2\u0db1\u0dcf\u0dc1 \u0dc0\u0dd4 \u0dc4\u0dbd\u0dcf\u0dc0\u0dad \u0db8\u0dc4 \u0dbb\u0ddd\u0dc4\u0dbd\u0dda \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0db1\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0dab \u0da0\u0dcf\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0d9a \u0db1\u0dd2\u0dbb\u0dad \u0dc0\u0dd6\u0dc4.\n\n\u0db8\u0dd9\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0da7 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc3\u0db8\u0d9c \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0dc4\u0dcf \u0db4\u0dc5\u0dcf\u0dad\u0dca \u0db4\u0dcf\u0dbd\u0db1 \u0d87\u0db8\u0dad\u0dd2 \u0da0\u0db1\u0dca\u0daf\u0db1 \u0d85\u0db6\u0dda\u0dbb\u0dad\u0dca\u0db1, \u0d9c\u0dba\u0dcf\u0db1\u0dca \u0da2\u0dcf\u0db1\u0d9a,\u0d85\u0da2\u0dd3\u0dad\u0dca \u0d9c\u0dd2\u0dc4\u0dcf\u0db1\u0dca,\u0dc4\u0dd2\u0dbb\u0dd4\u0db1\u0dd2 \u0dc0\u0dd2\u0da2\u0dda\u0dc3\u0dd2\u0d82\u0dc4 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0d91\u0d9a\u0dca \u0dc0\u0dd6\u0dc4.\n\n\u0d92 \u0dc3\u0db8\u0d9c \u0dbd\u0ddd\u0d9a \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba\u0dd9 \u0db8\u0dd9\u0dbb\u0da7 \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dd3\u0dad \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0dbb\u0dcf\u0da2\u0dda\u0dc2\u0dca \u0dc3\u0db8\u0dca\u0db7\u0dcf\u0da2\u0dd3\u0dbb\u0dcf\u0d95 \u0db4\u0dcf\u0dab\u0dca\u0da9\u0dc0\u0dd2, \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dc3\u0dda\u0dc0\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2 \u0da2\u0db1\u0dbb\u0dcf\u0dbd\u0dca \u0d85\u0dc3\u0dda\u0dbd \u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db0\u0db1, \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0dcf\u0d82\u0dc1 \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd2\u0dc4\u0dd4 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0daf \u0d91\u0d9a\u0dca \u0dc0\u0dd6\u0dc4.\n\n\u0dc4\u0dbd\u0dcf\u0dc0\u0dad \u0db8\u0dc4 \u0dbb\u0ddd\u0dc4\u0dbd\u0dda \u0dc3\u0dca\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd4 \u0dc3\u0dd3\u0da7\u0dd2 \u0dc3\u0dca\u0d9a\u0dd1\u0db1\u0dca \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb\u0dd3\u0db1\u0dca \u0d85\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0dba\u0dc0\u0dd2\u0db8 \u0d91\u0db8 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9c\u0dda \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba\u0da7 \u0dbd\u0d9a\u0dca \u0dc0\u0dd6\u0dc4.\n\n\u0dc0\u0d9a\u0dd4\u0d9c\u0da9\u0dd4 \u0d92\u0d9a\u0d9a\u0dba, \u0dc1\u0dbd\u0dca\u200d\u0dba\u0dcf\u0d9c\u0dcf\u0dbb \u0daf\u0dd9\u0d9a \u0dc4\u0dcf \u0d85\u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d92\u0d9a\u0d9a \u0db1\u0dd0\u0dc0\u0dad \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d87\u0db8\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dc5\u0dda\u0dba."
