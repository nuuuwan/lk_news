    "num": "dailyftlk-85388e06",
    "date_str": "2025-12-15",
    "description": "Placing smallholder farmers and fishers at the centre of Cyclone Ditwah recovery",
    "url_metadata": "https://www.ft.lk/columns/Placing-smallholder-farmers-and-fishers-at-the-centre-of-Cyclone-Ditwah-recovery/4-785669",
    "lang": "en",
    "newspaper_id": "dailyftlk",
