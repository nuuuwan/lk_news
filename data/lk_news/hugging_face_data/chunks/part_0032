    "chunk_text": "\u0db8\u0dc3\u0dca\u0d9a\u0dd9\u0dc5\u0dd2\u0dba \u0dc0\u0dad\u0dca\u0dad\u0dda 21 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dca \u0daf\u0dd2\u0db1\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0dbb\u0da7 \u0d9c\u0ddc\u0da9 \u0db1\u0dd0\u0d9c\u0dd3\u0db8\u0dda \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0da7 \u0daf\u0dd9\u0dad\u0dd2\n\n\u0db8\u0dc3\u0dca \u0d9a\u0dd9\u0dbd\u0dd2\u0dba\u0dda \u0dc0\u0dad\u0dd4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca 21 \u0daf\u0dd9\u0db1\u0d9a\u0dd4 \u0dbb\u0da7 \u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd3\u0db8\u0dda \u0dbb\u0da2\u0dba\u0dda \u0d85\u0dbb\u0db8\u0dd4\u0daf\u0dbd\u0da7 \u0dc3\u0dd2\u0dba \u0daf\u0ddb\u0db1\u0dd2\u0d9a \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dd9\u0db1\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0daf\u0dc4\u0dc3 \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0db4\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dba\u0dcf\u0d9c \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda.\n\n\u0db8\u0dd9\u0db8 \u0db4\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dba\u0dcf\u0d9c\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dca\u0db1\u0dda \u0db8\u0dc3\u0dca\u0d9a\u0dd9\u0dbd\u0dd2\u0dba\u0dda \u0db8\u0dc0\u0dd4\u0dc3\u0dca\u0dc3\u0dcf\u0d9a\u0dd0\u0dbd\u0dda \u0d9a\u0ddc\u0da7\u0dca\u0da7\u0dcf\u0dc3\u0dba\u0dda \u0dc4\u0db4\u0dd4\u0d9c\u0dc3\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0db4\u0dc4\u0dbd \u0d9a\u0ddc\u0da7\u0dc3\u0dda \u0dc0\u0dad\u0dd4\u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dc0\u0db1\u0dca 21 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd2.\n\n\u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dc0\u0dad\u0dd4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db4\u0dc0\u0dc3\u0dcf \u0d87\u0dad\u0dca\u0dad\u0dda \u0dc0\u0dd2\u0db4\u0dad\u0da7 \u0db4\u0dad\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dc3\u0dc4\u0dcf\u0dba \u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db8\u0dcf\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dba\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0d8b\u0db4\u0d9a\u0dcf\u0dbb \u