    "date_str": "2025-12-13",
    "description": "The government is taking steps to streamline trade facilitation, customs processes, investment approvals, and improving export facilities \u2013 Prime Minister",
    "url_metadata": "http://island.lk/he-government-is-taking-steps-to-streamline-trade-facilitation-customs-processes-investment-approvals-and-improving-export-facilities-prime-minister/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1765590480.0,
    "chunk_id": "2025-12-13-islandlk-91b117fb-0000",
    "chunk_index": 0,
