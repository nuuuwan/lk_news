    "description": "Australia\u2019s contribution boosts WFP emergency response to Cyclone Ditwah in Sri Lanka",
    "url_metadata": "https://www.ft.lk/news/Australia-s-contribution-boosts-WFP-emergency-response-to-Cyclone-Ditwah-in-Sri-Lanka/56-785449",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1765315411.0,
