    "url_metadata": "https://www.tamilmirror.lk/\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0b85\u0ba9\u0bbf\u0bb2\u0bcd-\u0b85\u0bae\u0bcd\u0baa\u0bbe\u0ba9\u0bbf-\u0bae\u0b95\u0ba9\u0bcd-\u0bae\u0bc0\u0ba4\u0bc1-\u0bb5\u0bb4\u0b95\u0bcd\u0b95\u0bc1/175-369353",
