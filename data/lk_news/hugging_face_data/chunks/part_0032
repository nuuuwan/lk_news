    "chunk_text": "\u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0d9a\u0da9\u0dd2\u0db1\u0db8\u0dca\u0db1\u0dca \u0dbd\u0dd2\u0d9b\u0dd2\u0dad\u0dc0\u00a0 \u0d92 \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dd4\u0dc0\u0dad\u0dca \u0d9a\u0dbd \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\u00a0 \u0d92 \u0dc0\u0d9c\u0dda\u0db8 \u0dad\u0db8\u0dba\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dd9\u0daf\u0dca\u0dc1\u0dd2\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4 \u0d9a\u0dd0\u0daf\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2 .\u0d85\u0dc0\u0db8\u00a0 \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dad\u0dd2\u0dba\u0d9a\u0da7 \u0dc3\u0dd0\u0dbb\u0dba\u0dc0\u0d9a\u0dca \u0dc0\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf \u0daf\u0dda\u0dc1\u0dd2\u0dba \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d9a\u0db8\u0dd2\u0da7\u0dd4 \u0d9a\u0dd0\u0daf\u0dc0\u0dbd\u0dcf \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0db4 \u0d89\u0da9\u0db8\u0dca \u0dbd\u0db6\u0dcf\u0daf\u0dd9\u0db1\u0dc0\u0daf \u0dbd\u0db6\u0dcf\u0daf\u0dd9\u0db1\u0dca\u0db1\u0dda \u0d9a\u0ddc\u0dc4\u0ddc\u0db8\u0daf,\u0dbd\u0d9a\u0dca\u0dc2 50 \u0d9a \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca\u00a0 \u0daf\u0dd9\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dc0\u0dca\u0dc0\u0dcf.\u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf\u00a0 \u0d92\u0d9a \u0daf\u0dd9\u0db1\u0dc0\u0daf? \u0d9a\u0ddc\u0dc4\u0db8\u0daf \u0d92\u0d9a \u0daf\u0dd9\u0db1\u0dca\u0db1\u0dda ,\u0d9c\u0dd9\u0dba\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0dca\u0dab \u0dc4\u0dcf\u0db1\u0dd2 \u0d8b\u0db1\u0ddc\u0d9a\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0dbd\u0d9a\u0dca\u0dc2 50 \u0d9a\u0dca \u0daf\u0dd9\u0db1\u0dcf \u0d9a\u0dd2\u0dc0\u0dca\u0dc0\u0dcf \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dad\u0dd4\u0db8\u0dcf \u0d92\u0dc0\u0dcf\u00a0 \u0daf\u0dd9\u0db1\u0dca\u0db1\u0dda \u0d9a\u0ddc\u0dc4\u0ddc\u0db8\u0daf? \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0da7\u00a0 \u0dad\u0dd3\u0db1\u0dca\u0daf\u0dd4 \u0d9c\u0dad \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2."
