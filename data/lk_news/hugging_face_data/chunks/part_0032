    "chunk_text": "\u0dc4\u0ddd\u0dbb\u0dca\u0da7\u0db1\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0db1\u0ddd\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0daf\u0dd9\u0dc3\u0dca \u0dc0\u0dd2\u0daf\u0dd9\u0dc3\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0db4\u0db8\u0dab\u0dba\u0dd2\n\n\u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dc0\u0dba\u0dad\u0dca \u0dc3\u0db8\u0d9c \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d86\u0db4\u0daf\u0dcf \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0d85\u0dc0\u0dc3\u0dbb \u0dbd\u0db6\u0dcf \u0daf\u0dd4\u0db1\u0dca \u0dc4\u0ddd\u0dbb\u0dca\u0da7\u0db1\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0db1\u0ddd\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c (07) \u0daf\u0dcf \u0dc3\u0dd2\u0da7 \u0daf\u0dd9\u0dc3\u0dca \u0dc0\u0dd2\u0daf\u0dd9\u0dc3\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dca\u0dad \u0dc0\u0db1 \u0db6\u0dc0 \u0d91\u0db8 \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0db7\u0dcf\u0dbb\u0d9a\u0dcf\u0dbb \u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca.\u0d9a\u0dda. \u0db8\u0ddc\u0dbb\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba.\n\n\u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba-\u0dc0\u0dd0\u0dbd\u0dd2\u0db8\u0da9 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dba\u0dad\u0dcf \u0dad\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db1\u0dd2\u0dc3\u0dcf \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab \u0d8b\u0db4\u0daf\u0dd9\u0dc3\u0dca \u0db8\u0dad \u0db8\u0dd9\u0db8 \u0dad\u0dd3\u0dbb\u0dab\u0dba \u0d9c\u0dad\u0dca \u0db6\u0dc0 \u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca.\u0d9a\u0dda \u0db8\u0ddc\u0dbb\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0d9a\u0dd3\u0dc0\u0dda\u0dba.\n\n\u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc4\u0dda\u0dbb\u0dca\u0da7\u0db1\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc0\u0db1\u0ddd\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1\u0dba\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd9\u0db1 \u0daf\u0dd9\u0dc3\u0dca \u0dc0\u0dd2\u0daf\u0dd9\u0dc3\u0dca \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0dd2\u0db1\u0dca\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0 \u0dc4\u0dcf \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc3\u0db4\u0dba\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0dc4\u0ddd\u0dbb\u0dca\u0da7\u0db1\u0dca\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1 \u0db7\u0dcf\u0dbb\u0d9a\u0dcf\u0dbb \u0d91\u0db8\u0dca.\u0d91\u0db8\u0dca.\u0d9a\u0dda.\u0db8\u0ddc\u0dbb\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dc5\u0dda\u0dba."
