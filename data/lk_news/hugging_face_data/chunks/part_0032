    "description": "\u0db8\u0dcf\u0db1\u0dc0 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0db8\u0dca \u0d9a\u0ddc\u0db8\u0dd2\u0dc3\u0db8\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dd2\u0dba\u0dad\u0dca \u0dc4\u0dd2\u0db8\u0dd2 \u0d9a\u0db8\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0db1\u0dc0-\u0dc4\u0db8\u0d9a\u0db8-\u0d9a\u0db8\u0dc3\u0db8-\u0db1\u0dbd\u0db0\u0dbb\u0db1\u0dba\u0dad-\u0dc4\u0db8-\u0d9a\u0db8-\u0d89\u0dbd\u0dbd\u0dba/1-685105",
