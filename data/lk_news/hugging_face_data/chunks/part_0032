    "chunk_text": "\u0db8\u0dd4\u0dc4\u0dd4\u0dab\u0dd4 \u0db4\u0ddc\u0dad\u0dda \u0dc3\u0dcf\u0daf\u0dba\u0da7 \u0d86 \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0db8\u0dd4\u0daf\u0dcf \u0dc4\u0dbb\u0dd2\u0dba\u0dd2\n\n\u0dad\u0dd9\u0dbd\u0dca\u0daf\u0dd9\u0dab\u0dd2\u0dba\u00a0 ,\u0d9a\u0dbb\u0dbd\u0dca\u0dbd\u0dd2\u0dba\u0daf\u0dca\u0daf \u0db1\u0dc0 \u0db1\u0d9c\u0dbb\u0dba\u0dda ,\u0dc0\u0dd2\u0d9a\u0dca\u0da7\u0ddd\u0dbb\u0dd2\u0dba\u0dcf \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc4\u0ddd\u0da7\u0dbd\u0dba\u0d9a ,\u0d85\u0dba\u0dd2\u0dc2\u0dca ,\u0d9a\u0dd4\u0dc2\u0dca ,\u0dc4\u0dd9\u0dbb\u0ddc\u0dba\u0dd2\u0db1\u0dca ,\u0dc3\u0dc4 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dca\u0db1\u0dd0\u0db8\u0dad\u0dd2 \u0db8\u0dad\u0dca \u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d86\u0db4\u0daf\u0dcf \u0dc3\u0db8\u0dba\u0dda \u0db8\u0dad\u0dca \u0dc3\u0dcf\u0daf\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0da7\u0dd2 \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1\u0dcf\u0da5\u0dba\u0d9a\u0dd4\u0d9c\u0dda \u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4 27 \u0daf\u0dd9\u0db1\u0dcf \u0d87\u0db4 \u0db8\u0dad \u0db8\u0dd4\u0daf\u0dcf \u0dc4\u0dd0\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u00a0 \u0d85\u0daf \u0dc3\u0dc0\u0dc3 \u0db1\u0dd2\u0dba\u0ddd\u0d9c \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0dc3\u0dcf\u0daf\u0dba\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd3 \u0dc0\u0dd6\u00a0 \u0dad\u0dbb\u0dd4\u0dab \u0dad\u0dbb\u0dd4\u0dab\u0dd2\u0dba\u0db1\u0dca\u0d9c\u0dd9\u0db1\u0dca 27 \u0daf\u0dd9\u0db1\u0d9a\u0dd4\u0d9c\u0dd9\u0db1\u0dca \u0dba\u0dd4\u0d