    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db1\u0dc0\u0d9a-\u0dc4\u0db8\u0daf\u0dc0-\u0db4\u0dbb\u0dc3\u0d9a-\u0d8b\u0dc3\u0dc3\u0dc0\u0db8-\u0dbd\u0db6\u0dad/1-684953",
