    "num": "dailyftlk-7030b6d6",
    "date_str": "2025-12-12",
    "description": "NCPA calls on public to report suspicious childcare offers to 1929 helpline",
    "url_metadata": "https://www.ft.lk/news/NCPA-calls-on-public-to-report-suspicious-childcare-offers-to-1929-helpline/56-785544",
    "lang": "en",
