    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbb\u0da7-\u0d9c\u0da9-\u0d9c\u0db1\u0db1-\u0d9a\u0da7-\u0dbd\u0d9a\u0dc2\u0dba\u0d9a-\u0db4\u0dbb\u0db4\u0dbb\u0d9a\u0dba\u0d9a/1-685244",
