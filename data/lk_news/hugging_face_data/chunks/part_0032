    "chunk_text": "\u0db8\u0dda \u0d85\u0dad\u0dbb \u0dad\u0dd4\u0dbb\u0dda\u00a0 \u0dad\u0dd2\u0dbb\u0dd2\u0d82\u0d9c \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba\u0dda \u0daf\u0ddd\u0dc2\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0d9c \u0daf\u0dd4\u0db1\u0dca\u0dc4\u0dd2\u0db3 \u0db4\u0dbd\u0dca\u0dbd\u0db8\u0dda \u0db0\u0dcf\u0dc0\u0db1\u0dba \u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0db8\u0dd9\u0db8 \u0db6\u0dc3\u0dca\u200d \u0dbb\u0dae\u0dba \u0dbb\u0dd2\u0dba\u0dd0\u0daf\u0dd4\u0dbb\u0dd4\u0db8\u0dc4\u0dad\u0dcf\u00a0 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0d85\u0dc3\u0dbd \u0dc0\u0dda\u0dbd\u0dca\u0dbd\u0d9a\u0da7 \u0d85\u0dbd\u0dca\u0dbd\u0dcf \u0db1\u0dc0\u0dad\u0dcf \u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4 \u0daf\u0dbb\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0dba \u0dc0\u0dca\u200d\u0dba\u0dbb\u0dca\u0dae \u0dc0\u0dd6 \u0dc4\u0dd9\u0dba\u0dd2\u0db1\u0dca\u00a0 \u0db4\u0dbd\u0dca\u0dbd\u0db8\u0dda \u0d87\u0daf\u0dd3 \u0d86 \u0db6\u0dc3\u0dca\u200d \u0dbb\u0dae\u0dba \u0db4\u0dc4\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d9a\u0dbd\u0dd4\u0d9c\u0dbd\u0dca \u0dad\u0dcf\u0db4\u0dca\u0db4\u0dba\u0d9a\u0da7 \u0d85\u0dbd\u0dca\u0dbd\u0dcf \u0d9a\u0dd2\u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0daf\u0dbb\u0dba\u0d9a\u0dca \u0db1\u0ddc\u0dc0\u0db1 \u0d85\u0dba\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0db6\u0dc3\u0dca\u200d \u0dbb\u0dae\u0dba \u0dc3\u0db8\u0d9c \u0db8\u0d9c\u0dd3 \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0db1\u0dd2\u0dbb\u0dd4\u0db4\u0daf\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0db6\u0dda\u0dbb\u0dcf \u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0dbb\u0dd2\u0dba\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0da2\u0db1\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd6 \u0db6\u0dc0\u0dad\u0dca \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0d9a\u0dbd\u0dda\u0dba ."
