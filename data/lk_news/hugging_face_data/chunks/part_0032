    "chunk_text": "\u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0daf\u0dd9\u0dc4\u0dd2\u0d95\u0da7, \u0db8\u0dcf\u0dc0\u0db1\u0dd0\u0dbd\u0dca\u0dbd,\u0dc0\u0dbb\u0d9a\u0dcf\u0db4\u0ddc\u0dc5 , \u0db6\u0dd4\u0dbd\u0dad\u0dca\u0d9a\u0ddc\u0dc4\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba,\u0daf\u0dd0\u0dbb\u0dab\u0dd2\u0dba\u0d9c\u0dbd, \u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbd,\u0d85\u0dbb\u0dab\u0dcf\u0dba\u0d9a, \u0dbb\u0db9\u0dd4\u0d9a\u0dca\u0d9a\u0db1,\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dba\u0da7\u0dd2\u0dba\u0db1\u0dca\u0dad\u0ddc\u0da7, \u0dc3\u0dc4 \u0d9c\u0dbd\u0dd2\u0d9c\u0db8\u0dd4\u0dc0, \u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0db4\u0ddc\u0dbd\u0dca\u0d9c\u0dc4\u0dc0\u0dd9\u0dbd \u0dc3\u0dc4 \u0d85\u0dbd\u0dc0\u0dca\u0dc0, \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dad\u0dbd\u0dc0\u0d9a\u0dd0\u0dbd\u0dda \u0db1\u0ddd\u0dbb\u0dca\u0dc0\u0dd4\u0da9\u0dca,\u0d85\u0db9\u0d9c\u0db8\u0dd4\u0dc0 \u0d9a\u0ddd\u0dbb\u0dc5\u0dba, \u0d9a\u0ddc\u0dad\u0dca\u0db8\u0dbd\u0dda \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0dc3\u0dc4 \u0d9a\u0ddc\u0dad\u0dca\u0db8\u0dbd\u0dda \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd2\u0dba \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc3 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0da7\u0da7\u0dca\u0db8\u0dda \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba\u0daf\u00a0\u00a0\u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda.\n\n\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d9c\u0ddc\u0da9\u0db1\u0dd0\u0d9c\u0dd2\u0dbd\u0dd2 \u0db4\u0dbb\u0dca\u0dba\u0dda\u0dc2\u0dab \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db8\u0dd9\u0db8\u00a0\u00a0\u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dda \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba \u0d85\u0daf 16 \u0dc0\u0db1\u0daf\u0dcf\u00a0\u0db4\u0dc3\u0dca\u0dc0\u0dbb\u0dd4 4.00\u00a0\u00a0\u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db6\u0dbd \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd9\u0db1\u00a0\u00a0\u0db6\u0dc0\u0dad\u0dca\u00a0\u00a0\u0d91\u0db8 \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dd2\u0dba\u0dba\u0dd2."
  },
