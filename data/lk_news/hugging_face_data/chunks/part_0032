    "description": "\u0db8\u0da9\u0ddc\u0dbd\u0dca\u0dc3\u0dd2\u0db8 \u0db8\u0dd0\u0da7\u0dd2\u0d9c\u0dc4\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dba\u0dc5\u0dd2 \u0dc0\u0dc3\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0da9\u0dbd\u0dc3\u0db8-\u0db8\u0da7\u0d9c\u0dc4\u0dad\u0db1\u0db1-\u0db8\u0dbb\u0d9c\u0dba-\u0dba\u0dc5-\u0dc0\u0dc3\u0dba/1-685104",
