    "description": "EU commits  \u20ac 1.8 m in response to floods in Sri Lanka",
    "url_metadata": "https://www.ft.lk/news/EU-commits-1-8-m-in-response-to-floods-in-Sri-Lanka/56-785549",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1765488720.0,
