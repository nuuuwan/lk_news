    "chunk_text": "\u0db8\u0dbb\u0dda \u0dc0\u0dad\u0dd4\u0dba\u0dcf\u0dba\u0dda \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 50\u0d9a\u0dd2\u0db1\u0dca \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0dba\u0dd2\n\n\u0db1\u0dbd\u0dca\u0dbd\u0dad\u0db1\u0dca\u0db1\u0dd2\u0dba \u0db8\u0dbb\u0dda \u0dc0\u0dad\u0dd4\u0dba\u0dcf\u0dba\u0dda \u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0dad\u0dd4\u0dbd \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0dad\u0dbb\u0dca\u0da2\u0db1\u0dba\u0d9a\u0dca \u0db8\u0dad\u0dd4\u0dc0\u0dd9\u0dad\u0dd0\u0dba\u0dd2 \u0d87\u0dad\u0dd2\u0dc0\u0dd4 \u0dc3\u0dd0\u0d9a\u0dba\u0d9a\u0dca \u0db8\u0dad \u0d91\u0db8 \u0dc0\u0dad\u0dd4\u0dba\u0dcf\u0dba\u0dda \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 50\u0d9a \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d91\u0db8 \u0db1\u0dd2\u0dc0\u0dcf\u0dc3\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb \u0dc3\u0dd4\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dd9\u0dad \u0dbb\u0daf\u0dc0\u0dcf \u0dad\u0dd0\u0db6\u0dd2\u0db8\u0da7 \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0dd9\u0db1 \u0d87\u0dad.\n\n\u0db8\u0dda \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0daf\u0dc0 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd2\u0dc3\u0d9a\u0daf\u0dd2 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd4 \u0db1\u0dbd\u0dca\u0dbd\u0dad\u0db1\u0dca\u0db1\u0dd2\u0dba \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dd4 \u0db4\u0dc0\u0dc3\u0db1 \u0dbd\u0daf\u0dca\u0daf\u0dda \u0db1\u0dbd\u0dca\u0dbd\u0dad\u0db1\u0dca\u0db1\u0dd2\u0dba \u0db8\u0dbb\u0dda \u0dc0\u0dad\u0dd4\u0dba\u0dcf\u0dba\u0dda \u0d9a\u0ddc\u0da7\u0dc3\u0d9a\u0dca \u0db1\u0dcf\u0dba\u0dba\u0dcf\u0db8\u0dda \u0dad\u0dbb\u0dca\u0da2\u0db1\u0dba\u0d9a\u0da7 \u0dbd\u0d9a\u0dca \u0dc0\u0dd9\u0dad\u0dd0\u0dba\u0dd2 \u0d87\u0dad\u0dd2\u0dc0\u0dd4 \u0dc3\u0dd0\u0d9a\u0dba\u0d9a\u0dca