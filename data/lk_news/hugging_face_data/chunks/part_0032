    "chunk_text": "\u0daf\u0dc5 \u0daf\u0dda\u0dc1\u0dd3\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 9\u0d9a\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dd6 \u0db6\u0daf\u0dd4 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 15 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0dc0\u0db1 \u0d9a\u0dbb\u0dd4\u0dab \u0dc0\u0db1\u0dca\u0db1\u0dda \u0db6\u0daf\u0dd4 \u0d85\u0dba\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dba\u0d9a\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dd9\u0db1 \u0db6\u0dc0\u0dba\u0dd2. \u0d91\u0dc3\u0dda \u0dc0\u0dd4\u0dc0 \u0daf \u0d91\u0d9a\u0dad\u0dd4 \u0d9a\u0dbb\u0d9c\u0dad\u0dca \u0db6\u0daf\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dc0\u0d9a\u0dca\u200d\u0dbb \u0db6\u0daf\u0dd4 \u0dc0\u0dd3\u0db8\u0dad\u0dca, \u0dad\u0dc0\u0db8\u0dad\u0dca \u0db8\u0dd4\u0dc5\u0dd4 \u0db6\u0daf\u0dd4 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dd9\u0db1\u0dca \u0dc3\u0dd8\u0da2\u0dd4 \u0db6\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0d89\u0dad\u0dcf \u0db4\u0dc4\u0dc5 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0db6\u0dc0\u0dad\u0dca \u0d85\u0db8\u0dad\u0d9a \u0d9a\u0dc5\u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0dd0\u0dad. \u0dc0\u0d9a\u0dca\u200d\u0dbb \u0db6\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0db8\u0dd4\u0dc5\u0dd4 \u0db6\u0daf\u0dd4 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0dba\u0dba\u0da7 80\u0d9a\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0d89\u0dc4\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc1\u0dad\u0dba\u0d9a\u0dca \u0d85\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dd0\u0dc4\u0dd0\u0daf\u0dd2\u0dbd\u0dd2 \u0dc0\u0db1\u0dca\u0db1\u0dda \u0dbb\u0da7\u0dda \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u200d\u0db8 \u0da2\u0db1 \u0d9a\u0ddc\u0da7\u0dc3\u0dca \u0db8\u0dd9\u0db8 \u0db6\u0daf\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0db8 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dc3\u0dd2\u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0d9a\u0dd0\u0db4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dba\u0dd2. \u0d91\u0dba \u0d89\u0dc4\u0dc5 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dbd\u0db6\u0db1 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dbd\u0da7 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u2018\u0d85\u0dc3\u0dca\u0dc0\u0dd0\u0dc3\u0dd4\u0db8\u2019 \u0d86\u0db0\u0dcf\u0dbb \u0dbd\u0db6\u0db1 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dbd\u0da7 \u0daf, \u0d86\u0db6\u0dcf\u0db0\u0dd2\u0dad \u0dc3\u0dc4 \u0dbb\u0ddd\u0d9c\u0dd3 \u0dad\u0dad\u0dca\u0dc0 \u0db8\u0dad \u0d86\u0db0\u0dcf\u0dbb \u0dbd\u0db6\u0db1 \u0d85\u0dba\u0da7 \u0daf, \u0db8\u0dc4\u0db8\u0d9c \u0da2\u0dd3\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0dba\u0dcf\u0da0\u0d9a\u0dba\u0db1\u0dca\u0da7 \u0daf \u0db6\u0dbd\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dba\u0dd2. \u0dbb\u0da7\u0dda \u0db6\u0daf\u0dd4 \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd9\u0daf\u0dca\u0daf\u0dd3 \u0d91\u0dc4\u0dd2 \u0dc0\u0d9a\u0dca\u200d\u0dbb \u0db6\u0daf\u0dd4 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba \u0d89\u0dc4\u0dc5 \u0d85\u0d9c\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dd3 \u0db1\u0db8\u0dca \u0d91\u0dc4\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db5\u0dbd\u0dba \u0dc0\u0db1\u0dca\u0db1\u0dda \u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0db6\u0daf\u0dd4 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dd9\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dca\u0dad\u0dda \u0dbb\u0da7\u0dda \u0d85\u0da9\u0dd4 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dbd\u0db6\u0db1 \u0dc3\u0dc4 \u0daf\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dc0\u0dba\u0dd2."
