    "description": "\u0b85\u0bae\u0bc6\u0bb0\u0bbf\u0b95\u0bcd\u0b95 \u0bb5\u0bbf\u0b9e\u0bcd\u0b9e\u0bbe\u0ba9\u0bbf \u0b9c\u0bc7\u0bae\u0bcd\u0bb8\u0bcd \u0bb5\u0bbe\u0b9f\u0bcd\u0b9a\u0ba9\u0bcd \u0b95\u0bbe\u0bb2\u0bae\u0bbe\u0ba9\u0bbe\u0bb0\u0bcd!",
    "url_metadata": "https://www.virakesari.lk/article/229849",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1762596180.0,
    "chunk_id": "2025-11-08-virakesarilk-da008319-0000",
    "chunk_index": 0,
    "language": "ta",
