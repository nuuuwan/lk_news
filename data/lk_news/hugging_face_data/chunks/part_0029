    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc3\u0dc0\u0dbb\u0db0\u0db1\u0dba-\u0db4\u0dbb\u0d9c\u0dad\u0dba-\u0dc3\u0dba\u0dba\u0da7-58\u0dba/101-683149",
