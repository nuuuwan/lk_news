    "chunk_text": "\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dba\u0dd2\n\n\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0dd6 \u0d91\u0dc4\u0dd2 \u0db8\u0dd6\u0dbd\u0dd2\u0d9a \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0dc0\u0db1 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 40 \u0dc3\u0dd3\u0db8\u0dcf\u0dc0 \u0db8\u0dcf\u0dc3 10\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0dad\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc3\u0db8\u0dad\u0dca\u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda.\n\n2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0dc3\u0dad\u0dca\u200d\u0dba \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 37.8 \u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb, 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0db8\u0dd4\u0dbd\u0dca \u0db8\u0dcf\u0dc3 10 \u0dad\u0dd4\u0dbd \u0d91\u0db8 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dad\u0dca, 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0db1\u0dca \u0d85\u0db7\u0dd2\u0db7\u0dc0\u0dcf \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d92\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0dd3\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0daf\u0dcf\u0dba\u0d9a \u0dc0\u0dd6 \u0dc3\u0dd0\u0db8\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dab\u0dcf\u0db8\u0dba \u0db4\u0dd4\u0daf \u0d9a\u0dbb\u0db1 \u0db6\u0dc0 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dbd\u0ddc\u0dad\u0dbb\u0dd0\u0dba\u0dd2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0db4\u0dc0\u0dc3\u0dba\u0dd2 ."
