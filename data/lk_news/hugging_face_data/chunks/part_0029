    "date_str": "2025-11-14",
    "description": "\u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d9a\u0dd2\u0dba\u0dd9\u0dc0\u0dca\u0dc0\u0dd9 \u0da2\u0dda.\u0d86\u0dbb\u0dca \u0d9c\u0dd9 \u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dd4\u0dbb\u0dcf",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d85\u0dba\u0dc0\u0dba-\u0d9a\u0dba\u0dc0\u0dc0-\u0da2-\u0d86\u0dbb-\u0d9c-\u0db8\u0dab\u0db4\u0dbb/1-683129",
    "lang": "si",
    "newspaper_id": "lankadeepalk",
    "time_ut": 1763100526.0,
    "chunk_id": "2025-11-14-lankadeepalk-911d5750-0000",
    "chunk_index": 0,
    "language": "si",
    "md5": "f7b75aa33a4c93e6a8e697ce5fb8ffc1",
    "chunk_size_bytes": 2279,
    "chunk_text": "\u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d9a\u0dd2\u0dba\u0dd9\u0dc0\u0dca\u0dc0\u0dd9 \u0da2\u0dda.\u0d86\u0dbb\u0dca \u0d9c\u0dd9 \u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dd4\u0dbb\u0dcf\n\n\u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0dda \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dc0\u0dd2\u0da7 \u0dad\u0db8\u0dcf\u0da7 \u0dad\u0dda\u0dbb\u0dd4\u0db8\u0dca \u0d9c\u0dd2\u0dba\u0dda \u0da2\u0dda.\u0d86\u0dbb\u0dca.\u0d9c\u0dda \u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dd4\u0dbb\u0dcf \u0db4\u0dd0\u0db8\u0dd2\u0dab \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dc3\u0dca\u0dc0\u0dbb\u0dd6\u0db4\u0dba\u0d9a\u0dca \u0db6\u0dc0 \u0d9a\u0ddc\u0dc5\u0db9 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d91\u0dc3\u0dca.\u0d91\u0db8\u0dca \u0db8\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dcf\u0dbb\u0dca \u0db8\u0dc4\u0dad\u0dcf:-(\u0dc3.\u0da2.\u0db6) \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba.\n\n'\u0dc0\u0dad\u0dd4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 200 \u0d9a\u0dca \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8\u0da7\u00a0 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0d85\u0db4 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc3\u0dda\u0dad\u0dca \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0 \u0db1\u0dd1.\u0dc0\u0dad\u0dd4\u0d9a\u0dbb\u0dba\u0dda \u0daf\u0dd9\u0db8\u0dc5 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0d8b\u0dad\u0dd4\u0dbb\u0dda \u0daf\u0dd9\u0db8\u0dc5 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7\u0dad\u0dca \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d9a\u0dbb\u0db4\u0dd4 \u0d85\u0dc3\u0dcf\u0db0\u0dcf\u0dbb\u0dab\u0d9a\u0db8\u0dca \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0dd0\u0dba\u0dd2 \u0d85\u0db4 \u0dad\u0daf\u0dd2\u0db1\u0dca\u0db8 \u0dc3\u0dd2\u0dad\u0db1\u0dc0\u0dcf.\n\n\u0db8\u0dda \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d9a\u0dd2\u0dba\u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db8\u0da7 \u0dad\u0dda\u0dbb\u0dd4\u0db1\u0dda \u0da2\u0dda.\u0d86\u0dbb\u0dca \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0d9c\u0dda \u0db8\u0dd4\u0dab\u0dd4\u0db4\u0dd4\u0dbb\u0dcf \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d9a\u0dd2\u0dba\u0dc0\u0db1 \u0db6\u0dc0\u0dba\u0dd2.\u0dbd\u0dbd\u0dd2\u0dad\u0dca \u0d87\u0dad\u0dd4\u0dbd\u0dad\u0dca\u0db8\u0dd4\u0daf\u0dbd\u0dd2\u0dbd\u0dcf, \u0d9c\u0dcf\u0db8\u0dd2\u0dab\u0dd3 \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dbd\u0dcf,\u0dbb\u0ddc\u0db1\u0dd3\u0daf \u0db8\u0dd9\u0dbd\u0dca\u0dbd\u0dcf,\u0d85\u0dad\u0dca\u0db4\u0dd4\u0da9\u0dd2 \u0d9c\u0dc4\u0db1\u0dc0\u0dcf \u0dc0\u0d9c\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0db4\u0da7 \u0db4\u0dd9\u0db1\u0dd4\u0db1\u0dda.\u0db8\u0dda \u0dc0\u0dcf\u0db8\u0dcf\u0d82\u0dc1\u0dd2\u0d9a \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dbd\u0dd2\u0db6\u0dbb\u0dbd\u0dca \u0dc0\u0dcf\u0daf\u0dd3 \u0d85\u0dba\u0dc0\u0dd0\u0dba\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5\u0dcf.\u0dc0\u0dd0\u0da9 \u0dc0\u0dbb\u0dca\u0da2\u0db1\u00a0 \u0d8b\u0daf\u0dca\u0d9d\u0ddd\u0dc2\u0dab \u0d9a\u0dbb\u0dbd\u0dcf \u0db8\u0dda \u0dbb\u0da7\u0dda \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u0dba \u0dc0\u0da7\u0dca\u0da7\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0daf\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba \u0daf\u0dd4\u0db1\u0dca\u0db1 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0d86\u0dba\u0dad\u0db1 \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1\u0dc0\u0dcf \u0dba\u0dd0\u0dba\u0dd2 \u0d85\u0dba\u0dc0\u0dd0\u0dba\u0dd9\u0db1\u0dca \u0d85\u0db8\u0dd4 \u0d85\u0db8\u0dd4\u0dc0\u0dda \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0dcf.\u0db8\u0db8 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0da7\u0dad\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7\u0dad\u0dca \u0d92 \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0da7 \u0db1\u0db8\u0dca \u0dc3\u0dca\u0dad\u0dd4\u0dad\u0dd2\u0dc0\u0db1\u0dca\u0dad \u0dc0\u0dd9\u0db1\u0dc0\u0dcf \u0dba\u0dd0\u0dba\u0dd2 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dcf \u0d9a\u0dd3\u0dba."
  },
  {
    "doc_type": "lk_news",
