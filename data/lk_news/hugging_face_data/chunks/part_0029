    "description": "\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0dda \u0d85\u0d9c\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dd2\u0db4\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca, 12\u0d9a\u0dca \u0db8\u0dbb\u0dd4\u0da7",
    "url_metadata": "https://www.ada.lk/international/\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0dda-\u0d85\u0d9c\u0db1\u0dd4\u0dc0\u0dbb-\u0db4\u0dd2\u0db4\u0dd2\u0dbb\u0dd3\u0db8\u0d9a\u0dca--12\u0d9a\u0dca-\u0db8\u0dbb\u0dd4\u0da7/3-419639",
