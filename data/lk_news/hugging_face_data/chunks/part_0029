    "description": "Socialist Alliance demands Provincial Council Elections",
    "url_metadata": "https://www.ft.lk/news/Socialist-Alliance-demands-Provincial-Council-Elections/56-784177",
    "lang": "en",
    "newspaper_id": "dailyftlk",
