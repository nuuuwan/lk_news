    "num": "dailyftlk-1067780a",
    "date_str": "2025-11-13",
    "description": "Anura suspends social and ethnic contracts; Mamdani presents new socialism",
    "url_metadata": "https://www.ft.lk/columns/Anura-suspends-social-and-ethnic-contracts-Mamdani-presents-new-socialism/4-784259",
