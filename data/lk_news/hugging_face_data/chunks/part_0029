    "description": "\u0dad\u0dcf\u0db1\u0dcf\u0db4\u0dad\u0dd2 \u0d9a\u0dd4\u0dc3\u0dbd\u0dcf\u0db1 \u0db6\u0dd0\u0da9\u0dca\u0db8\u0dd2\u0db1\u0dca\u0da7\u0db1\u0dca \u0dad\u0dbb\u0d9f\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0da7 CICT \u0dc4\u0dd2 \u0d85\u0db1\u0dd4\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba",
