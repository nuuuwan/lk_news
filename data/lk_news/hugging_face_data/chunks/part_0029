    "num": "dailyftlk-227f8041",
    "date_str": "2025-11-13",
    "description": "Reforming our Constitution: Getting basics right first",
    "url_metadata": "https://www.ft.lk/columns/Reforming-our-Constitution-Getting-basics-right-first/4-784258",
    "lang": "en",
