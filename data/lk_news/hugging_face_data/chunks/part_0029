    "description": "Dear Mr. President,\u00a0A Submission Re: Budget 2026, Investments & Growth Optimisation",
    "url_metadata": "https://www.colombotelegraph.com/index.php/dear-mr-president-a-submission-re-budget-2026-investments-growth-optimisation/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
