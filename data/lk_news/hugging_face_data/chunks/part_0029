    "description": "India\u2013Sri Lanka Policy Dialogue sets new course for regional environmental cooperation",
    "url_metadata": "http://island.lk/india-sri-lanka-policy-dialogue-sets-new-course-for-regional-environmental-cooperation/",
    "lang": "en",
    "newspaper_id": "islandlk",
