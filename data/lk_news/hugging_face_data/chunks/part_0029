  {
    "doc_type": "lk_news",
    "doc_id": "2025-11-13-dailyftlk-9dd01374",
    "num": "dailyftlk-9dd01374",
    "date_str": "2025-11-13",
    "description": "National Supply Chain Day 2025 celebrations highlight excellence and innovation",
    "url_metadata": "https://www.ft.lk/business/National-Supply-Chain-Day-2025-celebrations-highlight-excellence-and-innovation/34-784293",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1763003420.0,
