    "date_str": "2025-11-06",
    "description": "AOD and Cinnamon Life unite for \u201cWhat\u2019s Your Colombo?\u201d",
    "url_metadata": "https://www.ft.lk/business/AOD-and-Cinnamon-Life-unite-for-What-s-Your-Colombo/34-783953",
    "lang": "en",
    "newspaper_id": "dailyftlk",
