    "url_metadata": "https://www.lankadeepa.lk/news/\u0db4\u0db4-\u0dc0\u0dc4\u0db1\u0dc3\u0da7-\u0dbd\u0d9a\u0dc0\u0da7-\u0d91\u0db1\u0db1\u0dba-\u0dc0\u0db0\u0db8\u0dad-\u0d86\u0dbb\u0db0\u0db1\u0dba\u0d9a/101-682698",
