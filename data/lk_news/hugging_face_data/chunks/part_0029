    "description": "Business leaders share  lessons in resilience at I AM COYLE Leadership Forum 2025",
    "url_metadata": "https://www.ft.lk/business/Business-leaders-share-lessons-in-resilience-at-I-AM-COYLE-Leadership-Forum-2025/34-784264",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1762996515.0,
