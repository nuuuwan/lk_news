    "description": "\u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0da7 \u0dc3\u0dd3\u0db8\u0dcf \u0dc0\u0dd6 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dad\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d9a\u0dd3\u0db4\u0dba\u0d9a\u0da7 \u0d9a\u0dad\u0dd4\u0db1\u0dca\u0da7 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0",
