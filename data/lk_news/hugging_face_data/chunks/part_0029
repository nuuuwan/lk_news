    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b95\u0bbe\u0ba4\u0bb2\u0bbf-\u0baa\u0bc7\u0b9a\u0bbe\u0ba4\u0ba4\u0bbe\u0bb2\u0bcd-\u0b89\u0baf\u0bbf\u0bb0\u0bc8-\u0bae\u0bbe\u0baf\u0bcd\u0ba4\u0bcd\u0ba4-\u0b95\u0bbe\u0ba4\u0bb2\u0ba9\u0bcd/76-367424",
