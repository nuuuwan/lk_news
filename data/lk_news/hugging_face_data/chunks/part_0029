    "url_metadata": "https://www.lankadeepa.lk/news/\u0db6\u0dbb\u0dbd\u0db4\u0db1\u0dad\u0dbb-\u0dc3\u0db8\u0db4-\u0db6\u0dbd\u0dba\u0dad-\u0db4\u0daf-\u0dc0\u0db4\u0d9a\u0dc2\u0dba\u0da7/101-682860",
