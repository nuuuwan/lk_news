    "description": "\u0db8\u0db1\u0db8\u0dca\u0db4\u0dda\u0dbb\u0dd2 \u0d9a\u0dd4\u0da9\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0ddc\u0dba\u0dcf \u0d9c\u0dad\u0dca \u0db6\u0dc3\u0dba\u0d9a\u0dca - \u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca \u0d85\u0dbd\u0dca\u0dbd\u0dba\u0dd2",
