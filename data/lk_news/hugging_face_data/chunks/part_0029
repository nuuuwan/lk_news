    "chunk_text": "\u0d9a\u0dbb\u0dd4\u0dc0\u0dbd\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0d85\u0dba\u0dc0\u0dd0\u0dba\u0da7 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0dc4\u0dad\u0dbb\u0d9a\u0d9c\u0dda \u0dc3\u0dc4\u0dcf\u0dba\n\n\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1\u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba \u0db4\u0d9a\u0dca\u0dc2\u0dba\u00a0 \u0dba\u0da7\u0dad\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d9a\u0dbb\u0dd4\u0dc0\u0dbd\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd2\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda 2026 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dbd\u0dda\u0d9b\u0db1\u0dba \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0d82\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc4\u0dad\u0dbb \u0daf\u0dd9\u0db1\u0d9a\u0dd4\u0d9c\u0dda \u0dc3\u0dc4\u0dba\u0dd9\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0da1\u0db1\u0dca\u0daf 6\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db7\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dad \u0dc0\u0dd2\u0dba.\n\n\u0d9a\u0dbb\u0dd4\u0dc0\u0dbd\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u00a0 \u0db1\u0dd3\u0dbd\u0dca \u0db1\u0dc0\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf\u0d9c\u0dda\u00a0(\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1\u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba) \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0db8\u0dd9\u0db8 \u0dc3\u0db7\u0dcf \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0d85\u0dc3 \u0d91\u0db8 \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0dc1\u0dcf\u0dbd\u0dcf\u0dc0\u0dda\u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dab\u0dd2.\n\n\u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0dba\u0dc0\u0dd0\u0dba\u0da7 \u0db4\u0d9a\u0dca\u0dc2\u0dc0 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0dc3\u0db8\u0d9c\u0dd2 \u0da2\u0dbd\u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0dc3\u0dd4\u0d9c\u0db1\u0dca\u0db0\u0dd2\u0d9a\u0dcf \u0da0\u0dcf\u0db1\u0dca\u0daf\u0db1\u0dd3,\u00a0 \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0ddc\u0daf\u0dd4 \u0da2\u0db1\u0db4\u0dd9\u0dbb\u0db8\u0dd4\u0dab \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0d85\u0dbb\u0dd4\u0dab \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0d9a,\u0dc3\u0dbb\u0dca\u0dc0 \u0da2\u0db1\u0db6\u0dbd\u0dba \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0da0\u0db8\u0dd2\u0db1\u0dca\u0daf \u0da2\u0dd3\u0dc0\u0db1\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0dc3\u0dc4 \u0da2\u0db1\u0d85\u0dbb\u0d9c\u0dbd \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dda \u0dc3\u0dd4\u0dc3\u0db1\u0dca\u0dad \u0dc3\u0dd4\u0da2\u0dd3\u0dc0 \u0dc0\u0dd2\u0da2\u0dda\u0dc3\u0dd2\u0d82\u0dc4 \u0dba\u0db1 \u0db8\u0dc4\u0dad\u0dca\u0db8 \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd3\u0dc4\u0dd4 \u0da1\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0d9a\u0dc5\u0dc4.\n\n\u0d9a\u0dbb\u0dd4\u0dc0\u0dbd\u0d9c\u0dc3\u0dca\u0dc0\u0dd0\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db8\u0dd4\u0dc5\u0dd4 \u0d86\u0dc3\u0db1 \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 21\u0d9a\u0dd2.\u00a0 \u0db4\u0dcf\u0dbd\u0d9a \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1\u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba\u0da7\u00a0 \u00a0\u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 9\u0d9a\u0dca \u0daf \u0dc3\u0db8\u0d9c\u0dd2 \u0da2\u0db1\u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba\u0da7 \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 4\u0d9a\u0dca, \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0ddc\u0daf\u0dd4\u0da2\u0db1 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0db4\u0dd9\u0dbb\u0db8\u0dd4\u0dab\u0da7 \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 3\u0d9a\u0dca, \u0dc1\u0dca\u200d\u0dbb\u0dd3\u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0ddc\u0daf\u0dd4\u0da2\u0db1 \u0db4\u0dd9\u0dbb\u0db8\u0dd4\u0dab\u0da7 \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 2\u0d9a\u0dca, \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 1\u0d9a\u0dca, \u0dc3\u0dbb\u0dca\u0dc0\u0da2\u0db1\u0db6\u0dbd \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 1\u0d9a\u0dca \u0dc3\u0dc4 \u0da2\u0db1\u0d85\u0dbb\u0d9c\u0dbd \u0dc3\u0db1\u0dca\u0db0\u0dcf\u0db1\u0dba\u0da7 \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 1\u0d9a\u0dca \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0dc3\u0db7\u0dd2\u0d9a\u0db0\u0dd6\u0dbb 21\u0d9a\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba."
  },
