    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0d9c\u0dd3\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca\u0da7 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0daf\u0dd9\u0d9a\u0d9a\u0dca\n\n\u2018\u0db1\u0dc0\u0dca\u200d\u0dba\u0d9a\u0dbb\u0dab\u0dba \u0dad\u0dd4\u0dc5 \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0db1\u0dd3\u0dba \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba\u0d9a\u0dbb\u0dab\u0dba\u0d9a\u0dca \u0d8b\u0daf\u0dd9\u0dc3\u0dcf \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 2025\u2019 \u0dba\u0db1 \u0dad\u0dda\u0db8\u0dcf\u0dc0 \u0dba\u0da7\u0dad\u0dda \u0db1\u0dd9\u0dc5\u0dd4\u0db8\u0dca \u0db4\u0ddc\u0d9a\u0dd4\u0dab \u0dbb\u0d9f\u0dc4\u0dbd\u0dda\u0daf\u0dd3 \u0d85\u0daf (11) \u0db4\u0dc3\u0dca\u0dc0\u0dbb\u0dd4\u0dc0\u0dda \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0d8b\u0dc5\u0dd9\u0dbd\u0dda\u0daf\u0dd3 \u0dc0\u0dd2\u0da2\u0dba \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0db4\u0dad\u0dca \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0db1 \u2018\u0da9\u0dda\u0dbd\u0dd2\u0db8\u0dd2\u0dbb\u0dbb\u0dca\u2019 \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0db4\u0dad\u0dda \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dd3\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0daf\u0dd9\u0d9a\u0d9a\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0dba.\n\n\u0db4\u0dca\u200d\u0dbb\u0d9c\u0dd3\u0dad\u0dca \u0dc3\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dad\u0dd2\u0dbd\u0d9a \u0db8\u0dc4\u0dad\u0dcf 2023 \u0dc0\u0dc3\u0dbb\u0dda \u0d89\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0db4\u0dad\u0dca \u0d85\u0d82\u0dc1\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dc3\u0dca\u0dae \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dcf\u0d82\u0d9c \u0dbd\u0dd2\u0db4\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0dc3\u0dc4 2023 \u0dc0\u0dc3\u0dbb\u0dda \u0d89\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd3\u0dc3\u0dd2 \u0db4\u0dd4\u0dc0\u0dad\u0dca\u0db4\u0dad\u0dca \u0d85\u0d82\u0dc1\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0dc3\u0dc3\u0dca\u0dae \u0d9c\u0dc0\u0dda\u0dc1\u0db1\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dbd\u0dd2\u0db4\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dc0\u0db1 \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb\u0d9c\u0dad\u0dca\u0dad\u0dda\u0dba."
