    "description": "Empowering women-led exporters with trade data insights",
    "url_metadata": "https://www.ft.lk/business/Empowering-women-led-exporters-with-trade-data-insights/34-783836",
    "lang": "en",
    "newspaper_id": "dailyftlk",
