    "description": "2nd Session of Sri Lanka\u2013UAE Joint Commission concludes in Colombo",
    "url_metadata": "https://www.ft.lk/news/2nd-Session-of-Sri-LankaUAE-Joint-Commission-concludes-in-Colombo/56-783970",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1762389313.0,
