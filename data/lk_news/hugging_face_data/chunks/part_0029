    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0da2\u0dbd-\u0db8\u0dbb\u0d9c-\u0db4\u0dbd\u0dc3\u0da7\u0d9a-\u0dc0\u0dbd\u0db1-\u0db6\u0dbb-\u0d9c\u0db1\u0db1-\u0dc0\u0da9\u0d9a-\u0d85\u0dbb\u0db9\u0dba/1-682834",
