    "chunk_text": "\u0d9a\u0dd4\u0da9\u0dd4 \u0dc3\u0db8\u0d9c \u0d87\u0dbd\u0dca\u0dbd\u0dd6 \u0d9a\u0da7\u0dd2\u0dba\u0dcf\u0dc0 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2 \u0dbb\u0dd2\u0db8\u0dcf\u0db1\u0dca\u0da9\u0dca\n\n\u0dc4\u0dd9\u0dbb\u0ddd\u0dba\u0dd2\u0db1\u0dca \u0d9a\u0dd2\u0dbd\u0ddd 1 \u0dba\u0dd2 \u0d9c\u200d\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dca 184 \u0dba\u0dd2 \u0db8\u0dd2\u0dc5\u0dd2 \u0d9c\u200d\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dca 400 \u0d9a\u0dca \u0dc3\u0db8\u0d9c \u0d91\u0db4\u0dca\u0db4\u0dcf\u0dc0\u0dbd \u0d87\u0db3\u0d9c\u0dbd \u0db4\u200d\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda \u0daf\u0dd3 \u0d85\u0dad\u0dca \u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dd9\u0db1 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0db1\u0dd2\u0dba\u0ddd\u0d9c\u00a0 \u0db8\u0dad \u0daf\u0dd2\u0db1 \u0dc4\u0dad\u0d9a \u0d9a\u0dcf\u0dbd\u0dba\u0d9a\u0dca \u0dbb\u0db3\u0dc0\u0dcf \u0dad\u0db6\u0dcf \u0d9c\u0dd9\u0db1 \u0db4\u200d\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1 \u0d9a\u0dc5 \u0dc0\u0dd0\u0da9\u0dad\u0dc4\u0db1\u0db8\u0da7 \u0dbd\u0d9a\u0dca \u0dc0\u0dd6 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc3\u0dc4 \u0dc4\u0dd9\u0dbb\u0ddd\u0dba\u0dd2\u0db1\u0dca \u0d9c\u200d\u0dca\u200d\u0dbb\u0dd1\u0db8\u0dca 69 \u0d9a\u0dca \u0dc3\u0db8\u0d9f \u0d85\u0dad\u0dca \u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dad\u0dca \u0d85\u0db1\u0dd9\u0d9a\u0dca \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4 \u0dbd\u0db6\u0db1 26 \u0daf\u0dd2\u0db1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dbb\u0dd2\u0db8\u0dcf\u0db1\u0dca\u0da9\u0dca \u0db6\u0dcf\u0dbb\u0dba\u0dda \u0dad\u0db6\u0db1 \u0dbd\u0dd9\u0dc3 \u0dad\u0db9\u0dd4\u0dad\u0dca\u0dad\u0dda\u0d9c\u0db8 \u0db8\u0dc4\u0dda\u0dc3\u0dca\u0dad\u200d\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca \u0d9c\u0dba\u0dcf\u0dad\u200d\u0dca\u200d\u0dbb\u0dd2 \u0dc4\u0dd9\u0da7\u0dca\u0da7\u0dd2\u0d86\u0dbb\u0da0\u0dd2\u0da0\u0dd2 \u0db8\u0dd9\u0db1\u0dc0\u0dd2\u0dba \u0d85\u0daf \u0db1\u0dd2\u0dba\u0ddd\u0d9c \u0d9a\u0dc5\u0dcf\u0dba.\n\n\u0db8\u0dd9\u0dc3\u0dda \u0dbb\u0dd2\u0db8\u0dcf\u0db1\u0dca\u0da9\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf\u0dca\u0daf\u0dda \u0dad\u0db9\u0dd4\u0dad\u0dca\u0dad\u0dda\u0d9c\u0db8 \u0d85\u0db0\u0dca\u200d\u0dba\u0db4\u0db1 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda \u0d91\u0db4\u0dca\u0db4\u0dcf\u0dc0\u0dbd \u0d9a\u0da7\u0dd2\u0dba\u0dcf\u0dc0 \u0dba\u0dcf\u0dba 10 \u0db4\u200d\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda \u0db4\u0dcf\u0dc3\u0dbd\u0d9a \u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0d9a\u0dd4 \u0dc0\u0db1 \u0da2\u0dba\u0db1\u0dca\u0dad \u0db6\u0dcf\u0dbd\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0dc3\u0dc4 \u0d91\u0db4\u0dca\u0db4\u0dcf\u0dc0\u0dbd \u0d87\u0daf\u0d9c\u0dbd \u0db1\u0dbd\u0dca\u0dbd\u0db8\u0dd4\u0daf\u0dcf\u0dc0 \u0db4\u0dcf\u0dbb \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0dad\u0dbb\u0dd2\u0daf\u0dd4 \u0db0\u0db1\u0d82\u0da2\u0dba \u0dc0\u0dd2\u0d9a\u200d\u0dca\u200d\u0dbb\u0db8\u0dc3\u0dd2\u0d82\u0dc4 \u0dba\u0db1 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dba.\n\n\u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0db1\u0dca\u0dad\u0d9a\u0dba\u0dda \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3 \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba \u0db6\u0dcf\u0dbb\u0dba\u0da7 \u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dd2 \u0dc4\u0dd9\u0dbb\u0ddd\u0dba\u0dd2\u0db1\u0dca \u0db6\u0dc0\u0da7 \u0dc3\u0dd0\u0d9a \u0d9a\u0dd9\u0dbb\u0dd9\u0db1 \u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0dbb\u0da2\u0dba\u0dda \u0dbb\u0dc3 \u0db4\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd9\u0dad \u0dba\u0dc0\u0dcf \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0dbb\u0dc3 \u0db4\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0d9a \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba\u0da7 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9\u0dc3\u0da7\u0daf \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\