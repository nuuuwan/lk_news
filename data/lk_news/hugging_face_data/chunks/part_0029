    "description": "\u0dbd\u0dc3\u0dca\u0dc3\u0db1 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba\u0d9a\u0dca \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d87\u0dc0\u0dd2\u0dad\u0dca  \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0d85\u0dc3\u0dbb\u0dab \u0d9a\u0dc5\u0dcf",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbd\u0dc3\u0dc3\u0db1-\u0da2\u0dc0\u0dad\u0dba\u0d9a-\u0daf\u0db1\u0db1-\u0d87\u0dc0\u0dad-\u0db8\u0db1\u0dc3\u0dc3-\u0d85\u0dc3\u0dbb\u0dab-\u0d9a\u0dc5/1-682964",
