    "description": "DFCC Bank recognised at ICC Emerging Asia Banking Awards 2026",
    "url_metadata": "https://www.dailymirror.lk/business-news/DFCC-Bank-recognised-at-ICC-Emerging-Asia-Banking-Awards-2026/273-349193",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
