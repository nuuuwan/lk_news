    "num": "dailymirrorlk-77ee1d2d",
    "date_str": "2026-09-01",
    "description": "Quality of life:  Is it the state\u2019s responsibility?",
    "url_metadata": "https://www.dailymirror.lk/opinion/Quality-of-life-Is-it-the-states-responsibility/172-349209",
