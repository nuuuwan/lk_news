    "num": "dailyftlk-3aeb1c64",
    "date_str": "2026-08-14",
    "description": "UNFPA and NYSC empower 100 youth to lead local disaster preparedness and response",
    "url_metadata": "https://www.ft.lk/news/UNFPA-and-NYSC-empower-100-youth-to-lead-local-disaster-preparedness-and-response/56-796025",
