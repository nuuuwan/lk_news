    "description": "Husband and mother-in-law charged over Indian bride\u2019s death",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Husband-and-mother-in-law-charged-over-Indian-brides-death/108-348410",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1787118814.0,
    "chunk_id": "2026-08-19-dailymirrorlk-7990f2c7-0000",
