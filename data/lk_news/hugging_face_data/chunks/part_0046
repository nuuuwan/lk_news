    "description": "Pakistan to host Sri Lanka for Tests and T20Is, England for ODI tri-series",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Pakistan-to-host-Sri-Lanka-for-Tests-and-T20Is-England-for-ODI-tri-series/108-348514",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1787216498.0,
    "chunk_id": "2026-08-20-dailymirrorlk-f81dc0d6-0000",
