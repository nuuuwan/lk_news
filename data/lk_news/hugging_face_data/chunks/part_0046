    "description": "Returning refugees and challenges ahead for the govt.",
    "url_metadata": "https://www.dailymirror.lk/opinion/Returning-refugees-and-challenges-ahead-for-the-govt/172-348953",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
