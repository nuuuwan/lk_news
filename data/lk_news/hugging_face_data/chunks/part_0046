    "description": "NCE to lead exporters\u2019 delegation to India to unlock new opportunities",
    "url_metadata": "https://www.ft.lk/business/NCE-to-lead-exporters-delegation-to-India-to-unlock-new-opportunities/34-796438",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1787531346.0,
