    "description": "Korea-backed mineral processing research moves to second phase",
    "url_metadata": "https://www.dailymirror.lk/business/Korea-backed-mineral-processing-research-moves-to-second-phase/215-348564",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1787283756.0,
