    "description": "\u0dba\u0db1\u0dca\u0db1 \u0dc0\u0dd4\u0dab\u0ddc\u0dad\u0dca \u0dba\u0db1\u0dca\u0db1 \u0dbd\u0dd1\u0dc3\u0dca\u0dad\u0dd2\u0dba\u0dd2, \u0db4\u0dcf\u0dc3\u0dca\u0d9a\u0dd4 \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf",
