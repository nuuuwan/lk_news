    "description": "A Pyrrhic Triumph on the Bench",
    "url_metadata": "https://www.dailymirror.lk/opinion/A-Pyrrhic-Triumph-on-the-Bench/172-348077",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1786641954.0,
    "chunk_id": "2026-08-13-dailymirrorlk-0b55fae7-0000",
