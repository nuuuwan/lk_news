    "num": "dailymirrorlk-38563a93",
    "date_str": "2026-08-13",
    "description": "More competition  better  prices \u2013 why the CEP 4 tender risks wasting public money",
    "url_metadata": "https://www.dailymirror.lk/news-features/More-competition-better-prices-why-the-CEP-4-tender-risks-wasting-public-money/131-348078",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1786642217.0,
