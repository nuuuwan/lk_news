    "description": "How Sri Lanka can turn resources into riches",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/How-Sri-Lanka-can-turn-resources-into-riches/108-348988",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1787894842.0,
    "chunk_id": "2026-08-28-dailymirrorlk-8cef0931-0000",
    "chunk_index": 0,
