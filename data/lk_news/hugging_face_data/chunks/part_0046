    "description": "Constitution: How Much Longer Can We Wait?",
    "url_metadata": "https://www.dailymirror.lk/opinion/Constitution-How-Much-Longer-Can-We-Wait/172-349111",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
