    "url_metadata": "https://www.dailymirror.lk/breaking-news/India-must-uphold-water-sharing-treaty-with-Pakistan-international-court-says/108-349165",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1788184641.0,
