    "description": "July tea output falls 1% as medium-grown production drops",
    "url_metadata": "https://www.dailymirror.lk/business/July-tea-output-falls-1-as-medium-grown-production-drops/215-348649",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
