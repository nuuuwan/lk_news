    "description": "Urgent need to fill diplomatic vacancies in key capitals",
    "url_metadata": "https://www.ft.lk/opinion/Urgent-need-to-fill-diplomatic-vacancies-in-key-capitals/14-795982",
    "lang": "en",
    "newspaper_id": "dailyftlk",
