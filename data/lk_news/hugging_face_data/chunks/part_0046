    "description": "Gamma Interpharm enters Cambodia, expands Sri Lanka\u2019s pharmaceutical export footprint",
    "url_metadata": "https://www.ft.lk/business/Gamma-Interpharm-enters-Cambodia-expands-Sri-Lanka-s-pharmaceutical-export-footprint/34-796440",
    "lang": "en",
    "newspaper_id": "dailyftlk",
