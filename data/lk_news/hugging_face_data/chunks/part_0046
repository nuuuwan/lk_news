    "description": "When economic warnings become political weapons",
    "url_metadata": "https://www.dailymirror.lk/opinion/When-economic-warnings-become-political-weapons/172-348881",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1787696487.0,
    "chunk_id": "2026-08-26-dailymirrorlk-b32f9c4b-0001",
