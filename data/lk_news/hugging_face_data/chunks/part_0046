    "description": "Snake undergoes \u2019world-first\u2019 human cancer therapy",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Snake-undergoes-world-first-human-cancer-therapy/108-348603",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1787311693.0,
