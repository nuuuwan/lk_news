    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0bb5\u0bbf\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd-\u0ba4\u0bb5\u0bb1\u0bbe\u0ba9-\u0baa\u0bc1\u0bb1\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bc1-\u0b85\u0ba4\u0bbf\u0bb0\u0bcd\u0bb7\u0bcd\u0b9f\u0bb5\u0b9a\u0bae\u0bbe\u0b95\u0ba4\u0bcd-\u0ba4\u0baa\u0bcd\u0baa\u0bbf\u0baf-\u0bb5\u0bbf\u0baa\u0ba4\u0bcd\u0ba4\u0bc1/50-381304",
