    "description": "Call for stronger fire  resilience in built environment",
    "url_metadata": "https://www.ft.lk/business/Call-for-stronger-fire-resilience-in-built-environment/34-796260",
    "lang": "en",
    "newspaper_id": "dailyftlk",
