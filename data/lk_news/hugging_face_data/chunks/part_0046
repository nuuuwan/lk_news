    "url_metadata": "https://www.ada.lk/breaking_news/\u0db6\u0ddd\u0dc0\u0dad\u0dd0\u0db1\u0dca\u0db1\u0dda-\u0da2\u0dbd\u0dba-\u0dc4\u0dd2\u0dc3\u0dca-\u0d9a\u0dd2\u0dbb\u0dd2\u0db8-\u0dc4\u0dd9\u0da7/11-423876",
