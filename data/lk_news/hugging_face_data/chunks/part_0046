    "description": "Seylan Bank celebrates 294th Pahasara library",
    "url_metadata": "https://www.dailymirror.lk/business/Seylan-Bank-celebrates-294th-Pahasara-library/215-348642",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
