    "description": "\u0bae\u0ba9\u0bbf\u0ba4\u0b95\u0bcd \u0b95\u0bc7\u0b9f\u0baf\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0b9a\u0bcd\u0b9a\u0bbf\u0bb3\u0bae\u0bcd \u0b95\u0bc1\u0bb4\u0ba8\u0bcd\u0ba4\u0bc8\u0b95\u0bb3\u0bcd",
    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0bae\u0ba9\u0bbf\u0ba4\u0b95\u0bcd-\u0b95\u0bc7\u0b9f\u0baf\u0bae\u0bbe\u0b95\u0baa\u0bcd-\u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd-\u0baa\u0b9a\u0bcd\u0b9a\u0bbf\u0bb3\u0bae\u0bcd-\u0b95\u0bc1\u0bb4\u0ba8\u0bcd\u0ba4\u0bc8\u0b95\u0bb3\u0bcd/50-381457",
