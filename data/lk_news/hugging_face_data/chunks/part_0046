    "url_metadata": "https://www.ada.lk/breaking_news/\u0dbb\u0dc0\u0dd3-\u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a-\u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7/11-423976",
