    "description": "Two Borrowers, Two Different Stories",
    "url_metadata": "https://www.dailymirror.lk/opinion/Two-Borrowers-Two-Different-Stories/172-348325",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
