    "chunk_text": "\u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0d87\u0dc3\u0dc5 \u0db8\u0d82\u0d9c\u0dbd\u0dca\u200d\u0dba\u0dba\u0da7 \u0d9a\u0db4\u0dca \u0dc3\u0dd2\u0da7\u0dd4\u0dc0\u0dba\u0dd2\n\n\u0d93\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dd2\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0daf\u0dc5\u0daf\u0dcf \u0db8\u0dcf\u0dbd\u0dd2\u0d9c\u0dcf\u0dc0\u0dda \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dd2\u0d9a \u0d87\u0dc3\u0dc5 \u0db4\u0dd9\u0dbb\u0dc4\u0dd0\u0dbb \u0db8\u0d82\u0d9c\u0dbd\u0dca\u200d\u0dba\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0da0\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba \u0dc0\u0db1 \u0d9a\u0db4\u0dca \u0dc3\u0dd2\u0da7\u0dd4\u0dc0\u0dd3\u0db8 \u0d85\u0daf (13) \u0db4\u0dd9.\u0dc0. 6.17\u0da7 \u0dba\u0dd9\u0daf\u0dd9\u0db1 \u0dc3\u0dd4\u0db6 \u0db1\u0dd0\u0d9a\u0dad\u0da7 \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd9\u0dbb\u0dd2\u0dab.\n\n\u0d89\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0d85\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4 17\u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dcf \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0daf\u0dd2\u0db1 5\u0d9a\u0dca \u0db1\u0dcf\u0dae, \u0dc0\u0dd2\u0dc2\u0dca\u0dab\u0dd4, \u0db4\u0dad\u0dca\u0dad\u0dd2\u0db1\u0dd2 \u0dc4\u0dcf \u0d9a\u0dad\u0dbb\u0d9c\u0db8 \u0dba\u0db1 \u0dc3\u0dd2\u0dc0\u0dca \u0db8\u0dc4\u0dcf \u0daf\u0dda\u0dc0\u0dcf\u0dbd\u0dba\u0db1\u0dca\u0dc4\u0dd2 \u0d85\u0db7\u0dca\u200d\u0dba\u0db1\u0dca\u0dad\u0dbb \u0db4\u0dd9\u0dbb\u0dc4\u0dd0\u0dbb \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dda.\n\n\u0db4\u0dc5\u0db8\u0dd4 \u0d9a\u0dd4\u0db9\u0dbd\u0dca \u0db4\u0dd9\u0dbb\u0dc4\u0dd0\u0dbb \u0d85\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4 18 \u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dcf \u0dc0\u0dd3\u0dae\u0dd2 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0db1 \u0d85\u0dad\u0dbb, \u0d91\u0dad\u0dd0\u0db1\u0dca \u0dc3\u0dd2\u0da7 22\u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dcf \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d91\u0db8 \u0db4\u0dd9\u0dbb\u0dc4\u0dd0\u0dbb \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u