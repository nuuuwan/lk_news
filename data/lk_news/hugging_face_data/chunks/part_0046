    "num": "dailymirrorlk-d7b7c970",
    "date_str": "2026-08-13",
    "description": "Can the NPP implement  the death  penalty  again?",
    "url_metadata": "https://www.dailymirror.lk/opinion/Can-the-NPP-implement-the-death-penalty-again/172-348019",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
