    "date_str": "2026-08-28",
    "description": "Groundwater levels follow seasonal decline in dry-zone areas",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Groundwater-levels-follow-seasonal-decline-in-dry-zone-areas/108-349030",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
