    "description": "President orders faster rollout of Rs.102 b provincial Ditwah projects",
    "url_metadata": "https://www.ft.lk/business/President-orders-faster-rollout-of-Rs-102-b-provincial-Ditwah-projects/34-796439",
    "lang": "en",
    "newspaper_id": "dailyftlk",
