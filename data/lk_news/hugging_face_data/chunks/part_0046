    "description": "INSEE Cement launches Galle training school",
    "url_metadata": "https://www.dailymirror.lk/business-news/INSEE-Cement-launches-Galle-training-school/273-349088",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1788110652.0,
    "chunk_id": "2026-08-30-dailymirrorlk-84ccfc6f-0000",
