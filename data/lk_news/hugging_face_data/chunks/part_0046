    "description": "Uniformity without discrimination: Revisiting the health workers\u2019 dress code",
    "url_metadata": "https://www.ft.lk/columns/Uniformity-without-discrimination-Revisiting-the-health-workers-dress-code/4-796323",
    "lang": "en",
    "newspaper_id": "dailyftlk",
