    "url_metadata": "https://www.dailymirror.lk/breaking-news/Meta-agrees-to-pay-18-billion-to-settle-US-lawsuits-over-childrens-social-media-addiction/108-348943",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
