    "description": "\u0db8\u0dcf\u0dc3 8\u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7 \u0d9c\u0dad\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0dbd\u0d9a\u0dca\u0dc2\u0dba \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dba\u0dd2",
