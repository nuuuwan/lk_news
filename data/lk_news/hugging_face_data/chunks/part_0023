    "description": "\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 \u0db6\u0db3\u0dc0\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dca \u0db1\u0dc0\u0dad\u0dd3 - \u0daf\u0dd9\u0dc3\u0dca \u0dc0\u0dd2\u0daf\u0dd9\u0dc3\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0da9\u0dd4\u0dad\u0dca \u0d85\u0dc0\u0dbd\u0d82\u0d9c\u0dd4\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/213567",
