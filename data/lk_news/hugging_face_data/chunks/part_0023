    "description": "\u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf \u0dbd\u0dd4\u0dab\u0dd4 \u0db8\u0dd2\u0dbd \u0db4\u0dc4\u0dc5\u0da7",
