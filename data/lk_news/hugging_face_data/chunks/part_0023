    "description": "Marine pollution issues relating to nurdles spill in Sri Lanka",
    "url_metadata": "https://www.ft.lk/opinion/Marine-pollution-issues-relating-to-nurdles-spill-in-Sri-Lanka/14-779944",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1754438773.0,
