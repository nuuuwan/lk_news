    "num": "adaderanasinhalalk-189ec685",
    "date_str": "2025-08-15",
    "description": "\u0d85\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 - \u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9c\u0dda \u0dc4\u0db8\u0dd4\u0dc0 \u0d85\u0daf \u0d87\u0dbd\u0dc3\u0dca\u0d9a\u0dcf\u0dc0\u0dda\u0daf\u0dd3",
    "url_metadata": "http://sinhala.adaderana.lk/news/213407",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1755253320.0,
    "chunk_id": "2025-08-15-adaderanasinhalalk-189ec685-0000",
    "chunk_index": 0,
    "language": "si",
