    "url_metadata": "https://www.tamilmirror.lk/\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0baa\u0bb4\u0ba9\u0bbf-\u0b95\u0bbe\u0ba4\u0bb2\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95-\u0b95\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0b95\u0bbf\u0bb2\u0bcd-\u0bb5\u0ba8\u0bcd\u0ba4-\u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8-\u0b87\u0bb3\u0bae\u0bcd\u0baa\u0bc6\u0ba3\u0bcd-\u0bae\u0bc1\u0bb4\u0bc1-\u0bb5\u0bbf\u0baa\u0bb0\u0bae\u0bcd/175-362854",
