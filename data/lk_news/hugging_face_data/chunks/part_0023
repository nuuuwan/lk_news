    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0bae\u0bbe\u0bb5\u0ba9\u0bc6\u0bb2\u0bcd\u0bb2-\u0baf\u0bc1\u0bb5\u0ba4\u0bbf-\u0bae\u0bbe\u0baf\u0bae\u0bcd/76-363127",
