    "description": "\u0d85\u0dad\u0dd4\u0dbb\u0dd4\u0daf\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0d9c\u0dd0\u0db1 \u0db1\u0dc0 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dbd\u0dd2 \u0db1\u0dd0\u0dc4\u0dd0",
    "url_metadata": "http://sinhala.adaderana.lk/news/213326",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1755073680.0,
    "chunk_id": "2025-08-13-adaderanasinhalalk-195e35b2-0000",
