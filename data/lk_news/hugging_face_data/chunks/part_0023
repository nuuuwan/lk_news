    "url_metadata": "https://www.tamilmirror.lk/cinema/\u0b87\u0ba4\u0bc8-\u0bae\u0bb1\u0bc8\u0b95\u0bcd\u0b95\u0ba4\u0bcd-\u0ba4\u0bbe\u0ba9\u0bcd-\u0b85\u0ba8\u0bcd\u0ba4-\u0b9a\u0bbf\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1/54-362256",
