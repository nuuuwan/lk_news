    "description": "\u0db4\u0dca\u200d\u0dbb\u0db8\u0dd2\u0dad\u0dd2\u0dba \u0dad\u0dc4\u0dc0\u0dd4\u0dbb\u0dd4 \u0db1\u0ddc\u0d9a\u0dc5 \u0d9c\u0dd1\u0dc3\u0dca \u0d8b\u0db3\u0dd4\u0db1\u0dca \u0dad\u0ddc\u0d9c\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0d86\u0dba\u0dad\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0da7\u0dbd\u0dba\u0dd2",
