    "url_metadata": "https://www.ada.lk/breaking_news/\u0da2\u0dcf\u0dad\u0dd2\u0d9a-\u0db0\u0dd3\u0dc0\u0dbb-\u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf-\u0dc3\u0d82\u0d9c\u0dab\u0db1\u0dba-\u0d85\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4-20-\u0daf\u0d9a\u0dca\u0dc0\u0dcf/11-417742",
