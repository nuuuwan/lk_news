    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b9a\u0bc0\u0ba4\u0bc8-\u0b85\u0bae\u0bcd\u0bae\u0ba9\u0bcd-\u0b86\u0bb2\u0baf-\u0bae\u0ba3\u0bcd\u0b9f\u0baa-\u0ba4\u0bbf\u0bb1\u0baa\u0bcd\u0baa\u0bc1-\u0bb5\u0bbf\u0bb4\u0bbe/76-362255",
