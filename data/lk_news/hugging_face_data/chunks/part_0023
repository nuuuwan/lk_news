    "description": "Occupational exposure to GenAI in Sri Lanka",
    "url_metadata": "https://economynext.com/occupational-exposure-to-genai-in-sri-lanka-237222/",
    "lang": "en",
    "newspaper_id": "economynextcom",
    "time_ut": 1755581400.0,
    "chunk_id": "2025-08-19-economynextcom-e9114cf3-0000",
