    "description": "Against national policy on reconciliation: Tamil perspective",
    "url_metadata": "https://www.ft.lk/opinion/Against-national-policy-on-reconciliation-Tamil-perspective/14-780536",
    "lang": "en",
    "newspaper_id": "dailyftlk",
