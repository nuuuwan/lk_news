    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0bb9\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1-\u0b9c\u0bc0\u0bb5\u0ba9\u0bcd-\u0b86\u0ba4\u0bb0\u0bb5\u0bc1/76-362689",
