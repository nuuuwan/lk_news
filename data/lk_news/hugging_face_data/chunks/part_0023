    "url_metadata": "https://www.ft.lk/business/Swisstek-Aluminium-pledges-to-deliver-Sri-Lanka-s-most-reliable-solar-mounting-systems/34-779919",
    "lang": "en",
    "newspaper_id": "dailyftlk",
