    "url_metadata": "https://www.adaderana.lk/news/111342/pdexcil-to-strengthen-trade-ties-between-india-and-sri-lanka",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1754841360.0,
