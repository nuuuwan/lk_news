    "description": "Parliamentary Business Committee to discuss no-confidence motion today",
    "url_metadata": "https://www.adaderana.lk/news/111697/parliamentary-business-committee-to-discuss-no-confidence-motion-today",
    "lang": "en",
    "newspaper_id": "adaderanalk",
