    "num": "dailyftlk-9c54a5ab",
    "date_str": "2025-08-14",
    "description": "Trumpeting Trump\u2019s tariff",
    "url_metadata": "https://www.ft.lk/columns/Trumpeting-Trump-s-tariff/4-780246",
