    "description": "Vidullanka commissions 2 MW solar project in Horana",
    "url_metadata": "https://www.ft.lk/business/Vidullanka-commissions-2-MW-solar-project-in-Horana/34-780479",
    "lang": "en",
    "newspaper_id": "dailyftlk",
