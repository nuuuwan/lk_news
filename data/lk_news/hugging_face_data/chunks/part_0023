    "description": "Air Canada grounded as striking union defies order to get back to work",
    "url_metadata": "https://www.adaderana.lk/news/111570/air-canada-grounded-as-striking-union-defies-order-to-get-back-to-work",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1755495600.0,
