    "description": "CSF launches new policy brief on Trade Policy Uncertainty and Impacts on Exporters",
    "url_metadata": "https://www.ft.lk/business/CSF-launches-new-policy-brief-on-Trade-Policy-Uncertainty-and-Impacts-on-Exporters/34-780110",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1754871692.0,
