    "description": "How inclusive design strategies can transform Sri Lankan banking experience",
    "url_metadata": "https://www.ft.lk/columns/How-inclusive-design-strategies-can-transform-Sri-Lankan-banking-experience/4-780244",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1755130380.0,
