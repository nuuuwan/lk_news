    "description": "\u0dc4\u0d82\u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dda \u0dc0\u0dd9\u0da9\u0dd2\u0dad\u0dd0\u0db6\u0dd3\u0db8 '\u0db6\u0db1\u0dcf \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3' \u0d9d\u0dcf\u0dad\u0db1\u0dba\u0da7 \u0db4\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0dca - \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2 \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4\u0dad\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0dbd\u0dcf",
