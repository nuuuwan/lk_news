    "chunk_text": "\u0dbd\u0ddd\u0d9a \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0daf\u0dd2\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0db8\u0dca \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca\n\n\u0dbd\u0ddd\u0d9a \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0daf\u0dd2\u0db1\u0dba \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dd9\u0dbb\u0dd4\u0dab\u0dd4 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0db8\u0dca \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0dbb \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0d85\u0daf (09) \u0db4\u0dd9\u0dbb\u0dc0\u0dbb\u0dd4\u0dc0\u0dda \u0daf\u0db9\u0dcf\u0db1 \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0d9a\u0dde\u0dad\u0dd4\u0d9a\u0dcf\u0d9c\u0dcf\u0dbb \u0db4\u0dbb\u0dd2\u0dc1\u0dca\u200d\u0dbb\u0dba\u0dda \u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dab\u0dd2.\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0db1\u0dcf\u0dba\u0d9a, \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2 \u0dc0\u0db1\u0dc3\u0dca\u0db4\u0dad\u0dd2 \u0d8c\u0dbb\u0dd4\u0dc0\u0dbb\u0dd2\u0d9c\u0dda \u0dc0\u0db1\u0dca\u0db1\u0dd2\u0dba\u0dbd\u0dd0\u0dad\u0dca\u0dad\u0ddd 1996 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0da2\u0dd2\u0db1\u0dd3\u0dc0\u0dcf\u0dc4\u0dd2 \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0dc3\u0db8\u0dd4\u0dc5\u0dd4\u0dc0\u0da7 \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd3 \u0dc0\u0dd3\u0db8\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0dbd\u0ddd\u0d9a \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0daf\u0dd2\u0db1 \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0db8\u0dca \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dad\u0dd4\u0dc5 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0dda \u0d9a\u0dad\u0dd2\u0d9a\u0dcf\u0dc0 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd9\u0dbb\u0dd4\u0dab\u0dd4 \u0d85\u0dad\u0dbb \u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0daf\u0dd2\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0db8\u0dca \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba 1999 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0d9a\u0ddc\u0dc5\u0db9 \u0dc0\u0dd2\u0dc4\u0dcf\u0dbb \u0db8\u0dc4\u0dcf \u0daf\u0dda\u0dc0\u0dd2 \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0db1\u0dba\u0dda\u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0dc3\u0dc4 \u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0d86\u0dba\u0dad\u0db1 \u0d91\u0d9a\u0dca\u0dc0 \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0daf\u0dd2\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0dd0\u0db8\u0dbb\u0dd4\u0db8\u0dca \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0dc0\u0dd2\u0da0\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dad\u0dca \u0d85\u0dba\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd4 \u0d85\u0dad\u0dbb, \u0dc3\u0dcf\u0db8\u0dba \u0dc3\u0dc4 \u0dc3\u0dde\u0db7\u0dcf\u0d9c\u0dca\u200d\u0dba\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0d86\u0dc1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0daf \u0d9a\u0dd9\u0dbb\u0dd9\u0db1 \u0dc3\u0dcf\u0db8\u0dca\u0db4\u0dca\u200d\u0dbb\u0daf\u0dcf\u0dba\u0dd2\u0d9a \u0d9a\u0dd2\u0dbb\u0dd2 \u0d9a\u0ddc\u0dbb\u0dc4\u0dcf \u0da0\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dbb\u0dba \u0d89\u0da7\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0d86\u0daf\u0dd2\u0dc0\u0dcf\u0dc3\u0dd3 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0da7 \u0d86\u0dc0\u0dda\u0dab\u0dd2\u0d9a \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dad\u0dd2\u0d9a\u0dcf\u0d82\u0d9c \u0dbb\u0dd0\u0dc3\u0d9a\u0dd2\u0db1\u0dca \u0db8\u0dd9\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dc0\u0dbb\u0dca\u0dab\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dba."
