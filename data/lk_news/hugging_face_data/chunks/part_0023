    "description": "\u0b86\u0bb3\u0bc1\u0bae\u0bcd \u0b95\u0b9f\u0bcd\u0b9a\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b92\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bc8 ?",
    "url_metadata": "https://www.virakesari.lk/article/222705",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1755403920.0,
    "chunk_id": "2025-08-17-virakesarilk-0cf1e6e0-0000",
    "chunk_index": 0,
