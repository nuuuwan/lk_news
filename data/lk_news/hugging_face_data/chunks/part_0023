    "description": "Former Deputy Director of Prison Hospital further remanded",
    "url_metadata": "https://www.adaderana.lk/news/111631/former-deputy-director-of-prison-hospital-further-remanded",
    "lang": "en",
    "newspaper_id": "adaderanalk",
