    "description": "Rhino launches \u2018Rhino Premier\u2019: Game-changer in roofing innovation",
    "url_metadata": "https://www.ft.lk/business/Rhino-launches-Rhino-Premier-Game-changer-in-roofing-innovation/34-780514",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1755689119.0,
    "chunk_id": "2025-08-20-dailyftlk-a93f5b35-0000",
    "chunk_index": 0,
