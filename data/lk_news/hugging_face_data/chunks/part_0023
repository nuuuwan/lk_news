    "description": "India, Sri Lanka to conduct Navy exercise SLINEX-2025",
    "url_metadata": "https://economynext.com/india-sri-lanka-to-conduct-navy-exercise-slinex-2025-235798/",
    "lang": "en",
    "newspaper_id": "economynextcom",
