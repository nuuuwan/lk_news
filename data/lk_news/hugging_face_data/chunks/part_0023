    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b95\u0b9a\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b9f\u0ba9\u0bcd-\u0bae\u0bbe\u0bae\u0bbf\u0baf\u0bbe\u0bb0\u0bcd-\u0bae\u0bb0\u0bc1\u0bae\u0b95\u0bb3\u0bcd-\u0b95\u0bc8\u0ba4\u0bc1/76-362439",
