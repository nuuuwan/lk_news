    "description": "PRISL announces two landmark events to elevate polymer sector",
    "url_metadata": "https://www.ft.lk/business/PRISL-announces-two-landmark-events-to-elevate-polymer-sector/34-779851",
    "lang": "en",
    "newspaper_id": "dailyftlk",
