    "date_str": "2025-08-04",
    "description": "Prime Minister vows no obstruction to student protests",
    "url_metadata": "https://www.ft.lk/news/Prime-Minister-vows-no-obstruction-to-student-protests/56-779857",
    "lang": "en",
    "newspaper_id": "dailyftlk",
