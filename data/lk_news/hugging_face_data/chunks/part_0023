    "chunk_text": "\u0da0\u0dd3\u0db1\u0dba\u0dda \u0dc0\u0dd0\u0dbd\u0dca \u0db4\u0dcf\u0dbd\u0db8\u0d9a\u0dca \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0da7\u0dd3 \u0db4\u0dc3\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0db8\u0dbb\u0dd4\u0da7\n\n\u0dc0\u0dba\u0db9\u0daf\u0dd2\u0d9c \u0da0\u0dd3\u0db1\u0dba\u0dda \u0dc2\u0dd2\u0db1\u0dca\u0da2\u0dd2\u0dba\u0dd0\u0d82 \u0db4\u0dc5\u0dcf\u0dad\u0dda \u0d91\u0dbd\u0dca\u0dbd\u0dd9\u0db1 \u0db4\u0dcf\u0dbd\u0db8\u0d9a \u0d9a\u0dda\u0db6\u0dbd\u0dba\u0d9a\u0dca \u0d9a\u0dd0\u0da9\u0dd3 \u0dba\u0dcf\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0db8\u0dd2\u0dba \u0d9c\u0ddc\u0dc3\u0dca \u0dad\u0dd2\u0db6\u0dda.\n\n\u0d91\u0dc4\u0dd2\u0daf\u0dd2 \u0dad\u0dc0\u0dad\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dd2\u0db1\u0dca 24 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dad\u0dd4\u0dc0\u0dcf\u0dbd \u0dbd\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc0\u0dd2\u0daf\u0dd9\u0dc3\u0dca \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0dc2\u0dd2\u0db1\u0dca\u0da2\u0dd2\u0dba\u0dd0\u0d82 \u0dc4\u0dd2 \u0da0\u0dd3\u0db1\u0dba\u0dda \u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dd3\u0dba \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a \u0d9a\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0db1 \u0dc2\u0dd2\u0dba\u0dcf\u0da7\u0dcf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda \u0db8\u0dd9\u0db8 \u0d85\u0db1\u0dad\u0dd4\u0dbb \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0d87\u0dad.\n\n\u0db4\u0dcf\u0dbd\u0db8\u0dda \u0d9a\u0dda\u0db6\u0dbd\u0dba \u0d9a\u0dd0\u0da9\u0dd3\u0dba\u0dcf\u0db8\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0db4\u0dcf\u0dbd\u0db8 \u0d91\u0d9a\u0dca \u0db4\u0dd0\u0dad\u0dca\u0dad\u0d9a\u0da7 \u0d87\u0dbd\u0dc0\u0dd3 \u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0dc3\u0d82