    "description": "Pulse of a nation: Why tax compliance is a collective heartbeat",
    "url_metadata": "https://www.ft.lk/columns/Pulse-of-a-nation-Why-tax-compliance-is-a-collective-heartbeat/4-780211",
    "lang": "en",
    "newspaper_id": "dailyftlk",
