    "date_str": "2025-08-12",
    "description": "US, China extend tariff truce by 90 days, staving off surge in duties",
    "url_metadata": "https://www.adaderana.lk/news/111409/us-china-extend-tariff-truce-by-90-days-staving-off-surge-in-duties",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1755006900.0,
    "chunk_id": "2025-08-12-adaderanalk-c0c71953-0000",
    "chunk_index": 0,
