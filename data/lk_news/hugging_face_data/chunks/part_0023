    "description": "\u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb \u0db4\u0dbb\u0dd2\u0db4\u0dd6\u0dbb\u0d9a \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0dc3\u0dda\u0dc0\u0dcf \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dba\u0ddd \u0dc0\u0dbb\u0dca\u0da2\u0db1\u0dba\u0dda - \u0dad\u0dd0\u0db4\u0dd1\u0dbd \u0dc3\u0dd2\u0dc0\u0dca\u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0da7\u0dad\u0dca",
