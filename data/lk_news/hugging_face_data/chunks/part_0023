    "description": "Sri Lanka makes strides in prevention and care of cervical cancer",
    "url_metadata": "https://www.adaderana.lk/news/111290/sri-lanka-makes-strides-in-prevention-and-care-of-cervical-cancer",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1754660040.0,
    "chunk_id": "2025-08-08-adaderanalk-c2c643ed-0000",
