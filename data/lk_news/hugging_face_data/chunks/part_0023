    "description": "COYLE, JETRO kick-off Sri Lankan Corporate Health and Productivity Awards 2025",
    "url_metadata": "https://www.ft.lk/business/COYLE-JETRO-kick-off-Sri-Lankan-Corporate-Health-and-Productivity-Awards-2025/34-780307",
    "lang": "en",
    "newspaper_id": "dailyftlk",
