    "description": "Rising sons: Namal Rajapaksa, Sajith Premadasa  and the Opposition project",
    "url_metadata": "https://www.ft.lk/columns/Rising-sons-Namal-Rajapaksa-Sajith-Premadasa-and-the-Opposition-project/4-780250",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1755132274.0,
    "chunk_id": "2025-08-14-dailyftlk-b98555fd-0000",
