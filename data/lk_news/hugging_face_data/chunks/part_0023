    "description": "SDF and partners launch regional AquaLivelihood Project to empower small-scale fish farmers and bolster nutrition security in South Asia",
    "url_metadata": "https://www.ft.lk/business/SDF-and-partners-launch-regional-AquaLivelihood-Project-to-empower-small-scale-fish-farmers-and-bolster-nutrition-security-in-South-Asia/34-780032",
    "lang": "en",
    "newspaper_id": "dailyftlk",
