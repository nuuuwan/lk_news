    "chunk_text": "\"\u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dba\u0dd9\u0db1\u0dca\u0db8 \u0db8\u0dda \u0db4\u0dd4\u0d82\u0da0\u0dd2 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca. \u0db8\u0dda \u0db4\u0dd4\u0d82\u0da0\u0dd2 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0dda \u0dc5\u0db8\u0dcf \u0d9a\u0dcf\u0dbd\u0dba \u0dc3\u0dad\u0dd4\u0da7\u0dd2\u0db1\u0dca \u0d9c\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0 \u0dc3\u0dbd\u0dc3\u0dcf \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d95\u0db1\u0dda. 05 \u0dc1\u0dd2\u0dc2\u0dca\u200d\u0dba\u0dad\u0dca\u0dc0 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba \u0d9a\u0dd2\u0dba\u0db1 \u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0db8\u0dad\u0db8 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0db0\u0dd2\u0d9a \u0dbd\u0dd9\u0dc3 \u0db4\u0dd3\u0da9\u0db1\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8 \u0dc0\u0dc5\u0d9a\u0dca\u0dc0\u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0d91\u0d9a \u0d85\u0db4\u0dd2 \u0dc4\u0dd0\u0db8 \u0daf\u0dd9\u0db1\u0dcf\u0d9c\u0dda\u0db8 \u0dc0\u0d9c\u0d9a\u0dd3\u0db8\u0d9a\u0dca. \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0db8\u0db1\u0dca\u0d9c\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba\u0da7 \u0db4\u0dd9\u0db1\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dc0\u0dcf. \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0dc0\u0dd9\u0db1\u0dc3\u0dca \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0d82\u0dc3\u0db1\u0dca\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d85\u0daf \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba\u0da7 \u0dbd\u0dd2\u0dc0\u0dca\u0dc0\u0dda \u0db8\u0ddc\u0db1\u0dc0\u0dcf\u0daf?, \u0d92 \u0d8b\u0dad\u0dca\u0dad\u0dbb \u0db1\u0dd0\u0dc0\u0dad \u0dc4\u0ddc\u0dba\u0dbd\u0dcf \u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d8b\u0dad\u0dca\u0dad\u0dbb \u0dbd\u0dd2\u0dba\u0dbd\u0dcf \u0db1\u0db8\u0dca \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0db6\u0db1\u0dd2\