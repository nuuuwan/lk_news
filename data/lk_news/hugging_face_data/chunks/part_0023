    "description": "Gautam Adani steps down from executive role at ports unit",
    "url_metadata": "https://www.adaderana.lk/news/111226/gautam-adani-steps-down-from-executive-role-at-ports-unit",
    "lang": "en",
    "newspaper_id": "adaderanalk",
