    "url_metadata": "https://www.ada.lk/breaking_news/\u0d89\u0db1\u0dca\u0daf\u0dd3\u0dba-\u0dba\u0dd4\u0daf-\u0db1\u0dde\u0d9a\u0dcf-\u0daf\u0dd9\u0d9a\u0d9a\u0dca-\u0d9a\u0ddc\u0dc5\u0db9\u0da7/11-417937",
