    "url_metadata": "https://www.lankadeepa.lk/friday/\u0dbd\u0d9a\u0dba-\u0db8\u0daf-\u0dbd\u0d9a\u0dc0-\u0dc4\u0daf\u0d9a\u0dbd-\u0dc0\u0db8/122-681062",
