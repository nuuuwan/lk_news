    "description": "President opens Somawathi Archaeological Museum, International Archaeological Research Institute",
    "url_metadata": "https://www.ft.lk/news/President-opens-Somawathi-Archaeological-Museum-International-Archaeological-Research-Institute/56-782661",
    "lang": "en",
    "newspaper_id": "dailyftlk",
