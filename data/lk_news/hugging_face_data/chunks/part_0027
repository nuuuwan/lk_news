    "description": "Save Mandaitivu: Call to protect SL\u2019s blue carbon treasure",
    "url_metadata": "https://www.ft.lk/opinion/Save-Mandaitivu-Call-to-protect-SL-s-blue-carbon-treasure/14-783009",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1760490159.0,
    "chunk_id": "2025-10-15-dailyftlk-c2d69e06-0000",
    "chunk_index": 0,
