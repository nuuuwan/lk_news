    "description": "Landscaping of areas bordering Kadawatha Mirigama Highway",
    "url_metadata": "http://island.lk/landscaping-of-areas-bordering-kadawatha-mirigama-highway/",
    "lang": "en",
    "newspaper_id": "islandlk",
