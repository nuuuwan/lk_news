    "url_metadata": "https://www.lankadeepa.lk/news/\u0db8\u0dc4\u0db1\u0daf-\u0d9a\u0dad\u0db1\u0d9c-\u0d9c\u0dab-\u0d9a\u0dba\u0dba/101-681266",
