    "chunk_text": "\u0daf\u0dd3\u0db4\u0dc0\u0dcf\u0dbd\u0dd2\u0dba\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0db6\u0dc3\u0dca\n\n\u0daf\u0dd3\u0db4\u0dc0\u0dcf\u0dbd\u0dd3 \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dad\u0dd2 \u0d85\u0db1\u0dca\u0dad\u0dda \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0db6\u0dc3\u0dca \u0dbb\u0dae \u0dba\u0ddc\u0daf\u0dcf \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba \u0d9a\u0dbb\u0dba\u0dd2.\n\n\u0dc0\u0dd0\u0da9\u0dd2\u0db4\u0dd4\u0dbb \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4\u00a0 \u0d85\u0dba \u0d9a\u0dbb\u0db1 \u0db6\u0dc3\u0dca \u0dbb\u0dae \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0daf\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0db1\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db6\u0dc0\u0daf \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0dba\u0dd2."
  },
