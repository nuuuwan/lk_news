    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d8b\u0dc3\u0dc0\u0dba-\u0db8\u0d9c\u0dc4\u0dbb-\u0dc3\u0dbb\u0d9a\u0dbb\u0dc0\u0d9a-\u0db8\u0da7\u0da7/1-681496",
