    "url_metadata": "https://www.ft.lk/news/Navy-seizes-839-kg-haul-of-drugs-drifting-in-southern-seas/56-783065",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1760573502.0,
