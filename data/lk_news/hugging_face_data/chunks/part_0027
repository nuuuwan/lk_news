    "url_metadata": "http://island.lk/ceylon-agro-food-technologies-cultivating-solutions-for-sri-lankas-agri-crisis/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1760273820.0,
    "chunk_id": "2025-10-12-islandlk-536cd4fe-0000",
