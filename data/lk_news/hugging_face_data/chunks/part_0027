    "url_metadata": "https://www.lankadeepa.lk/news/\u0daf\u0db1\u0d9a\u0da7-\u0dc4\u0dba\u0d9a-\u0d91\u0dbd\u0dc0-\u0dba\u0dad/101-681150",
