    "description": "\u0dbd\u0dd6\u0db1\u0dd4 \u0db8\u0dd2\u0dbd\u0da7 \u0dc4\u0dac\u0db1 \u0d9c\u0ddc\u0dc0\u0dd3\u0dc4\u0dd4",
