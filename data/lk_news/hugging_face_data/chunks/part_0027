    "description": "\u0d87\u0d9f\u0dd2\u0dbd\u0dd2 \u0dc3\u0da7\u0dc4\u0db1\u0dca \u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2\u0dc0 \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0dc3\u0dda\u0dc0\u0d9a\u0dba\u0db1\u0dca\u0da7 2024\u0daf\u0dd3 \u0dbb\u0dd4. \u0d9a\u0ddd\u0da7\u0dd2 3971\u0d9a \u0d85\u0dad\u0dd2\u0d9a\u0dcf\u0dbd \u0dc4\u0dcf \u0db1\u0dd2\u0dc0\u0dcf\u0da9\u0dd4 \u0daf\u0dd2\u0db1 \u0dc0\u0dd0\u0da7\u0dd4\u0db4\u0dca \u0d9c\u0dd9\u0dc0\u0dbd\u0dcf",
