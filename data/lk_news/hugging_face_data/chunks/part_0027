    "description": "\u0db1\u0dd2\u0dbd\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dda \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dca \u0d9c\u0dc3\u0dcf\u0db1 \u0dba\u0dad\u0dd2",
