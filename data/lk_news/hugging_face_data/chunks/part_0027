    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0dad\u0dc3\u0db6-\u0d9a\u0dc0\u0da7\u0dba\u0dad-\u0d89\u0db1\u0db1-\u0d95\u0db1/1-680951",
