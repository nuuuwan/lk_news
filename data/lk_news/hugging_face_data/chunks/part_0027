    "description": "\u0bb0\u0bc2.4 \u0b87\u0bb2\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bc8 \u0b95\u0b9f\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1 \u0ba4\u0b99\u0bcd\u0b95 \u0bb5\u0bbf\u0bb2\u0bc8",
    "url_metadata": "https://www.virakesari.lk/article/227962",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1760682180.0,
