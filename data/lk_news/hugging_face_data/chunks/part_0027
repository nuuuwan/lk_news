    "description": "The UNHRC\u2019s continuing assault on Sri Lanka: A way forward",
    "url_metadata": "http://island.lk/the-unhrcs-continuing-assault-on-sri-lanka-a-way-forward/",
    "lang": "en",
    "newspaper_id": "islandlk",
