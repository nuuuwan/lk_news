    "description": "\u0db6\u0dc4\u0dcf\u0dbd\u0dd4\u0db8\u0dca \u0d85\u0dc0\u0dd4\u0dbd \u0dc4\u0dd9\u0dcf\u0dba\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0\u0d9a\u0dca",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db6\u0dc4\u0dbd\u0db8-\u0d85\u0dc0\u0dbd-\u0dc4\u0dba\u0db1\u0db1-\u0dc0\u0dc1\u0dc2-\u0d9a\u0dbb\u0d9a-\u0dc3\u0db7\u0dc0\u0d9a/1-680879",
