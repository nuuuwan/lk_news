    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0dc4\u0db1\u0dc0\u0dbb-\u0db4\u0dad\u0dad\u0d9a\u0da7-\u0dc4\u0da7-\u0dc0\u0dad\u0dbb-\u0d9a\u0db4\u0dba/1-681249",
