    "description": "\u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2\u0db1\u0dd3 \u0d89\u0db1\u0dca\u0daf\u0dd3\u0dba \u0dc0\u0dcf\u0dab\u0dd2\u0da2 \u0db8\u0dab\u0dca\u0da9\u0dbd \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba\u0dd2\u0db1\u0dca \u0dc4\u0db8\u0dd4\u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0d85\u0d9c\u0db8\u0dad\u0db1-\u0d89\u0db1\u0daf\u0dba-\u0dc0\u0dab\u0da2-\u0db8\u0dab\u0da9\u0dbd-\u0db1\u0dba\u0da2\u0dad\u0dba\u0db1-\u0dc4\u0db8\u0dc0\u0dba/101-681541",
