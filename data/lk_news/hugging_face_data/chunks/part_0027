    "description": "\u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db1\u0d9c\u0dbb\u0dc3\u0db7\u0dcf \u0db4\u0d9a\u0dca\u0dc2 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4 \u0dc0\u0dd2\u0dbb\u0ddd\u0db0\u0dba\u0d9a",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0dc4\u0dbb\u0d9c\u0db8-\u0db1\u0d9c\u0dbb\u0dc3\u0db7-\u0db4\u0d9a\u0dc2-\u0dc0\u0db4\u0d9a\u0dc2-\u0db8\u0db1\u0dad\u0dbb\u0dc0\u0dbb-\u0dc0\u0dbb\u0db0\u0dba\u0d9a/1-680980",
