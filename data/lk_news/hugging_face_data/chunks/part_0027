    "url_metadata": "https://www.lankadeepa.lk/news/\u0dba\u0dad\u0dbb-\u0db4\u0daf-\u0dc3\u0dbb-\u0d9a\u0dbd\u0dbd\u0dba\u0d9a-\u0d9a\u0db1\u0dad\u0dc0\u0db1-\u0daf\u0d9a\u0d9a-\u0d87\u0dad\u0dc5-11\u0d9a-\u0d85\u0dbd\u0dbd\u0dba/101-680974",
