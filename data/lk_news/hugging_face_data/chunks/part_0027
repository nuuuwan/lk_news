    "url_metadata": "https://www.ada.lk/business/HUTCH---NSBM-\u0d85\u0dad\u0dbb-\u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1--\u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd3\u0dba-\u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1-\u0dc3\u0dc4\u0dba\u0ddd\u0d9c\u0dd3\u0dad\u0dcf\u0dc0\u0d9a\u0dca/7-419161",
