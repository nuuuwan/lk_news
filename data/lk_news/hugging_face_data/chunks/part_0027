    "description": "UB40 concert \u2026 absolutely magical",
    "url_metadata": "http://island.lk/ub40-concert-absolutely-magical/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1760551500.0,
    "chunk_id": "2025-10-15-islandlk-3fdffa9f-0000",
