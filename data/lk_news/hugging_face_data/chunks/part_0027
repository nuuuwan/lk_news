    "description": "\u0d89\u0dbb\u0dcf\u0db1 \u0dad\u0dd9\u0dbd\u0dca \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0daf\u0dd4\u0db1\u0dca \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0dca 2\u0d9a\u0da7 \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db6\u0dcf\u0db0\u0d9a",
