    "description": "\u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0db4\u0dc4\u0dad\u0dbb\u0da7 \u0dc0\u0dd0\u0dc0\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0d9c\u0ddc\u0dc0\u0dd3\u0db1\u0dca \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a",
