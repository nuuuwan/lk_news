    "description": "\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0d85\u0db4\u0db1\u0dba\u0db1 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8 \u0d9c\u0dd0\u0db1 \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0db1 \u0dc0\u0dd0\u0da9\u0db8\u0dd4\u0dc5\u0dd4\u0dc0",
