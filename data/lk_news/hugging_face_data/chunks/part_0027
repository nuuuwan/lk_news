    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d85\u0db8\u0dad\u0dba\u0dc1-\u0daf\u0d9a\u0d9a\u0da7-\u0db1\u0dc0-\u0dbd\u0d9a\u0db8\u0dc0\u0dbb/1-681423",
