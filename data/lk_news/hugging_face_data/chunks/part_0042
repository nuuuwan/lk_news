    "doc_id": "2026-06-03-dailyftlk-4bcda303",
    "num": "dailyftlk-4bcda303",
    "date_str": "2026-06-03",
    "description": "Tax: Four stories, one nation",
    "url_metadata": "https://www.ft.lk/columns/Tax-Four-stories-one-nation/4-792816",
