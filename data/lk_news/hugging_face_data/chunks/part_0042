    "url_metadata": "https://www.dailymirror.lk/business-news/Sysco-wins-Newsweeks-2026-AI-Impact-Award-for-AI-Brand-Retail-Excellence/273-341911",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1780506201.0,
    "chunk_id": "2026-06-03-dailymirrorlk-589c4c9c-0000",
    "chunk_index": 0,
