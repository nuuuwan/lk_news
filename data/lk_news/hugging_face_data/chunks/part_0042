    "url_metadata": "https://www.ft.lk/business/Ceylinco-Life-partners-with-FTZMA-as-insurance-service-provider/34-792940",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1780685400.0,
