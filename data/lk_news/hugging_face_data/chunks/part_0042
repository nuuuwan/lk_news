    "description": "\u0bae\u0ba9\u0bc8\u0bb5\u0bbf\u0baf\u0bc8 \u0b95\u0bca\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0b95\u0ba3\u0bb5\u0ba9\u0bcd",
    "url_metadata": "https://www.tamilmirror.lk/\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0bae\u0ba9\u0bc8\u0bb5\u0bbf\u0baf\u0bc8-\u0b95\u0bca\u0bb3\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf-\u0b95\u0ba3\u0bb5\u0ba9\u0bcd/175-378204",
    "lang": "ta",
    "newspaper_id": "tamilmirrorlk",
