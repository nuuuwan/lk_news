    "url_metadata": "https://www.dailymirror.lk/breaking-news/Sooryavanshi-sweeps-IPL-awards-but-is-too-young-to-drive-prize/108-341679",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
