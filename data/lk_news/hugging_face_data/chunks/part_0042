    "description": "Borrowed credibility is a bridge, not a destination",
    "url_metadata": "https://www.ft.lk/columns/Borrowed-credibility-is-a-bridge-not-a-destination/4-792750",
    "lang": "en",
    "newspaper_id": "dailyftlk",
