    "num": "colombotelegraphcom-00dd0aa7",
    "date_str": "2026-06-06",
    "description": "They Burned The Library, Not The Knowledge: From Jaffna Library To Noolaham",
    "url_metadata": "https://www.colombotelegraph.com/index.php/they-burned-the-library-not-the-knowledge-from-jaffna-library-to-noolaham/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
