    "description": "IBCSL to lead delegation to 4th China-South Asia Standardisation Cooperation Conference in Chengdu",
    "url_metadata": "https://www.ft.lk/business/IBCSL-to-lead-delegation-to-4th-China-South-Asia-Standardisation-Cooperation-Conference-in-Chengdu/34-792787",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1780367337.0,
