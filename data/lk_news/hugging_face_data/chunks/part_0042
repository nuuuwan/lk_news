    "description": "\u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0dc0\u0d82\u0da0\u0dcf \u0db8\u0dd0\u0dac\u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0d85\u0d82\u0dc1\u0dba \u0dc3\u0db1\u0dca\u0db1\u0daf\u0dca\u0db0\u0dba\u0dd2 - SLBA",
