    "description": "Is power devolution under JVP-NPP a political daydream?",
    "url_metadata": "http://island.lk/is-power-devolution-under-jvp-npp-a-political-daydream/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1780751880.0,
