    "url_metadata": "https://www.dailymirror.lk/breaking-news/Unsafe-food-kills-1-5-million-people-each-year-children-most-at-risk-WHO/108-341976",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1780559750.0,
