    "doc_type": "lk_news",
    "doc_id": "2026-06-06-islandlk-5e0f727f",
    "num": "islandlk-5e0f727f",
    "date_str": "2026-06-06",
    "description": "Aren\u2019t We All Cockroaches?",
    "url_metadata": "http://island.lk/arent-we-all-cockroaches/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1780753260.0,
    "chunk_id": "2026-06-06-islandlk-5e0f727f-0001",
