    "url_metadata": "https://www.dailymirror.lk/breaking-news/Social-media-used-to-target-youth-with-prohibited-tobacco-products/108-342393",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1780986080.0,
