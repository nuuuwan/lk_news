    "description": "\u0dc0\u0dd9\u0dc3\u0d9a\u0dca \u0d8b\u0dad\u0dca\u0dc3\u0dc0 \u0dc3\u0db8\u0dba\u0dda \u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0d91\u0dc5\u0dc0\u0dbd\u0dd4 \u0db8\u0dd2\u0dbd \u0db4\u0dc4\u0dc5\u0da7",
