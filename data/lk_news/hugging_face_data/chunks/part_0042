    "description": "Unlocking Sri Lanka\u2019s full economic potential by leveraging human capital",
    "url_metadata": "https://www.ft.lk/columns/Unlocking-Sri-Lanka-s-full-economic-potential-by-leveraging-human-capital/4-792999",
    "lang": "en",
    "newspaper_id": "dailyftlk",
