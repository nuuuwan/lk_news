    "description": "Govt. seeks to fast-track industrial investment through environmental reforms",
    "url_metadata": "https://www.dailymirror.lk/business-news/Govt-seeks-to-fast-track-industrial-investment-through-environmental-reforms/273-342451",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
