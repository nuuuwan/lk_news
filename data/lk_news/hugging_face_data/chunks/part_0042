    "description": "Cabinet directs Legal Draftsman to prepare Digital Economy Bill",
    "url_metadata": "https://www.ft.lk/news/Cabinet-directs-Legal-Draftsman-to-prepare-Digital-Economy-Bill/56-793112",
    "lang": "en",
    "newspaper_id": "dailyftlk",
