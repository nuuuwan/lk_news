    "url_metadata": "https://www.colombotelegraph.com/index.php/cost-accounting-standards-for-sri-lanka-a-timely-measure-taken-by-cma-sri-lanka/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
