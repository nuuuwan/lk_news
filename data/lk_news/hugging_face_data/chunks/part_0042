    "description": "JAT posts record revenue in FY25/26, PBT up 5% despite external shocks",
    "url_metadata": "https://www.ft.lk/business/JAT-posts-record-revenue-in-FY25-26-PBT-up-5-despite-external-shocks/34-792857",
    "lang": "en",
    "newspaper_id": "dailyftlk",
