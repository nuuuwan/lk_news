    "url_metadata": "https://www.ada.lk/business/\u0d9c\u0dd9\u0dc0\u0dd4\u0dab\u0dd4-\u0daf\u0dd2\u0db1\u0dc0\u0dbd-\u0d89\u0dc4\u0dc5-\u0db4\u0dc4\u0dc5-\u0d9c\u0dd2\u0dba-\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dda-\u0d85\u0daf-\u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba/7-422824",
