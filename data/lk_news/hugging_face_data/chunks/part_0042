    "num": "dailymirrorlk-ffda6f5a",
    "date_str": "2026-06-10",
    "description": "Climate ambition alone won\u2019t pay bills, Sri Lanka warned",
    "url_metadata": "https://www.dailymirror.lk/business-main/Climate-ambition-alone-wont-pay-bills-Sri-Lanka-warned/245-342453",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
