    "description": "Minister alleges ex-SIS Chief Sallay conspired to facilitate Easter attacks",
    "url_metadata": "https://www.ft.lk/news/Minister-alleges-ex-SIS-Chief-Sallay-conspired-to-facilitate-Easter-attacks/56-793146",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1781137111.0,
