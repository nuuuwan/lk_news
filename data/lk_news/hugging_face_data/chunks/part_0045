    "description": "Creating a cognitive gym: Taming the AI monster in our classrooms",
    "url_metadata": "https://www.ft.lk/columns/Creating-a-cognitive-gym-Taming-the-AI-monster-in-our-classrooms/4-794840",
    "lang": "en",
    "newspaper_id": "dailyftlk",
