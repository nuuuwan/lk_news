    "doc_type": "lk_news",
    "doc_id": "2026-07-16-dailyftlk-1f51c994",
    "num": "dailyftlk-1f51c994",
    "date_str": "2026-07-16",
    "description": "NGO Bill: Slouching toward totalitarianism?",
    "url_metadata": "https://www.ft.lk/columns/NGO-Bill-Slouching-toward-totalitarianism/4-794690",
