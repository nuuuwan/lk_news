    "description": "US signs landmark nuclear deal with Saudi Arabia",
    "url_metadata": "https://www.dailymirror.lk/international/US-signs-landmark-nuclear-deal-with-Saudi-Arabia/107-346407",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784778790.0,
    "chunk_id": "2026-07-23-dailymirrorlk-320ad9e2-0000",
