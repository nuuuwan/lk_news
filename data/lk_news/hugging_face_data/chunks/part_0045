    "description": "Cleanliness is a public responsibility too!",
    "url_metadata": "https://www.dailymirror.lk/opinion/Cleanliness-is-a-public-responsibility-too/172-346264",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
