    "description": "Stop harassing businessmen: Opposition MP",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Stop-harassing-businessmen-Opposition-MP/108-346287",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
