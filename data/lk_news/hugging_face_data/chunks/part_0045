    "doc_type": "lk_news",
    "doc_id": "2026-07-21-islandlk-9f2de234",
    "num": "islandlk-9f2de234",
    "date_str": "2026-07-21",
    "description": "The Digital Underground",
    "url_metadata": "http://island.lk/the-digital-underground/",
    "lang": "en",
    "newspaper_id": "islandlk",
