    "url_metadata": "https://www.dailymirror.lk/opinion/Government-Must-Listen-to-the-Legal-Fraternity/172-345855",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784239076.0,
