    "url_metadata": "https://www.ada.lk/sports/\u0d86\u0da2\u0db1\u0dca\u0da7\u0dd2\u0db1\u0dcf\u0dc0-\u0d85\u0dc0\u0dc3\u0db1\u0dca-\u0db8\u0dc4-\u0dad\u0dbb\u0d9c\u0dba\u0da7/9-423280",
