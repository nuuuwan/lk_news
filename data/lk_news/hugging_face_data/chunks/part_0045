    "chunk_text": "\u0db8\u0dd9\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0da7 \u0dc3\u0dd9\u0dbd\u0dd2\u0db1\u0dca\u0d9a\u0ddd \u0dbd\u0dba\u0dd2\u0dc6\u0dca \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0dc3\u0dc4 \u0da2\u0dca\u200d\u0dba\u0dd9\u0dc2\u0dca\u0da8 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3\u0dad\u0dca\u0dc0\u0dba \u0daf \u0d91\u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd2\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca \u0dc3\u0db8\u0d9f \u0dc3\u0dd4\u0dc4\u0daf\u0dc0 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0dc4\u0dd4\u0dc0\u0db8\u0dcf\u0dbb\u0dd4 \u0d9a\u0dbb \u0d9c\u0db1\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0d91\u0daf\u0dd2\u0db1 \u0d8b\u0dad\u0dca\u0dc3\u0dc0\u0dba\u0dda \u0dc3\u0dad\u0dd4\u0da7 \u0db6\u0dd9\u0daf\u0dcf \u0d9c\u0dad\u0dca\u0dc4. \u0dad\u0dc0\u0daf, \u2018\u0dc6\u0dd0\u0db8\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc0\u0dcf\u0dbb\u0dd2\u2019 \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8 \u0dad\u0dcf\u0db1\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0db1 \u0dbb\u0ddc\u0dc2\u0dcf\u0db1\u0dca \u0dbb\u0dab\u0dc0\u0db1, \u0d9a\u0dd4\u0dc2\u0dca\u0dbd\u0dcf\u0db1\u0dd2 \u0dbb\u0dab\u0dc0\u0db1 \u0dc3\u0dc4 \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0d9c\u0dda \u0db4\u0dd4\u0dad\u0dca \u0db8\u0dd2\u0db1\u0dd9\u0dad\u0dca \u0daf \u0db8\u0dd9\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0da7 \u0d91\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0dc3\u0dc4\u0db7\u0dcf\u0d9c\u0dd3 \u0dc0\u0dd6\u0dc0\u0db1\u0dca \u0d9c\u0dda \u0d85\u0dad\u0dca\u0daf\u0dd0\u0d9a\u0dd3\u0db8 \u0dad\u0dc0\u0dad\u0dca \u0d94\u0db4\u0dca\u0db1\u0d82\u0dc0\u0db1 \u0dbd\u0daf\u0dd3. \u0db4\u0dbb\u0dca\u0dbd\u0dca \u0db6\u0dda \u0dc4\u0dd2 \u0db8\u0dd9\u0db8 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0d85\u0dad\u0dca\u0daf\u0dd0\u0d9a\u0dd3\u0db8, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0da2\u0dd3\u0dc0\u0dd2\u0dad \u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dca\u0dc2\u0dda\u0dad\u0dca\u200d\u0dbb\u0dba\u0dda \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0db8 \u0dc3\u0dc4 \u0daf\u0dd3\u0dbb\u0dca\u0d9d\u0dad\u0db8 \u0db4\u0dcf\u0dbb\u0dd2\u0db7\u0ddd\u0d9c\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dbd\u0dcf\u0db7 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1 \u0dbd\u0dd9\u0dc3 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd9\u0db1 \u2018\u0dc6\u0dd0\u0db8\u0dd2\u0dbd\u0dd2 \u0dc3\u0dc0\u0dcf\u0dbb\u0dd2\u2019 \u0dc0\u0dd0\u0da9\u0dc3\u0da7\u0dc4\u0db1\u0dda \u0d91\u0d9a\u0dca \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dd3 \u0d85\u0d82\u0d9c\u0dba\u0d9a\u0dd2."
