    "description": "Manipulation by self-appointed brokers",
    "url_metadata": "https://www.dailymirror.lk/opinion/Manipulation-by-self-appointed-brokers/172-346861",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
