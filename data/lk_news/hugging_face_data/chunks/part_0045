    "description": "Joint Opposition urges international partners to review Anti-Corruption Bill",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Joint-Opposition-urges-international-partners-to-review-Anti-Corruption-Bill/108-347350",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1785831922.0,
    "chunk_id": "2026-08-04-dailymirrorlk-37391831-0000",
    "chunk_index": 0,
