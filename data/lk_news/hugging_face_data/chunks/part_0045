    "description": "Hemas Embeds Sustainability  at the Core of its Business",
    "url_metadata": "https://www.ft.lk/business/Hemas-Embeds-Sustainability-at-the-Core-of-its-Business/34-795038",
    "lang": "en",
    "newspaper_id": "dailyftlk",
