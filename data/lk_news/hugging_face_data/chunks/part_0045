    "url_metadata": "https://www.ada.lk/breaking_news/\u0da2\u0dcf\u0dad\u0dd2\u0d9a-\u0dc3\u0dd4\u0db4\u0dd2\u0dc5\u0dd2\u0db4\u0db1\u0dca-\u0dc3\u0dad\u0dd2\u0dba-\u0d87\u0dbb\u0db9\u0dd9\u0dba\u0dd2/11-423442",
