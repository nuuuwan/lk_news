    "description": "Energy sector stakeholders identify priorities to accelerate Sri Lanka\u2019s renewable energy transition",
    "url_metadata": "https://www.ft.lk/business/Energy-sector-stakeholders-identify-priorities-to-accelerate-Sri-Lanka-s-renewable-energy-transition/34-794917",
    "lang": "en",
    "newspaper_id": "dailyftlk",
