    "doc_type": "lk_news",
    "doc_id": "2026-07-27-dailyftlk-1821ccef",
    "num": "dailyftlk-1821ccef",
    "date_str": "2026-07-27",
    "description": "H.M.R. Ellepola: A true unsung hero of the Central Bank",
    "url_metadata": "https://www.ft.lk/columns/H-M-R-Ellepola-A-true-unsung-hero-of-the-Central-Bank/4-795178",
