    "description": "Middle East unrest tempers factory confidence despite June expansion",
    "url_metadata": "https://www.dailymirror.lk/business/Middle-East-unrest-tempers-factory-confidence-despite-June-expansion/215-345877",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
