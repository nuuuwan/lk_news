    "description": "Hutch expands sustainability footprint with Kandy Signature+ outlet",
    "url_metadata": "https://www.ft.lk/business/Hutch-expands-sustainability-footprint-with-Kandy-Signature-outlet/34-795294",
    "lang": "en",
    "newspaper_id": "dailyftlk",
