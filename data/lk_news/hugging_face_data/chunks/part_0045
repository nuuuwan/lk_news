    "description": "HRCSL raises serious concerns about prison authorities\u2019 conduct",
    "url_metadata": "https://www.ft.lk/news/HRCSL-raises-serious-concerns-about-prison-authorities-conduct/56-794750",
    "lang": "en",
    "newspaper_id": "dailyftlk",
