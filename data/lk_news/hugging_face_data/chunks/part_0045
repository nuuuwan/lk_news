    "description": "Exporters Association of  Sri Lanka elects new leadership at 29th Annual General Meeting",
    "url_metadata": "https://www.ft.lk/business/Exporters-Association-of-Sri-Lanka-elects-new-leadership-at-29th-Annual-General-Meeting/34-794864",
    "lang": "en",
    "newspaper_id": "dailyftlk",
