    "date_str": "2026-08-07",
    "description": "Cost pressures drag Hemas first-quarter earnings lower",
    "url_metadata": "https://www.dailymirror.lk/business/Cost-pressures-drag-Hemas-first-quarter-earnings-lower/215-347616",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
