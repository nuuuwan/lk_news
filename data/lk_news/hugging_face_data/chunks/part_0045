    "description": "Judicial Service Association opposes judges\u2019 retirement age extension",
    "url_metadata": "https://www.ft.lk/news/Judicial-Service-Association-opposes-judges-retirement-age-extension/56-795267",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1785203586.0,
