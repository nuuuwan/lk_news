    "description": "Diversity, Equity and Inclusion: The Social Pillar Driving Sustainable Business Success",
    "url_metadata": "https://www.ft.lk/business/Diversity-Equity-and-Inclusion-The-Social-Pillar-Driving-Sustainable-Business-Success/34-795026",
    "lang": "en",
    "newspaper_id": "dailyftlk",
