    "url_metadata": "https://www.ft.lk/news/FSP-dismisses-judges-retirement-age-extension-as-not-a-move-to-catch-thieves/56-795662",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1785979381.0,
    "chunk_id": "2026-08-06-dailyftlk-ac7afd58-0000",
    "chunk_index": 0,
