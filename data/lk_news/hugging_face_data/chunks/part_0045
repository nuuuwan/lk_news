    "url_metadata": "https://www.ada.lk/breaking_news/\u0dc3\u0dd2\u0dbd\u0ddd\u0db1\u0dca-\u0da7\u0dd3-\u0dc0\u0dd2\u0dbd\u0dda\u0da2\u0dca-\u0d87\u0dbb\u0db9\u0dd9\u0dba\u0dd2/11-423271",
