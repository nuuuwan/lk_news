    "url_metadata": "https://www.dailymirror.lk/business-news/LB-CIM-launches-SLs-NextGen-virtual-debit-card/273-346251",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784658830.0,
