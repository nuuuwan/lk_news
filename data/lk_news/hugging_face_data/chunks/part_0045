    "url_metadata": "https://www.dailymirror.lk/breaking-news/Hamas-names-Khalil-al-Hayya-as-new-leader/108-346126",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784550357.0,
    "chunk_id": "2026-07-20-dailymirrorlk-6c32cdc0-0000",
    "chunk_index": 0,
