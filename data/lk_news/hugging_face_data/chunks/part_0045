    "description": "Managing Yala for a better experience by thinking beyond Leopards",
    "url_metadata": "https://www.ft.lk/columns/Managing-Yala-for-a-better-experience-by-thinking-beyond-Leopards/4-795390",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1785462495.0,
    "chunk_id": "2026-07-31-dailyftlk-84ae28c0-0001",
