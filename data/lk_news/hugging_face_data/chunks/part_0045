    "num": "dailymirrorlk-4976411f",
    "date_str": "2026-07-20",
    "description": "Steep hikes hit offshore firms and professionals in broad corporate registration fee revision",
    "url_metadata": "https://www.dailymirror.lk/business-news/Steep-hikes-hit-offshore-firms-and-professionals-in-broad-corporate-registration-fee-revision/273-346150",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
