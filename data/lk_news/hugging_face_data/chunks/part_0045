    "num": "dailyftlk-7bf4e1a2",
    "date_str": "2026-08-04",
    "description": "What Sri Lanka can learn from India\u2019s youth uprising",
    "url_metadata": "https://www.ft.lk/columns/What-Sri-Lanka-can-learn-from-India-s-youth-uprising/4-795529",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1785786172.0,
