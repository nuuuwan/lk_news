    "description": "The Sahodarayas We No Longer Have",
    "url_metadata": "https://www.dailymirror.lk/opinion/The-Sahodarayas-We-No-Longer-Have/172-346054",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
