    "description": "SLWJA condemns Parliament Select Committee over summoning journalists",
    "url_metadata": "https://www.ft.lk/news/SLWJA-condemns-Parliament-Select-Committee-over-summoning-journalists/56-794958",
    "lang": "en",
    "newspaper_id": "dailyftlk",
