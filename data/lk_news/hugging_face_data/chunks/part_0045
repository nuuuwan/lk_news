    "description": "CA Sri Lanka: Pioneering the Nation\u2019s Sustainable Future",
    "url_metadata": "https://www.ft.lk/business/CA-Sri-Lanka-Pioneering-the-Nation-s-Sustainable-Future/34-795048",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1784799903.0,
