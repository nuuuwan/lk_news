    "description": "LOLC Finance expands islandwide reach",
    "url_metadata": "https://www.dailymirror.lk/business-news/LOLC-Finance-expands-islandwide-reach/273-346366",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
