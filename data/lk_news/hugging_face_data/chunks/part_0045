    "chunk_text": "\u0d87\u0dc3\u0dc5 \u0db4\u0dd4\u0db1\u0dca \u0db4\u0ddc\u0dc4\u0ddd \u0daf\u0dd2\u0db1\u0dba \u0d85\u0daf\u0dba\u0dd2\n\n\u0db6\u0dde\u0daf\u0dca\u0db0 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba\u0dda \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd6\u00a0\u00a0\u0d87\u0dc3\u0dc5 \u0db4\u0dd4\u0dbb \u0db4\u0dc3\u0dc5\u0ddc\u0dc3\u0dca\u0dc0\u0d9a \u0db4\u0ddc\u0dc4\u0ddc\u0dba \u0daf\u0dd2\u0db1\u0dba \u0d85\u0daf\u0da7 (29) \u0dba\u0dd9\u0daf\u0dd3 \u0dad\u0dd2\u0db6\u0dda.\n\n\u0db4\u0dc3\u0dca\u0db8\u0dc4 \u0db6\u0dd0\u0dbd\u0dd4\u0db8\u0dca \u0db6\u0dd0\u0dbd\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0dc3\u0dd2\u0daf\u0dd4\u0dc4\u0dad\u0dca \u0d9a\u0dd4\u0db8\u0dbb\u0dd4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca \u0dbd\u0ddc\u0dc0 \u0d89\u0db4\u0daf\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db8\u0dc4\u0dcf\u0db8\u0dcf\u0dba\u0dcf \u0d9a\u0dd4\u0dc3 \u0db4\u0dd2\u0dc5\u0dd2\u0dc3\u0dd2\u0db3 \u0d9c\u0dad\u0dca\u0dad\u0dda \u0d85\u0daf \u0dc0\u0dd0\u0db1\u0dd2 \u0d87\u0dc3\u0dc5 \u0db4\u0ddc\u0dc4\u0ddc\u0dba \u0daf\u0dd2\u0db1\u0dba\u0d9a\u0dba.\n\n\u0dc3\u0dd2\u0daf\u0dd4\u0dc4\u0dad\u0dca \u0db6\u0ddd \u0dc3\u0dad\u0dcf\u0dab\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc3\u0dda \u0d9c\u0dd2\u0dc4\u0dd2\u0d9c\u0dd9\u0dba \u0d9a\u0dbd\u0d9a\u0dd2\u0dbb\u0dd3 \u0db8\u0dc4\u0dcf \u0d85\u0db7\u0dd2\u0dab\u0dd2\u0dc2\u0dca\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0dbb\u0dcf\u0dc4\u0dd4\u0dbd \u0d9a\u0dd4\u0db8\u0dbb\u0dd4\u0d9c\u0dda \u0d8b\u0db4\u0dad \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd6\u0dba\u0dda \u0daf\u00a0 \u0d87\u0dc3\u0dc5 \u0db4\u0ddc\u0dc4\u0ddc\u0dba \u0daf\u0dd2\u0db1\u0d9a\u0dba.\n\n\u0db6\u0dd4\u0daf\u0dd4\u0dbb\u0da2\u0dcf\u0dab\u0db1\u0dca \u0dc0\u0dc4\u0db1\u0dca\u0dc3\u0dda\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0dae\u0db8 \u0db0\u0dbb\u0dca\u0db8 \u0daf\u0dda