    "description": "SL Ambassador to Iran Prof. Fazeeha Azmi presents credentials",
    "url_metadata": "https://www.ft.lk/news/SL-Ambassador-to-Iran-Prof-Fazeeha-Azmi-presents-credentials/56-795262",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1785203147.0,
