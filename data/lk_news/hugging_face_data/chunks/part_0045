    "url_metadata": "https://www.dailymirror.lk/business/ASUS-brings-on-device-AI-to-Sri-Lankas-corporate-laptop-market/215-346999",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1785433799.0,
