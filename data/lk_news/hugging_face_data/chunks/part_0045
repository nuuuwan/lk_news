    "chunk_text": "\u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0dad\u0dd9\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db4\u0dc4\u0daf\u0dd4 \u0daf\u0dd9\u0d9a\u0d9a\u0da7 \u0db4\u0dc4\u0dbb \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dcf\n\n\u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0dad\u0dd9\u0dbd\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db4\u0dc4\u0daf\u0dd4 \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0daf\u0dd9\u0d9a\u0d9a\u0da7 \u0db4\u0dc4\u0dbb\u0daf\u0dd4\u0db1\u0dca \u0db6\u0dc0 \u0dba\u0dd4\u0d9a\u0dca\u0dbb\u0dda\u0db1 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0dc0\u0ddc\u0dbd\u0ddc\u0da9\u0dd2\u0db8\u0dd2\u0dba\u0dbb\u0dca \u0dc3\u0dd9\u0dbd\u0dd9\u0db1\u0dca\u0dc3\u0dca\u0d9a\u0dd2 \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n\u0dc3\u0db8\u0dcf\u0da2 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0dd2\u0db1\u0dca \u0d94\u0dc4\u0dd4 \u0db4\u0dc0\u0dc3\u0db1\u0dca\u0db1\u0dda \u0dba\u0dd4\u0d9a\u0dca\u0dbb\u0dda\u0db1\u0dba\u0dda \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dcf \u0dba\u0dcf\u0dbb\u0ddc\u0dc3\u0dca\u0dbd\u0dcf\u0dc0\u0dca \u0dc4\u0dd2 \u0dc3\u0dca\u0dbd\u0dcf\u0dc0\u0dca\u0db1\u0dd9\u0dc6\u0dca\u0da7\u0dca-\u0dba\u0dcf\u0db1\u0ddc\u0dc3\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0db4\u0dc4\u0daf\u0dd4\u0dc0\u0da7 \u0dc3\u0dc4\n\n\u0dba\u0dcf\u0dbb\u0ddc\u0dc3\u0dca\u0dbd\u0dcf\u0dc0\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0d9a\u0dcf\u0dbb \u0db8\u0dd2\u0dc4\u0dcf\u0dba\u0dd2\u0dbd\u0dca \u0d91\u0dc0\u0dca\u0dbb\u0dd9\u0dc0\u0dca \u0db4\u0dc0\u0dc3\u0db1\u0dca\u0db1\u0dda \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0da7 \u0db4\u0dc4\u0dbb \u0daf\u0dd9\u0db1 \u0dba\u0dd4\u0d9a\u0dca\u0dbb\u0dda\u0db1 \u0da9\u0dca\u200d\u0dbb\u0ddd\u0db1 \u0dba\u0dcf\u0db1\u0dcf \u0dc0\u0dd2\u0db1\u0dcf\u0dc1 \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db1\u0db8\u0dd4\u0dad\u0dca \u0dc3\u0dd4\u0db1\u0dca\u0db6\u0dd4\u0db1\u0dca\n\n\u0d9a\u0dc5\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dda \u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0dc3\u0dd9\u0dc0\u0db1\u0