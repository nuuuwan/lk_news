    "date_str": "2026-07-17",
    "description": "Government Must Listen to the Legal Fraternity",
    "url_metadata": "https://www.dailymirror.lk/opinion/Government-Must-Listen-to-the-Legal-Fraternity/172-345855",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784239076.0,
    "chunk_id": "2026-07-17-dailymirrorlk-5b9e6617-0002",
