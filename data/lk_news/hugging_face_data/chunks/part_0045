    "description": "Ukraine war: inside longstanding conflict between politicians and military\u00a0commanders",
    "url_metadata": "http://island.lk/ukraine-war-inside-longstanding-conflict-between-politicians-and-military-commanders/",
    "lang": "en",
    "newspaper_id": "islandlk",
