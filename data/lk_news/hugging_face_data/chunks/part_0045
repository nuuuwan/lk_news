    "description": "Two memorable excerpts from a former SLAF commander\u2019s memoir",
    "url_metadata": "http://island.lk/two-memorable-excerpts-from-a-former-slaf-commanders-memoir/",
    "lang": "en",
    "newspaper_id": "islandlk",
