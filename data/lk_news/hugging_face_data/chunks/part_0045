    "description": "\u0db8\u0dd2\u0dc3\u0dd2\u0dc3\u0dca \u0d9c\u0dca\u0dbd\u0ddd\u0db6\u0dbd\u0dca \u0dba\u0dd4\u0db1\u0dd2\u0dc0\u0dbb\u0dca\u0dc3\u0dca \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda \u0d85\u0db1\u0dd4\u0dc1\u0dd6\u0dbb\u0dad\u0dcf\u0dc0\u0dba \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7",
