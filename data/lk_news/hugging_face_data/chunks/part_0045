    "chunk_text": "\u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dba \u0dc4\u0dd0\u0da7\u0db1\u0dca \u0da9\u0dd2\u0db4\u0ddd\u0dc0\u0dda  \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0dbd\u0d9a\u0dca\u0dc2 23\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dc5 \u0daf\u0db8\u0dba\u0dd2\n\n\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0d9a\u0daf\u0dd4\u0d9a\u0dbb\u0dba\u0dda \u0db6\u0da7\u0dc4\u0dd0\u0dbb \u0db6\u0dd1\u0dc0\u0dd4\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0daf\u0dd0\u0da9\u0dd2 \u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dba \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dc0\u0dbd \u0dbb\u0dae\u0dc0\u0dcf\u0dc4\u0db1 \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1\u0dba\u0da7 \u0db6\u0dcf\u0db0\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0dc4\u0dd0\u0da7\u0db1\u0dca \u0dbd\u0d82\u0d9c\u0db8 \u0da9\u0dd2\u0db4\u0ddd\u0dc0\u0dda \u0daf\u0ddb\u0db1\u0dd2\u0d9a \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0dbb\u0dd4.\u0dbd\u0d9a\u0dca\u0dc2 33 \u0dc3\u0dd2\u0da7 \u0dbb\u0dd4.\u0dbd\u0d9a\u0dca\u0dc2 10-12\u0dad\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db4\u0dc4\u0dc5 \u0db6\u0dd0\u0dc3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc4\u0dd0\u0da7\u0db1\u0dca \u0dbd\u0d82\u0d9c\u0db8 \u0da9\u0dd2\u0db4\u0ddc\u0dc0\u0dda \u0d9a\u0dbd\u0db8\u0dab\u0dcf\u0d9a\u0dbb\u0dd4 \u0db4\u0dcf\u0dbd\u0dd2\u0dad \u0dc0\u0dd2\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba.\n\n\u0db8\u0dcf\u0db0\u0dca\u200d\u0dba\u0da7 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1\u0dba\u0d9a\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0da9\u0dd2\u0db4\u0ddd \u0d9a\u0dc5\u0db8\u0dab\u0dcf\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba \u0daf\u0dd2\u0db1\u0dc0\u0dbd \u0dad\u0db8 \u0da9\u0dd2\u0db4\u0ddd\u0dc0 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0daf\u0dd4\u0dbb \u0dc3\u0dc4 \u0d9a\u0dd9\u0da7\u0dd2 \u0daf\u0dd4\u0dbb \u0db6\u0dc3\u0dca \u0dbb\u0dae 75\u0d9a\u0dca \u0db0\u0dcf\u0dc0\u0db1\u0dba\u0da7 \u0d91\u0d9a\u0dca \u0d9a\u0dbb\u0db1 \u0db6\u0dc0\u0dba\u0dd2.\n\n\u0d91\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u0db8\u0d9c\u0dd3\u0db1\u0dca 18000-26000\u0d9a\u0dca \u0db4\u0db8\u0dab \u0dad\u0db8 \u0da9\u0dd2\u0db4\u0ddd\u0dc0\u0dda \u0db6\u0dc3\u0dca \u0dbb\u0dae\u0dc0\u0dbd \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dbd\u0daf \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0daf\u0dd0\u0da9\u0dd2 \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0\u0dad\u0dca \u0dc3\u0db8\u0d9c \u0d9c\u0dad \u0dc0\u0dd6 03/04/05 \u0dba\u0db1 \u0dad\u0dd9\u0daf\u0dd2\u0db1 \u0dad\u0dd4\u0dbd \u0daf\u0dd2\u0db1\u0d9a\u0da7 \u0db8\u0d9c\u0dd3\u0db1\u0dca 9218 \u2013 10000\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd2\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd9\u0db8 \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0dad\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dc4\u0dc5 \u0dc0\u0dd0\u0da7\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dba\u0dd2 \u0da9\u0dd2\u0db4\u0ddd \u0d9a\u0dbd\u0db8\u0dab\u0dcf\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda.\n\n\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dba\u0dad\u0dca \u0dc3\u0db8\u0d9c \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0da9\u0dd4 \u0dbd\u0db6\u0dcf \u0daf\u0dd3\u0db8, \u0db8\u0d9c\u0dd3\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dd9\u0dc3\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0db1\u0ddc\u0dc0\u0dd3\u0db8 \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0db8\u0dd9\u0db8 \u0db8\u0d9c\u0dd3\u0db1\u0dca \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0d85\u0da9\u0dd4 \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dba\u0dd2.\n\n\u0dad\u0dc0\u0daf, \u0dad\u0db8 \u0da9\u0dd2\u0db4\u0ddd\u0dc0\u0dda \u0dc3\u0dda\u0dc0\u0d9a\u0dd2\u0dba\u0db1\u0dca 328 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dc3\u0dda\u0dc0\u0dba \u0d9a\u0dbb\u0db1 \u0db6\u0dc0\u0dad\u0dca, \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0db8\u0dda \u0db8\u0dc3 \u0dc0\u0dd0\u0da7\u0dd4\u0db4 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dbb\u0dd4. \u0dbd\u0d9a\u0dca\u0dc2 138\u0d9a \u0db4\u0db8\u0dab \u0db8\u0dd4\u0daf\u0dbd \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d8b\u0db4\u0dba\u0dcf\u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0daf \u0da9\u0dd2\u0db4\u0ddd \u0d9a\u0dc5\u0db8\u0dab\u0dcf\u0d9a\u0dcf\u0dbb\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba."
