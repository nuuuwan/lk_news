    "description": "Daraz Sri Lanka joins Dialog Pay merchant ecosystem",
    "url_metadata": "https://www.dailymirror.lk/business-news/Daraz-Sri-Lanka-joins-Dialog-Pay-merchant-ecosystem/273-345742",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784174561.0,
