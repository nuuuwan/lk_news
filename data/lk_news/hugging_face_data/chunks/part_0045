    "description": "INSEE Lanka-Coast Guard launch coastal protection initiative",
    "url_metadata": "https://www.dailymirror.lk/business-news/INSEE-Lanka-Coast-Guard-launch-coastal-protection-initiative/273-346575",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1784913569.0,
