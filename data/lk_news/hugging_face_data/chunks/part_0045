    "description": "WhatsApp tests separate folder for business messages to reduce inbox clutter",
    "url_metadata": "https://www.dailymirror.lk/international/WhatsApp-tests-separate-folder-for-business-messages-to-reduce-inbox-clutter/107-347349",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1785831103.0,
    "chunk_id": "2026-08-04-dailymirrorlk-c848b315-0000",
    "chunk_index": 0,
