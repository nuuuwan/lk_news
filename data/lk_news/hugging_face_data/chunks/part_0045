    "description": "\u0dc0\u0dd0\u0da9\u0da7 \u0d91\u0db1 \u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2\u0db1\u0dca\u0da7 \u0d9a\u0ddc\u0da7 \u0d9a\u0dbd\u0dd2\u0dc3\u0db8\u0dca \u0d85\u0daf\u0dd2\u0db1\u0dca\u0db1 \u0d85\u0dc0\u0dc3\u0dbb \u0daf\u0dd4\u0db1\u0dca \u0da7\u0ddd\u0d9a\u0dd2\u0dba\u0ddd\u0dc0",
