    "url_metadata": "https://www.ada.lk/business/\u0db4\u0dd4\u0db1\u0dbb\u0dca\u0da2\u0db1\u0db1\u0dd3\u0dba-\u0db6\u0dbd\u0dc1\u0d9a\u0dca\u0dad\u0dd2-\u0dc3\u0d82\u0d9a\u0dca\u200d\u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0dba-\u0dc0\u0dda\u0d9c\u0dc0\u0dad\u0dca-\u0d9a\u0dbb\u0db1-\u0db4\u0dca\u200d\u0dbb\u0db8\u0dd4\u0d9b\u0dad\u0dcf-\u0db8\u0ddc\u0db1\u0dc0\u0dcf\u0daf-/7-423368",
