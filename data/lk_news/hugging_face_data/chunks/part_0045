    "description": "Why men\u2019s mental health deserves our attention",
    "url_metadata": "https://www.ft.lk/columns/Why-men-s-mental-health-deserves-our-attention/4-794713",
    "lang": "en",
    "newspaper_id": "dailyftlk",
