    "chunk_text": "\u0dc3\u0dd2\u0dad\u0dcf\u0d91\u0dc5\u0dd2\u0dba \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0da7 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd6 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4\u0da7 \u0dbb\u0dd4. 403,509.22\u0d9a \u0daf\u0da9\u0dba\u0d9a\u0dca\n\n\u0d9a\u0daf\u0db4\u0ddc\u0dc5 \u0db6\u0ddd\u0db8\u0dd4\u0dbb\u0dd4\u0d87\u0dbd\u0dca\u0dbd \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda \u0dc3\u0dd3\u0dad\u0dcf\u0d91\u0dc5\u0dd2\u0dba \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0dbd\u0dd4 \u0dc0\u0dd3 \u0d91\u0db8 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0dda \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd6 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dbd\u0dd2\u0dba \u0dc0\u0db1 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca (05) \u0daf\u0dd2\u0db1 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dbd\u0dd2\u0dba \u0db8\u0dc4\u0dda\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0dad\u0dca \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab\u0dba \u0dc0\u0dd9\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbd \u0db4\u0dc3\u0dd4 \u0dc3\u0dd0\u0d9a\u0d9a\u0dbb\u0dd4 \u0dc0\u0dbb\u0daf \u0db4\u0dd2\u0dbd\u0dd2\u0d9c\u0dad\u0dca \u0db1\u0dd2\u0dc3\u0dcf \u0da0\u0dd6\u0daf\u0dd2\u0dad\u0da7 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0da7 \u0d87\u0dad\u0dd4\u0dbd\u0dd4 \u0dc0\u0dd3\u0db8 \u0dc3\u0dc4 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0da7 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0db8 \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dbb\u0dd4.40000\u0d9a \u0daf\u0da9 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dca\u0daf, \u0d91\u0db8 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad\u0dba\u0dda \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0db8 \u0dad\u0dd4\u0dbd\u0dd2\u0db1\u0d