    "date_str": "2026-07-29",
    "description": "Sri Lanka\u2019s drug eradication campaign:  From rhetoric to real outcomes",
    "url_metadata": "https://www.dailymirror.lk/opinion/Sri-Lankas-drug-eradication-campaign-From-rhetoric-to-real-outcomes/172-346864",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1785271589.0,
