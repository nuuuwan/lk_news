    "url_metadata": "https://www.ada.lk/sports/\u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0-\u0d9c\u0dd0\u0db1-\u0db4\u0dca\u200d\u0dbb\u0d9c\u0dad\u0dd2\u0dad\u0dba-\u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0db1\u0dca\u0db1\u0dc0\u0dcf--\u0d89\u0d9a\u0dca\u0db8\u0db1\u0dd2\u0db1\u0dca-\u0db1\u0dd2\u0dbd\u0dc0\u0dbb\u0dab\u0dba\u0d9a\u0dca-\u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1/9-423278",
