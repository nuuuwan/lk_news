    "url_metadata": "https://www.dailymirror.lk/breaking-news/Betty-97-breaks-record-for-oldest-wingwalker/108-347630",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1786075057.0,
    "chunk_id": "2026-08-07-dailymirrorlk-23463d8a-0000",
