    "description": "Mahara Prison riots: High-level committee appointed to probe conspirators",
    "url_metadata": "https://www.ft.lk/news/Mahara-Prison-riots-High-level-committee-appointed-to-probe-conspirators/56-795621",
    "lang": "en",
    "newspaper_id": "dailyftlk",
