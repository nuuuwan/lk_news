    "url_metadata": "https://www.dailymirror.lk/breaking-news/Bodies-of-five-climbers-found-on-Russias-highest-mountain/108-346739",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1785147588.0,
