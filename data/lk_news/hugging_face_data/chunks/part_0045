    "url_metadata": "https://www.ft.lk/columns/Who-really-pays-for-digital-banking/4-794991",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1784757547.0,
    "chunk_id": "2026-07-23-dailyftlk-807a2fa8-0000",
    "chunk_index": 0,
