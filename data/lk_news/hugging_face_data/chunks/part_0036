    "description": "Why data centres?",
    "url_metadata": "https://www.ft.lk/columns/Why-data-centres/4-788718",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1771875957.0,
    "chunk_id": "2026-02-24-dailyftlk-2445bf53-0000",
    "chunk_index": 0,
