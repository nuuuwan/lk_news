    "description": "Flagship Pilot Pens store opens at Havelock City Mall",
    "url_metadata": "https://www.ft.lk/business/Flagship-Pilot-Pens-store-opens-at-Havelock-City-Mall/34-788246",
    "lang": "en",
    "newspaper_id": "dailyftlk",
