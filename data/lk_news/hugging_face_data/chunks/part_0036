    "description": "Japan-Sri Lanka Committee on Business Environment holds third meeting",
    "url_metadata": "https://www.ft.lk/business/Japan-Sri-Lanka-Committee-on-Business-Environment-holds-third-meeting/34-788808",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1771986424.0,
