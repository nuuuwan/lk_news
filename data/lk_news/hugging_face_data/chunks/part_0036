    "description": "United Motors reports  Rs. 2.4 b profit for nine months",
    "url_metadata": "https://www.ft.lk/business/United-Motors-reports-Rs-2-4-b-profit-for-nine-months/34-788282",
    "lang": "en",
    "newspaper_id": "dailyftlk",
