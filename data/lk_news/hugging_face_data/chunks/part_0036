    "description": "\u0dc3\u0dd1\u0db8 \u0dbb\u0ddd\u0dc4\u0dbd\u0d9a\u0db8 \u0db8\u0dcf\u0dc3\u0dba\u0d9a\u0da7 \u0dc0\u0dbb\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0d96\u0dc2\u0db0 \u0dc3\u0db8\u0dcf\u0dbd\u0ddd\u0da0\u0db1 \u0dbb\u0dd4\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1",
