    "url_metadata": "http://island.lk/vehicle-permit-revival-threatens-governance-credibility-advocata/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1770995880.0,
    "chunk_id": "2026-02-13-islandlk-3c943d60-0000",
    "chunk_index": 0,
