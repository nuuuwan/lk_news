    "description": "\u0db8\u0dd9\u0da7\u0dca\u200d\u0dbb\u0ddd \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0da7 \u0d95\u0db1 \u0db4\u0dad\u0dca\u0dbd \u0db4\u0dc4\u0dad\u0dca \u0db6\u0dc3\u0dca \u0dbb\u0dae \u0db8\u0dda \u0dc0\u0dc3\u0dbb\u0dd9\u0dca \u0d85\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0daf\u0dd2 \u0d91\u0dba\u0dd2",
