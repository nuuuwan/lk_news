    "url_metadata": "https://www.ada.lk/breaking_news/\u0d85\u0daf-\u0dc3\u0dd2\u0da7-\u0dc0\u0dd0\u0dc3\u0dca\u0dc3-\u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd9\u0dba\u0dd2/11-421270",
