    "url_metadata": "https://www.ada.lk/business/The-Colombo-Border-\u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0dda-Tower-Cosmos-\u0dc4\u0dd2-\u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0dca/7-421187",
