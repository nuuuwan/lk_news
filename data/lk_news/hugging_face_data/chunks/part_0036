    "chunk_text": "\u0d92 \u0d85\u0db1\u0dd4\u0dc0, \u2018\u0db4\u0dd3 628\u2019 \u0db1\u0dde\u0d9a\u0dcf\u0dc0 , \u2018\u0db6\u0dd0\u0dbd\u0dca\u0da7\u0dd2\u0db8\u0ddd\u0dbb\u0dca\u2019 \u0dc4\u0dd2 \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0db1\u0db4\u0daf \u0dc0\u0dd9\u0dbb\u0dc5\u0dcf\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0d9a \u0db1\u0dde\u0d9a\u0dcf \u0d85\u0d82\u0d9c\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0d85\u0dad\u0dca\u0dbd\u0dcf\u0db1\u0dca\u0dad\u0dd2\u0d9a\u0dca \u0dc3\u0dcf\u0d9c\u0dbb\u0dba, \u0db4\u0dd0\u0db1\u0db8\u0dcf \u0d87\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0d94\u0dc3\u0dca\u0dc3\u0dda \u0db4\u0dd0\u0dc3\u0dd2\u0dc6\u0dd2\u0d9a\u0dca \u0dc3\u0dcf\u0d9c\u0dbb\u0dba \u0dc3\u0dc4 \u0db8\u0dbd\u0d9a\u0dca\u0d9a\u0dcf \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb \u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba \u0d94\u0dc3\u0dca\u0dc3\u0dda \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0dc3\u0dcf\u0d9c\u0dbb\u0dba \u0dc4\u0dbb\u0dc4\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0dc3\u0dd0\u0dad\u0db4\u0dd4\u0db8\u0dca 14,775 \u0d9a \u0db4\u0db8\u0dab \u0daf\u0dd3\u0dbb\u0dca\u0d9d \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0d9c\u0db8\u0db1\u0d9a\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dd4 2026 \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dc3 \u0db4\u0dc5\u0db8\u0dd4 \u0dc3\u0dad\u0dd2\u0dba\u0dda\u0daf\u0dd3 \u0db4\u0db8\u0dab \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0db8\u0da7\u00a0 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0db8\u0dd4\u0daf\u0dcf \u0db1\u0dde\u0d9a\u0dcf\u0dc0\u0d9a\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbd \u0daf\u0dd3\u0dbb\u0dca\u0d9d\u0dad\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0d9c\u0db8\u0db1 \u0dc3\u0dc4 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0dc4\u0