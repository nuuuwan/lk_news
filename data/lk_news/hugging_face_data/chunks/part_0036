    "description": "Fcode Labs invests in Germany-based coffee startup Bunamo",
    "url_metadata": "https://www.ft.lk/business/Fcode-Labs-invests-in-Germany-based-coffee-startup-Bunamo/34-788527",
    "lang": "en",
    "newspaper_id": "dailyftlk",
