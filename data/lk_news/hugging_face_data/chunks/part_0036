    "chunk_text": "\u0db1\u0dda\u0db4\u0dcf\u0dbd\u0dba\u0da7 \u0d92\u0dbb\u0dd9\u0dc4\u0dd2\u0dc0 \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da8 \u0da2\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd6 \u0d89\u0dad\u0dcf\u0dbd\u0dd2\u0dba\u0dda \u0dad\u0dbb\u0d9c\u0dba\u0dda \u0dc0\u0dd3\u0dbb\u0dba\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1\u0dba \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0d9a\u0dbd\u0dd4\u0d9c\u0db8\u0d9c\u0dda\u0da7\n\n\u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb \u0dc0\u0dd2\u0dc3\u0dca\u0dc3\u0dba\u0dd220 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dbd\u0dcf\u0db1 \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda \u0d89\u0dad\u0dcf\u0dbd\u0dd2 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0dc4\u0dcf \u0db1\u0dda\u0db4\u0dcf\u0dbd \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0d85\u0dad\u0dbb \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0dc0\u0db1\u0dca\u0d9a\u0da9\u0dda \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf\u0d82\u0d9c\u0dab\u0dba\u0dda \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0dad\u0dbb\u0d9c\u0dba\u0dd9\u0db1\u0dca \u0d89\u0dad\u0dcf\u0dbd\u0dd2 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0d9a\u0da9\u0dd4\u0dd4\u0dbd\u0dd4 10\u0d9a \u0dc0\u0dd2\u0dc1\u0dd2\u0dc2\u0dca\u0da8 \u0da2\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3\u0dba.\n\n\u0dad\u0dbb\u0d9c\u0dba\u0dda \u0db8\u0dd4\u0dbd\u0dd2\u0db1\u0dca\u0db8 \u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0da7 \u0db4\u0dc4\u0dbb\u0daf\u0dd4\u0db1\u0dca \u0db1\u0dda\u0db4\u0dcf\u0dbd \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u0da7 \u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb 19.3\u0d9a\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0daf\u0dd9\u0db1\u0dcf \u0daf\u0dd0\u0dc0\u0dd3 \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0dd6\u0dba\u0dda \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 123\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dd2. \u0d91\u0dc4\u0dd2\u0daf\u0dd3 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc3\u0db8\u0dca\u0db7\u0dc0\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dcf\u0db1\u0dca \u0d9a\u0dbd\u0dd4\u0d9c\u0db8\u0d9c\u0dda \u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb 4\u0d9a\u0daf\u0dd3 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 18\u0da7 \u0d9a\u0da9\u0dd4\u0dbd\u0dd4 \u0dad\u0dd4\u0db1\u0d9a\u0dca \u0daf\u0dc0\u0dcf \u0d9c\u0dad\u0dca\u0dad\u0dda\u0dba.\n\n\u0dbd\u0d9a\u0dd4\u0dab\u0dd4 124\u0d9a \u0da2\u0dba\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0dc4\u0dd2 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca \u0dc4\u0db9\u0dcf \u0d9c\u0dd2\u0dba \u0d89\u0dad\u0dcf\u0dbd\u0dd2 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0\u0dcf\u0dbb 12.4\u0d9a\u0daf\u0dd3 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0dd9\u0d9a\u0dca \u0db1\u0ddc\u0daf\u0dd0\u0dc0\u0dd2 \u0d91\u0db8 \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0db4\u0dc3\u0dd4\u0d9a\u0dbb \u0d9c\u0dd2\u0dba\u0dda\u0dba.\u0dad\u0dbb\u0d9c\u0dba\u0dda \u0dc0\u0dd3\u0dbb\u0dba\u0dcf \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dc2\u0dcf\u0db1\u0dca \u0d9a\u0dbd\u0dd4\u0d9c\u0db8\u0d9c\u0dda\u0da7 \u0dc4\u0dd2\u0db8\u0dd2\u0dc0\u0dd2\u0dba."
