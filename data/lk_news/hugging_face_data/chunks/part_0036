    "description": "COYLE hosts G20 Young Entrepreneurs\u2019 Alliance Leadership Assembly",
    "url_metadata": "https://www.ft.lk/business/COYLE-hosts-G20-Young-Entrepreneurs-Alliance-Leadership-Assembly/34-788583",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1771551135.0,
