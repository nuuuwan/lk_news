    "description": "BALPP policy brief explores China\u2019s global strategy and India\u2019s economic ascent",
    "url_metadata": "https://www.ft.lk/news/BALPP-policy-brief-explores-China-s-global-strategy-and-India-s-economic-ascent/56-788781",
    "lang": "en",
    "newspaper_id": "dailyftlk",
