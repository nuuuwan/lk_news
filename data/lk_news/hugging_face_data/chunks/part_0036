    "description": "BIOFACH 2026: A gateway for Sri Lanka\u2019s organic export expansion",
    "url_metadata": "https://www.ft.lk/business/BIOFACH-2026-A-gateway-for-Sri-Lanka-s-organic-export-expansion/34-788448",
    "lang": "en",
    "newspaper_id": "dailyftlk",
