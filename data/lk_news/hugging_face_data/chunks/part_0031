    "description": "\u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\u0dc1 \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0dc4\u0dbd\u0dcf\u0dc0\u0dad \u0dbb\u0ddd\u0dc4\u0dbd\u0dda \u0dc3\u0dd0\u0db4 \u0daf\u0dd4\u0d9a\u0dca \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0dba\u0dba\u0dd2",
