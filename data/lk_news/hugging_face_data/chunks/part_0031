    "description": "\u0d85\u0dad\u0dca\u200d\u0dba\u0dcf\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dc3\u0dda\u0dc0\u0dcf \u0dc4\u0dd0\u0dbb \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0dbb\u0da2\u0dba\u0dda \u0d86\u0dba\u0dad\u0db1 \u0dc4\u0dd9\u0da7 \u0db1\u0dd2\u0dc0\u0dcf\u0da9\u0dd4",
