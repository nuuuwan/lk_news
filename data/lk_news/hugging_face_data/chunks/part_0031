    "description": "\u0d85\u0db0\u0dd2\u0dc0\u0dda\u0d9c\u0dd3 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1\u0dba \u0db1\u0ddc\u0db8\u0dd2\u0dbd\u0dda",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d85\u0db0\u0dc0\u0d9c-\u0db8\u0dbb\u0d9c\u0dba-\u0d9c\u0db8\u0db1-\u0d9c\u0db8\u0db1\u0dba-\u0db1\u0db8\u0dbd/1-684053",
