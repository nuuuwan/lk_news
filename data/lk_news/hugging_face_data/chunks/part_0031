    "description": "Sri Lanka moves toward electronic invoicing with RAMIS upgrade",
    "url_metadata": "https://www.ft.lk/news/Sri-Lanka-moves-toward-electronic-invoicing-with-RAMIS-upgrade/56-785139",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1764716223.0,
