    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d89\u0db1\u0daf\u0dba\u0dc0\u0db1-\u0dad\u0dc0\u0dad-\u0d86\u0db0\u0dbb-\u0dba\u0db1\u0dba\u0d9a/1-684188",
