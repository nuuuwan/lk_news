    "description": "\u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb, \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0db1\u0d9c\u0dbb \u0dc0\u0dd9\u0dad \u0d9c\u0ddc\u0da9\u0db6\u0dd2\u0db8\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dc3\u0db6\u0db3\u0dad\u0dcf \u0dba\u0dae\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0da7",
