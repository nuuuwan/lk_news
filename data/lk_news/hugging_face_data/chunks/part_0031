    "chunk_text": "\u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb\u0dba\u0da7\u0dad\u0dca \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dad\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca\n\n\u0d9a\u0dbd\u0dd4, \u0dc0\u0dda, \u0daf\u0dd9\u0db1\u0dc0\u0d9a\u0dca, \u0dc4\u0d82\u0d9c\u0db8\u0dd4, \u0d9a\u0dd4\u0dbb\u0dd4 \u0dba\u0db1 \u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9c\u0d82\u0d9c\u0dcf \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dbd \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8\u0dca \u0d89\u0dc4\u0dc5 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d91\u0db8 \u0d9c\u0d82\u0d9c\u0dcf\u0dc0\u0dbd \u0dc3\u0dca\u0dae\u0dcf\u0db4\u0dd2\u0dad \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9c\u0dc0\u0dd3\u0db8\u0dda \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2 \u0daf\u0dad\u0dca\u0dad \u0d85\u0db1\u0dcf\u0dc0\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0dba\u0dd2.\n\n\u0d9a\u0dbd\u0dd4 \u0d9c\u0d9c\u0dda \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8 28\u0daf\u0dcf \u0d85\u0dbd\u0dd4\u0dba\u0db8 \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0db8\u0dd3\u0da7\u0dbb\u0dca 7.780 \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0dd3\u0dba. \u0d91\u0dba \u0dc3\u0dd4\u0dc5\u0dd4 \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dd2.\n\n\u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb , \u0d87\u0dbd\u0db4\u0dcf\u0dad, \u0db1\u0dd2\u0dc0\u0dd2\u0dad\u0dd2\u0d9c\u0dbd , \u0d9a\u0dc4\u0dc0\u0dad\u0dca\u0dad ,\u0d9a\u0dbd\u0dc0\u0dcf\u0db1 , \u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 , \u0d9a\u0dd2\u0dbb\u0dd2\u0d87\u0dbd\u0dca\u0dbd , \u0d85\u0dba\u0d9c\u0db8, \u0d86\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0dbb\u0dd0\u0dc3\u0d9a \u0db4\u0dc4\u0dad\u0dca \u0db6\u0dd2\u0db8\u0dca \u0da2\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0d87\u0dad . \u0db4\u0dc4\u0dad\u0dca \u0db6\u0dd2\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0da2\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1\u0dba \u0d87\u0db1\u0dc4\u0dd2\u0da7 \u0d87\u0dad. \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0daf \u0da2\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda. \u0dc0\u0dd3 \u0dc0\u0d9c\u0dcf\u0d9a\u0dc5 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0d9a\u0dbb \u0dc3\u0dd2\u0dba \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0daf \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0d87\u0dad.\n\n\u0db6\u0dd0\u0d9a\u0ddd \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb \u0dba\u0ddc\u0daf\u0dcf \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dcf\u0db1\u0dd4\u0dc3\u0dcf\u0dbb\u0dba\u0dd9\u0db1\u0dca \u0d9a\u0db4\u0db1 \u0db8\u0dd0\u0dab\u0dd2\u0d9a\u0dca \u0db4\u0dad\u0dbd\u0dca \u0dbb\u0dd0\u0dc3\u0d9a\u0dca \u0daf \u0da2\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dda. \u0d86\u0db4\u0daf\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0dbd\u0d9a\u0dca\u0dc0\u0dd6 \u0db6\u0ddc\u0dc4\u0ddd \u0daf\u0dd9\u0db1\u0d9a\u0dd4 \u0db1\u0dd1\u0daf\u0dd1 \u0d9c\u0dd9\u0dc0\u0dbd\u0dca\u0dc0\u0dbd \u0dc3\u0dc4 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0dc0\u0dbd\u0da7 \u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2\u0db6\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dbd\u0dda\u0d9a\u0db8\u0dca\u0dc0\u0dbb\u0dd4 \u0d9a\u0dd2\u0dba\u0dad\u0dd2."
  },
