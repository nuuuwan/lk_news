    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d9a\u0dc5\u0db9\u0da7\u0dad-\u0db8\u0dc4-\u0d9c\u0dc0\u0dad\u0dbb-\u0d85\u0db1\u0dad\u0dbb-\u0d87\u0d9f\u0dc0\u0db8/1-684065",
