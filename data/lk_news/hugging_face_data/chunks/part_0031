    "chunk_text": "\u0d9a\u0dd9\u0da7\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0d9a\u0dd2\u0dc0\u0dc4\u0ddc\u0dad\u0dca, \u0db4\u0dc4\u0dad \u0d8b\u0dad\u0dca\u0dc3\u0dcf\u0dc4\u0dba\u0db1\u0dca \u0d9a\u0dd9\u0da7\u0dd2\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0d89\u0dbd\u0d9a\u0dca\u0d9a \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0da7 \u0daf\u0dd2\u0d9c\u0dd4\u0d9a\u0dcf\u0dbd\u0dd3\u0db1 \u0da2\u0dcf\u0dad\u0dd2\u0dba \u0d9c\u0ddc\u0da9 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0db8 \u0d9a\u0dbb\u0dcf \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0db1 \u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dd8\u0dad\u0dd2\u0d9a \u0dc0\u0dd9\u0db1\u0dc3\u0d9a\u0dca \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0dba\u0dd2.\n\n\u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0dc0\u0dd2\u0db1\u0dba \u0dc3\u0dc4 \u0dab\u0dba \u0dad\u0dd2\u0dbb\u0dc3\u0dcf\u0dbb\u0db7\u0dcf\u0dc0\u0dba, \u0d86\u0daf\u0dcf\u0dba\u0db8\u0dca \u0d9c\u0ddc\u0da9 \u0db1\u0dd0\u0d82\u0dc0\u0dd3\u0db8 \u0dc3\u0dc4 \u0db6\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab, \u0dc3\u0db8\u0dcf\u0da2 \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dab\u0dba \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd2\u0dba\u0daf\u0db8\u0dca \u0dad\u0dcf\u0dbb\u0dca\u0d9a\u0dd2\u0d9a\u0d9a\u0dbb\u0dab\u0dba, \u0dc0\u0dca\u200d\u0dba\u0dd4\u0dc4\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dc3\u0dc4 \u0db4\u0dcf\u0dbd\u0db1\u0dba, \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0da7 \u0db1\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0d86\u0dba\u0ddd\u0da2\u0db1"
  },
