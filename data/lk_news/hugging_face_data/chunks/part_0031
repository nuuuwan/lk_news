    "url_metadata": "https://www.lankadeepa.lk/news/\u0db8\u0dc4\u0dba\u0d9c\u0db1-\u0dbb\u0dc4\u0dbd-\u0d95-\u0db4-\u0da9-\u0d85\u0dbb/101-684410",
