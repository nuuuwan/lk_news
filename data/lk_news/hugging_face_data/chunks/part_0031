    "description": "HNB Assurance recognized with the Best Well-being Initiative for Working Parents",
    "url_metadata": "http://island.lk/hnb-assurance-recognized-with-the-best-well-being-initiative-for-working-parents/",
    "lang": "en",
    "newspaper_id": "islandlk",
