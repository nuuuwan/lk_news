    "url_metadata": "https://www.lankadeepa.lk/news/\u0dbb-\u0daf\u0dc5\u0dc4-\u0dc0\u0dc0\u0daf\u0dba\u0da7-\u0db8\u0db1\u0dad\u0dbb-\u0dc0\u0dbb\u0db0\u0dba\u0d9a/101-684289",
