    "description": "Rebuilding Sri Lanka beyond the catastrophe",
    "url_metadata": "https://www.ft.lk/columns/Rebuilding-Sri-Lanka-beyond-the-catastrophe/4-785243",
    "lang": "en",
    "newspaper_id": "dailyftlk",
