    "num": "dailyftlk-49dfbfaa",
    "date_str": "2025-12-05",
    "description": "Humanities, Arts and Social Sciences under pressure",
    "url_metadata": "https://www.ft.lk/news/Humanities-Arts-and-Social-Sciences-under-pressure/56-785245",
