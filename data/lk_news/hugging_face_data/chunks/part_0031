    "url_metadata": "https://www.ada.lk/breaking_news/\u0daf\u0dd2\u0da7\u0dca\u0dc0\u0dcf-\u0db1\u0dd2\u0dc3\u0dcf-\u0dc5\u0db8\u0dba\u0dd2-275000\u0d9a\u0dca-\u0db4\u0dd3\u0da9\u0dcf\u0dc0\u0da7/11-420029",
