    "chunk_text": "\u0d85\u0db4\u0dd2 \u0d86\u0d9c\u0db8\u0dd2\u0d9a \u0dc0\u0dad\u0dcf\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dc3\u0dd2 \u0daf\u0dd9\u0dba\u0d9a\u0dca \u0d85\u0da9\u0dd4 \u0db1\u0dd0\u0dad\u0dd4\u0dc0 \u0dc3\u0dd2\u0daf\u0dca\u0db0 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0d85\u0db4\u0dda \u0dc0\u0dad\u0dcf\u0dc0\u0dad\u0dca, \u0da0\u0dcf\u0dbb\u0dd2\u0dad\u0dca\u200d\u0dbb \u0d92 \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dbd\u0db8 \u0dc3\u0dd2\u0daf\u0dca\u0db0\u00a0 \u0d9a\u0dbb\u0db1\u0dc0\u0dcf. \u0d92 \u0dc0\u0d9c\u0dda\u0db8 \u0db8\u0dda \u0dc0\u0dca\u200d\u0dba\u0dc3\u0db1\u0dba\u0dd9\u0db1\u0dca \u0dc0\u0dd2\u0db4\u0dad\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0dd9\u0da0\u0dca\u0da0 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dba\u0dd9\u0db1\u0dca\u0db8 \u0db8\u0dd2\u0dba \u0db4\u0dbb\u0dbd\u0ddc\u0dc0 \u0d9c\u0dd2\u0dba\u00a0 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0daf\u0dd9\u0db1\u0dcf\u0da7\u0db8 \u0db4\u0dd4\u0dab\u0dca\u200d\u0dba\u0dcf\u0db1\u0dd4\u0db8\u0ddd\u0daf\u0db1\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dad\u0dca,\u00a0 \u0d92 \u0dc0\u0d9c\u0dd9\u0db8 \u0daf\u0dd0\u0db1\u0da7 \u0dbb\u0ddd\u0d9c\u0dcf\u0dad\u0dd4\u0dbb\u0dc0\u00a0 \u0d85\u0dc3\u0dbb\u0dab\u0dc0 \u0d89\u0db1\u0dca\u0db1 \u0d85\u0dba\u0da7 \u0d86\u0dc1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0daf\u00a0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf\u0dad\u0dca \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0d86\u0dc1\u0dd2\u0dbb\u0dca\u0dc0\u0dcf\u0daf \u0db6\u0ddd\u0db0\u0dd2 \u0db4\u0dd6\u0da2\u0dcf\u0dc0\u0d9a\u0dca\u00a0 \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1 \u0db6\u0dbd\u0dcf\u0db4\u0ddc\u0dbb\u0ddc\u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0dd9\u0db1\u0dc0\u0dcf.\n\n\u0db1\u0db8\u0dd4\u0dad\u0dca \u0d85\u0db4\u0dd2 \u0daf\u0dd4\u0dbb \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0d9c\u0dd9\u0dc0\u0dcf\u0d9c\u0dd9\u0db1 \u0d91\u0db1\u0dca\u0db1 \u0d91\u0db4\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1\u0dda, \u0d94\u0db6 \u0daf\u0dd4\u0dbb \u0db6\u0dd0\u0dc4\u0dd0\u0dbb \u0d89\u0db3\u0dbd\u0dcf \u0d91\u0db1\u0dc0\u0db1\u0db8\u0dca, \u0d9a\u0ddc\u0dc4\u0dda \u0dc4\u0dbb\u0dd2 \u0db1\u0dc0\u0dad\u0dd2\u0db1\u0dca\u0db1 \u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dc0\u0dd9\u0db1\u0dc0\u0dcf. \u0d92 \u0db1\u0dc0\u0dcf\u0dad\u0dd0\u0db1\u0dca \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca \u0dc0\u0dd9\u0db1\u0daf \u0dc0\u0d9c\u0dda \u0daf\u0dd9\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dc3\u0dd2 \u0d9a\u0dd9\u0db1\u0dd9\u0d9a\u0dd4\u0da7 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0d9a\u0db8\u0d9a\u0dca\u00a0 \u0db1\u0dd0\u0dc4\u0dd0."
  },
