    "chunk_text": "\u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0db8\u0dd2\u0dc5 \u0d85\u0da9\u0dd4 \u0dc0\u0dd9\u0db1\u0dca\u0db1 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0db1\u0dd3\n\n\u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0db4\u0dd4\u0dbb\u0dcf \u0db6\u0dbd\u0db4\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dad\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d87\u0dad\u0dd2 \u0dc0\u0dd6 \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dba\u0dba\u0dd1\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0d9c\u0ddc\u0dc0\u0dd2 \u0db6\u0dd2\u0db8\u0dca \u0dc4\u0dc3\u0dd4 \u0dc0\u0dd3 \u0dc0\u0dc5\u0dc0\u0dc5\u0dd4 \u0dc0\u0d9c\u0dcf\u0dc0\u0db1\u0dca \u0dc0\u0dd2\u0db1\u0dcf\u0dc1 \u0dc0\u0dd3\u00a0 \u0dba\u0dcf\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dd2\u0db1 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba \u0dad\u0dd4\u0dbd \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0dbd\u0dd9\u0dc3 \u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0db8\u0dd2\u0dc5\u00a0 \u0d85\u0daf 03 \u0dc0\u0db1\u0daf\u0dcf \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dc0\u0dbd \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a\u0dba\u0ddd \u0dc3 \u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0dad\u0dd2.\n\n\u0d9a\u0da7\u0dd4\u0d9c\u0dc3\u0dca\u0dad\u0ddc\u0da7 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0dda \u0dad\u0ddc\u0d9c \u0dc0\u0dd9\u0dc5 \u0db3 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0dda \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0da9\u0dd3.\u0d91\u0db1\u0dca \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0db8\u0dc4\u0dad\u0dcf\u00a0 \u0db8\u0dda \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca\u00a0 \u00a0\u0d85\u0daf\u0dc4\u0dc3\u0dca \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0db3\u0dc4\u0db1\u0dca\u00a0 \u0d9a\u0dc5\u0dda \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0daf\u0dd2\u0db1\u0dc0\u0dbd\u00a0 \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0dbd\u0dd0\u0db6\u0dd3\u0db8 \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0dad\u0ddc\u0d9c \u0db8\u0dd2\u0dc5 \u0d9c\u0dab\u0db1\u0dca \u0d85\u0daf \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dd9\u0db1 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dba\u0dd2.\u0db8\u0dda \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u200d\u0dba\u0dd9\u0db1\u0dca \u0dad\u0dc0 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd6 \u0dad\u0ddc\u0d9c \u0dc0\u0dd9\u0dc5\u0db3 \u0dc3\u0d82\u0d9c\u0db8\u0dba\u0dda \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0da9\u0dd2.\u0d91\u0db1\u0dca. \u0dc3\u0dd2\u0dbd\u0dca\u0dc0\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0db8\u0dd9\u0dc3\u0dda \u0daf \u0d9a\u0dd3\u0dba.\n\n\u201c \u0d85\u0daf \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0db8\u0dd2\u0dbd \u0dba\u0db8\u0dca \u0d9a\u0dd2\u0dc3\u0dd2 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.\u0d91\u0dc5\u0dc0\u0dc5\u0dd4\u00a0 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0db1\u0dba \u0d85\u0db4\u0dc4\u0dc3\u0dd4 \u0dc0\u0dd4\u0db1 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd2\u0dc5 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dad\u0dca \u0d85\u0daf \u0dbd\u0dd3\u0d9a\u0dca\u0dc2\u0dca 400 \u0dba\u0dd2 450 \u0dba\u0dd2.\u0d9a\u0dd0\u0dbb\u0da7\u0dca 400 \u0dba\u0dd2 450 \u0dba\u0dd2 .\u0d92 \u0dc0\u0d9c\u0dda \u0dbd\u0ddc\u0d9a\u0dd4 \u0db8\u0dd4\u0daf\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd4 \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0dc4\u0daf\u0dbd \u0daf\u0dd4\u0db1\u0dca\u0db1\u0ddc\u0dad\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0db6\u0da9\u0dd4 \u0d9c\u0db1\u0dca\u0db1 \u0d91\u0dba\u0dd2.\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0db8\u0dd2\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0db8\u0dd2\u0dc5\u00a0 \u0d85\u0da9\u0dd4 \u0dc0\u0dd9\u0dba\u0dd2. \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0dbd\u0dd0\u0db6\u0dd3\u0db8\u0dda \u0dba\u0db8\u0dca \u0d85\u0da9\u0dd4\u0dc0\u0d9a\u0dca \u0dad\u0dc0\u0db8\u0dad\u0dca \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0d92\u0d9a\u0da7 \u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0dc0\u0dc3\u0dcf \u0dad\u0dd0\u0db6\u0dd3\u0db8\u0dba\u0dd2.\u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba\u0dda \u0dbd\u0dd3\u0d9a\u0dca\u0dc3\u0dca 200 \u0db8\u0dd9\u0dc4\u0dda 400 \u0dba\u0dd2.\u0db4\u0dcf\u0dbb\u0dc0\u0dbd\u0dca \u0dc4\u0dd0\u0daf\u0dd4\u0db1\u0ddc\u0dad\u0dca \u0db4\u0ddd\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dca\u0dc3\u0dda \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0db8\u0dd2\u0dc5 \u0db8\u0dd3\u0da7\u0dad\u0dca \u0dc0\u0da9\u0dcf \u0d85\u0da9\u0dd4 \u0dc0\u0dd9\u0dba\u0dd2.\n\n\u0d85\u0daf \u0dc0\u0dd9\u0dc5\u0db3 \u0db4\u0ddc\u0dc5\u0da7 \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.\u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dd2\u0dc5 \u0dba\u0db8\u0dca \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0da7 \u0d85\u0da9\u0dd4 \u0dc0\u0dd9\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.\u0d85\u0db8\u0dd4\u0db8\u0dd2\u0dbb\u0dd2\u0dc3\u0dca \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 250 \u0dba\u0dd2 \u0d9a\u0dd0\u0dbb\u0da7\u0dca 350 \u0dba\u0dd2 400 \u0dba\u0dd2\u00a0 \u0d9c\u0ddd\u0dc0\u0dcf \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 70 \u0dba\u0dd2 80 \u0dba\u0dd2.\u0dad\u0d9a\u0dca\u0d9a\u0dcf\u0dbd\u0dd2 300 \u0dba\u0dd2 350 \u0dba\u0dd2.\u00a0 \u0dbd\u0dd3\u0d9a\u0dca\u0dc2 400 \u0dba\u0dd2.\u0d85\u0daf \u0d91\u0dc5\u0dc0\u0dc5\u0dd4 \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dbd\u0dd0\u0db6\u0dd2\u0dbd \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0dda\u0daf\u0dd3 \u0dad\u0dad\u0dc0\u0dba \u0dba\u0dae\u0dcf \u0dad\u0dad\u0dca\u0dc0\u0dba\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd9\u0dba\u0dd2.\u0dba\u0dd0\u0dba\u0dd2\u0daf \u0d9a\u0dd3\u0dba."
