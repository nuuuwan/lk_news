    "description": "\u0da2\u0dbd \u0d9c\u0dd0\u0dbd\u0dd3\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0dc5\u0dd2\u0d82 \u0da2\u0dbd\u0dba \u0db4\u0dcf\u0db1\u0dba \u0db4\u0dbb\u0dd2\u0dc3\u0dca\u0dc3\u0db8\u0dd9\u0db1\u0dca",
