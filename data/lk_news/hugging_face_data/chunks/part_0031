    "chunk_text": "\u0d9a\u0daf\u0db4\u0ddc\u0dc5 \u0d85\u0dad\u0dd4\u0dbb\u0dd4\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dd6 \u0d91\u0d9a\u0db8 \u0db4\u0dc0\u0dd4\u0dbd\u0dda \u0dc3\u0dd2\u0dc0\u0dca \u0daf\u0dd9\u0db1\u0dcf \u0dc3\u0ddc\u0dba\u0dcf \u0dba\u0dd4\u0daf \u0dc4\u0db8\u0dd4\u0daf\u0dcf\u0dc0 \u0db8\u0dd9\u0dc4\u0dd9\u0dba\u0dd4\u0db8\u0d9a\n\n\u0d9a\u0daf\u0db4\u0ddc\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0da7 \u0d87\u0daf\u0dc4\u0dd0\u0dbd\u0dd4\u0dab\u0dd4 \u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0d9a\u0daf\u0db4\u0ddc\u0dbd \u0da0\u0db1\u0dca\u0daf\u0dd2\u0dbb\u0dd2\u0d9c\u0db8 \u0db1\u0dcf\u0dba\u0dba\u0dd0\u0db8\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0dad\u0dd4\u0dbb\u0dd4\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dd6 \u0db8\u0dc0, \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0daf\u0dd9\u0daf\u0dd9\u0db1\u0dcf \u0dc3\u0dc4 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0daf\u0dd9\u0daf\u0dd9\u0db1\u0dcf\u0d9c\u0dda \u0db8\u0dd2\u0dad\u0dca\u0dad\u0db1\u0dd2\u0dba \u0dc3\u0ddc\u0dba\u0dcf \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dbd\u0dd2\u0dba \u0dc3\u0dd2\u0d82\u0dc4 \u0dbb\u0dd9\u0da2\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0db7\u0da7 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dd2 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca (01) \u0daf\u0dd2\u0db1 \u0db8\u0dd9\u0dc4\u0dd9\u0dba\u0dd4\u0db8\u0d9a\u0dca \u0daf\u0dd2\u0dba\u0dad\u0dca \u0d9a\u0dbd\u0dc4.\n\n\u0d89\u0d9a\u0dd4\u0dad\u0dca (27) \u0daf\u0dd2\u0db1 \u0daf\u0dc4\u0dc0\u0dbd\u0dca \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb \u0daf\u0dda\u0dc1\u0dba\u0da7 \u0d87\u0daf\u0dc4\u0dd0\u0dbd\u0dd4\u0dab\u0dd4 \u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0db1\u0dd2\u0dc0\u0dc3 \u0db8\u0dc3\u0d9c \u0db1\u0dcf\u0dba \u0dba\u0db1 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0d91\u0db8 \u0dc3\u0dd2\u0dc0\u0dca \u0daf\u0dd9\u0db1\u0dcf \u0db4\u0db8\u0dab\u0d9a\u0dca \u0db1\u0dd2\u0dc0\u0dc3\u0dda \u0dbb\u0dd0\u0daf\