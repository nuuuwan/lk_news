    "description": "\u0d8b\u0dc3\u0dc3\u0dca \u0db4\u0dd9\u0dc5 \u0dc3\u0dd9\u0db1\u0dc3\u0dd4\u0dbb\u0dcf\u0daf\u0dcf\u0dad\u0dca \u0db1\u0dd1",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d8b\u0dc3\u0dc3-\u0db4\u0dc5-\u0dc3\u0db1\u0dc3\u0dbb\u0daf\u0dad-\u0db1/1-684010",
    "lang": "si",
