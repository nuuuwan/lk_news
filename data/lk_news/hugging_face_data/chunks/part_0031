    "description": "Self-censorship in media has no place in democratic jurisdictions",
    "url_metadata": "https://www.ft.lk/columns/Self-censorship-in-media-has-no-place-in-democratic-jurisdictions/4-784976",
    "lang": "en",
    "newspaper_id": "dailyftlk",
