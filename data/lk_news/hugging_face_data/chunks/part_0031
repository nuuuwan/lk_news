    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0daf\u0da7\u0dc0-\u0db1\u0dc3-\u0dad\u0daf-\u0dc3\u0dc5-\u0dc3\u0db8\u0d9c-\u0dad\u0daf-\u0dc0\u0dc3/1-684048",
