    "description": "\u0d85\u0db1\u0dad\u0dd4\u0dbb\u0da7 \u0db4\u0dad\u0dca \u0dba\u0dcf\u0db1\u0dba\u0dda \u0db1\u0dd2\u0dba\u0db8\u0dd4\u0dc0\u0dcf \u0d85\u0dc0\u0dcf\u0dc3\u0db1\u0dcf\u0dc0\u0db1\u0dca\u0dad \u0dbd\u0dd9\u0dc3 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0dba \u0dc4\u0dd0\u0dbb\u0dba\u0dba\u0dd2",
