    "description": "\u0dc3\u0dd4\u0dc5\u0dd2\u0dba\u0da7 \u0d85\u0dc4\u0dd4\u0dc0\u0dd4\u0dab\u0dd4 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba",
