    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d9c\u0db8\u0db4\u0dc4-\u0db4\u0dbb-\u0dc3-\u0d85\u0dba-\u0dc0\u0dba-\u0dc0\u0da9-\u0da1\u0db1\u0daf-21-\u0d9a\u0db1-\u0dc3\u0db8\u0db8\u0dad\u0dba/1-684703",
    "lang": "si",
