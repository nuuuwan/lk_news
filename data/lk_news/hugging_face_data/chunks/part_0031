    "description": "\u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dbd\u0dca \u0dc3\u0dd2\u0dba\u0db9\u0dbd\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba: \u0dc1\u0dcf\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0dad\u0dd2 \u0d8b\u0db4\u0dcf\u0db0\u0dd2\u0dba \u0dbd\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0daf\u0dd2\u0db1 \u0dad\u0dd4\u0db1\u0d9a\u0da7 \u0db4\u0dd9\u0dbb \u0dc4\u0dd9\u0dbd\u0dd2\u0d9a\u0ddc\u0db4\u0dca\u0da7\u0dbb\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0db8\u0dd2\u0dba\u0d9c\u0dd2\u0dba \u0db1\u0dd2\u0dba\u0db8\u0dd4\u0dc0\u0dcf",
