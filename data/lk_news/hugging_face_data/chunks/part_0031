    "chunk_text": "\u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0ddc\u0dbb\u0da7\u0dd4 \u0d85\u0dbb\u0dd2\u0dba\u0dd2\n\n\u0d87\u0daf\u0dc4\u0dd0\u0dbd\u0dd9\u0db1 \u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0db4\u0dad\u0db1\u0dba\u0dad\u0dca \u0dc3\u0db8\u0d9c \u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda \u0da2\u0dbd\u0dcf\u0dc1\u0dba \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0da2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0\u0dba\u0da7 \u0dbd\u0d9c\u0dcf\u0dc0\u0dd2\u0db8 \u0dc0\u0db1 \u0d85\u0d9a\u0dca\u0d9a\u0dbb \u0d85\u0da9\u0dd2 114,000 \u0d9a \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd4\u0dbb\u0dca\u0dab\u0dc0\u0dd2\u0db8\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dda \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0ddc\u0dbb\u0da7\u0dd4 \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dbd\u0db8\u00a0 \u0d8a\u0dba\u0dda (27) \u0dbb\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dda \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dc5 \u0db6\u0dc0 \u0da2\u0dbd\u0dcf\u0dc1\u0dba \u0db7\u0dcf\u0dbb \u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4 \u0da0\u0dd2\u0db1\u0dca\u0dad\u0d9a \u0d91\u0dc3\u0dca.\u0dc3\u0dd4\u0dbb\u0dc0\u0dd2\u0dbb \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba.\n\n\u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dc4\u0dcf \u0d92 \u0d85\u0dc0\u0da7 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0da7 \u0db6\u0dbd\u0db4\u0dd1 \u0d87\u0dad\u0dd2 '\u0daf\u0dd2\u0dad\u0dca\u0dc0\u0dcf' \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0dda \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0dad\u0dca\u00a0 \u0dc3\u0db8\u0d9c \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dda \u0d89\u0dc4\u0dc5 \u0da2\u0dbd \u0db4\u0ddd\u0dc2\u0d9a \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0db4\u0dad\u0db1 \u0dc4\u0dcf \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0da7 \u0da2\u0dbd\u0dba \u0dbd\u0dd0\u0db6\u0dd9\u0db1\u00a0 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dda\u0daf\u0dba\u0d9a\u0dca \u0dc0\u0db1 \u0db8\u0dd2\u0db1\u0dca\u0db1\u0dda\u0dbb\u0dd2\u0dba \u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda \u0dba\u0ddd\u0db0 \u0d87\u0dbd\u0dd9\u0dc4\u0dd2 \u0d9c\u0dbd\u0dcf\u0d91\u0db1 \u0d85\u0d9b\u0dab\u0dca\u0da9 \u0da2\u0dbd \u0dc3\u0db8\u0d9c \u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda \u0d9c\u0ddc\u0dc0\u0dd2\u0db6\u0dd2\u0db8\u0dca \u0dba\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd2\u0db8 \u0dc4\u0dcf \u0da2\u0dbd\u0dcf\u0dc1\u0dba \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0dda \u0d85\u0dbb\u0db8\u0dd4\u0dab\u0dd2\u0db1\u0dca \u0db8\u0dd9\u0dbd\u0dd9\u0dc3 \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dda \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0ddc\u0dbb\u0da7\u0dd4 06 \u0d9a\u0dca \u0d85\u0da9\u0dd2 03 \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0daf \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0ddc\u0dbb\u0da7\u0dd4 04 \u0d9a\u0dca \u0d85\u0da9\u0dd2 01 \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb \u0d87\u0dad.\n\n\u0d91\u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dad\u0db4\u0dca\u0db4\u0dba\u0da7 \u0d9d\u0dab \u0d85\u0da9\u0dd2 4010\u00a0 \u0d9a \u0da2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0daf \u0d91\u0db8 \u0da2\u0dbd\u0dba \u0db1\u0dd2\u0dc3\u0dcf \u0db4\u0dda\u0dbb\u0db8\u0da9\u0dd4\u0dc0 \u0dc4\u0dcf \u0dc0\u0dcf\u0db1\u0dca\u0d87\u0dbd \u0dc0\u0dd0\u0dc0\u0dca \u0db4\u0dd2\u0da7\u0dcf\u0dbb \u0daf\u0db8\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0db8 \u0da2\u0dbd\u0dba\u0dad\u0dca \u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda , \u0dc0\u0dcf\u0db1\u0dca\u0d87\u0dbd \u0dc4\u0dcf \u0dc3\u0dd4\u0dbb\u0dd2\u0dba\u0db4\u0dd4\u0dbb \u0dc4\u0dbb\u0dc4\u0dcf \u0db8\u0dc4\u0dc0\u0dd0\u0dbd\u0dd2 \u0d9c\u0d9f\u0da7 \u0db8\u0dd4\u0daf\u0dcf \u0dc4\u0dbb\u0dd2\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0db8\u0dc4\u0dc0\u0dd0\u0dbd\u0dd2 \u0d9c\u0d9c\u0dda\u00a0 \u0d9a\u0db1\u0dca\u0dad\u0dbd\u0dda \u0daf\u0dca\u200d\u0dbb\u0ddd\u0dab\u0dd2\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0daf\u0dc0 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dd2\u0db8\u0dad\u0dca\u0dc0\u0db1 \u0dbd\u0dd9\u0dc3\u0daf \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba."
