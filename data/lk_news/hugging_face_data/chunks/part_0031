    "description": "\u0d86\u0db4\u0daf\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0daf\u0dd3 \u0db4\u0dd3\u0da9\u0dcf\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0db1 \u0d94\u0db6\u0dda \u0db8\u0db1\u0dc3 \u0db1\u0dd2\u0dbb\u0dc0\u0dd4\u0dbd\u0dca\u0dc0 \u0dad\u0db6\u0dcf \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0dc0\u0db1 \u0d9a\u0dbb\u0dd4\u0dab\u0dd4 6\u0d9a\u0dca",
