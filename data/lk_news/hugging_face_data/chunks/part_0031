    "description": "\u0dc3\u0da2\u0db6\u0dba\u0da7 \u0db6\u0dbd\u0dba \u0dc4\u0dd2\u0db8\u0dd2 \u0d85\u0d9a\u0dd4\u0dbb\u0dab \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d92\u0d9a\u0db8\u0dad\u0dd2\u0d9a\u0dc0 \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/breaking_news/\u0dc3\u0da2\u0db6\u0dba\u0da7-\u0db6\u0dbd\u0dba-\u0dc4\u0dd2\u0db8\u0dd2-\u0d85\u0d9a\u0dd4\u0dbb\u0dab-\u0dc3\u0db7\u0dcf\u0dc0\u0dda-\u0d85\u0dba\u0dc0\u0dd0\u0dba-\u0d92\u0d9a\u0db8\u0dad\u0dd2\u0d9a\u0dc0-\u0dc3\u0db8\u0dca\u0db8\u0dad\u0dba\u0dd2/11-419933",
