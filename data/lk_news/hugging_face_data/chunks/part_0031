    "description": "\u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0db1\u0ddc\u0dad\u0d9a\u0dcf \u0dc3\u0dd2\u0dba \u0d85\u0dc3\u0dbd\u0dca\u0dc0\u0dd0\u0dc3\u0dd2\u0dba\u0db1\u0dca \u0dc3\u0ddc\u0dba\u0dcf \u0dc0\u0dd9\u0dc4\u0dd9\u0dc3\u0dd9\u0db1 \u0d9c\u0db8\u0dca\u0dc0\u0dcf\u0dc3\u0dd3\u0db1\u0dca: '\u0db8\u0dda \u0dc5\u0db8\u0dba\u0dc0 \u0db4\u0dd0\u0dba\u0d9a\u0da7 \u0d89\u0dc3\u0dca\u0dc3\u0dd9\u0dbd\u0dca\u0dbd\u0dcf \u0db6\u0dda\u0dbb \u0d9c\u0db1\u0dca\u0db1 \u0dad\u0dd2\u0db6\u0dca\u0db6\u0dcf'",
