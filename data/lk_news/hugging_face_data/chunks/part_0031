    "description": "Uber partners Sri Lanka Red Cross Society",
    "url_metadata": "https://www.ft.lk/business/Uber-partners-Sri-Lanka-Red-Cross-Society/34-785194",
    "lang": "en",
    "newspaper_id": "dailyftlk",
