    "url_metadata": "https://www.lankadeepa.lk/news/\u0db4\u0dbb\u0daf\u0db1\u0dba-\u0db8\u0dbd\u0dc0\u0dad\u0dad-\u0dba\u0dc5-\u0d91\u0dc5\u0dba-\u0d9a\u0dbb\u0db1-\u0dc0\u0da9-\u0d85\u0dbb\u0db9\u0dba/101-684739",
