    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0dc4\u0dc0\u0dbd-\u0d9c\u0d9f-\u0dc0\u0dc3-\u0d9c\u0dad-\u0db8\u0db1\u0db8\u0db4\u0da7\u0dba/1-684146",
