    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d9a\u0db6-\u0d9c\u0db1\u0db1-\u0dc0\u0db1-\u0d9a\u0dc5-\u0dc3\u0dbd\u0dbd-\u0d86\u0db4\u0daf\u0dc0\u0da7-\u0daf\u0db1\u0db1/1-684241",
