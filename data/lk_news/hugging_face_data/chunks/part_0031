    "url_metadata": "https://www.ada.lk/breaking_news/\u0dbb\u0dcf\u0da2\u0dcf\u0d82\u0d9c\u0db1\u0dba--\u0d85\u0d82\u0d9c\u0db8\u0dd4\u0dc0-\u0dc0\u0dcf\u0db1\u0dca-\u0daf\u0db8\u0dba\u0dd2--\u0d9a\u0dc5\u0dcf-\u0d94\u0dba-\u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca/11-419910",
