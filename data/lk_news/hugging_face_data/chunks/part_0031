    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dc3\u0d9b\u0dba-\u0d9c\u0da7\u0dbd-\u0d9c\u0db1-\u0d85\u0dc4\u0db1\u0db1-\u0dc4\u0daf\u0dc3-\u0d87\u0db8\u0dad\u0db8-\u0d85\u0d9a\u0dba\u0d9a/1-684199",
