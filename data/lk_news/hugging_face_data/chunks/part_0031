    "description": "US provides $ 2 m assistance to  Sri Lanka\u2019s disaster response effort",
    "url_metadata": "https://www.ft.lk/news/US-provides-2-m-assistance-to-Sri-Lanka-s-disaster-response-effort/56-785191",
    "lang": "en",
    "newspaper_id": "dailyftlk",
