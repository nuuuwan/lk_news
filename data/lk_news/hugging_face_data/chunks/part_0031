    "description": "Global humanitarian support flows into Sri Lanka",
    "url_metadata": "https://www.ft.lk/news/Global-humanitarian-support-flows-into-Sri-Lanka/56-785147",
    "lang": "en",
    "newspaper_id": "dailyftlk",
