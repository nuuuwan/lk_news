    "url_metadata": "https://www.adaderana.lk/news/111967/over-14800-children-reported-in-vulnerable-situations-in-sri-lanka",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756434060.0,
