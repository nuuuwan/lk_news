    "description": "\u0dc4\u0dd2\u0da7\u0db4\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0dbb\u0db1\u0dd2\u0dbd\u0dca\u0dc0 \u0db6\u0dbd\u0db1\u0dca\u0db1 \u0db8\u0dc4 \u0dbb\u0dd1 \u0db6\u0db1\u0dca\u0db0\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7 \u0d9c\u0dd2\u0dba \u0daf\u0dd4\u0db8\u0dd2\u0db1\u0dca\u0daf, \u0db4\u0dca\u200d\u0dbb\u0dc3\u0db1\u0dca\u0db1 \u0dc3\u0dc4 \u0da0\u0dcf\u0db8\u0dbb",
