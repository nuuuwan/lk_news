    "description": "SC begins hearing petitions against bill to revoke privileges of former Presidents",
    "url_metadata": "https://www.adaderana.lk/news/111815/sc-begins-hearing-petitions-against-bill-to-revoke-privileges-of-former-presidents",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756102980.0,
