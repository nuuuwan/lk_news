    "description": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0d9a\u0da9\u0dd4\u0dbd\u0dd4 4\u0d9a \u0da2\u0dba\u0d9a\u0dca",
    "url_metadata": "http://sinhala.adaderana.lk/news/214137",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
