    "description": "2025 \u0dc0\u0dc3\u0dbb\u0dda \u0d9a\u0dd3\u0dbb\u0dca\u0dad\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0da1\u0dcf\u0dba\u0dcf\u0dbb\u0dd6\u0db4 \u0dc1\u0dd2\u0dbd\u0dca\u0db4\u0dd2\u0dba\u0dcf \u0dbd\u0dd9\u0dc3 \u0dbd\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0dbb\u0dad\u0dca\u0db1 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0dbd\u0db6\u0dba\u0dd2",
