    "description": "\u0dbd\u0d82\u0d9c\u0db8 \u0dc3\u0dc4 \u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0db6\u0dc3\u0dca \u0dbb\u0dae \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0 \u0d9a\u0dcf\u0dbd\u0dc3\u0da7\u0dc4\u0db1\u0d9a\u0dca \u0dba\u0da7\u0dad\u0dda \u0db0\u0dcf\u0dc0\u0db1 \u0dc0\u0dd9\u0dba\u0dd2",
