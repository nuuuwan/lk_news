    "description": "Why Fear Sri Lankan Remand Prison?",
    "url_metadata": "https://www.colombotelegraph.com/index.php/why-fear-sri-lankan-remand-prison/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
