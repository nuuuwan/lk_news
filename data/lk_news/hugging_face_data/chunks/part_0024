    "description": "\u0db4\u0daf\u0dca\u0db8\u0dda \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db4\u0dcf\u0dad\u0dcf\u0dbd \u0da0\u0dab\u0dca\u0da9\u0dd2 \u0d89\u0db1\u0dca\u0daf\u0dd4\u0db1\u0dd3\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0daf\u0dd3 \u0d9a\u0ddc\u0da7\u0dd4 \u0dc0\u0dd6 \u0dc4\u0dd0\u0da7\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/213904",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
