    "description": "Central Industries appoints new Chairman, Non-Executive Directors",
    "url_metadata": "https://www.ft.lk/business/Central-Industries-appoints-new-Chairman-Non-Executive-Directors/34-781105",
    "lang": "en",
    "newspaper_id": "dailyftlk",
