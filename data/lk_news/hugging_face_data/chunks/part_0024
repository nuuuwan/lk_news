    "description": "Japan urges steady implementation of Japan-assisted mega projects in SL",
    "url_metadata": "http://island.lk/japan-urges-steady-implementation-of-japan-assisted-mega-projects-in-sl/",
    "lang": "en",
    "newspaper_id": "islandlk",
