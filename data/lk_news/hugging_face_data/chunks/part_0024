    "description": "Could India Be A Victim Of Its Own Ambitions?",
    "url_metadata": "https://www.colombotelegraph.com/index.php/could-india-be-a-victim-of-its-own-ambitions/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
