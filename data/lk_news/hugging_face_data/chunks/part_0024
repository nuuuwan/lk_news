    "description": "PM wants schools sports culture to prioritize physical and mental well-being of students",
    "url_metadata": "https://www.adaderana.lk/news/111726/pm-wants-schools-sports-culture-to-prioritize-physical-and-mental-well-being-of-students",
    "lang": "en",
    "newspaper_id": "adaderanalk",
