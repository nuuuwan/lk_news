    "date_str": "2025-08-29",
    "description": "Ranil Wickremesinghe\u2019s Arrest: Fighting Corruption Or Fuelling Political Victimization?",
    "url_metadata": "https://www.colombotelegraph.com/index.php/ranil-wickremesinghes-arrest-fighting-corruption-or-fuelling-political-victimization/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
