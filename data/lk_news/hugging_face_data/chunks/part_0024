    "date_str": "2025-08-25",
    "description": "When a President travels whether to Anuradhapura  to see his mother , or to London  to accompany his spouse , does the law expect the head of state to discard the security trappings of that office?",
    "url_metadata": "https://dbsjeyaraj.com/dbsj/?p=86335",
    "lang": "en",
    "newspaper_id": "dbsjeyarajcom",
    "time_ut": 1756071000.0,
    "chunk_id": "2025-08-25-dbsjeyarajcom-2bb0b2bd-0000",
    "chunk_index": 0,
