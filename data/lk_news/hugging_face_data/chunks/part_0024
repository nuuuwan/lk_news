    "description": "Closing gender gap is economic strategy, boosts country\u2019s  GDP: Prime Minister",
    "url_metadata": "https://www.ft.lk/news/Closing-gender-gap-is-economic-strategy-boosts-country-s-GDP-Prime-Minister/56-780964",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1756422420.0,
