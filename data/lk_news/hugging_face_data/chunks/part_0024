    "description": "6.3 magnitude earthquake hits Afghanistan, at least 20 killed",
    "url_metadata": "https://www.adaderana.lk/news/112045/63-magnitude-earthquake-hits-afghanistan-at-least-20-killed",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756692300.0,
    "chunk_id": "2025-09-01-adaderanalk-b1d17d54-0000",
