    "url_metadata": "https://www.ada.lk/business/\u0dc3\u0dd2\u0dba\u0dd0\u0da7\u0dca-OHT-\u0da9\u0ddc-\u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1-171\u0d9a-\u0d86\u0dba\u0ddd\u0da2\u0db1\u0dba\u0da7-BOI-\u0d85\u0db1\u0dd4\u0db8\u0dd0\u0dad\u0dd2\u0dba/7-418253",
