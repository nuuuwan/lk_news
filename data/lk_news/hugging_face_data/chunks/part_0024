    "description": "NMSJ commends Election Commission on party registration policy",
    "url_metadata": "https://www.ft.lk/news/NMSJ-commends-Election-Commission-on-party-registration-policy/56-781125",
    "lang": "en",
    "newspaper_id": "dailyftlk",
