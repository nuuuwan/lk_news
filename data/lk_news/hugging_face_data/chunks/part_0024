    "url_metadata": "https://www.ada.lk/breaking_news/\u0db8\u0db1\u0dca\u0db1-\u0dc2\u0dcf\u0db1\u0dca-\u0dc4\u0dcf-\u0d9c\u0ddd\u0dbd\u0dba\u0dd9\u0d9a\u0dca-\u0d85\u0dbd\u0dca\u0dbd\u0dba\u0dd2/11-418269",
