    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0baa\u0bcb\u0bb2\u0bbf-\u0ba4\u0b95\u0b9f\u0bc1\u0b9f\u0ba9\u0bcd-\u0b95\u0bbe\u0bb0\u0bc8-\u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf-\u0baa\u0bc6\u0ba3\u0bcd-\u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bb0\u0bcd-\u0b95\u0bc8\u0ba4\u0bc1/76-364025",
