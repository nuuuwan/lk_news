    "description": "European postal services suspend shipment of packages to US over tariffs",
    "url_metadata": "https://www.adaderana.lk/news/111795/european-postal-services-suspend-shipment-of-packages-to-us-over-tariffs",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756051500.0,
    "chunk_id": "2025-08-24-adaderanalk-1ee6c9cb-0000",
    "chunk_index": 0,
