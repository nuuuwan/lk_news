    "description": "\u0dc3\u0dc4\u0dbd\u0dca \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0db8\u0dd2\u0dbd \u0d8b\u0dbd\u0dca\u0dbd\u0d82\u0d9d\u0db1\u0dba \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0db1\u0dca\u0da7 \u0d91\u0dbb\u0dd9\u0dc4\u0dd2\u0dc0 \u0daf\u0dd0\u0da9\u0dd2 \u0db4\u0dd2\u0dba\u0dc0\u0dbb",
