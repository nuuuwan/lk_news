    "description": "\u0d86\u0db1\u0dba\u0db1\u0dd2\u0d9a \u0d85\u0dbd - \u0dc5\u0dd4\u0dd1\u0db1\u0dd4 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0db1\u0dc0\u0dcf \u0dad\u0dd2\u0db6\u0dd4 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0dc0\u0dd9\u0dc5\u0dd9\u0db3 \u0db7\u0dcf\u0dab\u0dca\u0da9 \u0db6\u0daf\u0dca\u0daf \u0d89\u0dc4\u0dc5\u0da7",
