    "description": "\u0dc2\u0dd3 \u0da2\u0dd2\u0d82\u0db4\u0dd2\u0db1\u0dca \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0db1\u0db4\u0daf\u0dba\u0da7 \u0d91\u0dbb\u0dd9\u0dc4\u0dd2 \u0d9a\u0dd4\u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dab\u0dba\u0d9a \u0db6\u0dc0 \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0d9a\u0dd2\u0dba\u0dba\u0dd2",
