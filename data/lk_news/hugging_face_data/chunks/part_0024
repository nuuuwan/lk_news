    "description": "\u0dbd\u0d82\u0d9c\u0db8 - \u0db4\u0dde\u0daf\u0dca\u0d9c\u0dbd\u0dd2\u0d9a \u0d92\u0d9a\u0dcf\u0db6\u0daf\u0dca\u0db0 \u0d9c\u0db8\u0db1\u0dca\u0dc0\u0dcf\u0dbb \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dd9\u0dbb\u0dda",
    "url_metadata": "http://sinhala.adaderana.lk/news/213799",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1756179000.0,
    "chunk_id": "2025-08-26-adaderanasinhalalk-3c37a559-0000",
