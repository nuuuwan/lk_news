    "description": "Speaker endorses certificate on Gambling Regulatory Authority Bill",
    "url_metadata": "https://www.adaderana.lk/news/112140/speaker-endorses-certificate-on-gambling-regulatory-authority-bill",
    "lang": "en",
    "newspaper_id": "adaderanalk",
