    "description": "Gem Sri Lanka 2026 launch set for 26 August",
    "url_metadata": "https://www.ft.lk/business/Gem-Sri-Lanka-2026-launch-set-for-26-August/34-780583",
    "lang": "en",
    "newspaper_id": "dailyftlk",
