    "description": "\u0db4\u0db1\u0dca\u0da2\u0dcf\u0db6\u0dca \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db1\u0dca\u0dad\u0dba \u0dba\u0da7 \u0d9a\u0dc5 \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb - 30\u0d9a\u0da7 \u0d85\u0db0\u0dd2\u0d9a \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0db8\u0dbb\u0dd4\u0da7",
    "url_metadata": "http://sinhala.adaderana.lk/news/214117",
