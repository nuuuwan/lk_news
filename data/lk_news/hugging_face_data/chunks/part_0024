    "description": "88 postal operators suspend services to US over tariffs: UN",
    "url_metadata": "https://www.adaderana.lk/news/112241/88-postal-operators-suspend-services-to-us-over-tariffs-un",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1757209980.0,
