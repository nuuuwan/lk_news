    "doc_type": "lk_news",
    "doc_id": "2025-08-28-dailyftlk-5af879c2",
    "num": "dailyftlk-5af879c2",
    "date_str": "2025-08-28",
    "description": "Was Ranil Wickremesinghe  target of political witch hunt?",
    "url_metadata": "https://www.ft.lk/columns/Was-Ranil-Wickremesinghe-target-of-political-witch-hunt/4-780908",
