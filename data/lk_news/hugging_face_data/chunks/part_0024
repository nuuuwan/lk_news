    "description": "New Mediation Bill gets committee-level nod",
    "url_metadata": "https://www.ft.lk/business/New-Mediation-Bill-gets-committee-level-nod/34-780902",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1756334731.0,
