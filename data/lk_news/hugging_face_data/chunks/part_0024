    "description": "Mahindra Ideal Finance rolls out revolving credit solution for multi brand vehicle importers and SMEs",
    "url_metadata": "http://island.lk/mahindra-ideal-finance-rolls-out-revolving-credit-solution-for-multi-brand-vehicle-importers-and-smes/",
    "lang": "en",
    "newspaper_id": "islandlk",
