    "description": "Sri Lanka gets banana culture lab with FAO, China help",
    "url_metadata": "https://economynext.com/sri-lanka-gets-banana-culture-lab-with-fao-china-help-239193/",
    "lang": "en",
    "newspaper_id": "economynextcom",
