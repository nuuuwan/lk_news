    "description": "Foreign Minister Herath welcomes Xi\u2019s global initiatives at SCO Plus",
    "url_metadata": "https://www.ft.lk/news/Foreign-Minister-Herath-welcomes-Xi-s-global-initiatives-at-SCO-Plus/56-781129",
    "lang": "en",
    "newspaper_id": "dailyftlk",
