    "description": "President reviews 29 institutions of Plantation and Community Infrastructure Ministry",
    "url_metadata": "https://www.ft.lk/news/President-reviews-29-institutions-of-Plantation-and-Community-Infrastructure-Ministry/56-780725",
    "lang": "en",
    "newspaper_id": "dailyftlk",
