    "description": "Report on ongoing investigation into mass grave site in Chemmani, Jaffna",
    "url_metadata": "https://www.ft.lk/news/Report-on-ongoing-investigation-into-mass-grave-site-in-Chemmani-Jaffna/56-781237",
    "lang": "en",
    "newspaper_id": "dailyftlk",
