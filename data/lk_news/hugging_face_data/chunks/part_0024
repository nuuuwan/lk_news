    "description": "\u0d9a\u0dcf\u0dbd\u0ddd\u0dc3\u0dca \u0d85\u0dbd\u0dca\u0d9a\u0dbb\u0dcf\u0dc3\u0dca \u0dc4\u0dba \u0dc0\u0dd0\u0db1\u0dd2 \u0d9c\u0dca\u200d\u0dbb\u0dd1\u0db1\u0dca\u0da9\u0dca \u0dc3\u0dca\u0dbd\u0dd1\u0db8\u0dca \u0dc1\u0dd6\u0dbb\u0dad\u0dcf\u0dc0 \u0daf\u0dd2\u0db1\u0dcf \u0d9c\u0db1\u0dd3",
