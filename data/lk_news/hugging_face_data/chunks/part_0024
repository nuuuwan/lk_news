    "description": "Court backlog must be cleared by December 31 \u2013 Judicial Service Commission",
    "url_metadata": "https://www.adaderana.lk/news/112091/court-backlog-must-be-cleared-by-december-31-judicial-service-commission",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756781700.0,
