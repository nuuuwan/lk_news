    "description": "Remembering  Legendary Trade Union Leader amd Trotskyite Firebrand   Comrade  Bala Tampoe .",
    "url_metadata": "https://dbsjeyaraj.com/dbsj/?p=77697",
    "lang": "en",
    "newspaper_id": "dbsjeyarajcom",
