    "description": "New think-tank Asian Geopolitics, Sustainability, and Peace Council launched",
    "url_metadata": "https://www.ft.lk/news/New-think-tank-Asian-Geopolitics-Sustainability-and-Peace-Council-launched/56-780596",
    "lang": "en",
    "newspaper_id": "dailyftlk",
