    "num": "dailyftlk-7190a838",
    "date_str": "2025-08-22",
    "description": "ITAK launches half-day hartal with twin objectives in North-East",
    "url_metadata": "https://www.ft.lk/columns/ITAK-launches-half-day-hartal-with-twin-objectives-in-North-East/4-780620",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1755819704.0,
    "chunk_id": "2025-08-22-dailyftlk-7190a838-0001",
