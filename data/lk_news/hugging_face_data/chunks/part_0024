    "description": "Trump Administration reviews 55 million US visa holders for deportation violations",
    "url_metadata": "https://www.adaderana.lk/news/111728/trump-administration-reviews-55-million-us-visa-holders-for-deportation-violations",
    "lang": "en",
    "newspaper_id": "adaderanalk",
