    "description": "\u2018Kala Wewa Back to the Elephants\u2019 project a success",
    "url_metadata": "https://www.ft.lk/news/Kala-Wewa-Back-to-the-Elephants-project-a-success/56-781366",
    "lang": "en",
    "newspaper_id": "dailyftlk",
