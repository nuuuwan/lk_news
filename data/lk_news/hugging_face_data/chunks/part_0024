    "date_str": "2025-08-27",
    "description": "US imposes 50% tariff on Indian goods starting today, Modi says buy local",
    "url_metadata": "https://www.adaderana.lk/news/111883/us-imposes-50-tariff-on-indian-goods-starting-today-modi-says-buy-local-",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756253460.0,
