    "description": "\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0db1\u0db8\u0dca\u0db4\u0dda\u0dbb\u0dd2\u0d9c\u0dd9\u0db1\u0dca \u0dbb\u0db3\u0dc0\u0dcf\u0d9c\u0dd9\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dc0\u0dc3\u0dbb",
