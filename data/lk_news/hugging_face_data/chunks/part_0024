    "description": "Sri Lankan ingenuity saves billions at Kelanitissa Power Plant",
    "url_metadata": "http://island.lk/sri-lankan-ingenuity-saves-billions-at-kelanitissa-power-plant/",
    "lang": "en",
    "newspaper_id": "islandlk",
