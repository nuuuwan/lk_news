    "description": "\u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dca \u0d9a\u0ddc\u0db8\u0dd2\u0dc2\u0db1\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0d9a\u0dd4 \u0db4\u0dad\u0dca\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d85\u0dba\u0daf\u0dd4\u0db8\u0dca\u0db4\u0dad\u0dca \u0d9a\u0dd0\u0db3\u0dc0\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/213630",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1755780540.0,
    "chunk_id": "2025-08-21-adaderanasinhalalk-cc6b01f5-0000",
    "chunk_index": 0,
