    "description": "New quake shakes devastated Afghan region as death toll exceeds 1,400",
    "url_metadata": "https://www.adaderana.lk/news/112135/new-quake-shakes-devastated-afghan-region-as-death-toll-exceeds-1400",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1756885560.0,
    "chunk_id": "2025-09-03-adaderanalk-f90e3fbf-0000",
    "chunk_index": 0,
