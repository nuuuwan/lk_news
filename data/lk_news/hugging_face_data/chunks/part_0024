    "date_str": "2025-08-29",
    "description": "Corruption in any form undermines governance and public trust \u2013 PM",
    "url_metadata": "https://www.adaderana.lk/news/111968/corruption-in-any-form-undermines-governance-and-public-trust-pm",
    "lang": "en",
    "newspaper_id": "adaderanalk",
