    "description": "\u0dc3\u0dc4\u0dc3\u0dca\u0daf\u0db1\u0dc0\u0dd2 \u0dc3\u0dc4 \u0dc3\u0ddc\u0db6\u0dcf\u0daf\u0db1\u0dc0\u0dd2 \u0d9c\u0dd0\u0db1 \u0d86\u0d82\u0dc1\u0dd2\u0d9a \u0d85\u0db0\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba",
