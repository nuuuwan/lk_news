    "description": "Making public policy work for women: Lessons from Sri Lanka\u2019s Covid-19 response",
    "url_metadata": "https://economynext.com/making-public-policy-work-for-women-lessons-from-sri-lankas-covid-19-response-238320/",
    "lang": "en",
    "newspaper_id": "economynextcom",
    "time_ut": 1756195200.0,
    "chunk_id": "2025-08-26-economynextcom-59dc1eba-0001",
    "chunk_index": 1,
