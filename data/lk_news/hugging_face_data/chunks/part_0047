    "url_metadata": "https://www.ft.lk/columns/Customs-Paperless-Declaration-from-1-October-2026-Opportunity-for-genuine-Customs-modernisation-and-revenue-protection/4-797233",
    "lang": "en",
    "newspaper_id": "dailyftlk",
