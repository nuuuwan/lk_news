    "description": "Sri Lanka\u2019s next cybersecurity strategy should assume the hacker gets in",
    "url_metadata": "https://www.ft.lk/columns/Sri-Lanka-s-next-cybersecurity-strategy-should-assume-the-hacker-gets-in/4-797619",
    "lang": "en",
    "newspaper_id": "dailyftlk",
