    "description": "Sri Lanka pushes stronger social protection for migrant workers",
    "url_metadata": "https://www.ft.lk/news/Sri-Lanka-pushes-stronger-social-protection-for-migrant-workers/56-797883",
    "lang": "en",
    "newspaper_id": "dailyftlk",
