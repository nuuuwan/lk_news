    "description": "PM, new Chinese envoy discuss education, digital transformation push",
    "url_metadata": "https://www.ft.lk/news/PM-new-Chinese-envoy-discuss-education-digital-transformation-push/56-797393",
    "lang": "en",
    "newspaper_id": "dailyftlk",
