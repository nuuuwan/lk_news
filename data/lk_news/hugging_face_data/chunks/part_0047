    "url_metadata": "https://www.dailymirror.lk/business-main/Tourism-authority-mounts-cleanliness-drive-as-Pekoe-Trail-passes-into-state-ownership/245-350242",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1789367720.0,
