    "description": "PickMe connects Book Fair visits with QR tickets, rides and easier pickups",
    "url_metadata": "https://www.ft.lk/business/PickMe-connects-Book-Fair-visits-with-QR-tickets-rides-and-easier-pickups/34-797723",
    "lang": "en",
    "newspaper_id": "dailyftlk",
