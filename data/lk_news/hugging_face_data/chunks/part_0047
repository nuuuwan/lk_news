    "description": "Dialog Govi Mithuru and University of Ruhuna Partner to Advance Agricultural Innovation",
    "url_metadata": "https://www.dailymirror.lk/business/Dialog-Govi-Mithuru-and-University-of-Ruhuna-Partner-to-Advance-Agricultural-Innovation/215-351100",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
