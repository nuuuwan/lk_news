    "description": "HNB Bank\u2019s Central Collections Unit receives ISO 9001:2015 Certification",
    "url_metadata": "https://www.dailymirror.lk/business/HNB-Banks-Central-Collections-Unit-receives-ISO-90012015-Certification/215-351105",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
