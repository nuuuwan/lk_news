    "description": "Getting Ambulatory Curative Primary Care system right in Sri Lanka",
    "url_metadata": "https://www.ft.lk/columns/Getting-Ambulatory-Curative-Primary-Care-system-right-in-Sri-Lanka/4-797281",
    "lang": "en",
    "newspaper_id": "dailyftlk",
