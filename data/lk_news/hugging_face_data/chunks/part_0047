    "description": "IESL National Engineering Conference 2026 to focus on 4 national priorities",
    "url_metadata": "https://www.dailymirror.lk/business-news/IESL-National-Engineering-Conference-2026-to-focus-on-4-national-priorities/273-350389",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
