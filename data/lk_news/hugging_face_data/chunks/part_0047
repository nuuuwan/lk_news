    "description": "\u0d9a\u0ddc\u0db8\u0dbb\u0dca\u0dc2\u0dbd\u0dca \u0dc4\u0ddc\u0db3\u0db8 \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0dc3\u0dc4 \u0dc4\u0ddc\u0db3\u0db8 ESG \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0dbd\u0dd9\u0dc3 \u0dba\u0dd4\u0dbb\u0ddd\u0db8\u0db1\u0dd2 \u0d85\u0db7\u0dd2\u0dc2\u0dda\u0d9a\u0dba\u0da7\u00ad",
