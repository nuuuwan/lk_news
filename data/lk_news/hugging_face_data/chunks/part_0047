    "description": "Sri Lanka\u2019s shoppers experience elevated through AI",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Sri-Lankas-shoppers-experience-elevated-through-AI/108-350582",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
