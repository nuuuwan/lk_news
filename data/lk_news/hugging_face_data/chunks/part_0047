    "num": "dailymirrorlk-02301147",
    "date_str": "2026-09-17",
    "description": "Dr. Hans, where is the \u201cPeople\u2019s Digital Forum?\u201d",
    "url_metadata": "https://www.dailymirror.lk/opinion/Dr-Hans-where-is-the-Peoples-Digital-Forum/172-350505",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
