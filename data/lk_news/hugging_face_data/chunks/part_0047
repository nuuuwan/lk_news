    "description": "Why Are Our Politicians So Corrupt?",
    "url_metadata": "https://www.dailymirror.lk/opinion/Why-Are-Our-Politicians-So-Corrupt/172-351335",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
