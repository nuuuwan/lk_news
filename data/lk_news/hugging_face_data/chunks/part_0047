    "num": "dailymirrorlk-dda2bd9d",
    "date_str": "2026-09-24",
    "description": "Why are ministers  still complaining about bureaucratic bottlenecks?",
    "url_metadata": "https://www.dailymirror.lk/opinion/Why-are-ministers-still-complaining-about-bureaucratic-bottlenecks/172-351033",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
