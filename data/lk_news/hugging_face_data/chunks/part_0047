    "description": "Sri Lanka Living Lab: Moving from commodities to agility in VUCA world",
    "url_metadata": "https://www.ft.lk/columns/Sri-Lanka-Living-Lab-Moving-from-commodities-to-agility-in-VUCA-world/4-797620",
    "lang": "en",
    "newspaper_id": "dailyftlk",
