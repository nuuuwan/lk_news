    "date_str": "2026-09-21",
    "description": "When common sense crosses a border",
    "url_metadata": "https://www.dailymirror.lk/opinion/When-common-sense-crosses-a-border/172-350759",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
