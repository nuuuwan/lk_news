    "description": "Record-Breaking El Ni\u00f1o Surpasses Previous Benchmarks",
    "url_metadata": "https://www.dailymirror.lk/international/Record-Breaking-El-Ni\u00f1o-Surpasses-Previous-Benchmarks/107-350917",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
