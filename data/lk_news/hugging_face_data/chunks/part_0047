    "url_metadata": "https://www.dailymirror.lk/news-features/Rainwater-harvesting-in-Sri-Lanka-How-to-start-at-home-before-the-dry-months/131-351089",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
