    "description": "CDB supports Peradeniya University respond to Ditwah challenge",
    "url_metadata": "https://www.dailymirror.lk/business-news/CDB-supports-Peradeniya-University-respond-to-Ditwah-challenge/273-350481",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
