    "description": "Customs cuts paper trail in push for faster trade",
    "url_metadata": "https://www.dailymirror.lk/business/Customs-cuts-paper-trail-in-push-for-faster-trade/215-351619",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1790925965.0,
