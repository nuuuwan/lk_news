    "description": "Israel-bound flight diverted after fight between pilots",
    "url_metadata": "https://www.dailymirror.lk/international/Israel-bound-flight-diverted-after-fight-between-pilots/107-351461",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1790758827.0,
