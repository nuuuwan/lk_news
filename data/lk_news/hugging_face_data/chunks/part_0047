    "description": "Hayleys Solar commissions 3MW Veyangoda Ground-Mounted Solar Project",
    "url_metadata": "https://www.ft.lk/business/Hayleys-Solar-commissions-3MW-Veyangoda-Ground-Mounted-Solar-Project/34-797253",
    "lang": "en",
    "newspaper_id": "dailyftlk",
