    "chunk_text": "22\u0da7 \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7 \u0dc3\u0dd4\u0dc5\u0dd4 \u0db6\u0dd9\u0daf\u0dd3\u0db8\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf\n\n22 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf \u0dc3\u0d82\u0dc1\u0ddd\u0db0\u0db1\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dba\u0dd9\u0db1\u0dca \u0d86\u0dab\u0dca\u0da9\u0dd4\u0dc0 \u0dad\u0dd4\u0dc5 \u0dc3\u0dd4\u0dc5\u0dd4 \u0db6\u0dd9\u0daf\u0dd3\u0db8\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0db6\u0dd2\u0db8\u0dbd\u0dca \u0dbb\u0dad\u0dca\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0d9a\u0dd2\u0dba. \u0d85\u0daf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0daf\u0dd3 \u0d85\u0daf\u0dc4\u0dc3\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0db8\u0dd2\u0db1\u0dca \u0d94\u0dc4\u0dd4 \u0db8\u0dda \u0db6\u0dc0 \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd3\u0dba.\n\n\"22 \u0d9c\u0dd0\u0db1 \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0dda \u0db8\u0ddc\u0d9a\u0d9a\u0dca\u0dc0\u0dad\u0dca \u0db1\u0dd1. \u0db1\u0dd2\u0d9a\u0db1\u0dca \u0db6\u0ddc\u0dbb\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dc3\u0dca\u0dc3\u0dda \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0db6\u0dd2\u0dbd\u0dca\u0dbd\u0dd9\u0d9a\u0dca \u0db8\u0dc0\u0dbd\u0dcf \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0d94\u0db6\u0dad\u0dd4\u0db8\u0db1\u0dca\u0dbd\u0dcf \u0db6\u0dd0\u0dbd\u0dd4\u0dc0\u0dcf\n\n\u0db8\u0dd9\u0d9a\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dcf\u0da2\u0dba \u0db4\u0ddc\u0da9\u0dca\u0da9\u0d9a\u0dca \u0daf\u0dd9\u0d9a\u0da7 \u0db6\u0dd9\u0daf\u0dd9\u0db1\u0dc0\u0dcf \u0dc0\u0d9c\u0dda \u0d92\u0d9a\u0dd9\u0db1\u0dca \u0daf\u0dda\u0dc1\u0db4\u0dcf\u0dbd\u0db1 \u0dc0\u0dcf\u0dc3\u0dd2\u0dba\u0d9a\u0dca \u0d9c\u0db1\u0dca\u0db1 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd2\u0db8 \u0d85\u0db4\u0dd2\u0da7 \u0db4