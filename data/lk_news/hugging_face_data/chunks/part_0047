    "description": "Roar Global introduces Sri Lanka\u2019s first AI gateway",
    "url_metadata": "https://www.ft.lk/business/Roar-Global-introduces-Sri-Lanka-s-first-AI-gateway/34-797342",
    "lang": "en",
    "newspaper_id": "dailyftlk",
