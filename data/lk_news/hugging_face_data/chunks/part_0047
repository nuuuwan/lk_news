    "num": "dailymirrorlk-9e2a72da",
    "date_str": "2026-09-21",
    "description": "Dangerous,  shifting world",
    "url_metadata": "https://www.dailymirror.lk/opinion/Dangerous-shifting-world/172-350760",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
