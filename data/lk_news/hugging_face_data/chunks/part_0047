    "url_metadata": "https://www.dailymirror.lk/breaking-news/Referendum-cannot-be-called-as-a-result-of-protests-Nalinda-Jayatissa/108-350910",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
