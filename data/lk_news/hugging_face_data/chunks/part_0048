    "description": "RCSS study says Middle East war exposed South Asia\u2019s deep dependence",
    "url_metadata": "https://www.ft.lk/business/RCSS-study-says-Middle-East-war-exposed-South-Asia-s-deep-dependence/34-799764",
    "lang": "en",
    "newspaper_id": "dailyftlk",
