    "description": "EFL Global receives Green Business Leadership Award",
    "url_metadata": "https://www.dailymirror.lk/business/EFL-Global-receives-Green-Business-Leadership-Award/215-355689",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
