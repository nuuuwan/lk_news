    "date_str": "2026-11-27",
    "description": "From village craft to new markets",
    "url_metadata": "https://www.ft.lk/business/From-village-craft-to-new-markets/34-800684",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1795749269.0,
