    "description": "Hoteliers praise budget\u2019s tourism direction",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Hoteliers-praise-budgets-tourism-direction/108-354994",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
