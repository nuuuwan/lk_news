    "url_metadata": "https://www.ft.lk/business/Seafood-exporters-hail-Budget-2027-eye-680-m-by-2030/34-800135",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1794785457.0,
    "chunk_id": "2026-11-16-dailyftlk-8d5e136a-0001",
