    "url_metadata": "https://www.dailymirror.lk/business-main/October-exports-jump-11-6-YoY/245-355791",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1795680313.0,
    "chunk_id": "2026-11-26-dailymirrorlk-e942a0df-0000",
    "chunk_index": 0,
