    "url_metadata": "https://www.dailymirror.lk/breaking-news/Butterfly-swarms-across-Sri-Lanka-linked-to-natural-monsoon-migration/108-354438",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
