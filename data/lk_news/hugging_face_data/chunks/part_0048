    "description": "Dheera Hettiarachchi appointed acting chairman of SLTPB",
    "url_metadata": "https://www.dailymirror.lk/business/Dheera-Hettiarachchi-appointed-acting-chairman-of-SLTPB/215-354989",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
