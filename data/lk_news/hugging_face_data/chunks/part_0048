    "url_metadata": "https://www.dailymirror.lk/breaking-news/Three-Mannar-restaurants-fined-over-health-violations/108-355304",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1795082575.0,
    "chunk_id": "2026-11-19-dailymirrorlk-278de40f-0000",
    "chunk_index": 0,
