    "description": "Colombo - A city that should not drown",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Colombo-A-city-that-should-not-drown/108-354502",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
