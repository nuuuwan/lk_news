    "description": "Water must move to the centre of climate action",
    "url_metadata": "https://www.ft.lk/columns/Water-must-move-to-the-centre-of-climate-action/4-800120",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1794782807.0,
