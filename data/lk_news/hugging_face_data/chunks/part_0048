    "url_metadata": "https://www.dailymirror.lk/business/ADBs-US-200mn-package-to-ease-credit-barriers-for-small-businesses-in-SL/215-355633",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1795509242.0,
    "chunk_id": "2026-11-24-dailymirrorlk-70a0b056-0000",
    "chunk_index": 0,
