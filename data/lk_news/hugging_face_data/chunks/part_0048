    "description": "Russia\u2019s own figures show almost 500,000 deaths in war in Ukraine",
    "url_metadata": "https://www.dailymirror.lk/international/Russias-own-figures-show-almost-500-000-deaths-in-war-in-Ukraine/107-355652",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1795577241.0,
    "chunk_id": "2026-11-25-dailymirrorlk-c8649be0-0000",
