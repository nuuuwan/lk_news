    "url_metadata": "https://www.ft.lk/business/AICPA-CIMA-Sri-Lanka-Post-Budget-Forum-charts-priorities-for-reform-investment-and-growth/34-800683",
    "lang": "en",
    "newspaper_id": "dailyftlk",
