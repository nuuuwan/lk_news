    "description": "Sri Lanka launches AgriConnect Joint Implementation Plan to transform agriculture, create jobs",
    "url_metadata": "https://www.dailymirror.lk/business/Sri-Lanka-launches-AgriConnect-Joint-Implementation-Plan-to-transform-agriculture-create-jobs/215-353842",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
