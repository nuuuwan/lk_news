    "description": "Rooftop solar: A national asset or a burden on national electricity grid?",
    "url_metadata": "https://www.ft.lk/columns/Rooftop-solar-A-national-asset-or-a-burden-on-national-electricity-grid/4-799797",
    "lang": "en",
    "newspaper_id": "dailyftlk",
