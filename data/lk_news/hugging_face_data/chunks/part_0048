    "description": "Twice promised, never delivered: Tax Ombudsman Sri Lanka still needs",
    "url_metadata": "https://www.ft.lk/columns/Twice-promised-never-delivered-Tax-Ombudsman-Sri-Lanka-still-needs/4-799996",
    "lang": "en",
    "newspaper_id": "dailyftlk",
