    "description": "Former British High Commissioner joins George Steuart board",
    "url_metadata": "https://www.dailymirror.lk/business/Former-British-High-Commissioner-joins-George-Steuart-board/215-355181",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
