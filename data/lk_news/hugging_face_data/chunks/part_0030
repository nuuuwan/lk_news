    "chunk_text": "\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba \u0d9a\u0da9\u0dd4\u0dbd\u0dd4 8 \u0d9a\u0dd2\u0db1\u0dca \u0da2\u0dba \u0dbd\u0db6\u0dba\u0dd2\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dc3\u0dc4 \u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba \u0d85\u0dad\u0dbb \u0dad\u0dbb\u0d9c \u0dad\u0dd4\u0db1\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad \u0d91\u0d9a\u0dca\u0daf\u0dd2\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0da7\u0dca \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda \u0dbb\u0dcf\u0dc0\u0dbd\u0dca\u0db4\u0dd2\u0db1\u0dca\u0da9\u0dd2\u0dc4\u0dd2\u0daf\u0dd3 \u0d85\u0daf (14) \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0daf\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dbb\u0d9c\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0d9a\u0dba\u0ddd \u0d9a\u0da9\u0dd4\u0dbd\u0dd4 8 \u0d9a \u0da2\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd3\u0db8\u0da7 \u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd6\u0dc4.\n\n\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dd4 \u0db4\u0dd2\u0dbd \u0db8\u0dd9\u0db8 \u0da2\u0dba\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dab\u0dba\u0dad\u0dca \u0dc3\u0db8\u0d9f \u0dad\u0dbb\u0d9c\u0dba\u0d9a\u0dca \u0d89\u0dad\u0dd2\u0dbb\u0dd2\u0dc0 \u0dad\u0dd2\u0db6\u0dd2\u0dba\u0daf\u0dd3 2-0 \u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda \u0da2\u0dba \u0daf \u0dc4\u0dd2\u0db8\u0dd2\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dc3\u0db8\u0dad\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dd4 \u0db4\u0dd2\u0dbd \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 289 \u0d9a \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba \u0d95\u0dc0\u0dbb 48.2 \u0d9a\u0daf\u0dd3 \u0d9a\u0da9\u0dd4\u0dbd\u0dd4 2 \u0d9a\u0dca \u0db4\u0db8\u0dab\u0d9a\u0dca \u0daf\u0dd0\u0dc0\u0dd3 \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0db6\u0dcf