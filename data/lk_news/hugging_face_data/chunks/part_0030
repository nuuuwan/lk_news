    "url_metadata": "https://www.lankadeepa.lk/features/\u0dc3\u0da0\u0dbb\u0d9a-\u0d89\u0dbd\u0d9a\u0d9a\u0dba-\u0dc4\u0db1\u0dba\u0d9a\u0daf/2-683929",
