    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc4\u0db4\u0dad\u0dbd-\u0dba\u0dc4\u0dbd\u0db6\u0daf\u0daf-\u0db8\u0dbb\u0d9c\u0dba-\u0d85\u0dc0\u0dc4\u0dbb-\u0dc0\u0dba/101-683732",
