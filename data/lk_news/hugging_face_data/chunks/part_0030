    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbb\u0d9c-\u0d9a\u0dad\u0da7-\u0d85\u0dad\u0dc0\u0dbb-\u0d9a\u0dc5\u0dba-\u0d9a\u0dba\u0db1-\u0dc0\u0daf\u0dba\u0dc0\u0dbb\u0dba\u0da7-\u0d87\u0db4/1-683872",
