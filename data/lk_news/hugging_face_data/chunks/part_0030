    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b95\u0b9f\u0bc1\u0b95\u0ba3\u0bcd\u0ba3\u0bbe\u0bb5-\u0bb5\u0bc0\u0ba4\u0bbf\u0baf\u0bc8-\u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95-\u0ba4\u0bbe\u0bae\u0ba4\u0bae\u0bbe\u0b95\u0bc1\u0bae\u0bcd/76-368326",
