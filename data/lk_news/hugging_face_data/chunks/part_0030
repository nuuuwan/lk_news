    "description": "\u200b \u0b9a\u0bbf\u0bb5\u0ba9\u0bca\u0bb3\u0bbf\u0baa\u0bbe\u0ba4 \u0ba4\u0bb3\u0ba4\u0bcd\u0ba4\u0bc8 \u0b9a\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bae\u0bcd",
    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b9a\u0bbf\u0bb5\u0ba9\u0bca\u0bb3\u0bbf\u0baa\u0bbe\u0ba4-\u0ba4\u0bb3\u0ba4\u0bcd\u0ba4\u0bc8-\u0b9a\u0bc1\u0ba4\u0bcd\u0ba4\u0bae\u0bcd-\u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0bae\u0bcd-\u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd-\u0b86\u0bb0\u0bae\u0bcd\u0baa\u0bae\u0bcd/76-368538",
    "lang": "ta",
    "newspaper_id": "tamilmirrorlk",
    "time_ut": 1764146965.0,
    "chunk_id": "2025-11-26-tamilmirrorlk-9af74c0c-0001",
