    "description": "UNDP and Hirdaramani Apparel sign MoU",
    "url_metadata": "https://www.ft.lk/business/UNDP-and-Hirdaramani-Apparel-sign-MoU/34-784453",
    "lang": "en",
    "newspaper_id": "dailyftlk",
