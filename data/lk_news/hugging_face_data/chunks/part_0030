    "description": "\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\u0da7 \u0dc0\u0dbb\u0dcf\u0dba\u0da7 \u0db6\u0dc4\u0dcf\u0dbd\u0dd4\u0db8\u0dca \u0db6\u0da9\u0dd4\u0dad\u0ddc\u0d9c \u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab \u0d85\u0d82\u0d9c\u0db1\u0dba\u0d9a\u0dca",
    "url_metadata": "https://www.ada.lk/business/\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0ddc\u0da7-\u0dc0\u0dbb\u0dcf\u0dba\u0da7-\u0db6\u0dc4\u0dcf\u0dbd\u0dd4\u0db8\u0dca-\u0db6\u0da9\u0dd4\u0dad\u0ddc\u0d9c-\u0db4\u0dbb\u0dd3\u0d9a\u0dca\u0dc2\u0dab-\u0d85\u0d82\u0d9c\u0db1\u0dba\u0d9a\u0dca/7-419863",
