    "chunk_text": "\u0db8\u0dd4\u0dc5\u0dd4 \u0db8\u0dd0\u0dad\u0dd2\u0dc3\u0db6\u0dba\u0db8 \u0dad\u0dd0\u0db9\u0dd2\u0dbd\u0dd2 \u0db4\u0dcf\u0da7 \u0dc0\u0dd9\u0dba\u0dd2\n\n\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0db4\u0dd4\u0dbb\u0dd4\u0dc2 \u0db7\u0dcf\u0dc0\u0dba \u0dc3\u0db8\u0dcf\u0da2 \u0db7\u0dcf\u0dc0\u0dba \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca \u0dc0\u0dd6\u00a0 \u0dc4\u0dd2\u0d82\u0dc3\u0db1\u0dba\u0da7 \u0d91\u0dbb\u0dd9\u0dc4\u0dd2\u00a0 \u0d9c\u0ddd\u0dbd\u0dd3\u0dba \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0dd3\u0dad\u0dca\u0dc0\u0dba\u0da7\u00a0 \u0dc3\u0dc4\u0dcf\u0dba \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4\u0db8 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd2\u0dba\u0db1\u0dca\u00a0 \u0db8\u0dd9\u0db1\u0dca\u0db8\u00a0 \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba\u0dda\u00a0 \u0dc3\u0dcf\u0db8\u0dcf\u0da2\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dad\u0dd0\u0db9\u0dd2\u0dbd\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0dad\u0dd2 \u0d87\u0db3\u0dd4\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d85\u0daf\u00a0 \u0db4\u0dd0\u0db8\u0dd2\u0dab \u0dc3\u0dd2\u0da7\u0dd3\u0db8 \u0dc0\u0dd2\u0dc1\u0dda\u0dc2 \u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dd2\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0dba.\n\n\u0d9a\u0dad\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dc0\u0dbb\u0dba\u0dcf\u0daf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0daf\u00a0 \u0d8a\u0da7 \u0d85\u0daf\u0dcf\u0dc5\u0dc0\u00a0 \u0dc3\u0d9a\u0dc3\u0dca \u0d9a\u0dd9\u0dbb\u0dd4\u0dab\u0dd4 \u0dad\u0dd0\u0db9\u0dd2\u0dbd\u0dd2 \u0db4\u0dd0\u0dc4\u0dd0\u0dad\u0dd2 \u0db4\u0daf\u0d9a\u0dca\u0d9a\u0db8\u0d9a\u0dca \u0db4\u0dd0\u0dc5\u0db3 \u0db4\u0dcf\u0dbb\u0dca\u0dbd