    "chunk_text": "\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1\u0dba \u0dc0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8\u0da7 \u0dc3\u0dd3\u0db8\u0dcf \u0dc0\u0dda\n\n\u0d8a\u0dba\u0dda \u0daf\u0dd2\u0db1 \u0db4\u0dc3\u0dca\u0dc0\u0dbb\u0dd4 02.05 \u0da7\u00a0 \u0db8\u0dcf\u0dad\u0dbb \u0dc3\u0dd2\u0da7 \u0d9a\u0ddc\u0dc5\u0db9 \u0db8\u0dbb\u0daf\u0dcf\u0db1 \u0db6\u0dbd\u0dcf \u0db0\u0dcf\u0dc0\u0db1\u0dba \u0dc0\u0dd6 \u0db8\u0db1\u0dca\u0daf\u0d9c\u0dcf\u0db8\u0dd3 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d9a\u0db9\u0dd4\u0dbb\u0dd4\u0d9c\u0db8\u0dd4\u0dc0 \u0dc4\u0dcf \u0dc0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0d85\u0dad\u0dbb \u0db4\u0dd2\u0dbd\u0dd2 \u0db4\u0dd0\u0db1\u0dd3\u0db8\u0d9a\u0da7 \u0dbd\u0d9a\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d9a\u0dcf\u0dbb\u0dca\u200d\u0dba\u0db8\u0dab\u0dca\u0da9\u0dba\u0dbd \u0db1\u0dd0\u0dc0\u0dad\u00a0 \u0d91\u0dc4\u0dd2 \u0db4\u0dd2\u0dbd\u0dd2 \u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbd \u0db1\u0db8\u0dd4\u0dad\u0dca \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca \u0d91\u0db8 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d91\u0db8\u00a0 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0dda\u0db8 \u0db4\u0dd2\u0dbd\u0dd2 \u0db4\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0dbd\u0d9a\u0dca \u0d87\u0dad.\n\n\u0dba\u0dbd\u0dd2\u0dad\u0dca \u0d91\u0dc4\u0dd2 \u0db4\u0dd2\u0dbd\u0dd2 \u0d9c\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7\u0dad\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d9c\u0db8\u0db1\u0dcf\u0d9c\u0db8\u0db1 \u0d9a\u0d