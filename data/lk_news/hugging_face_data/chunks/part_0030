    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbb\u0dc4\u0dbd\u0dc0\u0dbd-\u0db6\u0dc4-\u0dba\u0db1\u0dad\u0dbb-\u0d9a\u0dbd-\u0db4\u0db1\u0dbd/1-683676",
    "lang": "si",
    "newspaper_id": "lankadeepalk",
