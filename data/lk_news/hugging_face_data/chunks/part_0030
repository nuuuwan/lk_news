    "chunk_text": "\u0daf\u0dc0\u0dc3\u0dca \u0dc4\u0dad\u0da7 \u0dab\u0dba \u0dad\u0ddc\u0d9c\u0dba \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 300\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd9\u0dbd\u0dcf\n\n\u0daf\u0dc0\u0dc3\u0dca \u0dc4\u0dad\u0da7 \u0dbb\u0da7\u0dda \u0dab\u0dba \u0dad\u0ddc\u0d9c\u0dba \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 300\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dbb\u0dc0\u0dd3 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf:- (\u0db1.\u0db4\u0dca\u200d\u0dbb.\u0db4\u0dd9) \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0daf\u0dd3 \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba.\n\n\u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0db8\u0dda \u0db6\u0dc0 \u0d9a\u0dd3\u0dc0\u0dda \u0db6\u0dbd\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\u0dc1\u0dba\u0dda \u0dc0\u0dd0\u0dba \u0dc1\u0dd3\u0dbb\u0dca\u0dc2 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc0\u0dd2\u0dc0\u0dcf\u0daf\u0dba\u0da7 \u0d91\u0d9a\u0dca\u0dc0\u0dd9\u0db8\u0dd2\u0db1\u0dd2.\n\n\"2025 \u0dc0\u0dc3\u0dbb \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d9c\u0dd2\u0d9c\u0dcf \u0dc0\u0ddc\u0da7\u0dca16500\u0d9a\u0dca \u0dbb\u0da7\u0dda \u0da2\u0db1\u0db1\u0dba \u0dc0\u0dd9\u0db1\u0dc0\u0dcf.2030 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0db8\u0dda \u0db8\u0da7\u0dca\u0da7\u0db8\u0db8 240000 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db4\u0dd4\u0dbb\u0ddd\u0d9a\u0dae\u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf.2050 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d92 \u0d85\u0d9c\u0dba \u0d9c\u0dd2\u0d9c\u0dcf \u0dc0\u0ddc\u0da7\u0dca 45000 \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0db8\u0da7 \u0db1\u0dd2\u0dba\u0db8\u0dd2\u0dad\u0dba\u0dd2.\n\n\u0d85\u0db4 \u0db7\u0dba\u0dcf\u0db1\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0dc3\u0dd9\u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dc0 \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.\u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0daf\u0dc0\u0dc3\u0dda \u0da9\u0ddc\u0dbd\u0dbb\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 300 \u0db8\u0da7\u0dca\u0da7\u0db8\u0dda \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf.\u0db8\u0dda \u0d9a\u0dad\u0dcf \u0d9a\u0dbb\u0db1 \u0db8\u0ddc\u0dc4\u0ddc\u0dad\u0dda \u0d91\u0dbd\u0dca \u0dc3\u0dd3 \u0d91\u0d9a\u0d9a\u0dca \u0d85\u0dbb\u0dd2\u0db1\u0dca\u0db1 \u0db1\u0db8\u0dca \u0da9\u0ddc\u0dbd\u0dbb\u0dba 312 \u0d9a\u0da7 \u0db4\u0db8\u0dab \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3 \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0daf\u0dc0\u0dc3\u0dca 7\u0db1\u0dca \u0d85\u0db4 \u0dbb\u0da7\u0dda \u0dab\u0dba \u0dad\u0ddc\u0d9c\u0dba \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 300\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3 \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf. \u0db8\u0dda \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0d85\u0db4\u0dda \u0d86\u0dba\u0ddd\u0da2\u0db1\u0dba\u0da7 \u0db8\u0ddc\u0db1 \u0d85\u0db1\u0dca\u0daf\u0db8\u0dd2\u0db1\u0dca \u0db6\u0dbd\u0db4\u0dcf\u0db1\u0dc0\u0dcf\u0daf \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0dad\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2.\n\n\u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0db6\u0dbd \u0d92\u0d9a\u0d9a\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0db1 \u0db8\u0dd2\u0dbd \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0dab\u0dba\u0d9a\u0dca.\u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0, \u0db4\u0d9a\u0dd2\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba, \u0db6\u0d82\u0d9c\u0dbd\u0dcf\u0daf\u0dda\u0dc1\u0dba \u0dc0\u0dd0\u0db1\u0dd2 \u0dbb\u0da7\u0dc0\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0d92\u0d9a\u0d9a\u0dba\u0d9a \u0db8\u0dd2\u0dbd \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca 16-20 \u0d85\u0dad\u0dbb \u0d85\u0d9c\u0dba\u0d9a \u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dc0\u0dcf.\u0dad\u0dcf\u0dba\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0dba \u0db8\u0dd0\u0dbd\u0dda\u0dc3\u0dd2\u0dba\u0dcf\u0dc0 \u0dc0\u0dd0\u0db1\u0dd2 \u0dbb\u0da7\u0d9a \u0d91\u0db8 \u0d85\u0d9c\u0dba 22\u0d9a\u0dca\u00a0 \u0db4\u0db8\u0dab \u0dc0\u0dd9\u0db1\u0dc0\u0dcf.\u0db1\u0db8\u0dd4\u0dad\u0dca \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0d92\u0d9a\u0d9a\u0dba\u0d9a \u0db8\u0dd2\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u0db1\u0dda 24-25\u0d9a\u0dca \u0db8\u0da7\u0dca\u0da7\u0db8\u0d9a\u0dba\u0dd2 \u0dba\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0daf \u0dbb\u0dc0\u0dd3 \u0d9a\u0dbb\u0dd4\u0dab\u0dcf\u0db1\u0dcf\u0dba\u0d9a \u0db8\u0dc4\u0dad\u0dcf \u0d9a\u0dd3\u0dba."
