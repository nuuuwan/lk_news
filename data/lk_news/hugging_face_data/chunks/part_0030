    "chunk_text": "\u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb\u0dda \u0dc0\u0dd0\u0dc0\u0dca \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0db8\u0dba\u0dd2\n\n\u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0da7 \u0d87\u0daf \u0dc4\u0dd0\u0dbd\u0dd9\u0db1 \u0db0\u0dcf\u0dbb\u0dcf\u0db1\u0dd2\u0db4\u0dcf\u0dad \u0dc0\u0dcf\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd0\u0dc0\u0dca\u0dc0\u0dbd \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8 \u0d89\u0dc4\u0dc5 \u0dba\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0 \u0dc0\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0dba\u0dd2.\n\n\u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0db8\u0dd4\u0dc0\u0dda \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0d9a\u0ddc\u0dab\u0dca\u0da9\u0dd4\u0dc0\u0da7\u0dd4\u0dc0\u0dcf\u0db1 \u0dc0\u0dd0\u0dc0 \u0d85\u0d9c\u0dbd\u0dca \u0dc4\u0dba\u0d9a\u0dca \u0db4\u0db8\u0dab \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0dd0\u0db8\u0dd2\u0db8\u0da7 \u0db4\u0da7\u0db1\u0dca \u0d9c\u0dd9\u0db1 \u0dad\u0dd2\u0db6\u0dda .\n\n\u0db8\u0dda\u00a0 \u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0d89\u0d9c\u0dd2\u0db1\u0dd2\u0dba\u0dcf\u0d9c\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0dda \u0d9c\u0db8\u0db1\u0dcf \u0d9c\u0db8\u0db1 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0daf\u0dc4\u0dcf \u0db8\u0daf \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0db6\u0dcf\u0db0\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0dd2 \u0dad\u0dd2\u0db6\u0dda.\n\n\u0db8\u0dd9\u0dba\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0dc0\u0dbd\u0d9c\u0db8 \u0dc0\u0dd0\u0dc0 \u0d85\u0d9f\u0dbd\u0dca \u0dc4\u0dad\u0dbb\u0d9a\u0dca \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0db8\u0db1 \u0d85\u0dad\u0dbb \u0dc0\u0dd3\u0dbb\u0d9c\u0ddc\u0da9 \u0dc0\u0dd0\u0dc0 \u0d85\u0da9\u0dd2\u0dba\u0d9a\u0dca \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0db8\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2.\u0dd9\n\n\u0db8\u0dda \u0d85\u0dad\u0dbb \u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0dbd\u0dca\u0db8\u0dd4\u0db1\u0dda \u0dc3\u0db8\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dda \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4\u0daf \u0da2\u0dbd\u0dba\u0dd9\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd2 \u0dad\u0dd2\u0db6\u0dda."
