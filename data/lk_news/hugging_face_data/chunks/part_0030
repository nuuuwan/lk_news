    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dba\u0db4\u0db1\u0dba\u0da7-\u0d9c\u0dc4\u0dc3\u0dae-\u0d9a\u0dbb\u0da9\u0d9c\u0db1\u0dba\u0d9a/1-683697",
