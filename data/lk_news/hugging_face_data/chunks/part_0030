    "description": "\u0dc0\u0dd9\u0da9\u0dd2 \u0db4\u0dc4\u0dbb\u0dd2\u0db1\u0dca \u0d85\u0db9\u0dd4\u0dc3\u0dd0\u0db8\u0dd2 \u0dba\u0dd4\u0dc0\u0dbd \u0db8\u0dbb\u0dd4\u0da7",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dc0\u0da9-\u0db4\u0dc4\u0dbb\u0db1-\u0d85\u0db9\u0dc3\u0db8-\u0dba\u0dc0\u0dbd-\u0db8\u0dbb\u0da7/1-683396",
