    "description": "\u0dc0\u0dad\u0dd4 \u0d9a\u0db8\u0dca\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd3\u0db8 \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0daf\u0dbb\u0dcf\u0d9c\u0db1\u0dca\u0db1 \u0db6\u0dd1",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc0\u0dad-\u0d9a\u0db8\u0d9a\u0dbb\u0dc0\u0db1\u0da7-\u0dc3\u0dbd\u0d9a\u0db8-\u0dc0\u0db4\u0d9a\u0dc2\u0dba\u0da7-\u0daf\u0dbb\u0d9c\u0db1\u0db1-\u0db6/101-683276",
