    "chunk_text": "\u0db8\u0dda \u0d9a\u0da9\u0dda \u0dc0\u0dd0\u0da9\u0da7 \u0d87\u0dc0\u0dd2\u0dad\u0dca \u0daf\u0dd0\u0db1\u0dca \u0db8\u0dcf\u0dc3 6 \u0d9a\u0dca \u0dc0\u0dd2\u0dad\u0dbb \u0dc0\u0dd9\u0db1\u0dc0\u0dcf. \u0d91\u0daf\u0dcf \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd2\u0db8 \u0db8\u0dd9\u0dc4\u0dd9\u0db8\u0dba\u0dd2 \u0dc0\u0dd4\u0db1\u0dda. \u0db8\u0da7 \u0dad\u0dda\u0dbb\u0dd4\u0dab\u0dda \u0d8b\u0da9\u0dd2\u0db1\u0dca \u0d9c\u0dc4\u0d9a\u0dca \u0d91\u0db1\u0dc0\u0dcf \u0dc0\u0dcf\u0d9c\u0dda. \u0db8\u0db8 \u0d9a\u0da9\u0dda \u0d85\u0d82\u0d9a\u0dbd\u0dca\u0da7 \u0d9a\u0dd2\u0dc0\u0dcf \u0d9c\u0dc4\u0d9a\u0dca \u0d91\u0db1\u0dc0\u0dcf \u0daf\u0dd4\u0dc0\u0db8\u0dd4 \u0d9a\u0dd2\u0dba\u0dbd\u0dcf. \u0d92 \u0daf\u0dd4\u0dc0\u0d9c\u0dd9\u0db1 \u0db8\u0dd0\u0daf\u0da7 \u0d91\u0daf\u0dca\u0daf\u0dd3 \u0dad\u0db8\u0dba\u0dd2 \u0db8\u0dda \u0d85\u0db1\u0db4\u0dd9\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0da7 \u0db8\u0dd4\u0dc4\u0dd4\u0dab \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dda. \u0db1\u0db8\u0dd4\u0dad\u0dca \u0daf\u0dd4\u0dc0\u0dcf \u0d9c\u0db1\u0dca\u0db1 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dda \u0db1\u0dd0\u0dc4\u0dd0. \u0db8\u0db8 \u0dc4\u0dd2\u0dbb \u0dc0\u0dda\u0dbd\u0dcf \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dda \u0db6\u0dd2\u0db8\u0dca \u0daf\u0dd9\u0d9a\u0d9a\u0dca \u0d85\u0dad\u0dbb \u0db8\u0da7 \u0dc4\u0dd4\u0dc3\u0dca\u0db8 \u0d9c\u0db1\u0dca\u0db1 \u0d9a\u0dd2\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dd4\u0dc5\u0dd4\u0dc0\u0db1\u0dca \u0db8\u0da7\u0dca\u0da7\u0db8\u0dda \u0dad\u0db8\u0dba\u0dd2 \u0dc4\u0dd2\u0da7\u0dd2\u0dba\u0dda \u0d91\u0dad\u0db1 \u0db4\u0dbb\u0dad\u0dbb\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dcf \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0db4\u0dc4\u0dc3\u0dd4 \u0dc0\u0dd4\u0db1\u0dcf.\n\n\u0db8\u0db8 \u0d87\u0dad\u0dd4\u0dbd\u0dda \u0d91\u0dc4\u0dd9\u0da7 \u0db8\u0dd9\u0dc4\u0dd9\u0da7 \u0dc0\u0dd9\u0db1\u0dca\u0db1 \u0d9c\u0dd2\u0dc4\u0dd2\u0db1\u0dca \u0dad\u0db8\u0dba\u0dd2 \u0d85\u0dad \u0d9a\u0dd0\u0db4\u0dd4\u0dab\u0dda \u0d8a\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0db6\u0ddc\u0dba\u0dd2\u0dbd\u0dd9\u0dbb\u0dd4\u0dc0\u0dda \u0dc0\u0dad\u0dd4\u0dbb \u0dc4\u0dd0\u0dbd\u0dd2\u0dbd\u0dcf \u0d9a\u0d9a\u0dd4\u0dbd \u0da7\u0dd2\u0d9a\u0d9a\u0dca \u0db4\u0dd2\u0da0\u0dca\u0da0\u0dd4\u0db1\u0dcf. \u0da7\u0dd2\u0d9a \u0dc0\u0dda\u0dbd\u0dcf\u0dc0\u0d9a\u0dca \u0dba\u0daf\u0dca\u0daf\u0dd2 \u0dc3\u0dd3\u0dad\u0dbd\u0d9a\u0dca \u0d86\u0dc0\u0dcf \u0db8\u0db8 \u0dc4\u0dd2\u0dad\u0dd4\u0dc0\u0dcf \u0db6\u0ddc\u0dba\u0dd2\u0dbd\u0dd9\u0dbb\u0dd4\u0dc0\u0dda \u0dc0\u0dad\u0dd4\u0dbb\u0dad\u0dca \u0db1\u0dd2\u0dc0\u0dd2\u0dbd\u0dcf \u0d9a\u0dd2\u0dba\u0dbd\u0dcf."
  },
