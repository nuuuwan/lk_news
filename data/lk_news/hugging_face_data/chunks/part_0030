    "description": "\u0dc0\u0dd3 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb \u0db8\u0dd2\u0dc5\u0d9a\u0dca",
