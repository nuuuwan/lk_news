    "description": "\u0baf\u0bbe\u0bb4\u0bbf\u0bb2\u0bcd \u0b95\u0b9a\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b9f\u0ba9\u0bcd \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd \u0b95\u0bc8\u0ba4\u0bc1!",
    "url_metadata": "https://www.virakesari.lk/article/231181",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1763878800.0,
