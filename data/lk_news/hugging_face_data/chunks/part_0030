    "chunk_text": "\u0d85\u0dbb\u0dca\u0da0\u0dd4\u0db1\u0dcf\u0da7 \u2019\u2019\u0d8b\u0d9c\u0db1\u0dca\u0da9\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2\u0dba\u2019\u2019 \u0db8\u0dad\u0d9a\u0dca \u0dc0\u0dd9\u0dbd\u0dcf\n\n\u0d8b\u0d9c\u0db1\u0dca\u0da9\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dbd\u0dca\u0dbd\u0dd2 \u0d9c\u0dda\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dba\u0db4\u0dd4 \u0d8b\u0d9c\u0db1\u0dca\u0da9\u0dcf \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2\u0dad\u0dca \u0d85\u0daf \u0db8\u0dda \u0dc3\u0db7\u0dcf\u0dc0\u0dda\u00a0 \u0db1\u0dd0\u0dad\u0dd0\u0dba\u0dd2 \u0db8\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0dbb\u0dcf\u0db8\u0db1\u0dcf\u0daf\u0db1\u0dca \u0d85\u0dbb\u0dca\u0da0\u0dd4\u0db1\u0dcf \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda\u0daf\u0dd3 \u0d85\u0daf \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba\n\n\u0d94\u0dba\u0dcf\u0dbd\u0dcf \u0d9a\u0ddc\u0da0\u0dca\u0da0\u0dbb \u0db6\u0ddc\u0dbb\u0dd4 \u0d9a\u0dc5\u0dcf\u0daf \u0d8b\u0d9c\u0db1\u0dca\u0da9\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc3\u0dbd\u0dca\u0dbd\u0dd2 \u0d9c\u0dda\u0db1\u0dc0\u0dcf \u0d9a\u0dd2\u0dc0\u0dca\u0dc0\u0dcf. \u0d9a\u0ddd \u0d85\u0daf \u0d8b\u0d9c\u0db1\u0dca\u0da9\u0dcf\u00a0 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb\u0dd2. \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dd9\u0dad\u0dca \u0db1\u0dd1. \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba \u0d87\u0db8\u0dd0\u0dad\u0dd2 \u0db8\u0dd9\u0dad\u0db1 \u0dc4\u0dbb\u0dd2\u0dba\u0da7 \u0d9a\u0dad\u0dcf \u0d9a\u0dc5\u0dcf.\u00a0 \u0d92 \u0db1\u0dd2\u0dc3\u0dcf \u0d85\u0db4\u0dd2 \u0d91\u0dad\u0dd4\u0db8\u0dcf\u0da7 \u0d86\u0daf\u0dbb\u0dd9\u0dba\u0dd2. \u0d85\u0db4\u0dd2 \u0dc4\u0ddc\u0db3 \u0daf\u0dda\u0dc0\u0dbd\u0dca \u0dc0\u0dbd\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0 \u0dc0\u0dd9\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd1."
  },
