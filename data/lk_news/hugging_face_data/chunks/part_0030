    "description": "Ceylon Chamber of Commerce and Gujarat Chamber of Commerce & Industry sign MoU",
    "url_metadata": "https://www.ft.lk/business/Ceylon-Chamber-of-Commerce-and-Gujarat-Chamber-of-Commerce-Industry-sign-MoU/34-784457",
    "lang": "en",
