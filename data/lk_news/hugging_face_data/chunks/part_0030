    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db8\u0db8-\u0dc0\u0dc3\u0dbb-\u0db8-\u0daf\u0d9a\u0dc0-\u0dc0\u0da9\u0dad\u0db6\u0db8-107\u0d9a/1-683493",
