    "description": "Duty Free Cars; How Was Every Mother\u2019s Son Awarded\u00a0This Right?",
    "url_metadata": "https://www.colombotelegraph.com/index.php/duty-free-cars-how-was-every-mothers-son-awarded-this-right/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
    "time_ut": 1764126917.0,
