    "description": "Not everyone who dies by suicide is depressed",
    "url_metadata": "https://www.ft.lk/columns/Not-everyone-who-dies-by-suicide-is-depressed/4-784625",
    "lang": "en",
    "newspaper_id": "dailyftlk",
