    "chunk_text": "\u0dc3\u0db8\u0dd6\u0dc4\u0dba\u0dda \u0dab\u0dba \u0daf\u0dd3\u0db8\u0dda \u0d85\u0d9b\u0dab\u0dca\u0da9 \u0dc0\u0dda\u0d9c\u0dba \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0db8\u0dcf\u0dc3 \u0db1\u0dc0\u0dba \u0dad\u0dd4\u0dc5 \u0daf\u0dc5 \u0dab\u0dba \u0dc3\u0dc4 \u0d85\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dcf\u0dbb\u0db8\u0dca \u0dbb\u0dd4.\u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 381 \u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dd0\u0dad\u0dc4\u0ddc\u0dad\u0dca 25.01% \u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc0\u0dd3 \u0dbb\u0dd4.\u0da7\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1.907 \u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0d91\u0dc4\u0dd2 \u0db8\u0dcf\u0dc3\u0dd2\u0d9a \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0d85\u0d9c\u0dba \u0dbb\u0dd4.\u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 42.39 \u0d9a\u0dd2. \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0db8\u0dcf\u0dc3 12 \u0dad\u0dd4\u0dc5 \u0dab\u0dba \u0db4\u0ddc\u0dad\u0dda \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dbb\u0dd4.\u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 490 \u0d9a\u0dca \u0dc4\u0dd9\u0dc0\u0dad\u0dca 34.60% \u0d9a\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0d91\u0dc4\u0dd2 \u0db8\u0dcf\u0dc3\u0dd2\u0d9a \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba\u0dba \u0d85\u0d9c\u0dba \u0dbb\u0dd4.\u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 40.85 \u0d9a\u0dd2."
  },
