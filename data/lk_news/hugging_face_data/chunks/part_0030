    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc3\u0dbd\u0dbd-\u0dc0\u0db1-\u0d9a\u0dc5\u0da7-\u0db8\u0daf-\u0dc0\u0da9-\u0d9a\u0dbb\u0db1\u0db1/101-683945",
