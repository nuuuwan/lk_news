    "url_metadata": "https://www.lankadeepa.lk/features/\u0dc0\u0dad-\u0db4\u0da9\u0dba\u0db1-\u0dc0\u0db4\u0d9a\u0dc2\u0dba-\u0d87\u0db1\u0d9c\u0db1\u0db8/2-683638",
