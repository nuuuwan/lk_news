    "description": "\u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf.\u0dc3. \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0da1\u0db1\u0dca\u0daf\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0d9a\u0dbb\u0dc0\u0da7-\u0db4\u0dbb-\u0dc3-\u0d85\u0dba\u0dc0\u0dba-\u0dc0\u0da9-\u0da1\u0db1\u0daf\u0dba\u0db1-\u0dc3\u0db8\u0db8\u0dad\u0dba/101-683414",
    "lang": "si",
    "newspaper_id": "lankadeepalk",
    "time_ut": 1763527693.0,
    "chunk_id": "2025-11-19-lankadeepalk-d5a9cbc1-0000",
    "chunk_index": 0,
    "language": "si",
    "md5": "b53d565a616794dc0ac9bbf626a04433",
    "chunk_size_bytes": 2535,
    "chunk_text": "\u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf.\u0dc3. \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0da1\u0db1\u0dca\u0daf\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dba\u0dd2\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0da2\u0db1\u0dca\u0daf \u0d85\u0da7\u0d9a\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dad \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db4\u0dcf\u0dbd\u0d9a \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u00a0 \u0dc3\u0db8\u0dad\u0dca \u0dc0\u0dd2\u0dba.\n\n\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0dc0\u0dd2\u0d9a\u0dc3\u0dd2\u0dad \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0db8\u0dc4\u0dad\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dc0\u0dab\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0dda \u0daf\u0dd3 \u0db8\u0dd9\u0db8 \u0dbb\u0dd0\u0dc3\u0dca\u0dc0\u0dd3\u0db8 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dab\u0dd2 .\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db8\u0d82\u0d9c\u0dbd \u0d85\u0dba\u0dc0\u0dd0\u0dba\u0da7 \u0db4\u0d9a\u0dca\u0dc2\u0dc0 \u0da2\u0db1\u0dca\u0daf 27\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dd2. \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0dc0 \u0da2\u0db1\u0dca\u0daf 19\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dd2. \u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db8\u0dd4\u0dbd\u0dd4 \u0dc3\u0db7\u0dd2\u0d9a \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u00a0 46\u0d9a\u0dd2. \u0db4\u0dcf\u0dbd\u0d9a \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba\u0dda \u0dc3\u0db7\u0dd2\u0d9a \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0 20\u0d9a\u0dd2. \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0d8b\u0db4\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0db0\u0dd6\u0dbb\u0dba \u0db4\u0ddc\u0daf\u0dd4 \u0da2\u0db1 \u0db4\u0dd9\u0dbb\u0db8\u0dd4\u0dab \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dcf\u0d9c\u0dd9\u0db1\u0dca \u0d9a\u0dd9\u0db1\u0dd9\u0d9a\u0dca \u0d8b\u0dc3\u0dd4\u0dbd\u0dba\u0dd2.\n\n\u0d85\u0dba\u0dc0\u0dd0\u0dba\u0da7 \u0db4\u0d9a\u0dca\u0dc2\u0dc0 \u0db8\u0dcf\u0dc5\u0dd2\u0db8\u0dcf\u0dc0\u0dda \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca 20\u0daf\u0dd9\u0db1\u0dcf \u0dc3\u0db8\u0d9c \u0db4\u0dd4\u0da7\u0dd4\u0dc0\u0dda \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca\u00a0 03\u0daf\u0dd9\u0db1\u0dcf, \u0db4\u0dcf\u0db4\u0db1\u0dca\u0daf\u0dd4\u0dc0 \u0dbd\u0d9a\u0dd4\u0dab\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0dc0\u0dcf\u0db0\u0dd3\u0db1 \u0d89\u0dbd\u0dca\u0dbd\u0dd6 \u0daf\u0dd9\u0daf\u0dd9\u0db1\u0dcf , \u0db4\u0ddc\u0dbb\u0ddc\u0dc0 \u0dbd\u0d9a\u0dd4\u0dab\u0dd2\u0db1\u0dca\u00a0 \u0dc3\u0dca\u0dc0\u0dcf\u0db0\u0dd3\u0db1\u0dc0 \u0d89\u0dbd\u0dca\u0dbd\u0dd6 \u0d91\u0d9a\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd9\u0d9a\u0dca\u00a0 \u0dc3\u0dc4 \u0dc0\u0dcf\u0dc3\u0dd4\u0daf\u0dda\u0dc0 \u0db1\u0dcf\u0db1\u0dcf\u0dba\u0d9a\u0dca\u0d9a\u0dcf\u0dbb \u0db8\u0dc4\u0dad\u0dcf\u0d9c\u0dda \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dd9\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dd6 \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0dd2\u0dad\u0dba \u0da2\u0db1\u0dca\u0daf\u0dba \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dda\u0dba .\n\n\u0d85\u0dba\u0dc0\u0dd0\u0dba\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dc0\u00a0 \u0dc3\u0db8\u0d9c\u0dd2\u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u0dda \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dc4\u0daf\u0dd9\u0db1\u0dcf, \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0db4\u0ddc\u0daf\u0dd4 \u0da2\u0db1 \u0db4\u0dd9\u0dbb\u0db8\u0dd4\u0dab \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0dc4\u0dba\u0daf\u0dd9\u0db1\u0dcf, \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0d9a\u0dca\u0dc2\u0dba \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd2\u0db1\u0dca \u0daf\u0dd9\u0daf\u0dd9\u0db1\u0dcf \u0dc3\u0dc4 \u0db4\u0ddc\u0dbb\u0ddc\u0dc0 \u0dbd\u0d9a\u0dd4\u0dab\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d91\u0d9a\u0dca \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0dd9\u0d9a\u0dca \u0dc3\u0db8\u0d9c \u0da2\u0db1\u0dca\u0daf19\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dd2."
  },
