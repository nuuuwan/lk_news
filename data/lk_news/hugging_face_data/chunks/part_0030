    "description": "\u0daf\u0dc4\u0db8\u0dd2\u0db1\u0dca \u0dc3\u0dd0\u0db1\u0dc3\u0dd4\u0db1 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0d9a\u0dd4\u0da9\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0db1\u0dc3\u0dd9\u0db1\u0dc0\u0dcf",
    "url_metadata": "https://www.ada.lk/breaking_news/\u0daf\u0dc4\u0db8\u0dd2\u0db1\u0dca-\u0dc3\u0dd0\u0db1\u0dc3\u0dd4\u0db1-\u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca\u0dc3\u0dd4-\u0d9a\u0dd4\u0da9\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca-\u0dc0\u0dd0\u0db1\u0dc3\u0dd9\u0db1\u0dc0\u0dcf/11-419844",
