    "md5": "0b8e2572880030feeee01c0790814b58",
    "chunk_size_bytes": 2018,
    "chunk_text": "\u0db6\u0ddd\u0dc0\u0dad\u0dd0\u0db1\u0dca\u0db1\u0dda \u0daf\u0ddc\u0dbb\u0da7\u0dd4 06\u0db8 \u0d85\u0da9\u0dd2\u0dba \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb\u0dba\u0dd2\n\n\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dd0\u0dc3\u0dd2 \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0db6\u0ddd\u0dc0\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dda \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0ddc\u0dbb\u0da7\u0dd4 \u0dc4\u0dba\u0db8 \u0d85\u0da9\u0dd2\u0dba \u0db6\u0dd0\u0d9c\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dc5 \u0db6\u0dd0\u0dc0\u0dca \u0da2\u0dbd\u0dcf\u0dc1 \u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db7\u0dcf\u0dbb \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4 \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd3\u0d9a \u0db8\u0dc4\u0dda\u0dc2\u0dca \u0db1\u0dc0\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0d85\u0daf (26) \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda\u0dba.\n\n\u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0db6\u0ddd\u0dc0\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dad\u0dad\u0dca\u0dad\u0dca\u0db4\u0dbb\u0dba\u0da7 \u0d9d\u0db1 \u0d85\u0da9\u0dd2 \u0daf\u0dc3 \u0daf\u0dc3\u0daf\u0dc4\u0dc3\u0d9a\u00a0 \u0da2\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0d85\u0db9\u0db1\u0dca \u0d9c\u0d9c\u0da7 \u0db8\u0dd4\u0daf\u0dcf\u0dc4\u0dd0\u0dbb\u0dd9\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0d85\u0db9\u0db1\u0dca \u0d9c\u0d9c \u0d85\u0dc0\u0da7 \u0da2\u0dd2\u0dc0\u0dad\u0dca\u0dc0\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0\u0db1 \u0dbd\u0dd9\u0dc3\u0dad\u0dca \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4 \u0db6\u0dd4\u0daf\u0dca\u0db0\u0dd2\u0d9a \u0db8\u0dc4\u0dda\u0dc2\u0dca \u0db1\u0dc0\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda\u0dba.\n\n\u0d85\u0db9\u0db1\u0dca \u0d9c\u0d9c \u0d85\u0dc0\u0da7 \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0dc0 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db8\u0dd9\u0dc0\u0dbb \u0d8b\u0dc3\u0dc3\u0dca \u0db4\u0dd9\u0dc5 \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba\u0da7 \u0db4\u0dd9\u0db1\u0dd2\u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0daf\u0dd6 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0d85\u0db9\u0db1\u0dca \u0d9c\u0d9c \u0db4\u0dd2\u0da7\u0dcf\u0dbb \u0d9c\u0dd0\u0dc5\u0dd2\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0d85\u0db4\u0dc4\u0dc3\u0dd4\u0dad\u0dcf\u0dc0\u0db1\u0dca\u0da7 \u0db4\u0dd2\u0dbd\u0dd2\u0dba\u0db8\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0db6\u0ddd\u0dc0\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dcf\u0dc1\u0dba\u0dda \u0db6\u0dd0\u0db8\u0dca\u0db8 \u0dc4\u0dbb\u0dc4\u0dcf \u0d87\u0dad\u0dd2 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba \u0dc0\u0dd2\u0d9a\u0dbd\u0dca\u0db4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1 \u0dbd\u0dd9\u0dc3 \u0daf \u0dc4\u0dd9\u0dad\u0dd9\u0db8 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda\u0dba.\n\n\u0d89\u0dc4\u0dbd \u0da2\u0dbd \u0db4\u0ddd\u0dc2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0dc0\u0dbd\u0da7 \u0dbd\u0dd0\u0db6\u0dd9\u0db1 \u0da2\u0dbd\u0dba \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0db6\u0ddd\u0dc0\u0dad\u0dd0\u0db1\u0dca\u0db1 \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0da7 \u0dad\u0dad\u0dca\u0dad\u0dca\u0db4\u0dbb\u0dba\u0da7 \u0d9d\u0db1 \u0d85\u0da9\u0dd2 \u0daf\u0ddc\u0dbd\u0ddc\u0dc3\u0dca \u0daf\u0dc4\u0dc3\u0d9a \u0da2\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dab\u0dba\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd9\u0db8\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0\u0daf \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d9a\u0dd2\u0dba\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dda\u0dba."
  },
