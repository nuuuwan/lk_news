    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0dbd\u0d9a\u0dc0-\u0dad\u0db1\u0db1-\u0daf\u0d9a\u0d9a-\u0db6\u0dbb-\u0dad\u0dbb\u0dad\u0dbb-\u0dc0\u0dbd\u0da7-\u0dbb\u0dc0\u0da7\u0dbd/1-683681",
