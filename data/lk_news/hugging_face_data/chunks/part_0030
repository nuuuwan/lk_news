    "description": "Double Cab debacle \u2013 Soviet-style standardisation",
    "url_metadata": "http://island.lk/double-cab-debacle-soviet-style-standardisation/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1763487420.0,
    "chunk_id": "2025-11-18-islandlk-b9565f19-0000",
    "chunk_index": 0,
