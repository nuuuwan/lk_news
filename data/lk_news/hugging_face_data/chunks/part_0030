    "chunk_text": "\u2019\u2019\u0dbb\u0da7\u0dd9\u0dca  \u0dad\u0dd4\u0db1\u0dca\u0dbd\u0d9a\u0dca\u0dc2 \u0dc4\u0dd0\u0da7\u0db4\u0db1\u0dca\u0daf\u0dcf\u0dc4\u0d9a\u0da7 \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0db1\u0dd1\u2019\u2019\n\n\u0db8\u0dd9\u0dbb\u0da7 \u0dad\u0dd4\u0db1\u0dca\u0dbd\u0d9a\u0dca\u0dc2 \u0dc4\u0dd0\u0da7\u0db4\u0db1\u0dca\u0daf\u0dc4\u0dc3\u0dca \u0db1\u0dc0\u0dc3\u0dd2\u0dba \u0db4\u0db1\u0dc3\u0dca \u0d91\u0d9a\u0d9a (365,951) \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0dc0\u0dd2\u0dbb\u0dc4\u0dd2\u0dad\u0db7\u0dcf\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dd9\u0dc5\u0dd9\u0db1 \u0db6\u0dc0 \u0d85\u0d9c\u0dca\u200d\u0dbb\u0dcf\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0dc4\u0dbb\u0dd2\u0db1\u0dd2 \u0d85\u0db8\u0dbb\u0dc3\u0dd6\u0dbb\u0dd2\u0dba \u0db8\u0dd9\u0db1\u0dc0\u0dd2\u0dba \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0daf\u0dd3 \u0d85\u0daf (26) \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd4\u0dc0\u0dcf\u0dba\n\n\u0d85\u0dd0\u0dba \u0db8\u0dd9\u0dc3\u0dd9\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd4\u0dc0\u0dd9\u0dca \u0dc0\u0dd2\u0db4\u0d9a\u0dca\u0dc2\u0db1\u0dcf\u0dba\u0d9a \u0dc3\u0da2\u0dd2\u0dad\u0dca \u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0daf\u0dcf\u0dc3 \u0db8\u0dc4\u0dad\u0dcf \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0dc1\u0dca\u0db1\u0dba\u0d9a\u0da7 \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4\u00a0 \u0daf\u0dd9\u0db8\u0dd2\u0db1\u0dd2\n\n2024 \u0dc1\u0dca\u200d\u0dbb\u0db8 \u0db6\u0dbd\u0d9a\u0dcf \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0da7 \u0d85\u0db1\u0dd4\u0dc0 2024 \u0dc0\u0dc3\u0dbb\u0dda 4.5\u0d9a\u0dca \u0dc0\u0dd6 \u0db4\u0dc5\u0db8\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0dc0\u0dd2\u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba 2025 \u0daf\u0dd3 3.8\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db4\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0daf\u00a0 \u0d87\u0dba \u0d85\u0dc0\u0db0\u0dcf\u0dbb\u0dab\u0dba\u00a0 \u0d9a\u0dc5\u0dcf\u0dba"
  },
