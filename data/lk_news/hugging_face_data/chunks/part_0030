    "description": "Interim report on public service salary structure to enhance professionalism",
    "url_metadata": "https://www.ft.lk/news/Interim-report-on-public-service-salary-structure-to-enhance-professionalism/56-784365",
    "lang": "en",
    "newspaper_id": "dailyftlk",
