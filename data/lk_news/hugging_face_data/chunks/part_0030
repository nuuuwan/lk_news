    "url_metadata": "https://www.ada.lk/business/GREE-AirTech-Sri-Lanka-\u0d9c\u0ddd\u0dbd\u0dd3\u0dba-\u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1\u0dba\u0d9a\u0dca-\u0dbd\u0db6\u0dba\u0dd2/7-419724",
