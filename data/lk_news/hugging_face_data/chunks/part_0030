    "chunk_text": "\u0d9a\u0dd0\u0db6\u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca \u0db8\u0dad\u0da7 \u0d9c\u0dc3\u0d9a \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0da7\u0dd9\u0dba\u0dd2\n\n\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc0\u0dbb\u0dca\u0dc2\u0dcf\u0dc0 \u0dc4\u0dcf \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d9f \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0d9c\u0dc3\u0d9a\u0dca \u0d85\u0daf 25\u00a0 \u0db6\u0dd9\u0dbb\u0d9c\u0dbd \u0d9c\u0dbd\u0dca\u0d9a\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda\u00a0 \u0db8\u0dd2\u0daf\u0dd4\u0dbd\u0dda \u0db1\u0dc0\u0dad\u0dcf \u0dad\u0dd2\u0db6\u0dd6 \u0d9a\u0dd0\u0db6\u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca\u00a0 \u0db8\u0dad\u0da7 \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0da7\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0d9a\u0dd0\u0db6\u0dca\u00a0 \u0dbb\u0dae\u0dba\u0da7 \u0daf\u0dd0\u0da9\u0dd2 \u0dc4\u0dcf\u0db1\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc4\u0db4\u0dd4\u0dad\u0dbd\u0dba\u0dda \u0db4\u0ddc\u0dbd\u0dd2\u0dc3\u0dd2\u0dba \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba. \u0db8\u0dd9\u0dc3\u0dda \u0d9a\u0dd0\u0db6\u0dca \u0dbb\u0dae\u0dba\u0d9a\u0dca \u0db8\u0dad\u0da7 \u0d9c\u0dc3\u0d9a\u0dca \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0da7\u0dd3 \u0d87\u0dad\u0dca\u0dad\u0dda \u0db6\u0dd9\u0dbb\u0d9c\u0dbd\u00a0 \u0db1\u0dd2\u0d9a\u0db4\u0ddc\u0dad \u0d9c\u0dbd\u0dca \u0d9a\u0db1\u0dca\u0daf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0db4\u0dad\u0dca\u0db8\u00a0 \u0d9a\u0dd4\u0db8\u0dcf\u0dbb \u0db1\u0db8\u0dd0\u0dad\u0dd2 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dcf\u0dbb\u0dd2\u0d9a \u0db8\u0dc4\u0dad\u0dd9\u0d9a\u0dd4\u0da7 \u0d85\u0dba\u0dad\u0dca \u0d9a\u0dd0\u0db6\u0dca\u00a0 \u0dbb\u0dae\u0dba\u0dba\u0d9a\u0dca\u00a0 \u0db8\u0dad\u0da7\u0dba ."
