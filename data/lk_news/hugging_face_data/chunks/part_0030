    "url_metadata": "https://www.lankadeepa.lk/news/\u0db4\u0daf\u0dba\u0dad\u0dbd\u0dc0-\u0db4\u0dbb-\u0dc3\u0db7-\u0d85\u0dba\u0dc0\u0dba-\u0daf\u0dc0\u0db1-\u0dc0\u0dbb\u0da7\u0dad-\u0db4\u0dbb\u0daf\u0dba/101-683632",
