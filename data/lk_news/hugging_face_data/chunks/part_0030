    "lang": "en",
    "newspaper_id": "dbsjeyarajcom",
    "time_ut": 1763987400.0,
    "chunk_id": "2025-11-24-dbsjeyarajcom-9ff4a687-0002",
    "chunk_index": 2,
    "language": "en",
