    "description": "\u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dd2\u0dbd\u0dca\u0d9a\u0dca \u0dc6\u0dd4\u0da9\u0dca\u0dc3\u0dca \u0db1\u0dc0\u0dad\u0db8 \u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba \u2019\u2019\u0dc3\u0dd4\u0daf\u0dca\u0daf\u0dd2\u2019\u2019 \u0d91\u0dc5\u0dd2\u0daf\u0d9a\u0dd3",
    "url_metadata": "https://www.ada.lk/business/\u0dbd\u0d82\u0d9a\u0dcf-\u0db8\u0dd2\u0dbd\u0dca\u0d9a\u0dca-\u0dc6\u0dd4\u0da9\u0dca\u0dc3\u0dca-\u0db1\u0dc0\u0dad\u0db8-\u0db1\u0dd2\u0dc2\u0dca\u0db4\u0dcf\u0daf\u0db1\u0dba-\u2019\u2019\u0dc3\u0dd4\u0daf\u0dca\u0daf\u0dd2\u2019\u2019-\u0d91\u0dc5\u0dd2\u0daf\u0d9a\u0dd3/7-419737",
