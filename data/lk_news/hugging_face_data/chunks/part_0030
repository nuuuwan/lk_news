    "description": "\u0db4\u0dd4\u0db1\u0dbb\u0dd4\u0daf\u0dba\u0da7 \u0d85\u0dad\u0dc0\u0db1\u0db1 \u0d85\u0dba\u0dc0\u0dd0\u0dba",
    "url_metadata": "https://www.lankadeepa.lk/features/\u0db4\u0db1\u0dbb\u0daf\u0dba\u0da7-\u0d85\u0dad\u0dc0\u0db1\u0db1-\u0d85\u0dba\u0dc0\u0dba/2-683304",
