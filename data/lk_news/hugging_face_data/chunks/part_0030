    "description": "Viet Nam explores cooperation opportunities with Northern Province",
    "url_metadata": "https://www.ft.lk/business/Viet-Nam-explores-cooperation-opportunities-with-Northern-Province/34-784581",
    "lang": "en",
    "newspaper_id": "dailyftlk",
