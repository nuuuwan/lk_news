    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc3\u0db4\u0db4-\u0d9a\u0dbb\u0dba\u0dbd-\u0dc3\u0dc0\u0d9a-\u0db4\u0db1\u0dad-\u0dc3\u0dc1\u0db0\u0db1\u0dba\u0da7/101-683360",
