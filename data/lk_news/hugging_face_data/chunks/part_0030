    "description": "\u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0d9c\u0dda \u0dad\u0dd3\u0dbb\u0d9a \u0da1\u0db1\u0dca\u0daf\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dcf\u0db1\u0daf\u0dd4\u0dbb \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0dc3\u0db8\u0dca\u0db8\u0dad\u0dba\u0dd2",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc3\u0db7\u0db4\u0dad\u0d9c-\u0dad\u0dbb\u0d9a-\u0da1\u0db1\u0daf\u0dba\u0db1-\u0db4\u0db1\u0daf\u0dbb-\u0d85\u0dba\u0dc0\u0dba-\u0dc3\u0db8\u0db8\u0dad\u0dba/101-683284",
