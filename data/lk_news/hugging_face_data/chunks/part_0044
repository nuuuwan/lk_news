    "url_metadata": "https://www.ft.lk/business/Cabinet-clears-export-control-import-regulations-for-Parliamentary-approval/34-794347",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1783477165.0,
    "chunk_id": "2026-07-08-dailyftlk-5f3d6738-0000",
    "chunk_index": 0,
