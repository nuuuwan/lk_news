    "description": "BYD building Sri Lanka\u2019s EV ecosystem beyond the showroom",
    "url_metadata": "http://island.lk/byd-building-sri-lankas-ev-ecosystem-beyond-the-showroom/",
    "lang": "en",
    "newspaper_id": "islandlk",
