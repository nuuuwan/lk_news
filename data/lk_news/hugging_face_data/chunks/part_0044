    "url_metadata": "https://www.dailymirror.lk/breaking-news/US-launches-more-strikes-on-Iran-with-blasts-reported-in-south-of-country/108-345110",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1783560539.0,
    "chunk_id": "2026-07-09-dailymirrorlk-6e1113f5-0000",
    "chunk_index": 0,
