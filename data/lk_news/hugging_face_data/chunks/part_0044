    "description": "IMF warns fuel-importing economies risk inflation rebound",
    "url_metadata": "https://www.dailymirror.lk/business/IMF-warns-fuel-importing-economies-risk-inflation-rebound/215-345232",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
