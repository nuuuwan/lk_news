    "chunk_text": "\u0dc3\u0dda\u0dc0\u0dcf \u0dc0\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2\u0dba \u0db4\u0dc4\u0dc5\u0da7\n\n\u0db8\u0dd9\u0dbb\u0da7 \u0dc3\u0dda\u0dc0\u0dcf \u0dc0\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba\u00a0 \u0db8\u0dd9\u0db8 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda (2026) \u0db4\u0dc5\u0db8\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0daf\u0dd2\u00a0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 3.7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db4\u0dc4\u0dc5\u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dca \u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dbd\u0d82\u0d9a\u0dcf \u0db8\u0dc4\u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dd2 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0d9a \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dda.\n\n\u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda (2025) \u0db8\u0dd0\u0dba\u0dd2 \u0db8\u0dcf\u0dc3\u0dba\u0dda \u0daf\u0dd2 \u0db8\u0dd9\u0dbb\u0da7 \u0dc3\u0dda\u0dc0\u0dcf \u0dc0\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad\u0dd2 \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad\u0dba\u00a0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 3.8\u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd2 \u0dad\u0dd2\u0db6\u0dd4 \u0db6\u0dc0\u0daf \u0db8\u0dc4\u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0dda \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dda.\n\n\u0db8\u0dd9\u0db8 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0d9a\u0dcf\u0dbb\u0dca\u0dad\u0dd4\u0dc0 \u0dad\u0dd4\u0dbd\u00a0 \u0db8\u0dd9\u0dbb\u0da7 \u0db8\u0dd4\u0db5 \u0dc3\u0dda\u0dc0\u0dcf \u0db1\u0dd2\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0db1\u0dca\u0d9c\u0dd9\u0db1\u0dca\u00a0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 23.7\u0d9a\u0dca \u0d9a\u0dd8\u0dc2\u0dd2\u0d9a\u0dbb\u0dca\u0db8\u0dcf\u0db1\u0dca\u0dad\u0dba\u0dda \u0db1\u0dd2\u0dbb\u0dad\u0dc0 \u