    "description": "From the Pathfinder Collection: A Soldier\u2019s Eye on Ceylon",
    "url_metadata": "http://island.lk/from-the-pathfinder-collection-a-soldiers-eye-on-ceylon/",
    "lang": "en",
    "newspaper_id": "islandlk",
