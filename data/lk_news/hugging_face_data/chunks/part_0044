    "description": "SAWM - SL leads national dialogue on ethical AI in media",
    "url_metadata": "https://www.ft.lk/news/SAWM-SL-leads-national-dialogue-on-ethical-AI-in-media/56-794085",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1782946722.0,
