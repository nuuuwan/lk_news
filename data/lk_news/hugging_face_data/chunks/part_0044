\u0dd2 \u0d89\u0db1\u0dd2\u0db8\u00a0\u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0d9a\u0dc5 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u00a0 \u0d9a\u0da9\u0dd4\u0dbd\u0dd4 9\u0da7 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 251\u0d9a\u0dca \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5\u0dda\u0dba. \u0db1\u0dd0\u0dc0\u0dad\u0dad\u0dca \u0dc3\u0dd2\u0dba \u0daf\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u0d89\u0db1\u0dd2\u0db8 \u0d9a\u0dca\u200d\u0dbb\u0dd3\u0da9\u0dcf \u0d9a\u0dc5 \u0d9a\u0ddc\u0daf\u0dd9\u0dc0\u0dca \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8 \u0d9a\u0dd2\u0dc3\u0dd2\u0dc0\u0dd9\u0d9a\u0dd4 \u0db1\u0ddc\u0daf\u0dd0\u0dc0\u0dd2 \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 109\u0d9a\u0dca \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5\u0dda\u0dba."
