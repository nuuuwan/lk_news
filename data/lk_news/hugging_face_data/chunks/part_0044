    "url_metadata": "https://www.ft.lk/business/FTZ-manufacturers-push-for-energy-reforms-to-strengthen-export-competitiveness/34-794627",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1783993874.0,
    "chunk_id": "2026-07-14-dailyftlk-621d4d3c-0000",
