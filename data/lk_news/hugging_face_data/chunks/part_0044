    "description": "CBSL banking supervision to go digital following Cabinet approval",
    "url_metadata": "https://www.dailymirror.lk/business-news/CBSL-banking-supervision-to-go-digital-following-Cabinet-approval/273-344432",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1782965245.0,
