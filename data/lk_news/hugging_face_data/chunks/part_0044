    "description": "Neglected Kerawalapitiya industrial road sparks concerns",
    "url_metadata": "https://www.dailymirror.lk/business-news/Neglected-Kerawalapitiya-industrial-road-sparks-concerns/273-344978",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
