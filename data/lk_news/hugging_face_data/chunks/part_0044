    "url_metadata": "https://www.ft.lk/news/Criminal-cases-take-over-10-years-on-average-to-conclude-Justice-Kodagoda/56-794120",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1783038418.0,
