    "description": "Colombo Tea Auction faces scrutiny as smallholders raise concerns about dollar gains",
    "url_metadata": "http://island.lk/colombo-tea-auction-faces-scrutiny-as-smallholders-raise-concerns-about-dollar-gains/",
    "lang": "en",
    "newspaper_id": "islandlk",
