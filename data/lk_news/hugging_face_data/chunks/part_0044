    "chunk_text": "\u0db4\u0dca\u200d\u0dbb\u0d82\u0dc1\u0dba \u0dc4\u0dcf \u0db8\u0ddc\u0dbb\u0ddc\u0d9a\u0dca\u0d9a\u0ddd\u0dc0 \u0d85\u0dbb\u0dca\u0db0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0da7\u0dba\u0da7\n\n\u0db4\u0dcf\u0db4\u0db1\u0dca\u0daf\u0dd4 \u0dbd\u0ddd\u0d9a \u0d9a\u0dd4\u0dc3\u0dbd\u0dcf\u0db1 \u0dad\u0dbb\u0d9c\u0dcf\u0dc0\u0dbd\u0dd2\u0dba\u0dda \u0d85\u0dbb\u0dca\u0db0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0db4\u0dd6\u0dbb\u0dca\u0dc0 \u0dc0\u0da7\u0dba\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd2\u0db8\u0da7 \u0db4\u0dca\u200d\u0dbb\u0d82\u0dc1\u0dba \u0dc4 \u0db8\u0ddc\u0dbb\u0ddc\u0d9a\u0dca\u0d9a\u0ddd\u0dc0 \u0d8a\u0dba\u0dda \u0dc3\u0db8\u0dad\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0db4\u0dca\u200d\u0dbb\u0d82\u0dc1\u0dba \u0dc4\u0dcf \u0db4\u0dd0\u0dbb\u0d9c\u0dd4\u0dc0\u0dda \u0d85\u0dad\u0dbb \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dd2 \u0dad\u0dbb\u0d9c\u0dba \u0d9c\u0ddd\u0dbd 1-0\u0d9a\u0dca \u0dbd\u0dd9\u0dc3\u0dd2\u0db1\u0dca \u0da2\u0dba \u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0db4\u0dca\u200d\u0dbb\u0d82\u0dc1\u0dba \u0dc3\u0db8\u0dad\u0dca\u0dc0\u0dd2\u0dba. \u0db4\u0dca\u200d\u0dbb\u0d82\u0dc1\u0dba \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dad\u0dbb\u0d9c\u0dba\u0dda70 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dd2\u0db1\u0dcf\u0da9\u0dd2\u0dba\u0dda\u0daf\u0dd2 \u0daf\u0da9\u0dd4\u0dc0\u0db8\u0dca \u0db4\u0dc4\u0dbb\u0d9a\u0dca \u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0d92\u0db8\u0dca\u0db6\u0dcf\u0db4\u0dca\u0db4\u0dda \u0dc3\u0db8\u0dad\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0d9a\u0dd0\u0db1\u0da9\u0dcf\u0dc0 \u0dc4\u0dcf \u0db8\u0ddc\u0dbb\u0ddc\u0d9a\u0dca\u0d9a\u0ddd\u0dc0 \u0d85\u0dad\u0dbb \u0dad\u0dbb\u0d9c\u0dba\u0dd9 \u0d9c\u0ddd\u0dbd 3-0\u0d9a\u0dca \u0dbd\u0dd9\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dc4\u0dc3\u0dd4\u0dc0\u0dd9\u0db1\u0dca\u0db8 \u0da2\u0dba \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0db8\u0ddc\u0dbb\u0ddc\u0d9a\u0dca\u0d9a\u0ddd\u0dc0 \u0dc3\u0db8\u0dad\u0dca\