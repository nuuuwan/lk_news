    "description": "Sri Lanka looks stable, that is exactly the danger",
    "url_metadata": "https://www.ft.lk/columns/Sri-Lanka-looks-stable-that-is-exactly-the-danger/4-794459",
    "lang": "en",
    "newspaper_id": "dailyftlk",
