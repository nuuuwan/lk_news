    "description": "Ravi Gamage appointed to Capital Maharaja Group Board",
    "url_metadata": "https://www.ft.lk/business/Ravi-Gamage-appointed-to-Capital-Maharaja-Group-Board/34-794160",
    "lang": "en",
    "newspaper_id": "dailyftlk",
