    "description": "Pakistan Defence Secretary arrives in Sri Lanka",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Pakistan-Defence-Secretary-arrives-in-Sri-Lanka/108-344488",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1782974193.0,
