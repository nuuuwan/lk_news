    "num": "dailyftlk-f901c70c",
    "date_str": "2026-07-13",
    "description": "Effective trade  agreements: Why and how?",
    "url_metadata": "https://www.ft.lk/columns/Effective-trade-agreements-Why-and-how/4-794554",
    "lang": "en",
    "newspaper_id": "dailyftlk",
