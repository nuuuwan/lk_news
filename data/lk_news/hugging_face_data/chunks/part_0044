    "description": "The State wants our data, how will it protect it?",
    "url_metadata": "https://www.ft.lk/columns/The-State-wants-our-data-how-will-it-protect-it/4-794125",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1783039186.0,
    "chunk_id": "2026-07-03-dailyftlk-4dc6ef38-0002",
