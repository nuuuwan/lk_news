    "description": "\u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dba\u0d9a \u0db1\u0dd2\u0dba\u0db8\u0dd4\u0dc0\u0dcf \u0dbd\u0dd9\u0dc3 \u0dbd\u0d82\u0d9a\u0dcf \u0dc0\u0dcf\u0dab\u0dd2\u0da2 \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0db1\u0dc0 \u0d9c\u0db8\u0db1\u0d9a",
    "url_metadata": "https://www.ada.lk/business/\u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a-\u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dba\u0d9a-\u0db1\u0dd2\u0dba\u0db8\u0dd4\u0dc0\u0dcf-\u0dbd\u0dd9\u0dc3-\u0dbd\u0d82\u0d9a\u0dcf-\u0dc0\u0dcf\u0dab\u0dd2\u0da2-\u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba-\u0db1\u0dc0-\u0d9c\u0db8\u0db1\u0d9a/7-423058",
