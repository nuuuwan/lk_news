    "url_metadata": "https://www.ft.lk/business/Ceylon-Chamber-convenes-dialogue-on-energy-security-and-standards-for-Sri-Lanka-s-energy-transition/34-794159",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1783046256.0,
    "chunk_id": "2026-07-03-dailyftlk-b5e15f9e-0000",
