    "description": "International call to pause PTA use till new law introduced",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/International-call-to-pause-PTA-use-till-new-law-introduced/108-344626",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
