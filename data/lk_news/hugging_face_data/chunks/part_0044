    "url_metadata": "https://www.ft.lk/news/Sajith-blames-President-for-Negombo-Prison-violence-demands-independent-probe/56-794300",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1783379561.0,
