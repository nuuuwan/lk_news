    "description": "Architect of modern Qatar Sheikh Hamad bin Khalifa Al Thani dies",
    "url_metadata": "https://www.ft.lk/news/Architect-of-modern-Qatar-Sheikh-Hamad-bin-Khalifa-Al-Thani-dies/56-794575",
    "lang": "en",
    "newspaper_id": "dailyftlk",
