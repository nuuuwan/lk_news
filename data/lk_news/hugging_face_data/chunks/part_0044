    "description": "US launches fresh strikes as Iran closes Strait of Hormuz",
    "url_metadata": "https://www.dailymirror.lk/international/US-launches-fresh-strikes-as-Iran-closes-Strait-of-Hormuz/107-345423",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1783826356.0,
    "chunk_id": "2026-07-12-dailymirrorlk-0c3dc83e-0000",
    "chunk_index": 0,
