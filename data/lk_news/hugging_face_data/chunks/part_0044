    "date_str": "2026-07-01",
    "description": "Balancing import liberalisation and external stability: Why economic policy must put people first",
    "url_metadata": "https://www.ft.lk/columns/Balancing-import-liberalisation-and-external-stability-Why-economic-policy-must-put-people-first/4-794007",
    "lang": "en",
    "newspaper_id": "dailyftlk",
