    "description": "New Anthoney\u2019s Feeds shines at NCQP 2026",
    "url_metadata": "https://www.ft.lk/business/New-Anthoney-s-Feeds-shines-at-NCQP-2026/34-794262",
    "lang": "en",
    "newspaper_id": "dailyftlk",
