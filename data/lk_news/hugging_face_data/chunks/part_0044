    "description": "Merino strikes late again as Spain sink Belgium to reach World Cup Semi-finals",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Merino-strikes-late-again-as-Spain-sink-Belgium-to-reach-World-Cup-Semi-finals/108-345359",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1783719686.0,
    "chunk_id": "2026-07-11-dailymirrorlk-e2420cec-0000",
    "chunk_index": 0,
