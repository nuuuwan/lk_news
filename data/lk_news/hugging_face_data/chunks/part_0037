    "description": "CA Sri Lanka forum explores country\u2019s resilience to economic shockwaves from Middle East crisis",
    "url_metadata": "https://www.ft.lk/business/CA-Sri-Lanka-forum-explores-country-s-resilience-to-economic-shockwaves-from-Middle-East-crisis/34-789621",
    "lang": "en",
    "newspaper_id": "dailyftlk",
