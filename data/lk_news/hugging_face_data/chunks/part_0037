    "chunk_text": "\u0d9a\u0dcf\u0dc3\u0dbd\u0dca\u0dbb\u0dd3 \u0dc4\u0dcf \u0db8\u0dcf\u0dc0\u0dd4\u0dc3\u0dca\u0dc3\u0dcf\u0d9a\u0dd0\u0dbd\u0dda \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8 \u0db4\u0dc4\u0dc5\u0da7\n\n\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0d9a\u0daf\u0dd4\u0d9a\u0dbb \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0db1\u0dca\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0daf\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dba\u0dc5\u0dd2 \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0db8\u0dad \u0db8\u0dcf\u0d8b\u0dc3\u0dca\u0dc3\u0dcf \u0d9a\u0dd0\u0dbd\u0dda \u0dc4\u0dcf \u0d9a\u0dcf\u0dc3\u0dbd\u0dca\u0dbb\u0dd2 \u0da2\u0dbd\u0dcf\u0dc1\u0dc0\u0dbd \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8\u0dca \u0dc3\u0dd2\u0d9c\u0dca\u200d\u0dbb\u0dba\u0dd9\u0db1\u0dca \u0db4\u0dc4\u0dbd \u0db6\u0dd0\u0dc3 \u0d87\u0dad.\n\n\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dc0\u0dd2\u0dba\u0dc5\u0dd2 \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0db8\u0dad 05\u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d8b\u0daf\u0dd0\u0dc3\u0db1 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7\u00a0 \u0db8\u0dcf\u0d8b\u0dc3\u0dca\u0dc3\u0dcf\u0d9a\u0dd0\u0dbd\u0dda \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dda \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8 \u0db4\u0dd2\u0da7\u0dcf\u0dbb \u0db8\u0da7\u0dca\u0da7\u0db8\u0dda \u0dc3\u0dd2\u0da7 \u0d85\u0da9\u0dd2 09\u0dba\u0dd2 \u0d85\u0d9c\u0dbd\u0dca 03\u0d9a\u0dd2\u0db1\u0dca\u0daf \u0d9a\u0dcf\u0dc3\u0dbd\u0dca\u0dbb\u0dd2 \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0dda \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8 \u0db4\u0dd2\u0da7\u0dcf\u0dbb \u0db8\u0da7\u0dca\u0da7\u0db8\u0dda \u0dc3\u0dd2\u0da7 \u0d85\u0da9\u0dd2 16\u0dba\u0dd2 \u0d85\u0d9c\u0dbd\u0dca 05\u0d9a\u0dd2\u0db1\u0dca\u0daf \u0db4\u0dc4\u0dbd \u0db6\u0dd0\u0dc3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0d91\u0db8 \u0da2\u0dbd\u0dcf\u0dc1 \u0db6\u0dcf\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0d9a\u0dd4 \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba.\n\n\u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0daf\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dba\u0dc5\u0dd2 \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0db8\u0dad \u0dc3\u0db8\u0dc4\u0dbb \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d9a\u0dd0\u0dbd\u0dd0 \u0d9c\u0dd2\u0db1\u0dd2 \u0dad\u0dd0\u0db6\u0dd2\u0db8\u0dca \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0db8\u0dd9\u0db8 \u0da2\u0dbd\u0dcf\u0dc1\u0dc0\u0dbd\u0da7 \u0da2\u0dbd\u0dba \u0dc3\u0dd0\u0db4\u0dba\u0dd9\u0db1 \u0da2\u0dbd \u0db8\u0dd4\u0dbd\u0dcf\u0dc1\u0dca\u200d\u0dbb \u0dc3\u0dd2\u0daf\u0dd2 \u0dba\u0dcf\u0db8\u0dda \u0dad\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0db8 \u0dad\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0db8\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0dda\u0daf\u0dd2 \u0db8\u0dd9\u0db8 \u0da2\u0dbd\u0dcf\u0dc1\u0dc0\u0dbd \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8\u0dca \u0dad\u0dc0 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dc4\u0dbd \u0db6\u0dd0\u0dc3\u0dd2\u0db8\u0dda \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0\u0daf \u0d91\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba.\n\n\u0db8\u0dda \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0db8\u0dd9\u0db8 \u0da2\u0dbd\u0dcf\u0dc1\u0dc0\u0dbd \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0da2\u0dbd\u0dba \u0da2\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2\u0dba \u0db1\u0dd2\u0db4\u0daf\u0dc0\u0dd2\u0db8 \u0dc3\u0daf\u0dc4\u0dcf \u0d85\u0daf\u0dcf\u0dbd \u0da2\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb \u0dc0\u0dd9\u0dad \u0d85\u0d9b\u0db1\u0dca\u0da9\u0dc0 \u0dbd\u0db6\u0dcf \u0daf\u0dd2\u0db8\u0da7 \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0db6\u0dc0\u0daf \u0d91\u0db8 \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba."
