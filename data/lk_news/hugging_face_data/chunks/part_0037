    "description": "Dipped Products\u2019 50th year  focuses on regional healthcare,  education and community resilience",
    "url_metadata": "https://www.ft.lk/business/Dipped-Products-50th-year-focuses-on-regional-healthcare-education-and-community-resilience/34-789219",
    "lang": "en",
    "newspaper_id": "dailyftlk",
