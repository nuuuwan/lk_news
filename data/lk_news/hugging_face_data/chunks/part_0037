    "description": "\u201cTHE JR I DISLIKED\u201d \u2013 Imthiaz Bakeer Markar",
    "url_metadata": "http://island.lk/the-jr-i-disliked-imthiaz-bakeer-markar/",
    "lang": "en",
    "newspaper_id": "islandlk",
