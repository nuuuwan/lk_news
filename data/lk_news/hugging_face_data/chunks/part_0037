    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0b88\u0bb0\u0bbe\u0ba9\u0bbf\u0ba9\u0bcd-\u0b85\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4-\u0ba4\u0bb2\u0bc8\u0bb5\u0bb0\u0bcd-\u0baf\u0bbe\u0bb0\u0bcd/50-373238",
