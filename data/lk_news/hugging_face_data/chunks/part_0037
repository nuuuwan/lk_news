    "description": "\u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0daf\u0dd9\u0db1 \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0d9c\u0dd0\u0db1 \u0dc0\u0dd2\u0dc1\u0dca\u0dc0\u0dcf\u0dc3\u0dba \u0daf\u0dd4\u0dbb\u0dca\u0dc0\u0dbd\u0dc0\u0dd3\u0db8 \u0dc3\u0db8\u0dcf\u0da2\u0dba\u0d9a\u0da7 \u0db7\u0dba\u0dcf\u0db1\u0d9a\u0dba\u0dd2",
