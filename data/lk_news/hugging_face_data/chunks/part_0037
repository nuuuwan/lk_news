    "url_metadata": "https://www.tamilmirror.lk/\u0b89\u0bb2\u0b95-\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0b85\u0bb0\u0bbe\u0bae\u0bcd\u0b95\u0bcb-\u0bb5\u0bc8-\u0bae\u0bc2\u0b9f\u0bbf\u0baf\u0ba4\u0bc1-\u0b9a\u0bb5\u0bc1\u0ba4\u0bbf-\u0b85\u0bb0\u0bc7\u0baa\u0bbf\u0baf\u0bbe/50-373267",
