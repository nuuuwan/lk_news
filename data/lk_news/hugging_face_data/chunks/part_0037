    "chunk_size_bytes": 4095,
    "chunk_text": "2025\u0daf\u0dd3 \u0dc0\u0db1 \u0d85\u0dbd\u0dd2 \u0db8\u0dbb\u0dab \u0dc0\u0dda\u0d9c\u0dba\u0dd9\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd9\u0dbd\u0dcf\n\n2025 \u0dc0\u0dc3\u0dbb \u0dad\u0dd4\u0dc5 \u0db8\u0dd9\u0dbb\u0da7 \u0dc0\u0db1 \u0d85\u0dbd\u0dd3\u0db1\u0dca 455\u0d9a\u0dd4 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dca \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0d9a\u0db8\u0dca \u0dc4\u0dcf \u0d85\u0db1\u0dd9\u0d9a\u0dd4\u0dad\u0dca \u0dc4\u0dda\u0dad\u0dd4\u0db1\u0dca \u0db8\u0dad \u0db8\u0dbb\u0dab\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca, \u0d92 \u0d85\u0dad\u0dbb \u0d87\u0dad\u0dd4\u0db1\u0dca \u0dc4\u0dad\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db6\u0dc0\u00a0 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0da7 \u0dc3\u0dcf\u0db4\u0dda\u0d9a\u0dca\u0dc2\u0dc0 2025 \u0dc0\u0dc3\u0dbb\u00a0 \u0dad\u0dd4\u0dc5 \u0dc0\u0db1 \u0d85\u0dbd\u0dd2 \u0db8\u0dbb\u0dab\u00a0 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d89\u0dc4\u0dc5 \u0d9c\u0ddc\u0dc3\u0dca \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb, 2024 \u0dc0\u0dc3\u0dbb\u0dda \u0dc0\u0db1 \u0d85\u0dbd\u0dd3\u0db1\u0dca 388\u0d9a\u0dd4 \u0db8\u0dbb\u0dab\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dd2\u0dab\u0dd2.\n\n\u0dc0\u0dd9\u0da9\u0dd2 \u0dad\u0dd0\u0db6\u0dd3\u0db8\u0dd9\u0db1\u0dca 79 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dc3\u0dd0\u0dbb \u0dc0\u0dd0\u0daf\u0dd3\u0db8\u0dd9\u0db1\u0dca 69 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc4\u0d9a\u0dca\u0d9a \u0db4\u0da7\u0dc3\u0dca \u0dad\u0dd0\u0db6\u0dd3\u0db8\u0dd9\u0db1\u0dca 56 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4,\u00a0 \u0daf\u0dd4\u0db8\u0dca\u0dbb\u0dd2\u0dba \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca 21 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dad\u0dd4\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0daf\u0dd2\u0dba\u0dda \u0d9c\u0dd2\u0dbd\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0dc4\u0dad\u0dbb \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc5\u0dd2\u0d82\u0dc0\u0dbd\u0da7 \u0dc0\u0dd0\u0da7\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0d85\u0da7 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dc3\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc3\u0dca\u0dc0\u0dcf\u0db7\u0dcf\u0dc0\u0dd2\u0d9a \u0db8\u0dbb\u0dab\u0dc0\u0dbd\u0dd2\u0db1\u0dca 10\u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0d9a\u0dd4\u0dab\u0dd4 \u0dc0\u0dd3\u0db8\u0dd9\u0db1\u0dca 30 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc0\u0dd2\u0da2\u0dbd\u0db1\u0dba \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca 20 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0db4\u0dab\u0dd4 \u0dbb\u0ddd\u0d9c\u0dc0\u0dbd\u0dd2\u0db1\u0dca 17 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc3\u0dd9\u0db4\u0dca\u0da7\u0dd2\u0dc3\u0dd3\u0db8\u0dd2\u0dba\u0dcf \u0dbb\u0ddd\u0d9c\u0dba\u0dd9\u0db1\u0dca \u0d91\u0d9a\u0dca \u0d85\u0dba\u0dd9\u0d9a\u0dd4, \u0dc0\u0dc3 \u0dc1\u0dbb\u0dd3\u0dbb \u0d9c\u0dad \u0dc0\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0dad\u0dd4\u0db1\u0dca \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0d86\u0dc3\u0dcf\u0daf\u0dd2\u0dad \u0dad\u0dd4\u0dc0\u0dcf\u0dbd \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dc4\u0dba \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0dc4\u0dda\u0dad\u0dd4 \u0db8\u0dad \u0db1\u0dc0 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dc3\u0dc4 \u0dc4\u0db3\u0dd4\u0db1\u0dcf \u0db1\u0ddc\u0d9c\u0dad\u0dca \u0db8\u0dbb\u0dab \u0dbd\u0dd9\u0dc3 114 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0db8\u0dd9\u0dc3\u0dda \u0db8\u0dbb\u0dab\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dad\u0ddc\u0dbb\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd0\u0db1 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0db4\u0db1\u0dad \u0dba\u0da7\u0dad\u0dda \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd3\u0db8\u0dda\u0daf\u0dd3 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0dc3\u0d82\u0dbb\u0d9a\u0dca\u0dc2\u0dab \u0daf\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2 (\u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab) \u0db8\u0d82\u0da2\u0dd4\u0dbd \u0d85\u0db8\u0dbb\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n\u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 93 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 91 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0db4\u0ddc\u0dc5\u0ddc\u0db1\u0dca\u0db1\u0dbb\u0dd4\u0dc0 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 82 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0d8c\u0dc0 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 38 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc0\u0dba\u0db9 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 32 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 31 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 29 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0dc0\u0dc0\u0dd4\u0db1\u0dd2\u0dba\u0dcf\u0dc0 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 21 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4, \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 17 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4,\u00a0 \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8 \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda 17 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dc3\u0dc4 \u0d9a\u0dd2\u0dbd\u0dd2\u0db1\u0ddc\u0da0\u0dca\u0da0\u0dd2\u0dba \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda \u0dc4\u0dad\u0dbb \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0dbd\u0dd9\u0dc3 \u0db8\u0dd9\u0db8 \u0dc0\u0db1 \u0d85\u0dbd\u0dd2 \u0dc4\u0dcf \u0d87\u0dad\u0dca \u0db8\u0dbb\u0dab \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0daf \u0d85\u0db8\u0dbb\u0dbb\u0dad\u0dca\u0db1 \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0d9a\u0dbb\u0dba\u0dd2.\n\n\u0dc0\u0db1 \u0d85\u0dbd\u0dd3\u0db1\u0dca \u0db4\u0dc4\u0dbb\u0daf\u0dd3\u0db8\u0dd9\u0db1\u0dca 2025 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca 160 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb,\u00a0 \u0db4\u0ddc\u0dc5\u0ddc\u0db1\u0dca\u0db1\u0dbb\u0dd4\u0dc0, \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0db4\u0dd4\u0dbb \u0dc3\u0dc4 \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0dc0\u0db1\u0da2\u0dd3\u0dc0\u0dd3 \u0d9a\u0dbd\u0dcf\u0db4 \u0dad\u0dd4\u0dc5 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0dc0\u0db1 \u0d85\u0dbd\u0dd2 \u0db4\u0dc4\u0dbb\u0daf\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0db8\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0db1\u0dca 101 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0da2\u0dd3\u0dc0\u0dd2\u0dad\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dda."
