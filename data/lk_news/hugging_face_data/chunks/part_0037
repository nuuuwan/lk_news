    "description": "Saliya Pieris warns  Sri Lanka faces economic fallout from ME war",
    "url_metadata": "https://www.ft.lk/business/Saliya-Pieris-warns-Sri-Lanka-faces-economic-fallout-from-ME-war/34-789107",
    "lang": "en",
    "newspaper_id": "dailyftlk",
