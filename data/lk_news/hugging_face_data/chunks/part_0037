    "url_metadata": "https://www.ada.lk/breaking_news/\u0db8\u0dcf\u0dc3\u0dd9\u0db1\u0dca-\u0d89\u0db1\u0dca\u0db0\u0db1-\u0db8\u0dd2\u0dbd-\u0d85\u0da9\u0dd4\u0d9a\u0dbb\u0db1\u0dc0\u0dcf/11-421599",
