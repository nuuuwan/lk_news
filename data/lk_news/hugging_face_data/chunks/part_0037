    "url_metadata": "https://www.colombotelegraph.com/index.php/an-open-letter-to-the-public-utilities-commission-of-sri-lanka-on-the-proposed-electricity-tariff-revision/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
