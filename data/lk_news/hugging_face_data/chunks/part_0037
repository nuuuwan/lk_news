    "description": "\u0d9a\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dc3\u0dd2 \u0dc0\u0dd2\u0dbb\u0dc4\u0dd2\u0dad\u0dc0 \u0d89\u0dbb\u0dcf\u0db1\u0dba \u0dba\u0da7\u0dad\u0dca \u0dc0\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/international/\u0d9a\u0ddc\u0db1\u0dca\u0daf\u0dda\u0dc3\u0dd2-\u0dc0\u0dd2\u0dbb\u0dc4\u0dd2\u0dad\u0dc0-\u0d89\u0dbb\u0dcf\u0db1\u0dba-\u0dba\u0da7\u0dad\u0dca-\u0dc0\u0dd2\u0dba-\u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2/3-421554",
