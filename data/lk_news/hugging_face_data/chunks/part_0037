    "description": "Second incubation centre of Science and Technology Ministry opens at Faculty of Agriculture, Ruhuna",
    "url_metadata": "https://www.ft.lk/business/Second-incubation-centre-of-Science-and-Technology-Ministry-opens-at-Faculty-of-Agriculture-Ruhuna/34-789218",
    "lang": "en",
    "newspaper_id": "dailyftlk",
