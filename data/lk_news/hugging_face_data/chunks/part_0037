    "description": "Enforcement delay: A test of credibility for Sri Lanka\u2019s tourism regulator",
    "url_metadata": "https://www.ft.lk/columns/Enforcement-delay-A-test-of-credibility-for-Sri-Lanka-s-tourism-regulator/4-789173",
    "lang": "en",
    "newspaper_id": "dailyftlk",
