    "chunk_text": "2025 \u0db8\u0dd4\u0dbd\u0dca \u0db8\u0dcf\u0dc3 \u0d85\u0da7\u0dda\u0daf\u0dd3 \u0dad\u0dd9\u0dbd\u0dca \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0dbd\u0dcf\u0db7\u0dba \u0dc3\u0dd2\u0dba\u0dba\u0da7 19\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd4\u0dc0\u0dd9\u0dbd\u0dcf\n\n\u0dbd\u0d82\u0d9a\u0dcf \u0d9b\u0db1\u0dd2\u0da2\u0dad\u0dd9\u0dbd\u0dca \u0db1\u0dd2\u0dad\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0dc1\u0dd4\u0daf\u0dca\u0db0\u0dbd\u0dcf\u0db7\u0dba \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda (2025)\u00a0 \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 \u0d85\u0da7 \u0dad\u0dd4\u0dbd\u0daf\u0dd2\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 22.1 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 19\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd4\u0dc0\u0dd2 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc3\u0db8\u0dca\u0db4\u0dcf\u0daf\u0db1 \u0dc4\u0dcf \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u00a0 \u0dc3\u0d82\u0dc0\u0dbb\u0dca\u0db0\u0db1 \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\u0dc1\u0dba \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dd2 \u0d85\u0dba\u0dc0\u0dd0\u0dba \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a\u00a0 \u0dc3\u0dc4 \u0db8\u0dd4\u0dbd\u0dca\u200d\u0dba \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0daf\u00a0 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0dda \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0dc0\u0dda.\n\n2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 \u0d85\u0da7\u0dad\u0dd4\u0dbd\u0daf\u0dd2 \u0d9b\u0db1\u0dd2\u0da2\u0dad\u0dd9\u0dbd\u0dca \u0db1\u0dd2\u0dad\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda \u0dc1\u0dd4\u0daf\u0dca\u0db0 \u0dbd\u0dcf\u0db7\u0dba \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 27.4\u0d9a\u0dd2. \u0d91\u0db8 \u0d9a\u0dcf\u0dbd\u0dba\u0da7 \u0dc3\u0dcf\u0db4\u0dda\u0d9a\u0dca\u0dc2\u0dc0\u00a0 \u00a02025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 \u0d85\u0da7 \u0dad\u0dd4\u0dbd\u0daf\u0dd2 \u0dc1\u0dd4\u0daf\u0dca\u0db0\u0dbd\u0dcf\u0db7\u0dba\u00a0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 19\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd4\u0dc0\u0dd2 \u0d87\u0dad. \u0dc0\u0dd2\u0d9a\u0dd4\u0dab\u0dd4\u0db8\u0dca \u0d86\u0daf\u0dcf\u0dba\u0db8 \u0d85\u0da9\u0dd4\u0dc0\u0dd2\u0db8, \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0db8\u0dd9\u0dc4\u0dd9\u0dba\u0dd4\u0db8\u0dca \u0d86\u0daf\u0dcf\u0dba\u0db8\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 1.1 \u0dc3\u0dd2\u0da7\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 0.4 \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u00a0 \u0dc3\u0dd2\u0dba\u0dba\u0da7 60\u0d9a\u0dd2\u0db1\u0dca\u00a0 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dbd\u0dd9\u0dc3 \u0d85\u0da9\u0dd4\u0dc0\u0dd2\u0db8, \u0dc3\u0dc4 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0db8\u0dcf\u0dc3 \u0d85\u0da7 \u0dad\u0dd4\u0dbd\u0daf\u0dd2\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 3.3\u0d9a\u0dca \u0dc0\u0dd4 \u0d8b\u0db4\u0dbd\u0db6\u0dca\u0daf\u0dd2\u00a0 \u0dc0\u0dd2\u0db1\u0dd2\u0db8\u0dba \u0d85\u0db1\u0dd4\u0db4\u0dcf\u0dad \u0dc0\u0dd2\u0da0\u0dbd\u0db1\u0dba\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 0.09 \u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dad\u0dd2\u0dba\u0dd4\u0dab\u0dd4 \u0dbd\u0dd9\u0dc3 \u0db4\u0dc4\u0dc5\u0dba\u0dcf\u0db8\u00a0 \u0db8\u0dd9\u0db8 \u0dc1\u0dd4\u0daf\u0dca\u0db0 \u0dbd\u0dcf\u0db7\u0dba \u0d85\u0da9\u0dd4\u0dc0\u0dd2\u0db8\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd2\u00a0 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2.\n\n\u0d91\u0db8\u0dd9\u0db1\u0dca\u0db8\u00a0 \u0dbd\u0d82\u0d9a\u0dcf \u0d9b\u0db1\u0dd2\u0da2\u0dad\u0dd9\u0dbd\u0dca \u0db1\u0dd2\u0dad\u0dd2\u0d9c\u0dad \u0dc3\u0d82\u0dc3\u0dca\u0dae\u0dc0\u0dda \u0dc3\u0db8\u0dc3\u0dca\u0dad \u0dc4\u0dd2\u0d9c \u0dc0\u0dd9\u0dc5\u0daf\u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba 2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0d85\u0d9c\u0ddd\u0dc3\u0dca\u0dad\u0dd4 \u0db8\u0dcf\u0dc3\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca\u0dc0\u0db1\u0dc0\u0dd2\u0da7\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 13.7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0dd2\u0dba\u0dba\u0da7 38\u0d9a\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd2 \u0d87\u0dad.2025 \u0dc0\u0dbb\u0dca\u0dc2\u0dba\u0dda \u0d85\u0db4\u0dca\u200d\u0dbb\u0dda\u0dbd\u0dca \u0db8\u0dcf\u0dc3\u0dba\u0dda \u0dc3\u0dd2\u0da7\u00a0 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0dad\u0dca\u0db8\u0d9a\u0dc0\u0db1 \u0db4\u0dbb\u0dd2\u0daf\u0dd2 \u0d85\u0dbd\u0dd9\u0dc0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7\u00a0 \u0dbd\u0db6\u0dcf\u0daf\u0dd9\u0db1 \u0dab\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca\u00a0 \u0db4\u0dd4\u0dc5\u0dd4\u0dbd\u0dca \u0d9a\u0dd2\u0dbb\u0dd2\u0db8 \u0dc3\u0dc4\u00a0 \u0d85\u0db0\u0dd2\u0d9a\u0dbb\u0dab \u0dad\u0dd2\u0dbb\u0dab\u0dba\u0d9a\u0da7 \u0d85\u0db1\u0dd4\u0dc02024 \u0dc4\u0dcf 2025 \u0dc0\u0dc3\u0dbb \u0dc3\u0daf\u0dc4\u0dcf\u00a0 \u0db8\u0dcf\u0dc3\u0dd2\u0d9a \u0d8b\u0db4\u0dba\u0ddd\u0d9c\u0dd2\u0dad\u0dcf \u0d9c\u0dcf\u0dc3\u0dca\u0dad\u0dd4 \u0dc4\u0daf\u0dd4\u0db1\u0dcf\u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0db8\u0dad\u0dca, \u0db8\u0dd9\u0db8 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd2 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0d91\u0db8\u0dd9\u0db1\u0dca\u0db8 \u0dc0\u0dda\u0dc3\u0dca\u0da7 \u0d9a\u0ddd\u0dc3\u0dca\u0da7\u0dca \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7\u00a0 \u0dbd\u0db6\u0dcf\u0daf\u0dd4\u0db1\u0dca \u0d85\u0dad\u0dd2\u0dbb\u0dda\u0d9b \u0dab\u0dba \u0db4\u0dc4\u0dc3\u0dd4\u0d9a\u0db8\u0dca\u0daf\u00a0 \u0dc0\u0dd9\u0dc5\u0daf\u0dab\u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0dc0\u0dd2\u0db8\u0da7 \u0daf\u0dcf\u0dba\u0d9a\u0dc0\u0dd2 \u0d87\u0dad.."
