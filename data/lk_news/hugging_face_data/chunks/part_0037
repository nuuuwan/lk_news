    "description": "Pope renews appeal for peace in Middle East",
    "url_metadata": "https://www.ft.lk/news/Pope-renews-appeal-for-peace-in-Middle-East/56-789614",
    "lang": "en",
    "newspaper_id": "dailyftlk",
