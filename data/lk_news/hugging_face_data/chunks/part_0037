    "description": "\u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2 \u0dc6\u0dd2\u0db1\u0dd1\u0db1\u0dca\u0dc3\u0dca \u0db1\u0dd4\u0d9c\u0dda\u0d9c\u0ddc\u0da9 \u0dc1\u0dcf\u0d9b\u0dcf\u0dc0 \u0db1\u0dc0 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/business/\u0da2\u0db1\u0dc1\u0d9a\u0dca\u0dad\u0dd2-\u0dc6\u0dd2\u0db1\u0dd1\u0db1\u0dca\u0dc3\u0dca-\u0db1\u0dd4\u0d9c\u0dda\u0d9c\u0ddc\u0da9-\u0dc1\u0dcf\u0d9b\u0dcf\u0dc0-\u0db1\u0dc0-\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a-\u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u0dba\u0dd2/7-421523",
