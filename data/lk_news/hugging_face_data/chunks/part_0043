    "description": "JAT executes strategic  Mirotone acquisition roadmap with Australian re-entry",
    "url_metadata": "https://www.ft.lk/business/JAT-executes-strategic-Mirotone-acquisition-roadmap-with-Australian-re-entry/34-793737",
    "lang": "en",
    "newspaper_id": "dailyftlk",
