    "url_metadata": "https://www.dailymirror.lk/breaking-news/India-A-beat-Sri-Lanka-A-by-66-runs-to-win-Tri-Nation-A-Series/108-343518",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1782045757.0,
    "chunk_id": "2026-06-21-dailymirrorlk-a88ecbcb-0000",
