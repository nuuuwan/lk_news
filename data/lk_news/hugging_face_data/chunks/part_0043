    "url_metadata": "https://www.ada.lk/breaking_news/\u0dbb\u0dd4\u0d9a\u0dca\u0db8\u0db1\u0dca-\u0d85\u0dc3\u0dd2\u0dad-\u0dc3\u0db8\u0dd4\u0d9c\u0db1\u0dd2\u0dba\u0dd2/11-423034",
