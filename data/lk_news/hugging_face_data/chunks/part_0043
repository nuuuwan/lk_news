    "url_metadata": "https://www.dailymirror.lk/business-main/CSE-to-recalibrate-benchmark-index-in-quarterly-market-reset/245-343446",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1781889983.0,
    "chunk_id": "2026-06-19-dailymirrorlk-0b82c974-0000",
    "chunk_index": 0,
