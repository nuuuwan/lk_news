    "description": "Is Sri Lanka\u2019s investor-friendly environment at risk?",
    "url_metadata": "https://www.dailymirror.lk/opinion/Is-Sri-Lankas-investor-friendly-environment-at-risk/172-343539",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
