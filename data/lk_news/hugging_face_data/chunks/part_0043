    "url_metadata": "https://www.colombotelegraph.com/index.php/public-confidence-cannot-be-built-by-defending-controversial-appointments-alone/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
    "time_ut": 1782669742.0,
    "chunk_id": "2026-06-28-colombotelegraphcom-de610aba-0001",
