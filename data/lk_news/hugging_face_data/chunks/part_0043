    "description": "Poson lessons for leaders: Battling in BANI world",
    "url_metadata": "https://www.ft.lk/columns/Poson-lessons-for-leaders-Battling-in-BANI-world/4-793950",
    "lang": "en",
    "newspaper_id": "dailyftlk",
