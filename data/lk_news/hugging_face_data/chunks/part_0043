    "description": "Dialog advances enterprise risk governance to global ISO 31000 standards",
    "url_metadata": "https://www.ft.lk/business/Dialog-advances-enterprise-risk-governance-to-global-ISO-31000-standards/34-793516",
    "lang": "en",
    "newspaper_id": "dailyftlk",
