    "description": "SL-Japan research collaboration leverages explainable AI to strengthen public health",
    "url_metadata": "https://www.dailymirror.lk/business-news/SL-Japan-research-collaboration-leverages-explainable-AI-to-strengthen-public-health/273-343223",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1781716952.0,
