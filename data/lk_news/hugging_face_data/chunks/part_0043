    "description": "Public healthcare facing collapse while citizens face bankruptcy",
    "url_metadata": "https://www.dailymirror.lk/opinion/Public-healthcare-facing-collapse-while-citizens-face-bankruptcy/172-343448",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
