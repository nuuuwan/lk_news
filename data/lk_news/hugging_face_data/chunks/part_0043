    "description": "Cabinet approves next steps  for railway electrification program",
    "url_metadata": "https://www.ft.lk/business/Cabinet-approves-next-steps-for-railway-electrification-program/34-793734",
    "lang": "en",
    "newspaper_id": "dailyftlk",
