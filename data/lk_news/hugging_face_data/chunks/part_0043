    "url_metadata": "https://www.dailymirror.lk/breaking-news/Iranian-tankers-exit-U-S-blockade-ahead-of-deal-signing/108-343143",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1781674590.0,
    "chunk_id": "2026-06-17-dailymirrorlk-54631363-0000",
    "chunk_index": 0,
