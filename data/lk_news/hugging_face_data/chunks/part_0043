    "description": "LIIN empowers Northern women entrepreneurs through Emerging Women Summit",
    "url_metadata": "https://www.ft.lk/business/LIIN-empowers-Northern-women-entrepreneurs-through-Emerging-Women-Summit/34-793579",
    "lang": "en",
    "newspaper_id": "dailyftlk",
