    "description": "Sri Lanka\u2019s Marine Frontline: Dr. Samantha Gunasekara\u2019s Battle Against Plastic Pollution and Transboundary Waste",
    "url_metadata": "http://island.lk/sri-lankas-marine-frontline-dr-samantha-gunasekaras-battle-against-plastic-pollution-and-transboundary-waste/",
    "lang": "en",
    "newspaper_id": "islandlk",
