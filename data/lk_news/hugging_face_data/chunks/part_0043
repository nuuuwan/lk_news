    "description": "Development \u2013 not at the cost of people or the environment",
    "url_metadata": "https://www.dailymirror.lk/opinion/Development-not-at-the-cost-of-people-or-the-environment/172-343238",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
