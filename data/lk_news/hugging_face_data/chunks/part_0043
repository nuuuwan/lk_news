    "description": "Inflation climbs above 5% as price pressures broaden",
    "url_metadata": "https://www.dailymirror.lk/business-news/Inflation-climbs-above-5-as-price-pressures-broaden/273-343624",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1782150901.0,
