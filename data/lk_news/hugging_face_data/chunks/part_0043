    "description": "New mediation law for smarter dispute resolution of civil and commercial disputes \u2013 I",
    "url_metadata": "http://island.lk/new-mediation-law-for-smarter-dispute-resolution-of-civil-and-commercial-disputes-i/",
    "lang": "en",
    "newspaper_id": "islandlk",
