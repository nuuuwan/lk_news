    "description": "A new Mediation Law for smarter dispute resolution of civil and commercial disputes",
    "url_metadata": "https://www.ft.lk/columns/A-new-Mediation-Law-for-smarter-dispute-resolution-of-civil-and-commercial-disputes/4-793641",
    "lang": "en",
    "newspaper_id": "dailyftlk",
