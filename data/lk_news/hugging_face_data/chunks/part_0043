    "description": "Police bust illicit liquor factory disguised as bottled water business",
    "url_metadata": "https://www.ft.lk/news/Police-bust-illicit-liquor-factory-disguised-as-bottled-water-business/56-794000",
    "lang": "en",
    "newspaper_id": "dailyftlk",
