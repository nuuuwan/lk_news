    "description": "Youth expect jobs that build lives, not just livelihoods from World Bank CPF 2026-2030",
    "url_metadata": "https://www.ft.lk/news/Youth-expect-jobs-that-build-lives-not-just-livelihoods-from-World-Bank-CPF-2026-2030/56-793733",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1782270152.0,
    "chunk_id": "2026-06-24-dailyftlk-fcb7a6b3-0000",
    "chunk_index": 0,
