    "description": "Special security and traffic plan for Poson season",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Special-security-and-traffic-plan-for-Poson-season/108-343493",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1781947320.0,
    "chunk_id": "2026-06-20-dailymirrorlk-a9a22eaf-0000",
