    "description": "Prajeeth\u2019s blueprint: The long game",
    "url_metadata": "https://www.ft.lk/columns/Prajeeth-s-blueprint-The-long-game/4-793450",
    "lang": "en",
    "newspaper_id": "dailyftlk",
