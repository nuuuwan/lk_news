    "description": "India to help Sri Lanka build countrywide disaster early warning system",
    "url_metadata": "https://www.ft.lk/news/India-to-help-Sri-Lanka-build-countrywide-disaster-early-warning-system/56-793682",
    "lang": "en",
    "newspaper_id": "dailyftlk",
