    "date_str": "2026-06-22",
    "description": "How Sri Lanka can transform education, according to Prof. Gunapala Nanayakkara",
    "url_metadata": "https://www.ft.lk/columns/How-Sri-Lanka-can-transform-education-according-to-Prof-Gunapala-Nanayakkara/4-793640",
    "lang": "en",
    "newspaper_id": "dailyftlk",
