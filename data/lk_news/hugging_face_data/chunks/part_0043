    "description": "Fire Exit Audit Needed for Old High-Rise Apartments",
    "url_metadata": "https://www.dailymirror.lk/opinion/Fire-Exit-Audit-Needed-for-Old-High-Rise-Apartments/172-343832",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
