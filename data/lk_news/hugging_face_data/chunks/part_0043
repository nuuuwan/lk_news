    "url_metadata": "https://www.dailymirror.lk/opinion/More-questions-than-answers-in-Suresh-Sallays-detention/172-343104",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1781629924.0,
    "chunk_id": "2026-06-16-dailymirrorlk-4aaa955a-0000",
