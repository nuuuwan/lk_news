    "description": "The US occupation of the Indian Ocean \u2018Zone of Peace\u2019",
    "url_metadata": "http://island.lk/the-us-occupation-of-the-indian-ocean-zone-of-peace-2/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1782828120.0,
