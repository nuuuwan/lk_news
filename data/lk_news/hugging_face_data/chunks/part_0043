    "url_metadata": "https://www.dailymirror.lk/breaking-news/If-the-Presidential-Secretariat-needed-a-dengue-clean-up-what-about-the-rest-of-the-country-Namal/108-344117",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1782625506.0,
