    "description": "The slow train to the more sustainable fast track is back",
    "url_metadata": "https://www.ft.lk/columns/The-slow-train-to-the-more-sustainable-fast-track-is-back/4-793897",
    "lang": "en",
    "newspaper_id": "dailyftlk",
