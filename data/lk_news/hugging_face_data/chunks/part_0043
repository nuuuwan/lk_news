    "description": "\u0d9a\u0ddc\u0db8\u0dbb\u0dca\u0dc2\u0dbd\u0dca \u0db6\u0dd0\u0d82\u0d9a\u0dd4 \u0dc0\u0dd3\u0dc3\u0dcf \u0d9a\u0dcf\u0da9\u0dca\u0db4\u0dad\u0dca \u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca FIFA \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0db8\u0dc4\u0dcf \u0dad\u0dbb\u0d9c\u0dba\u0da7",
    "url_metadata": "https://www.ada.lk/business/\u0d9a\u0ddc\u0db8\u0dbb\u0dca\u0dc2\u0dbd\u0dca-\u0db6\u0dd0\u0d82\u0d9a\u0dd4-\u0dc0\u0dd3\u0dc3\u0dcf-\u0d9a\u0dcf\u0da9\u0dca\u0db4\u0dad\u0dca-\u0dc4\u0dd2\u0db8\u0dd2\u0dba\u0db1\u0dca-FIFA-\u0d85\u0dc0\u0dc3\u0db1\u0dca-\u0db8\u0dc4\u0dcf-\u0dad\u0dbb\u0d9c\u0dba\u0da7/7-423040",
