    "description": "Beneficial Ownership rules should  strengthen governance, not burden business",
    "url_metadata": "https://www.ft.lk/columns/Beneficial-Ownership-rules-should-strengthen-governance-not-burden-business/4-793766",
    "lang": "en",
    "newspaper_id": "dailyftlk",
