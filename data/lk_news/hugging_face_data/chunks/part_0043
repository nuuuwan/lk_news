    "date_str": "2026-06-17",
    "description": "Sri Lanka won\u2019t change until YOU change",
    "url_metadata": "https://www.ft.lk/columns/Sri-Lanka-won-t-change-until-YOU-change/4-793392",
    "lang": "en",
    "newspaper_id": "dailyftlk",
