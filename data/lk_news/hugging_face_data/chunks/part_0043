    "description": "Daily vehicle import bill drops below USD 4Mn",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Daily-vehicle-import-bill-drops-below-USD-4Mn/108-343243",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1781744047.0,
    "chunk_id": "2026-06-18-dailymirrorlk-b48b3cdf-0000",
