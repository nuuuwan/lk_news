    "description": "\u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0dc0\u0dc3\u0dbb \u0dbd\u0dd9\u0dc3 2025 \u0d89\u0dad\u0dd2\u0dc4\u0dcf\u0dc3\u0dba\u0da7",
