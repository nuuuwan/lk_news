    "url_metadata": "https://www.lankadeepa.lk/news/\u0d9a\u0da7\u0db1\u0dba\u0d9a-\u0dba\u0db1\u0dba\u0d9a\u0dad-\u0db6\u0db8\u0db6-\u0db6\u0dba\u0d9a/101-685926",
