    "description": "\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd \u0db6\u0dcf\u0dbd\u0dca\u0daf\u0dd4\u0dc0\u0dd3\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd2\u0daf\u0dda\u0dc1 \u0dab\u0dba \u0db6\u0dbb \u0dbb\u0dd4. \u0db6\u0dd2\u0dbd\u0dd2\u0dba\u0db1 703 \u0d9a\u0dd2\u0db1\u0dca \u0d89\u0dc4\u0dc5\u0dba\u0dba\u0dd2",
