    "url_metadata": "https://www.lankadeepa.lk/news/\u0d9d\u0dad\u0db1-\u0dbb\u0dc3\u0d9a-\u0dc0\u0da9\u0d9a\u0d9a\u0dbb\u0dc0\u0d9a-\u0db8\u0da7\u0da7/101-685910",
