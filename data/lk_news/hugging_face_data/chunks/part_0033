    "num": "tamilmirrorlk-3f3f1a27",
    "date_str": "2025-12-22",
    "description": "\u0b87\u0ba9\u0bcd\u0bb1\u0bc1 \u0b9a\u0bbf\u0bb1\u0bbf\u0ba4\u0bb3\u0bb5\u0bc1 \u0bae\u0bb4\u0bc8",
    "url_metadata": "https://www.tamilmirror.lk/\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0b87\u0ba9\u0bcd\u0bb1\u0bc1-\u0b9a\u0bbf\u0bb1\u0bbf\u0ba4\u0bb3\u0bb5\u0bc1-\u0bae\u0bb4\u0bc8/175-369922",
    "lang": "ta",
