    "url_metadata": "https://www.ada.lk/breaking_news/\u0d9a\u0ddc\u0dc5\u0db9-\u0d85\u0dba\u0dc0\u0dd0\u0dba\u0dd9\u0db1\u0dca-\u0dbb\u0da7\u0db8-\u0dc0\u0dd9\u0db1\u0dc3\u0dca-\u0dc0\u0dd9\u0db1\u0dca\u0db1\u0dda-\u0db1\u0dd1/11-420429",
