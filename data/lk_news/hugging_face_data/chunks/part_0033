    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d85\u0dc3\u0dbb\u0db8\u0dad-\u0db1\u0dad\u0dad\u0dbd-\u0d8b\u0daf-\u0dc0\u0dba/1-685836",
