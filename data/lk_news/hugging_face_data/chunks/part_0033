    "url_metadata": "https://www.lankadeepa.lk/news/\u0daf\u0db1-\u0d9a\u0dc5\u0db9-\u0db4\u0dbb-\u0dc3\u0db6-\u0db4\u0dbd\u0db1\u0dba-\u0d9a\u0dbb\u0db1\u0db1-\u0d85\u0db4/101-685732",
