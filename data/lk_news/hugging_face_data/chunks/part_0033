    "description": "Round Table Sri Lanka delivers rapid, high-impact relief following Cyclone Ditwah",
    "url_metadata": "https://www.ft.lk/business/Round-Table-Sri-Lanka-delivers-rapid-high-impact-relief-following-Cyclone-Ditwah/34-786187",
    "lang": "en",
    "newspaper_id": "dailyftlk",
