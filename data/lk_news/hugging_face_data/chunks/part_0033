af\u0dd0\u0db1\u0da7, \u0d91\u0dc4\u0dd2 \u0dc0\u0dd6 \u0daf\u0ddd\u0dc2\u0dba\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dd0\u0dbb\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dda \u0db1\u0da9\u0dad\u0dca\u0dad\u0dd4 \u0d9a\u0da7\u0dba\u0dd4\u0dd4\u0dad\u0dd4 \u0d9a\u0da9\u0dd2\u0db1\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb\u0dd2\u0db1\u0dca\u0dad\u0dca\u200d \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0dba\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dba\u0daf \u0dba\u0dae\u0dcf\u0dc0\u0dad\u0dca \u0d9a\u0dbb 2026 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 \u0db8\u0dc3 18 \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba\u0da7 \u0d91\u0d9a\u0dca \u0d9a\u0dd2\u0dbb\u0dd2\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0db1\u0dd4 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0dbd\u0d82\u0dc0\u0dd2\u0db8 \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1 \u0d9a\u0dbb\u0dba\u0dd2."
