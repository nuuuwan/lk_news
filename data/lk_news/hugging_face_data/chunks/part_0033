    "url_metadata": "https://www.lankadeepa.lk/news/\u0d9c\u0db1-\u0d85\u0dc0-\u0d8b\u0dab\u0da9-\u0dc3\u0db8\u0d9c-\u0dad\u0db1\u0d9a-\u0db8\u0da7\u0da7/101-685912",
