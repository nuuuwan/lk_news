    "description": "\u0d9a\u0dc3\u0d9a\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0dbb\u0dd0\u0d9c\u0dad\u0dca \u0dc1\u0dd3\u0dad \u0dc3\u0dd8\u0dad\u0dd4 \u0db4\u0dc5\u0db8\u0dd4 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0d92\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/breaking_news/\u0d9a\u0dc3\u0d9a\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0dda-\u0dc3\u0dd2\u0da7-\u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca-\u0dbb\u0dd0\u0d9c\u0dad\u0dca-\u0dc1\u0dd3\u0dad-\u0dc3\u0dd8\u0dad\u0dd4-\u0db4\u0dc5\u0db8\u0dd4-\u0d9c\u0dd4\u0dc0\u0db1\u0dca-\u0dba\u0dcf\u0db1\u0dba-\u0d92\u0dba\u0dd2/11-420471",
    "lang": "si",
    "newspaper_id": "adalk",
