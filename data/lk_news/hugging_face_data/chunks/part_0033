    "url_metadata": "https://www.lankadeepa.lk/features/\u0d85\u0dbb\u0db6\u0daf\u0dc0\u0dbd\u0db1-\u0d9c\u0da9-\u0d91\u0db1\u0db1\u0db8-\u0db6\u0dbb\u0daf/2-685745",
