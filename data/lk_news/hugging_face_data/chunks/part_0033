    "chunk_id": "2025-12-24-lankadeepalk-756f4e09-0000",
    "chunk_index": 0,
    "language": "si",
    "md5": "dd4b06100daaea8e414e4d1a3dc7da59",
    "chunk_size_bytes": 2414,
    "chunk_text": "\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0  \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db6\u0dbd\u0dba \u0da2\u0dcf\u0da2\u0db6\u0da7\n\n\u0d89\u0d82\u0dbd\u0d9c\u0dd9\u0dba\u0dd2 \u0dad\u0db8\u0dd2\u0dbd\u0dca\u0d85\u0dbb\u0dc3\u0dd4 \u0d9a\u0da0\u0dca\u0da0\u0dd2 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0da7 \u0db4\u0dcf\u0dbd\u0db1 \u0db6\u0dbd\u0dba \u0dc4\u0dd2\u0db8\u0dd2\u0dc0 \u0dad\u0dd2\u0db6\u0dd6 \u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dc0\u0dca, \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db1\u0dc0 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0db1\u0dd2\u0dba \u0dbd\u0dd9\u0dc3 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dc5 \u0d89\u0db8\u0d9a\u0dca\u0d9a\u0dd4\u0dbd\u0dd9\u0da7\u0dca\u0da7\u0dca\u200d\u0dbb\u0dcf \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dcf\u0db1\u0db1\u0dca\u0daf\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba\u00a0 \u0dc0\u0dd0\u0da9\u0dd2 \u0da1\u0db1\u0dca\u0daf\u0dba\u0dd9\u0db1\u0dca \u0dad\u0dda\u0dbb\u0dd3\u0db4\u0dad\u0dca\u0dc0\u0dd2\u0dba.\n\n\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd2\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0dbd\u0dd9\u0dc3 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0dbd\u0dd9\u0dc3 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dc5 \u0d91\u0dc3\u0dca.\u0dbd\u0ddd\u0d9c\u0dda\u0dc2\u0dca\u0dc0\u0dbb\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0d91\u0db8 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0db0\u0dd6\u0dbb\u0dba\u0dd9\u0db1\u0dca 2025 \u0db1\u0ddc\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 25 \u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dcf \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0d85\u0dc3\u0dca\u0dc0\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4\u0dc0 \u0db1\u0dc0 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2 \u0dad\u0ddd\u0dbb\u0dcf\u0db4\u0dad\u0dca\u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0da1\u0db1\u0dca\u0daf \u0dc0\u0dd2\u0db8\u0dc3\u0dd4\u0db8\u00a0 \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd2\u0dab\u0dd2.\n\n\u0db4\u0dca\u200d\u0dbb\u0dcf\u0daf\u0dda\u0dc1\u0dd3\u0dba \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db1\u0dc0 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dad\u0ddd\u0dbb\u0dcf\u0db4\u0dad\u0dca \u0d9a\u0dbb \u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dc5 \u0d89\u0db8\u0d9a\u0dca\u0d9a\u0dd4\u0dbd\u0dd9\u0da7\u0dca\u0da7\u0dca\u200d\u0dbb\u0dcf \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dcf\u0db1\u0db1\u0dca\u0daf\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba, \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dad\u0db1\u0dca\u0dad\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0daf\u0dd3 \u0daf\u0dd9\u0db8\u0dc5 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0dc3\u0db1\u0dca\u0db0\u0dcf\u0db1\u0dba\u0dd9\u0db1\u0dca \u0dad\u0ddd\u0db8\u0dca\u0db8\u0dda\u0db4\u0dd4\u0dbd\u0dca\u0dbd\u0dda \u0db6\u0db6\u0dd4\u0dbd\u0dca\u0dbb\u0dcf\u0da2\u0dca \u0db8\u0dc4\u0dad\u0dcf \u0dc3\u0dc4 \u0d89\u0dbd\u0d82\u0d9c\u0dd9\u0dba\u0dd2 \u0dad\u0db8\u0dd2\u0dbd\u0dca \u0d85\u0dbb\u0dc3\u0dd4 \u0d9a\u0da0\u0dca\u0da0\u0dd2 \u0db4\u0d9a\u0dca\u0dc2\u0dba\u0dd9\u0db1\u0dca \u0d91\u0db8\u0dca.\u0da2\u0ddc\u0db1\u0dca\u0dc3\u0db1\u0dca \u0db8\u0ddd\u0dc4\u0db1\u0dbb\u0dcf\u0da2\u0dcf \u0dba\u0db1 \u0dad\u0dd2\u0daf\u0dd9\u0db1\u0dcf\u0d9c\u0dd9 \u0db1\u0db8\u0dca \u0dba\u0ddd\u0da2\u0db1\u0dcf\u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dd9\u0d9a\u0dca \u0dad\u0ddd\u0dbb\u0dcf\u0d9c\u0dd0\u0db1\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0dc3\u0db7\u0dd2\u0d9a\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dbb\u0dc4\u0dc3\u0dca \u0da1\u0db1\u0dca\u0daf\u0dba\u0d9a\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0dba\u0dc4.\n\n\u0dbb\u0dc4\u0dc3\u0dca \u0da2\u0db1\u0dca\u0daf\u0dba\u0dda\u0daf\u0dd3 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0da2\u0db1 \u0db6\u0dbd\u0dc0\u0dda\u0d9c\u0dba \u0db1\u0dd2\u0dba\u0ddd\u0da2\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0d89\u0db8\u0d9a\u0dca\u0d9a\u0dd4\u0dbd\u0dd9\u0da7\u0dca\u0da7\u0dca\u200d\u0dbb\u0dcf \u0db4\u0dd4\u0dc2\u0dca\u0db4\u0dcf\u0db1\u0db1\u0dca\u0daf\u0db1\u0dca \u0db8\u0dc4\u0dad\u0dca\u0db8\u0dd2\u0dba \u0da2\u0db1\u0dca\u0daf 14 \u0d9a\u0dca \u0dbd\u0db6\u0dcf\u0d9c\u0dd9\u0db1 \u0db1\u0dc0 \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0db1\u0dd2\u0dba \u0dbd\u0dd9\u0dc3 \u0dad\u0dda\u0dbb\u0dd3\u0db4\u0dad\u0dca\u0dc0\u0dd2\u0dba."
  },
