    "url_metadata": "https://www.lankadeepa.lk/features/\u0d91\u0db1-\u0dc0\u0dc3\u0dbb-\u0d86\u0dbb\u0dae\u0d9a\u0dba-\u0d9a\u0dad\u0db1\u0da7\u0daf/2-686057",
