    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d9c\u0d9f\u0da7-\u0dc0\u0da7-\u0daf\u0dbb\u0dc0\u0d9a-\u0db8\u0dbb\u0da7/1-685764",
