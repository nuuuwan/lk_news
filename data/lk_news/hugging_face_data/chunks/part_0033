    "description": "Japan provides $ 1 m shelters through IOM in response to Cyclone Disaster",
    "url_metadata": "https://www.ft.lk/news/Japan-provides-1-m-shelters-through-IOM-in-response-to-Cyclone-Disaster/56-785898",
    "lang": "en",
    "newspaper_id": "dailyftlk",
