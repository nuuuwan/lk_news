    "description": "\u0db1\u0dcf\u0dba \u0dba\u0dd1\u0db8 \u0db1\u0dd2\u0dc3\u0dcf \u0db8\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0d89\u0dc0\u0dad\u0da7 \u0d9c\u0dad \u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2\u0dc0 \u0dad\u0dd2\u0db6\u0dd6 \u0db8\u0ddd\u0da7\u0dbb\u0dca \u0dbb\u0dae \u0dba\u0dc5\u0dd2 \u0d89\u0dc0\u0dad\u0da7 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0dc3\u0dad\u0dd4\u0da7",
