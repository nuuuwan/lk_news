    "url_metadata": "https://www.tamilmirror.lk/cinema/\u0b9a\u0bca\u0b9f\u0bcd\u0b9f-\u0b9a\u0bca\u0b9f\u0bcd\u0b9f-\u0ba8\u0ba9\u0bc8\u0baf\u0bc1\u0ba4\u0bc1/54-370277",
