    "chunk_text": "\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb\u0dda \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0daf\u0dbb\u0dd4 \u0dc3\u0dd4\u0dbb\u0dad\u0dbd\u0dca \u0db6\u0dd0\u0dbd\u0dd6 \u0dbb\u0da7 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\n\n\u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3\u00a0 \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0daf\u0dbb\u0dd4 \u0d8b\u0db4\u0dad\u0dca\u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0db1\u0dca\u0db1\u0dda \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0db6\u0dc0 \u0dc0\u0dd2\u0dc2\u0dd4\u0dc0\u0dbd\u0dca \u0d9a\u0dd0\u0db4\u0dd2\u0da7\u0dbd\u0dd2\u0dc3\u0dca\u0da7\u0dca \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0db4\u0dd4\u0dbb\u0ddd\u0d9a\u0dad\u0db1\u0dba \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd2\u0dba\u0db1\u0dca \u0d9a\u0ddd\u0da7\u0dd2 13.23 \u0d89\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0dc3\u0dbb\u0dda \u0db8\u0dd9\u0dbd\u0ddc\u0dc0 \u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd0\u0d9a \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0daf \u0d91\u0db8 \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dbb\u0dba\u0dd2.\n\n\u0daf\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0dc5\u0daf\u0dbb\u0dd4 \u0d8b\u0db4\u0dad\u0dca \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd3 \u0d87\u0dad\u0dca\u0dad\u0dda \u0da0\u0dd3\u0db1\u0dba\u0dd9\u0db1\u0dca \u0db6\u0dc0\u0dad\u0dca \u0dad\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0da7 \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0dc5\u0daf\u0dbb\u0dd4 \u0d8b\u0db4\u0dad\u0dca \u0dc3\u0d82\u0d9b\u0dca\u200d\u0dba\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0dd9\u0db1\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0db8 \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n\u0db8\u0dd9\u0db8 \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0dc5\u0daf\u0dbb\u0dd4 \u0d8b\u0db4\u0dad\u0dca \u0d9a\u0ddd\u0da7\u0dd2 2.31 \u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0da0\u0dd3\u0db1\u0dba\u0dd9\u0db1\u0dca \u0dc5\u0daf\u0dbb\u0dd4 \u0d8b\u0db4\u0dad\u0dca \u0dbd\u0d9a\u0dca\u0dc2 87 \u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0db8 \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0db4\u0dd4\u0dbb\u0ddd\u0d9a\u0dad\u0db1\u0dba \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0d91\u0dc3\u0dda\u0db8 \u0db4\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0dda \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0dc5\u0daf\u0dbb\u0dd4 \u0d8b\u0db4\u0dad\u0dca \u0dbd\u0d9a\u0dca\u0dc2 69 \u0d9a\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dd9\u0db1 \u0db6\u0dc0\u0daf \u0d91\u0db8 \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dcf\u0dc1 \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd2\u0dba\u0db1\u0dca \u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0d9a\u0dca \u0db8\u0dd9\u0dc5\u0ddc\u0dc0 \u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd0\u0d9a \u0d87\u0dad\u0dca\u0dad\u0dda \u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0db6\u0dc0\u0dad\u0dca \u0d86\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0db4\u0dc3\u0dd4\u0d9c\u0dd2\u0dba \u0dc0\u0dc3\u0dbb\u0dda\u0daf\u0dd3 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd2\u0dba\u0db1\u0dca \u0d9a\u0ddd\u0da7\u0dd2 6.51 \u0d9a\u0dca \u0d8b\u0db4\u0dad \u0dbd\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0dc0\u0dd2\u0dc2\u0dd4\u0dc0\u0dbd\u0dca \u0d9a\u0dd0\u0db4\u0dd2\u0da7\u0dbd\u0dd2\u0dc3\u0dca\u0da7\u0dca \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd4\u0dc0\u0dda\u0dba.\n\n\u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd2\u0dba\u0db1\u0dca \u0d9a\u0ddd\u0da7\u0dd2 4.71 \u0d9a\u0dca \u0d85\u0db4\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dda \u0d8b\u0db4\u0dad \u0dbd\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0dba\u0dd4\u0dbb\u0ddd\u0db4\u0dba\u0dda \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd4 \u0db6\u0dd2\u0dc5\u0dd2\u0db3\u0dd2\u0dba\u0db1\u0dca \u0dbd\u0d9a\u0dca\u0dc2 62 \u0d9a\u0dca \u0dc3\u0dc4 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dda \u0dbd\u0d9a\u0dca\u0dc2 76 \u0d9a\u0dca \u0d8b\u0db4\u0dad \u0dbd\u0db6\u0dcf \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0dad\u0dca \u0d91\u0db8 \u0dc0\u0dd9\u0db6\u0dca \u0d85\u0da9\u0dc0\u0dd2\u0dba \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dda\u0dba."
