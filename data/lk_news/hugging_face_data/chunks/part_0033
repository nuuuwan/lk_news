    "url_metadata": "https://www.lankadeepa.lk/news/\u0db6\u0dc3\u0dc3\u0db1-\u0da2\u0d9c\u0db8-\u0daf\u0dbb\u0d9a\u0dae\u0db1-133\u0d9a-\u0d85\u0dad\u0d85\u0da9\u0d9c\u0dc0\u0da7/101-685890",
