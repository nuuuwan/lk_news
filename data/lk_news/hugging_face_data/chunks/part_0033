    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc0\u0daf\u0dba-\u0d9c\u0dc0\u0db1-\u0dba\u0db1\u0dba\u0d9a-\u0d9a\u0da9-\u0dc0\u0da7-5\u0d9a-\u0db8\u0dbb\u0da7/101-685739",
