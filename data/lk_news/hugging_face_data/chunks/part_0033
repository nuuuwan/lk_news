    "description": "Corporate criminal liability under the Anti-Corruption Act of 2023",
    "url_metadata": "https://www.ft.lk/opinion/Corporate-criminal-liability-under-the-Anti-Corruption-Act-of-2023/14-786158",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1766956920.0,
    "chunk_id": "2025-12-29-dailyftlk-7bc9219d-0010",
