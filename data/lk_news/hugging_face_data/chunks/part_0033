    "chunk_text": "\u0daf\u0dd2\u0dad\u0dca\u0dc0\u0dcf \u0db1\u0dd2\u0dc3\u0dcf \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0d9a\u0dbb \u0dbd\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0dca \u0dc4\u0dcf\u0db1\u0dd2\u0dba\u0da7\n\n\u0d86\u0db4\u0daf\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca\u00a0 \u0db8\u0dd9\u0dbb\u0da7\u00a0 \u0db8\u0dc4\u0dcf\u0dc0\u0dcf\u0dbb\u0dd2 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba \u0dba\u0da7\u0dad\u0dda \u0dc0\u0d9c\u0dcf\u0d9a\u0dbb\u0dab\u0dd4 \u0dbd\u0dd0\u0db6\u0dd4 \u0d9a\u0dd4\u0db9\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0d9a\u0dbb \u0dbd\u0d9a\u0dca\u0dc2\u0dba\u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dc4\u0dcf\u0db1\u0dd2\u0dba\u0da7 \u0db4\u0dad\u0dca\u0dc0\u0dd4 \u0db6\u0dc0\u0dad\u0dca \u0d89\u0db1\u0dca \u0d85\u0d9a\u0dca\u0d9a\u0dbb 25000\u0d9a\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0db8\u0dd9\u0db8 \u0d9a\u0db1\u0dca\u0db1\u0dba\u0dda \u0daf\u0dd2 \u0db1\u0dd0\u0dc0\u0dad \u0d85\u0dc3\u0dca\u0dc0\u0dd0\u0daf\u0dca\u0daf\u0dd2\u0db8 \u0dc3\u0daf\u0dc4\u0dcf\u00a0 \u0d87\u0dc5 \u0d87\u0db8\u0dd4\u0dab\u0dd4 \u0d85\u0dbd\u0dd4\u0dad\u0dca\u0dc0\u0dd0\u0da9\u0dd2\u0dba\u0dcf\u0d9a\u0ddc\u0da7 \u0da2\u0dbd\u0dba \u0dbd\u0db6\u0dcf\u0daf\u0dd2\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dca \u0dc0\u0dcf\u0dbb\u0dd2\u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u200d\u0dc2 \u00a0(\u0da2\u0dbd\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf \u0dc3\u0dc4 \u0d86\u0db4\u0daf\u0dcf \u0d9a\u0dc5\u0db8\u0dab\u0dcf\u0d9a\u0dbb\u0dab), \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4 \u0d91\u0dbd\u0dca. \u0d92. \u0d91\u0dc3\u0dca. \u0dc3\u0dd6\u0dbb\u0dd2\u0dba\u0db6\u0dab\u0dca\u0da9\u0dcf\u0dbb \u0db8\u0dc4\u0dad\u0dcf \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n\u0d86\u0db4\u0daf\u0dc