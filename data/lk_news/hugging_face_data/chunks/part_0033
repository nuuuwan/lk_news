    "description": "\u0dc0\u0db1\u0dca\u0db0\u0dca\u200d\u0dba\u0dcf\u0d9a\u0dbb\u0dab \u0dc3\u0dd0\u0dad\u0dca\u0d9a\u0db8\u0dca \u0dc3\u0db3\u0dc4\u0dcf \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0d9c\u0dda \u0d9a\u0dd0\u0db8\u0dd0\u0dad\u0dca\u0dad \u0db4\u0db8\u0dab\u0d9a\u0dca \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dc0\u0dad\u0dca: \u0daf\u0dc1\u0d9a \u0d9c\u0dab\u0db1\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba\u0dda \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd6 \u0dc0\u0dd9\u0db1\u0dc3 \u0d9a\u0dd4\u0db8\u0d9a\u0dca \u0daf?",
