    "description": "\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4\u0db6\u0da9\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0  \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db6\u0dbd\u0dba \u0da2\u0dcf\u0da2\u0db6\u0da7",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0db8\u0dc4\u0daf\u0db6\u0da9\u0db4\u0dad\u0dad\u0dc0-\u0dc3\u0db7\u0dc0-\u0db6\u0dbd\u0dba-\u0da2\u0da2\u0db6\u0da7/101-685777",
    "lang": "si",
    "newspaper_id": "lankadeepalk",
