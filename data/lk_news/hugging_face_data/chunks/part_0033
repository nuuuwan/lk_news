    "description": "AIA provided urgent medical relief to flood-affected families in Thalwatta",
    "url_metadata": "http://island.lk/aia-provided-urgent-medical-relief-to-flood-affected-families-in-thalwatta/",
    "lang": "en",
    "newspaper_id": "islandlk",
