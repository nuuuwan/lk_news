    "chunk_text": "\u0dad\u0db8 \u0dc0\u0dd8\u0dad\u0dca\u0dad\u0dd2\u0dba \u0dba\u0dc4\u0db4\u0dad\u0dca \u0db8\u0da7\u0dca\u0da7\u0db8\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d9c\u0dd9\u0db1 \u0dba\u0dcf\u0db8\u0da7 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0db8\u0db1\u0dca \u0db4\u0dcf\u0dc5\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca 160 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4\u00a0 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0dc0\u0db1 \u0d85\u0dad\u0dbb , \u0d91\u0dc4\u0dd9\u0dad\u0dca \u0daf\u0dd0\u0db1\u0da7 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0db1\u0dda 101 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dd4 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0db6\u0dc0\u0dad\u0dca , \u0d92 \u0db4\u0dd2\u0dbb\u0dd2\u0dc3 \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca 40% \u0d9a\u0dca \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf\u0dc0\u0db1\u0dca \u0db6\u0dc0\u0dad\u0dca , \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0dbb\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dd3 11.00 \u0da7 \u0db4\u0db8\u0dab \u0dc3\u0dd2\u0dba \u0dc3\u0dda\u0dc0\u0dcf \u0db8\u0dd4\u0dbb\u0dba \u0db1\u0dd2\u0db8 \u0d9a\u0dbb \u0dc3\u0dd2\u0dba \u0db1\u0dd2\u0dc0\u0dd9\u0dc3\u0dca \u0dc0\u0dd9\u0dad \u0dba\u0dcf\u0db8 \u0dc3\u0dc4 \u0d85\u0dbd\u0dd4\u0dba\u0db8 06.00 \u0da7 \u0dc3\u0dda\u0dc0\u0dcf \u0dc3\u0daf\u0dc4\u0dcf \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd3\u0db8\u0dca \u0dc3\u0db8\u0d9c \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0db8\u0db1\u0dca \u0db4\u0dcf\u0dc5\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9c\u0dda \u0db8\u0dcf\u0db1\u0dc3\u0dd2\u0d9a \u0d86\u0dad\u0dad\u0dd2\u0dba \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7\u00a0 \u0db8\u0dd9\u0db1\u0dca\u0db8 \u0d94\u0dc0\u0dd4\u0db1\u0dca \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0dc3\u0db8\u0dcf\u0da2 \u0d86\u0dbb\u0dca\u0dae\u0dd2\u0d9a \u0daf\u0dd4\u0dc2\u0dca\u0d9a\u0dbb\u0dad\u0dcf \u0dc3\u0db8\u0dd6\u0dc4\u0dba\u0d9a\u0da7 \u0d87\u0daf \u0daf\u0dd0\u0db8\u0dd3\u0db8\u0d9a\u0dca \u0db6\u0dc0 \u0daf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0d9c\u0db8\u0db1\u0dca \u0db4\u0dcf\u0dc5\u0d9a\u0dc0\u0dbb\u0dd4\u0db1\u0dca\u0d9c\u0dda \u0dc3\u0d82\u0d9c\u0db8\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db4\u0dd9\u0db1\u0dca\u0dc0\u0dcf \u0daf\u0dd9\u0dad\u0dd2 ."
