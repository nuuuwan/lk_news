    "description": "Prime Group stands with children of Police families affected by Cyclone Ditwah",
    "url_metadata": "https://www.ft.lk/business/Prime-Group-stands-with-children-of-Police-families-affected-by-Cyclone-Ditwah/34-786129",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1766628753.0,
