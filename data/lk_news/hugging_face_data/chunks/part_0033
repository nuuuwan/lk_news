    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db4\u0dbb\u0daf\u0dc1-\u0d9a\u0db4\u0dba\u0d9a\u0da7-\u0dad\u0dbb\u0db8\u0d9a-\u0dad\u0daf-\u0dc0\u0dc3/1-685945",
