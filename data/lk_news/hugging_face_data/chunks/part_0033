    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0db4\u0dad\u0dbd\u0dba\u0d9a-\u0d9c\u0db1-\u0d85\u0dc0-\u0d8b\u0dab\u0da9-\u0dc3\u0db8\u0d9f-\u0d85\u0dbd\u0dbd\u0dba/1-685913",
