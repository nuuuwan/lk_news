    "description": "\u0d85\u0dbd\u0dd2\u0dba\u0dcf \u0db4\u0dd2\u0dc5\u0dd2\u0dc3\u0dca\u0dc3\u0dd4 \u0dc0\u0dd3\u0da9\u0dd2\u0dba\u0ddd\u0dc0 \u0daf\u0dd4\u0db1\u0dca \u0dc3\u0dd2\u0dc3\u0dd4\u0dc0\u0dcf \u0d85\u0dbd\u0dd2 \u0d85\u0db8\u0dcf\u0dbb\u0dd4\u0dc0\u0d9a",
    "url_metadata": "https://www.lankadeepa.lk/latest_news/\u0d85\u0dbd\u0dba-\u0db4\u0dc5\u0dc3\u0dc3-\u0dc0\u0da9\u0dba\u0dc0-\u0daf\u0db1-\u0dc3\u0dc3\u0dc0-\u0d85\u0dbd-\u0d85\u0db8\u0dbb\u0dc0\u0d9a/1-685713",
