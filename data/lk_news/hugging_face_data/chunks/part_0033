    "description": "\u0dc6\u0dd6\u0da2\u0dd2 \u0d9c\u0dd2\u0db1\u0dd2 \u0d9a\u0db1\u0dca\u0daf\u0da7 \u0d89\u0dc4\u0dc5\u0dd2\u0db1\u0dca \u0d85\u0dc4\u0dc3\u0dda \u0d91\u0dc5\u0dd2\u0dba\u0d9a\u0dca",
    "url_metadata": "https://www.lankadeepa.lk/news/\u0dc6\u0da2-\u0d9c\u0db1-\u0d9a\u0db1\u0daf\u0da7-\u0d89\u0dc4\u0dc5\u0db1-\u0d85\u0dc4\u0dc3-\u0d91\u0dc5\u0dba\u0d9a/101-685927",
    "lang": "si",
    "newspaper_id": "lankadeepalk",
