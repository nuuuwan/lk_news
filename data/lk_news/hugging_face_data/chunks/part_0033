    "description": "\u0dc1\u0dd3\u0dad \u0dc3\u0dd8\u0dad\u0dd4\u0dc0\u0da7 \u0db4\u0ddd\u0dbd\u0db1\u0dca\u0dad\u0dba\u0dda \u0dc3\u0dd2\u0da7 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca \u0d85\u0dbb\u0db1\u0dca \u0d91\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/breaking_news/\u0dc1\u0dd3\u0dad-\u0dc3\u0dd8\u0dad\u0dd4\u0dc0\u0da7-\u0db4\u0ddd\u0dbd\u0db1\u0dca\u0dad\u0dba\u0dda-\u0dc3\u0dd2\u0da7-\u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca-\u0d85\u0dbb\u0db1\u0dca-\u0d91\u0dba\u0dd2/11-420449",
    "lang": "si",
    "newspaper_id": "adalk",
