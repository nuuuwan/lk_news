    "num": "virakesarilk-af395ae4",
    "date_str": "2025-12-27",
    "description": "\u0b95\u0bb3\u0bbf\u0baf\u0bbe\u0b9f\u0bcd\u0b9f \u0bb5\u0bbf\u0b9f\u0bc1\u0ba4\u0bbf \u0bae\u0bc0\u0ba4\u0bc1 \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bcb\u0bb2\u0bcd \u0b95\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bb2\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4 \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf\u0ba4\u0bcd\u0ba4\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc8\u0ba4\u0bc1!",
    "url_metadata": "https://www.virakesari.lk/article/234519",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1766812860.0,
    "chunk_id": "2025-12-27-virakesarilk-af395ae4-0000",
    "chunk_index": 0,
    "language": "ta",
