    "description": "UNICEF delivers emergency BP-5 nutrition packs to support children hit by Cyclone Ditwah",
    "url_metadata": "https://www.ft.lk/news/UNICEF-delivers-emergency-BP-5-nutrition-packs-to-support-children-hit-by-Cyclone-Ditwah/56-786110",
    "lang": "en",
    "newspaper_id": "dailyftlk",
