    "description": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dd2\u0d9a \u0d86\u0db4\u0daf\u0dcf \u0dc0\u0dd0\u0da9\u0dd2\u0db8 \u0dbb\u0da7\u0dc0\u0dbd\u0dca \u0d85\u0dad\u0dbb \u0daf\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u0dad\u0dd0\u0db1\n \u0d85\u0d82\u0dc1\u0d9a 60\u0da7 \u0dc0\u0da9\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0db3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0dab\u0dad\u0dca \u0db1\u0dcf\u0dba  \u0dba\u0dcf\u0db8 \u0d85\u0db1\u0dd2\u0dc0\u0dcf\u0dbb\u0dca\u0dba\u0dba\u0dd2",
