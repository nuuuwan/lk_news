    "description": "Bradman W: A CEO for All Seasons\u2019",
    "url_metadata": "http://island.lk/bradman-w-a-ceo-for-all-seasons/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1754123460.0,
