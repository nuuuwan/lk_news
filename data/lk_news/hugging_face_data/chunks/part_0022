    "description": "Goal is to reduce number of students in a classroom to 25-30: PM Harini",
    "url_metadata": "https://www.adaderana.lk/news/110631/goal-is-to-reduce-number-of-students-in-a-classroom-to-25-30-pm-harini",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1752944820.0,
    "chunk_id": "2025-07-19-adaderanalk-a64fc913-0000",
