    "description": "\u0dc1\u0dd2\u0dc2\u0dca\u200d\u0dba\u0dad\u0dca\u0dc0\u0dba \u0d85\u0dc4\u0ddd\u0dc3\u0dd2 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0d85\u0dad\u0dbb \u0dc0\u0dd2\u0dc2\u0db8\u0dad\u0dcf\u0dc0 \u0db1\u0dd0\u0dad\u0dd2 \u0d9a\u0dc5 \u0dba\u0dd4\u0dad\u0dd4\u0dba\u0dd2",
