    "description": "US Embassy strengthens regional efforts to combat synthetic drug threat",
    "url_metadata": "https://www.adaderana.lk/news/110619/us-embassy-strengthens-regional-efforts-to-combat-synthetic-drug-threat",
    "lang": "en",
    "newspaper_id": "adaderanalk",
