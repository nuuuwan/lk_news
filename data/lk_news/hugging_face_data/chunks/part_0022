    "description": "\u0db1\u0dd2\u0dbd\u0db1\u0dca\u0dad\u0dc0 \u0dc3\u0dda\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0db1\u0dd9\u0dbb\u0db4\u0dd3\u0db8 \u0d9c\u0dd0\u0db1 \u0d9a\u0dad\u0ddd\u0dbd\u0dd2\u0d9a \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbb\u0dba \u0d9a\u0dd2\u0dba\u0dba\u0dd2",
