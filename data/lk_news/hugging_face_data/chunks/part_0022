    "description": "\u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dd2\u0dbb\u0ddd\u0db0\u0dd3 \u0db4\u0dad\u0dca\u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0d85\u0db1\u0dd2\u0dad\u0dd3\u0d9a \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dca \u0dc4\u0dda\u0dad\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0da2\u0dba\u0dc0\u0dbb\u0dca\u0db0\u0db1\u0db4\u0dd4\u0dbb \u0dbb\u0ddd\u0dc4\u0dbd\u0da7 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0db8\u0dd6\u0dbd\u0dca\u200d\u0dba \u0d85\u0dbd\u0dcf\u0db7\u0dba\u0d9a\u0dca - \u0d9a\u0ddd\u0db4\u0dca \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0dc4\u0dd9\u0dc5\u0dd2\u0d9a\u0dbb\u0dba\u0dd2",
