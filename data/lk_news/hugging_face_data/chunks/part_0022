    "description": "Sri\u202fLanka \u2013 Bangladesh keen to enhance economic cooperation",
    "url_metadata": "https://www.ft.lk/business/SriLanka-Bangladesh-keen-to-enhance-economic-cooperation/34-779505",
    "lang": "en",
    "newspaper_id": "dailyftlk",
