    "description": "\u0dc3\u0dd4\u0dc4\u0dd4\u0dbb\u0dd4 \u0d9a\u0dcf\u0db1\u0dd4 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0dbd\u0ddc\u0dc0\u0d9a\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0dda \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0dda \u0db1\u0db8 \u0db6\u0dd0\u0db6\u0dbd\u0dc0\u0dd6 \u0d86\u0da0\u0dcf\u0dbb\u0dca\u0dba \u0db1\u0daf\u0dd3\u0dc1\u0dcf \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0da7",
