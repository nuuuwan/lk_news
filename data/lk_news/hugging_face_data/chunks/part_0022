    "num": "islandlk-d658a0d0",
    "date_str": "2025-07-19",
    "description": "Developing Sri Lankan economy fast, learning from the past",
    "url_metadata": "http://island.lk/developing-sri-lankan-economy-fast-learning-from-the-past/",
