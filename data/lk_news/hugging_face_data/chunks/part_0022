    "description": "\u0d86\u0dc3\u0db1 \u0db4\u0da7\u0dd2 \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0daf\u0dd0\u0da9\u0dd2 \u0dc0\u0dd9\u0dba\u0dd2",
