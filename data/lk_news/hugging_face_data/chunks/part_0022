    "description": "When tax policy backfires: Call for more calculated policy approach",
    "url_metadata": "https://www.ft.lk/opinion/When-tax-policy-backfires-Call-for-more-calculated-policy-approach/14-779381",
    "lang": "en",
    "newspaper_id": "dailyftlk",
