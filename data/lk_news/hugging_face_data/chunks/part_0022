    "description": "\u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab \u0dba\u0db1\u0dd4 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0db4\u0dd9\u0dc5\u0db4\u0ddc\u0dad\u0d9a\u0dca \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf\u0daf\u0dd3\u0db8\u0d9a\u0dca \u0db1\u0dd9\u0dc0\u0dd9\u0dba\u0dd2 - \u0d85\u0d9c\u0db8\u0dd0\u0dad\u0dd2 \u0dc4\u0dbb\u0dd2\u0db1\u0dd2",
