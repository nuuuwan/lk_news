    "description": "\u0db4\u0dd2\u0dbb\u0dd2\u0db8\u0dd2 \u0d85\u0db6\u0dd2\u0db6\u0dc0\u0dcf \u0d9a\u0dcf\u0db1\u0dca\u0dad\u0dcf \u0da2\u0db1\u0d9c\u0dc4\u0dab\u0dba \u0d89\u0dc4\u0dc5 \u0dba\u0dd1\u0db8\u0dd9\u0db1\u0dca \u0d85\u0db1\u0dcf\u0d9c\u0dad\u0dba\u0dda \u0d85\u0dbb\u0dca\u0db6\u0dd4\u0daf \u0dbb\u0dd0\u0dc3\u0d9a\u0dca",
