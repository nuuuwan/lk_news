    "url_metadata": "https://www.ada.lk/breaking_news/\u0dbb\u0ddd\u0dc4\u0dd2\u0dad-\u0d85\u0db6\u0dda\u0d9c\u0dd4\u0dab\u0dc0\u0dbb\u0dca\u0db0\u0db1-\u0db8\u0dc4\u0dad\u0dcf\u0d9c\u0dda-\u0daf\u0dd2\u0dba\u0dab\u0dd2\u0dba-\u0db4\u0ddc\u0dbd\u0dd3\u0dc3\u0dd2\u0dba\u0da7-\u0db7\u0dcf\u0dbb-\u0dc0\u0dd9\u0dba\u0dd2/11-417602",
