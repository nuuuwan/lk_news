    "description": "\u0db7\u0dd6\u0d9a\u0db8\u0dca\u0db4\u0db1\u0dba\u0dd9\u0db1\u0dca \u0dad\u0dc0\u0dad\u0dca \u0dbb\u0da7\u0dc0\u0dbd\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0da7 \u0dc3\u0dd4\u0db1\u0dcf\u0db8\u0dd2 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca - \u0dc6\u0dd4\u0d9a\u0dd4\u0dc2\u0dd2\u0db8\u0dcf \u0db1\u0dca\u200d\u0dba\u0dc2\u0dca\u0da7\u0dd2\u0d9a \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0da7 \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a\u0dca \u0db1\u0dd1",
