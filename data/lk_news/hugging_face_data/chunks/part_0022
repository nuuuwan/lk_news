    "description": "Increase in female population over males could lead to future crises, expert warns",
    "url_metadata": "https://www.adaderana.lk/news/110713/increase-in-female-population-over-males-could-lead-to-future-crises-expert-warns",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1753156680.0,
    "chunk_id": "2025-07-22-adaderanalk-7fcbc73d-0000",
