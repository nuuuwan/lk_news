    "description": "\u0da2\u0db1\u0db4\u0dad\u0dd2 \u0d85\u0daf \u0db8\u0dcf\u0dbd\u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0da7",
    "url_metadata": "http://sinhala.adaderana.lk/news/212710",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1753666320.0,
