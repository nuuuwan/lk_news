    "date_str": "2025-07-30",
    "description": "\u201cCommercial Mediation Bill\u201d: Problem or solution?",
    "url_metadata": "https://www.ft.lk/opinion/Commercial-Mediation-Bill-Problem-or-solution/14-779649",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1753831012.0,
    "chunk_id": "2025-07-30-dailyftlk-48092388-0000",
