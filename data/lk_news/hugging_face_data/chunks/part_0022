    "description": "The Colombo Plan celebrates 74 years of regional cooperation and development",
    "url_metadata": "https://www.ft.lk/news/The-Colombo-Plan-celebrates-74-years-of-regional-cooperation-and-development/56-779249",
    "lang": "en",
    "newspaper_id": "dailyftlk",
