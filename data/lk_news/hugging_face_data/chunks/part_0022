    "description": "Black July 1983: Remembering the past to secure the future",
    "url_metadata": "https://www.ft.lk/opinion/Black-July-1983-Remembering-the-past-to-secure-the-future/14-779385",
    "lang": "en",
    "newspaper_id": "dailyftlk",
