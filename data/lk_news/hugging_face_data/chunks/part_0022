    "description": "Court rejects Rajitha\u2019s anticipatory bail application",
    "url_metadata": "https://www.ft.lk/news/Court-rejects-Rajitha-s-anticipatory-bail-application/56-779201",
    "lang": "en",
    "newspaper_id": "dailyftlk",
