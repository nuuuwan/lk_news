    "description": "The \u2018underwater bushfire\u2019 cooking Australia\u2019s reefs",
    "url_metadata": "http://island.lk/the-underwater-bushfire-cooking-australias-reefs/",
    "lang": "en",
    "newspaper_id": "islandlk",
