    "description": "Indigo Flight with 140 passengers on board makes emergency landing at Indore Airport",
    "url_metadata": "https://www.adaderana.lk/news/110706/indigo-flight-with-140-passengers-on-board-makes-emergency-landing-at-indore-airport",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1753144920.0,
