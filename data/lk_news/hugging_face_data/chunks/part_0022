    "description": "SriLankan Cargo joins Freightos:  New digital bridge to South Asian markets",
    "url_metadata": "https://www.ft.lk/business/SriLankan-Cargo-joins-Freightos-New-digital-bridge-to-South-Asian-markets/34-779314",
    "lang": "en",
    "newspaper_id": "dailyftlk",
