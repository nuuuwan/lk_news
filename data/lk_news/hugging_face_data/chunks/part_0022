    "description": "\u0db4\u0dbd\u0dc3\u0dca\u0dad\u0dd3\u0db1 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dda \u0dc3\u0dd0\u0dbd\u0dd0\u0dc3\u0dca\u0db8 \u0dc3\u0db8\u0d9f \u0d9a\u0dd0\u0db1\u0da9\u0dcf\u0dc0\u0dad\u0dca \u0d91\u0d9a\u0dca\u0dc0\u0dd9\u0dba\u0dd2",
