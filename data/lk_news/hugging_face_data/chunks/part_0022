    "description": "\u0db7\u0dd6\u0db8\u0dd2\u0d9a\u0db8\u0dca\u0db4\u0db1\u0dba \u0d85\u0dad\u0dbb\u0dad\u0dd4\u0dbb \u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0dbb\u0ddd\u0dc4\u0dbd\u0d9a \u0dc3\u0dd2\u0daf\u0dd4 \u0dc0\u0dd6 \u0dc3\u0dd0\u0dad\u0dca\u0d9a\u0db8",
