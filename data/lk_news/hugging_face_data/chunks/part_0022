    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1753161360.0,
    "chunk_id": "2025-07-22-adaderanasinhalalk-5ae8119d-0000",
    "chunk_index": 0,
    "language": "si",
