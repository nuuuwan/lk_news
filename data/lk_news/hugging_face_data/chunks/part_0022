    "doc_id": "2025-07-29-dailyftlk-dcdacaf0",
    "num": "dailyftlk-dcdacaf0",
    "date_str": "2025-07-29",
    "description": "Real hangover: Outdated laws and who they serve",
    "url_metadata": "https://www.ft.lk/columns/Real-hangover-Outdated-laws-and-who-they-serve/4-779577",
    "lang": "en",
    "newspaper_id": "dailyftlk",
