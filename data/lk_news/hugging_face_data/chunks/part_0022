    "description": "\u0db1\u0dcf\u0dbb\u0dcf\u0dc4\u0dda\u0db1\u0dca\u0db4\u0dd2\u0da7 \u0db1\u0dd2\u0dc0\u0dc3\u0d9a \u0d9c\u0dd2\u0db1\u0dca\u0db1\u0d9a\u0dca - \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dd9\u0d9a\u0dca \u0db8\u0dbb\u0dd4\u0da7",
