    "url_metadata": "https://www.ft.lk/news/Parliamentary-Committee-questions-policy-on-Chabad-Houses-amid-security-concerns/56-779308",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1753135551.0,
    "chunk_id": "2025-07-22-dailyftlk-09a8cbfd-0000",
