    "description": "Sri Lanka rupee depreciates amid record current account surplus : analysis",
    "url_metadata": "https://economynext.com/sri-lanka-rupee-depreciates-amid-record-current-account-surplus-analysis-234065/",
    "lang": "en",
    "newspaper_id": "economynextcom",
