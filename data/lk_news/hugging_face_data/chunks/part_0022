    "date_str": "2025-07-23",
    "description": "\u0db8\u0dd3\u0dc5\u0d9f \u0d85\u0d9c\u0dc0\u0dd2\u0db1\u0dd2\u0dc3\u0dd4\u0dbb\u0dd4 \u0dbd\u0dd9\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0dd3\u0dad\u0dd2 \u0db4\u0daf\u0dca\u0db8\u0db1\u0dca \u0dc3\u0dd6\u0dbb\u0dc3\u0dda\u0db1\u0d9c\u0dda \u0db1\u0db8 \u0dc0\u0dca\u200d\u0dba\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0daf\u0dcf\u0dba\u0d9a \u0dc3\u0db7\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0db8\u0dad \u0d9a\u0dbb\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/212560",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1753271340.0,
    "chunk_id": "2025-07-23-adaderanasinhalalk-8f68eb8f-0000",
    "chunk_index": 0,
