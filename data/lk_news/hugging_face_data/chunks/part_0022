    "description": "Authorities urged to take action against foreigners engaged in business activities in Arugam Bay",
    "url_metadata": "https://www.adaderana.lk/news/111112/authorities-urged-to-take-action-against-foreigners-engaged-in-business-activities-in-arugam-bay-",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1754189460.0,
