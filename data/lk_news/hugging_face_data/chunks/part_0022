    "description": "More details revealed in pregnant deer killing incident involving police officers",
    "url_metadata": "https://www.adaderana.lk/news/110848/more-details-revealed-in-pregnant-deer-killing-incident-involving-police-officers",
    "lang": "en",
    "newspaper_id": "adaderanalk",
    "time_ut": 1753499100.0,
