    "description": "Tuition classes for scholarship exam banned from Aug 6 midnight",
    "url_metadata": "https://www.adaderana.lk/news/111079/tuition-classes-for-scholarship-exam-banned-from-aug-6-midnight",
    "lang": "en",
    "newspaper_id": "adaderanalk",
