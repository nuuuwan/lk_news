    "description": "\u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca  \u0d9a\u0ddd\u0da7\u0dd2\u0dba \u0d89\u0d9a\u0dca\u0db8\u0dc0\u0db1 \u0db8\u0dad\u0dca\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba \u0dad\u0ddc\u0d9c\u0dba\u0d9a\u0dca \u0dc3\u0db8\u0d9c \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dd9\u0d9a\u0dd4 \u0d85\u0dad\u0dca\u0d85\u0da9\u0d82\u0d9c\u0dd4\u0dc0\u0da7",
