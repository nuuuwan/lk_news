    "description": "\u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dda \u0dc4\u0dc0\u0dcf\u0dba\u0dd2 \u0dc0\u0dd9\u0dad \u0dc3\u0dd4\u0db1\u0dcf\u0db8\u0dd2 \u0dbb\u0dc5 \u0d91\u0dba\u0dd2, \u0dad\u0dc0\u0dad\u0dca \u0dbb\u0da7\u0dc0\u0dbd\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0da7 \u0dc3\u0dd4\u0db1\u0dcf\u0db8\u0dd2 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8\u0dca",
