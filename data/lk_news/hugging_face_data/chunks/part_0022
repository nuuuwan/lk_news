    "description": "Trump Tariffs: Will moral suasion work?",
    "url_metadata": "http://island.lk/trump-tariffs-will-moral-suasion-work/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1752847200.0,
    "chunk_id": "2025-07-18-islandlk-ab648a17-0000",
    "chunk_index": 0,
