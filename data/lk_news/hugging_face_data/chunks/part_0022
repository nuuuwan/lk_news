    "doc_id": "2025-08-01-dbsjeyarajcom-4ec305ad",
    "num": "dbsjeyarajcom-4ec305ad",
    "date_str": "2025-08-01",
    "description": "Sirimavo Bandaranaike: The \u201cWeeping Widow\u201d  who Became the World\u2019s First Woman Prime Minister 65 Years ago.",
