    "description": "\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0d9a\u0daf\u0dd4\u0d9a\u0dbb\u0dba\u0da7 \u0dad\u0daf \u0dc0\u0dd0\u0dc3\u0dd2. \u0dc0\u0dd2\u0db8\u0dbd \u0dc3\u0dd4\u0dbb\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb \u0da2\u0dbd\u0dcf\u0dc1\u0dba \u0dc0\u0dcf\u0db1\u0dca \u0daf\u0db8\u0dba\u0dd2",
