    "description": "\u0db4\u0dca\u200d\u0dbb\u0dda\u0db8\u0dbd\u0dcf\u0dbd\u0dca \u0da2\u0dba\u0dc3\u0dda\u0d9a\u0dbb\u0da7 \u0db8\u0dbb\u0dab \u0daf\u0dac\u0dd4\u0dc0\u0db8  \u0dbd\u0db6\u0dcf\u0daf\u0dd9\u0db1\u0dca\u0db1\u0dd0\u0dba\u0dd2 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0d9c\u0ddc\u0db1\u0dd4 \u0d9a\u0dc5  \u0d85\u0db7\u0dd2\u0dba\u0dcf\u0da0\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dd2\u0db7\u0dcf\u0d9c\u0dba\u0da7 \u0d85\u0dc0\u0dc3\u0dbb",
