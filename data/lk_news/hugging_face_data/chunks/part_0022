    "description": "\u0db6\u0dd2\u0dad\u0dca\u0dad\u0dbb \u0dc3\u0ddd\u0daf\u0dcf \u0d9c\u0db6\u0da9\u0dcf\u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dde\u0d9b\u0dca\u200d\u0dba\u0dba\u0da7 \u0d85\u0dc4\u0dd2\u0dad \u0d9a\u0dbb\u0dba\u0dd2",
    "url_metadata": "http://sinhala.adaderana.lk/news/212925",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1754102460.0,
