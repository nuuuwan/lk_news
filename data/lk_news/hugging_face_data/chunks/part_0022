    "description": "\u0dbb\u0da2\u0dba\u0dda \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0d9a\u0dcf\u0dbb\u0d9a \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4\u0dc0\u0da7 \u0db1\u0dd2\u0dc1\u0dcf\u0db1\u0dca\u0dad \u0da2\u0dba\u0dc0\u0dd3\u0dbb \u0db4\u0dad\u0dca \u0d9a\u0dd9\u0dbb\u0dda",
    "url_metadata": "http://sinhala.adaderana.lk/news/212633",
    "lang": "si",
    "newspaper_id": "adaderanasinhalalk",
    "time_ut": 1753438860.0,
