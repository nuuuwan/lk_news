    "description": "\u0db1\u0dcf\u0db8\u0dd2\u0d9a\u0dc0 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dcf\u0dc3\u0dbd\u0dca \u0dc0\u0dd6\u00a0\u0db4\u0dcf\u0dc3\u0dbd\u0dca 809\u0d9a\u0dca - \u0d9a\u0ddd\u0db4\u0dcf \u0d9a\u0db8\u0dd2\u0da7\u0dd4\u0dc0\u0dda\u0daf\u0dd3 \u0dc3\u0dd2\u0dba\u0dbd\u0dca\u0dbd \u0dc4\u0dd9\u0dc5\u0dd2\u0dc0\u0dd9\u0dba\u0dd2",
