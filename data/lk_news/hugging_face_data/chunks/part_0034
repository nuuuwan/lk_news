    "date_str": "2026-01-09",
    "description": "Education reforms, let\u2019s learn from Singapore",
    "url_metadata": "https://www.ft.lk/columns/Education-reforms-let-s-learn-from-Singapore/4-786715",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1767921319.0,
