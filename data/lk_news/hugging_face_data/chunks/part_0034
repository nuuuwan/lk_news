    "description": "\u0d89\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dcf \u0da7\u0dca\u200d\u0dbb\u0dda\u0da9\u0dbb\u0dca\u0dc3\u0dca \u0dbd\u0d82\u0d9a\u0dcf \u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0 \u0dc3\u0db8\u0d9c \u0d91\u0d9a\u0dca\u0dc0 \u0d85\u0dad\u0dca\u0dc0\u0dd0\u0dbd \u0d9c\u0dd9\u0db1\u0dd9\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/business/\u0d89\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0dcf-\u0da7\u0dca\u200d\u0dbb\u0dda\u0da9\u0dbb\u0dca\u0dc3\u0dca-\u0dbd\u0d82\u0d9a\u0dcf-\u0db6\u0dd0\u0d82\u0d9a\u0dd4\u0dc0-\u0dc3\u0db8\u0d9c-\u0d91\u0d9a\u0dca\u0dc0-\u0d85\u0dad\u0dca\u0dc0\u0dd0\u0dbd-\u0d9c\u0dd9\u0db1\u0dd9\u0dba\u0dd2/7-420760",
