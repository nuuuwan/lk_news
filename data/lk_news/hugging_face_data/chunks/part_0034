    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0bae\u0b9f\u0bc1\u0bb2\u0bcd\u0b9a\u0bc0\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd-\u0bb5\u0bc0\u0ba4\u0bbf-\u0ba4\u0bbe\u0bb4\u0bbf\u0bb1\u0b99\u0bcd\u0b95\u0bbf\u0baf\u0ba4\u0bc1/76-370827",
