    "description": "Health after the floods: Scientific realities and shared responsibility for Sri Lanka\u2019s future",
    "url_metadata": "https://www.ft.lk/columns/Health-after-the-floods-Scientific-realities-and-shared-responsibility-for-Sri-Lanka-s-future/4-786787",
    "lang": "en",
    "newspaper_id": "dailyftlk",
