    "description": "\u0dc0\u0dd2\u0db8\u0dbd\u0dca\u0d9c\u0dda \u0dc3\u0dad\u0dca\u200d\u0dba\u0d9c\u0dca\u200d\u0dbb\u0dc4\u0dba \u0d85\u0dc0\u0dc3\u0db1\u0dca",
