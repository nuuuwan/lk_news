    "description": "Foreign Minister defends India pacts, sidesteps transparency demand",
    "url_metadata": "http://island.lk/foreign-minister-defends-india-pacts-sidesteps-transparency-demand/",
    "lang": "en",
    "newspaper_id": "islandlk",
