    "url_metadata": "https://www.ada.lk/sports/\u0db4\u0dcf\u0d9a\u0dd2\u0dc3\u0dca\u0dad\u0dcf\u0db1\u0dba\u0da7-\u0db4\u0dc4\u0dc3\u0dd4-\u0da2\u0dba\u0d9a\u0dca/9-420680",
