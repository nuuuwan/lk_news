    "description": "Sri Lanka: A proven neutral destination in the region",
    "url_metadata": "https://www.ft.lk/columns/Sri-Lanka-A-proven-neutral-destination-in-the-region/4-786712",
    "lang": "en",
    "newspaper_id": "dailyftlk",
