    "description": "Education Reforms and Democratic Deficit: A Warning for Sri Lanka",
    "url_metadata": "http://island.lk/education-reforms-and-democratic-deficit-a-warning-for-sri-lanka/",
    "lang": "en",
    "newspaper_id": "islandlk",
