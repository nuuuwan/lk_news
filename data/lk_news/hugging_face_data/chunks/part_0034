    "description": "\u0dc3\u0db8\u0dca\u0db7\u0dcf\u0dc4\u0db1\u0dba \u0db8\u0dd4\u0dc0\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dc0\u0dd9\u0db1 \u0dc0\u0dd0\u0da9\u0d9a\u0dca \u0d9a\u0dbb\u0dbd\u0dcf - \u0dc3\u0dd0\u0d9a\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0db1\u0dca 5\u0d9a\u0dca \u0d85\u0dbd\u0dca\u0dbd\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/breaking_news/\u0dc3\u0db8\u0dca\u0db7\u0dcf\u0dc4\u0db1\u0dba-\u0db8\u0dd4\u0dc0\u0dcf\u0dc0\u0dd9\u0db1\u0dca-\u0dc0\u0dd9\u0db1-\u0dc0\u0dd0\u0da9\u0d9a\u0dca-\u0d9a\u0dbb\u0dbd\u0dcf---\u0dc3\u0dd0\u0d9a\u0d9a\u0dcf\u0dbb\u0dd2\u0dba\u0db1\u0dca-5\u0d9a\u0dca-\u0d85\u0dbd\u0dca\u0dbd\u0dba\u0dd2/11-420701",
