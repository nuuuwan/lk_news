    "description": "President assures teacher unions on education reforms, funding priorities",
    "url_metadata": "https://www.ft.lk/news/President-assures-teacher-unions-on-education-reforms-funding-priorities/56-786920",
    "lang": "en",
    "newspaper_id": "dailyftlk",
