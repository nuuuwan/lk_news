    "description": "\u0d86 \u0daf\u0dd2\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0da7\u0db8 \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dda \u0dc5\u0dd0\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d9c\u0dd9\u0db1\u0dba\u0dd1\u0db8 \u0db8\u0d9c\u0dda \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0dc0\u0dd4\u0dab\u0dcf",
    "url_metadata": "https://www.ada.lk/business/\u0d86-\u0daf\u0dd2\u0db1\u0dba\u0dda-\u0dc3\u0dd2\u0da7\u0db8-\u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dda-\u0dc5\u0dd0\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0db1\u0dca-\u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7-\u0d9c\u0dd9\u0db1\u0dba\u0dd1\u0db8-\u0db8\u0d9c\u0dda-\u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba-\u0dc0\u0dd4\u0dab\u0dcf/7-420710",
