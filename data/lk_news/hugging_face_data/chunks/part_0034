    "description": "CH17 launches Sri Lanka\u2019s first integrated HRM, rewards and loyalty SaaS platform",
    "url_metadata": "https://www.ft.lk/business/CH17-launches-Sri-Lanka-s-first-integrated-HRM-rewards-and-loyalty-SaaS-platform/34-786702",
    "lang": "en",
    "newspaper_id": "dailyftlk",
