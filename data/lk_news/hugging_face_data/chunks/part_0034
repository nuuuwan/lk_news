    "description": "Digital divide persists despite rising literacy: Stats Dept.",
    "url_metadata": "https://www.ft.lk/news/Digital-divide-persists-despite-rising-literacy-Stats-Dept/56-786886",
    "lang": "en",
    "newspaper_id": "dailyftlk",
