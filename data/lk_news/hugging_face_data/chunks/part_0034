    "date_str": "2026-01-05",
    "description": "\u0baa\u0bc1\u0ba4\u0bc8\u0baf\u0bb2\u0bcd \u0ba4\u0bcb\u0ba3\u0bcd\u0b9f\u0bbf\u0baf \u0bae\u0bc2\u0bb5\u0bb0\u0bcd \u0b95\u0bc8\u0ba4\u0bc1!",
    "url_metadata": "https://www.virakesari.lk/article/235231",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1767581340.0,
    "chunk_id": "2026-01-05-virakesarilk-0887bd4a-0000",
    "chunk_index": 0,
