    "date_str": "2026-01-07",
    "description": "Beyond bank discretion: Why Sri Lanka needs  independent mechanism to protect calamity-affected SMEs",
    "url_metadata": "https://www.ft.lk/columns/Beyond-bank-discretion-Why-Sri-Lanka-needs-independent-mechanism-to-protect-calamity-affected-SMEs/4-786598",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1767739800.0,
    "chunk_id": "2026-01-07-dailyftlk-27f0fe6f-0000",
