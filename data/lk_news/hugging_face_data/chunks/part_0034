    "url_metadata": "https://www.ada.lk/breaking_news/\u0da0\u0dd3\u0db1-\u0dc0\u0dd2\u0daf\u0dd9\u0dc3\u0dca-\u0d87\u0db8\u0dad\u0dd2-\u0d91\u0d9a\u0dca\u0daf\u0dd2\u0db1-\u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0dba\u0d9a\u0da7-\u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7-\u0d91\u0dba\u0dd2/11-420737",
