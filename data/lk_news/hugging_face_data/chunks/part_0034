    "description": "\u0db1\u0dd4\u0daf\u0dd4\u0dbb\u0dda\u0daf\u0dd3 \u0db4\u0dcf\u0dbb\u0dca\u0dbd\u0dd2\u0db8\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0\u0da7 \u0d91\u0db1 \u0d85\u0dbd\u0dd4\u0dad\u0dca \u0db8 \u0daf\u0dd2\u0d9a\u0dca\u0d9a\u0dc3\u0dcf\u0daf \u0db1\u0dd3\u0dad\u0dd2\u0dba \u0dc3\u0dc4 \u0db8\u0dd4\u0dc3\u0dca\u0dbd\u0dd2\u0db8\u0dca, \u0dad\u0dda\u0dc3\u0dc0\u0dbd\u0dcf\u0db8\u0dda \u0db1\u0dd3\u0dad\u0dd2\u0dc0\u0dbd\u0da7 \u0dba\u0ddd\u0da2\u0dd2\u0dad \u0dc0\u0dd9\u0db1\u0dc3\u0dca\u0d9a\u0db8\u0dca",
