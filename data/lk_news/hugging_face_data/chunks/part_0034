    "description": "Synogen commissions one of largest rooftop solar projects",
    "url_metadata": "https://www.ft.lk/business/Synogen-commissions-one-of-largest-rooftop-solar-projects/34-786882",
    "lang": "en",
    "newspaper_id": "dailyftlk",
