    "description": "Talal Rafi delivers keynote on \u201cGlobal Debt Outlook\u201d at conference in Slovakia",
    "url_metadata": "https://www.ft.lk/business/Talal-Rafi-delivers-keynote-on-Global-Debt-Outlook-at-conference-in-Slovakia/34-786703",
    "lang": "en",
    "newspaper_id": "dailyftlk",
