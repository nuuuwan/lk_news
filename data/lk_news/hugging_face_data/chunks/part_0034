    "description": "\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dad\u0dca \u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dbd\u0dca \u0dbd\u0dcf\u0db7\u0dcf\u0d82\u0dc1 \u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dda \u0dc3\u0dda\u0dc0\u0dcf \u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0da7 CDS \u0dc3\u0dc4 NDB \u0dc4\u0dc0\u0dd4\u0dbd\u0dca \u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/business/\u0d9a\u0dca\u200d\u0dbb\u0db8\u0dc0\u0dad\u0dca-\u0da9\u0dd2\u0da2\u0dd2\u0da7\u0dbd\u0dca-\u0dbd\u0dcf\u0db7\u0dcf\u0d82\u0dc1-\u0d9c\u0dd9\u0dc0\u0dd3\u0db8\u0dda-\u0dc3\u0dda\u0dc0\u0dcf-\u0dc3\u0dd0\u0db4\u0dba\u0dd3\u0db8\u0da7-CDS-\u0dc3\u0dc4-NDB-\u0dc4\u0dc0\u0dd4\u0dbd\u0dca-\u0dc0\u0dd9\u0dba\u0dd2/7-420788",
