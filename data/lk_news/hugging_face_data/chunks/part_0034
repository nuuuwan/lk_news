    "description": "\u0db6\u0dc4\u0dd4 \u0d86\u0d9c\u0db8\u0dd2\u0d9a \u0dc3\u0dd2\u0daf\u0dca\u0db0\u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dd6 \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0db4\u0dcf\u0daf\u0dba \u0db6\u0dde\u0daf\u0dca\u0db0 \u0db4\u0dcf\u0dbd\u0db1\u0dba\u0da7 \u0db4\u0dbb\u0dd2\u0dc0\u0dbb\u0dca\u0dad\u0db1\u0dba \u0dc0\u0dd6 \u0d85\u0dba\u0dd4\u0dbb\u0dd4",
