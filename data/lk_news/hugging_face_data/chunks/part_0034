    "description": "Rebuilding after disaster: Speed versus sustainability",
    "url_metadata": "https://www.ft.lk/columns/Rebuilding-after-disaster-Speed-versus-sustainability/4-786599",
    "lang": "en",
    "newspaper_id": "dailyftlk",
