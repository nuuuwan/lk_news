    "chunk_text": "\u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0db4\u0db1\u0dad \u0d9c\u0dd9\u0db1 \u0d86 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda\u0dad\u0dca \u0db8\u0dda \u0dc0\u0dd2\u0daf\u0dd2\u0dba\u0da7\u0db8 \u0d8a\u0da7 \u0dc0\u0dd2\u0dbb\u0dd4\u0daf\u0dca\u0db0\u0dc0 \u0db4\u0ddc\u0dbb \u0db6\u0dd0\u0daf\u0dd4\u0dc0\u0dcf. \u0db8\u0dda \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dda\u0daf\u0dd3\u0dad\u0dca \u0d91\u0dc4\u0dd9\u0db8\u0dba\u0dd2. \u0db8\u0dd9\u0dba \u0dba\u0dc4\u0db4\u0dad\u0dca \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0dc3\u0d82\u0dc3\u0dca\u0d9a\u0dbb\u0dab\u0dba\u0d9a\u0dca, \u0d85\u0db4\u0dda \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db6\u0dbd\u0dcf \u0d9c\u0db1\u0dca\u0db1\u0dcf \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba\u0d9a\u0dca. \u0d85\u0db4\u0dda \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0 \u0dbd\u0ddd\u0d9a\u0dba \u0dc3\u0db8\u0d9c \u0db8\u0dd4\u0dc3\u0dd4 \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca. \u0d91\u0dc3\u0dda\u0db8 \u0d85\u0db4\u0dda \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0da7 \u0db4\u0dde\u0dbb\u0dca\u0dc2\u0dba\u0d9a\u0dca, \u0db1\u0dcf\u0dba\u0d9a\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0dc3\u0dc4\u0dd2\u0dad\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0dba\u0dcf \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0d9a\u0dca\u200d\u0dbb\u0db8\u0dba\u0d9a\u0dca. \u0db8\u0dd0\u0dc2\u0dd2\u0db1\u0dca \u0dc4\u0daf\u0db1 \u0dc4\u0ddd \u0dad\u0dd9\u0dad\u0db8\u0db1\u0dba\u0d9a\u0dca, \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0dad\u0dca\u0db8\u0dba\u0d9a\u0dca \u0db1\u0dd0\u0dad\u0dd2 \u0daf\u0dd9\u0db8\u0dcf\u0db4\u0dd2\u0dba\u0db1\u0dca, \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca, \u0d86\u0d9c\u0db8\u0dd2\u0d9a \u0db1\u0dcf\u0dba\u0d9a\u0dba\u0db1\u0dca\u00a0 \u0dc4\u0db3\u0dd4\u0db1\u0db1\u0dca\u0db1\u0dda \u0db1\u0dd0\u0dad\u0dd2 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0dc4\u0daf\u0db1 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba\u0d9a\u0dca \u0db1\u0ddc\u0dc0\u0dd9\u0dba\u0dd2. \u0d91\u0dc0\u0dd0\u0db1\u0dd2 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0d85\u0db4\u0dd2\u0da7 \u0db5\u0dbd\u0d9a\u0dca \u0db1\u0dd0\u0dc4\u0dd0."
  },
