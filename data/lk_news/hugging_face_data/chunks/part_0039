    "description": "Nuwara Eliya, a place in your imagination",
    "url_metadata": "https://www.ft.lk/columns/Nuwara-Eliya-a-place-in-your-imagination/4-790659",
    "lang": "en",
    "newspaper_id": "dailyftlk",
