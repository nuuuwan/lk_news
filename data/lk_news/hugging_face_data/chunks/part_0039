    "description": "\u0bae\u0bbf\u0ba9\u0bcd\u0b9a\u0bbe\u0bb0\u0bae\u0bcd \u0ba4\u0bbe\u0b95\u0bcd\u0b95\u0bbf \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd \u0baa\u0bb2\u0bbf!",
    "url_metadata": "https://www.virakesari.lk/article/243406",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1775969040.0,
