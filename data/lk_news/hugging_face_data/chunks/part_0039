d2 \u0d9a\u0da9\u0dd4\u0dbd\u0dca\u0dbd \u0dc0\u0dd9\u0db1\u0dd4\u0dc0\u0dd9\u0db1\u0dca \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 191\u0d9a \u0dc3 \u0dc3\u0db6 \u0db3 \u0dad\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0dad\u0dca\u0dc0\u0dd3\u0dba.\u0db6\u0dcf\u0db6\u0dbb\u0dca \u0d85\u0dc3\u0dcf\u0db8\u0dca \u0db1\u0ddc\u0daf\u0dd0\u0dc0 \u0dd2\u0dbd\u0d9a\u0dd4\u0dab\u0dd4 87\u0d9a\u0dca \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5\u0dda\u0dba.\n\n\u0dbd\u0d9a\u0dd4\u0dab\u0dd4 247\u0d9a \u0daf\u0dd0\u0dc0\u0dd0\u0db1\u0dca\u0dad \u0d89\u0dbd\u0d9a\u0dca\u0d9a\u0dba\u0d9a\u0dca \u0dc4\u0db9\u0dcf \u0dba\u0dcf\u0db8\u0da7 \u0db4\u0dd2\u0da7\u0dd2\u0dba\u0da7 \u0db4\u0dd2\u0dc0\u0dd2\u0dc3\u0dd2 \u0d9a\u0dbb\u0da0\u0dca\u0da0\u0dd2 \u0d9a\u0dab\u0dca\u0da9\u0dcf\u0dba\u0db8\u0da7 \u0dc3\u0dd2\u0dba\u0dbd\u0dd4 \u0daf\u0dd9\u0db1\u0dcf \u0daf\u0dd0\u0dc0\u0dd3 \u0dbb\u0dd0\u0dc3\u0dca \u0d9a\u0dc5 \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc0\u0dd6\u0dba\u0dda \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 87\u0d9a\u0dca \u0db4\u0db8\u0dab\u0dd2. \u0dad\u0dbb\u0d9c\u0dba\u0dda \u0dc0\u0dd3\u0dbb\u0dba\u0dcf \u0dbd\u0dd9\u0dc3 \u0d9a\u0dd4\u0dc3\u0dbd\u0dca \u0db8\u0dd9\u0db1\u0dca\u0da9\u0dd2\u0dc3\u0dca \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1 \u0dbd\u0dd0\u0db6\u0dd3\u0dba."
