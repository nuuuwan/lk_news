    "url_metadata": "https://www.ada.lk/breaking_news/\u0d85\u0dc0\u0dd4\u0dbb\u0dd4\u0daf\u0dca\u0daf\u0da7-\u0daf\u0dd2\u0db1-\u0daf\u0dd9\u0d9a\u0d9a\u0dca-\u0db6\u0dcf\u0dbb\u0dca-\u0dc0\u0dc3\u0dba\u0dd2/11-422048",
    "lang": "si",
