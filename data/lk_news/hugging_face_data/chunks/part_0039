    "description": "Court of Appeal affirms RTI order against People\u2019s Bank on Devalaya accounts",
    "url_metadata": "https://www.ft.lk/news/Court-of-Appeal-affirms-RTI-order-against-People-s-Bank-on-Devalaya-accounts/56-790576",
    "lang": "en",
    "newspaper_id": "dailyftlk",
