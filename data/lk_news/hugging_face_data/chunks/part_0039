    "description": "\u0dc3\u0dd9\u0dbd\u0dd2\u0db1\u0dca\u0d9a\u0ddd \u0dbd\u0dba\u0dd2\u0dc6\u0dca \u0dc3\u0db7\u0dcf\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd9\u0dad CMA \u0d9c\u0dde\u0dbb\u0dc0 \u0dc3\u0db8\u0dca\u0db8\u0dcf\u0db1\u0dba\u0d9a\u0dca",
