    "description": "Hayleys completes 800kW solar project  for LSEG Sri Lanka",
    "url_metadata": "https://www.ft.lk/business/Hayleys-completes-800kW-solar-project-for-LSEG-Sri-Lanka/34-790727",
    "lang": "en",
    "newspaper_id": "dailyftlk",
