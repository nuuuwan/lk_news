    "description": "How The Iran\u2013Israel Conflict Is Reshaping Global Consumer Markets",
    "url_metadata": "https://www.colombotelegraph.com/index.php/how-the-iran-israel-conflict-is-reshaping-global-consumer-markets/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
    "time_ut": 1775566872.0,
    "chunk_id": "2026-04-07-colombotelegraphcom-a5a41a03-0000",
