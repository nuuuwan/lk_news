    "description": "\u2018NDB addresses fraud incident and reinforces financial strength and stability\u2019",
    "url_metadata": "http://island.lk/ndb-addresses-fraud-incident-and-reinforces-financial-strength-and-stability/",
    "lang": "en",
    "newspaper_id": "islandlk",
