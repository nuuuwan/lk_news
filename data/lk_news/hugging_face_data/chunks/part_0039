    "chunk_text": "\u0db1\u0dc0\u0dad\u0db8 Kia Tasman \u0dbb\u0dae\u0dba \u0db1\u0dc0 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dcf\u0d9c\u0dcf\u0dbb\u0dba\u0dda \u0dc3\u0dd4\u0dc0\u0dd2\u0dc1\u0dda\u0dc2\u0dd3 \u0dbd\u0dd9\u0dc3 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dbb\u0dca\u0dc1\u0db1\u0dba \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0dba Kia \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dba\u0dda \u0db4\u0dc5\u0db8\u0dd4 \u0daf\u0dca\u0dc0\u0dd2\u0dad\u0dca\u0dc0 \u0d9a\u0dd0\u0db6\u0dca \u0db4\u0dd2\u0d9a\u0db4\u0dca \u0dbb\u0dae\u0dba \u0dc0\u0dda. Tasman \u0dc4\u0db3\u0dd4\u0db1\u0dca\u0dc0\u0dcf\u0daf\u0dd3\u0db8 \u0db8\u0d9c\u0dd2\u0db1\u0dca Kia \u0dc4\u0dd2 \u0dbb\u0dae\u0dc0\u0dcf\u0dc4\u0db1 \u0dc0\u0dd2\u0dc0\u0dd2\u0db0\u0dcf\u0d82\u0d9c\u0dd3\u0d9a\u0dbb\u0dab\u0dba \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0dc3\u0dc4 \u0db6\u0dc4\u0dd4\u0dc0\u0dd2\u0db0 \u0d85\u0d82\u0dc1 \u0dc4\u0dbb\u0dc4\u0dcf \u0dc0\u0db1 \u0db4\u0dcf\u0dbb\u0dd2\u0db7\u0ddd\u0d9c\u0dd2\u0d9a \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0da0\u0dcf\u0dbb \u0daf\u0dd0\u0d9a\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0dc3\u0db1\u0dca\u0db1\u0dcf\u0db8\u0dba\u0da7 \u0d87\u0dad\u0dd2 \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0d85\u0dc0\u0db0\u0dcf\u0dbb\u0dab\u0dba \u0d9a\u0dbb\u0dba\u0dd2."
  },
  {
