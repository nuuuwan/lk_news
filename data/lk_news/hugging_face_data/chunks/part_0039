    "description": "Roads, traffic police and commuters: Is SL heading towards a traffic crisis?",
    "url_metadata": "https://www.ft.lk/columns/Roads-traffic-police-and-commuters-Is-SL-heading-towards-a-traffic-crisis/4-790538",
    "lang": "en",
    "newspaper_id": "dailyftlk",
