    "description": "Sri Lankan-German Business Forum 2026 to strengthen trusted partnerships and unlock investment opportunities",
    "url_metadata": "https://www.dailymirror.lk/business-news/Sri-Lankan-German-Business-Forum-2026-to-strengthen-trusted-partnerships-and-unlock-investment-opportunities/273-341106",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
