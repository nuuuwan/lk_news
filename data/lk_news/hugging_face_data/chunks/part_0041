    "url_metadata": "https://www.ada.lk/breaking_news/\u0dbb\u0da7\u0dc0\u0dbd\u0dca-40\u0d9a-\u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0d9a\u0dba\u0db1\u0dca\u0da7-\u0daf\u0dd2\u0db1-30\u0d9a\u0da7-\u0dc0\u0dd3\u0dc3\u0dcf-\u0db1\u0dd2\u0daf\u0dc4\u0dc3\u0dca/11-422611",
