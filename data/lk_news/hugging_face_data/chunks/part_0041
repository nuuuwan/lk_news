    "chunk_text": "\u0d9a\u0dd9\u0dc3\u0dda\u0dc0\u0dd4\u0dc0\u0daf\u00a0 \u0db8\u0dda \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0daf \u0d9c\u0dcf\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9c\u0dab\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba\u0da7 \u0dc3\u0daf\u0dc4\u0db1\u0dca\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dca\u0dad\u0dda\u00a0 2024 \u0dc0\u0dbb\u0dca\u0dc2\u0dba \u0dad\u0dd4\u0dbd\u00a0 \u0dbb\u0dd4\u0db4\u0dd2\u0dba\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0dd2\u0dba\u0db1 500\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dad\u0dd2\u0db4\u0dcf\u0daf\u0db1 \u0dc0\u0dd9\u0db1\u0dca\u0d9a\u0dbb\u0daf\u0dd2 \u0d87\u0dad\u0dca\u0dad\u0dda \u0db6\u0dd2\u0dbd\u0dca\u0db4\u0dad\u0dca \u0db4\u0dd2\u0dba\u0dc0\u0dd2\u0db8 \u0dc3\u0daf\u0dc4\u0dcf \u0db6\u0dc0\u0dba. \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba \u0db1\u0dad\u0dbb\u0d9a\u0dd2\u0dbb\u0dd2\u0db8 \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0daf\u0dba\u0dd9\u0db1\u0dca\u00a0 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a\u0d9c\u0dda \u0db1\u0dd2\u0dbb\u0dd2\u0d9a\u0dca\u0dc2\u0dab \u0d87\u0dad\u0dd4\u0dbd\u0dad\u0dca\u00a0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca \u0d9a\u0dc5 \u0db4\u0dc3\u0dd4\u00a0 \u0db8\u0dd9\u0db8 \u0d85\u0dad\u0dca\u0dad\u0dd2\u0d9a\u0dcf\u0dbb\u0db8\u0dca \u0db8\u0dd4\u0daf\u0dbd\u0dca \u0d85\u0dba\u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\u0db1 \u0db6\u0dc0\u00a0 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9c\u0dab\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dcf\u00a0 \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba\u0da7 \u0dc3\u0daf\u0dc4\u0db1\u0dca\u0d9a\u0ddc\u0da7 \u0d87\u0dad. \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2\u0dba\u0dda \u0d89\u0daf\u0dd2\u0d9a\u0dd2\u0dbb\u0dd2\u0db8\u0dca \u0db1\u0dad\u0dbb\u0d9a\u0ddc\u0da7 \u0d87\u0dad\u0dd2 \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca\u00a0 \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0db6\u0dd2\u0dbd\u0dca\u0db4\u0dad\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0d9a\u0dbb\u0dab \u0dbd\u0dd9\u0dc3\u00a0 \u0dc0\u0dca\u200d\u0dba\u0dcf\u0db4\u0dd8\u0dad\u0dd2 \u0d8b\u0db4\u0daf\u0dda\u0dc1\u0d9a \u0dc0\u0dd9\u0dad \u0daf\u0db1\u0dca\u0dc0\u0dcf \u0d87\u0dad\u0dad\u0dca \u0db8\u0dda \u0daf\u0d9a\u0dca\u0dc0\u0dcf\u00a0 \u0d91\u0db8 \u0db6\u0dd2\u0dbd\u0dca\u0db4\u0dad \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db4\u0dad\u0dca\u0d9a\u0ddc\u0da7 \u0db1\u0ddc\u0db8\u0dd0\u0dad\u0dd2 \u0db6\u0dc0\u0daf\u00a0 \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dbd\u0dda\u0d9a\u0db8\u0dca \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0d9c\u0dab\u0db1\u0dca\u0daf\u0dd2\u0db8\u0dda \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0d9c\u0dab\u0db1\u0dba\u0da7 \u0dc3\u0daf\u0dc4\u0db1\u0dca \u0d9a\u0ddc\u0da7 \u0d87\u0dad."
