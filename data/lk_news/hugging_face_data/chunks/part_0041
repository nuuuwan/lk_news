    "description": "\u2018From Friendship to Dependency\u2019 launched in Colombo",
    "url_metadata": "https://www.ft.lk/news/From-Friendship-to-Dependency-launched-in-Colombo/56-792604",
    "lang": "en",
    "newspaper_id": "dailyftlk",
