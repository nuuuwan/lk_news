    "md5": "a1f974d78502c4f5e43449287cc8acbf",
    "chunk_size_bytes": 4660,
    "chunk_text": "2001\u0b86\u0bae\u0bcd \u0b86\u0ba3\u0bcd\u0b9f\u0bc1, \u0b95\u0bb2\u0bcd\u00ad\u0bae\u0bc1\u0ba9\u0bc8 \u0b92\u0bb0\u0bc1 \u0bae\u0bbe\u0ba8\u00ad\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u00ad\u0baf\u0bbe\u0b95 \u0ba4\u0bb0\u00ad\u0bae\u0bc1\u00ad\u0baf\u0bb0\u0bcd\u0ba4\u0bcd\u00ad\u0ba4\u0baa\u0bcd\u00ad\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0bbf\u0bb1\u0b95\u0bc1 \u0ba8\u0bbf\u0bb2\u0bc8\u00ad\u0bae\u0bc8\u00ad\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bae\u0bc7\u0bb2\u0bc1\u0bae\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u00ad\u0bb1\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8f\u0bb1\u0bcd\u00ad\u0baa\u0b9f\u0bcd\u00ad\u0b9f\u0ba9. \u0b87\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0ba3\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1 \u0b8a\u0bb0\u0bcd\u00ad\u0b95\u00ad\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u00ad\u0ba4\u0bbf\u0baa\u0bcd\u00ad\u0baa\u00ad\u0b9f\u0bc1\u0ba4\u0bcd\u00ad\u0ba4\u0bc1\u00ad\u0bb5\u00ad\u0ba4\u0bb1\u0bcd\u00ad\u0b95\u0bbe\u0b95 \u0bb8\u0bcd\u0bb0\u0bc0\u0bb2\u0b99\u0bcd\u0b95\u0bbe \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0b95\u0bbe\u0b99\u0bcd\u00ad\u0b95\u0bbf\u0bb0\u0bb8\u0bcd \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4 \u0b9a\u0bbe\u0ba3\u0b95\u0bcd\u00ad\u0b95\u0bbf\u00ad\u0baf\u00ad\u0bae\u0bbe\u0ba9 \u0b85\u0bb0\u00ad\u0b9a\u0bbf\u0baf\u0bb2\u0bcd \u0ba8\u0b95\u0bb0\u0bcd\u00ad\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0bb5\u0bc7\u0ba3\u0bcd\u00ad\u0b9f\u0ba4\u0bcd\u00ad\u0ba4\u00ad\u0b95\u0bbe\u0ba4 \u0bb5\u0bbf\u0bb3\u0bc8\u00ad\u0bb5\u0bc1\u00ad\u0b95\u00ad\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0ba4\u0bcd\u00ad\u0ba4\u0bbf\u0b9f\u0bcd\u00ad\u0b9f\u0ba9 \u0b8e\u0ba9\u0bcd\u00ad\u0bb1\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd \u0b95\u0bc2\u0bb1 \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd.\n\n\u0ba4\u0bc7\u0b9a\u0bbf\u0baf \u0b95\u0bbe\u0b99\u0bcd\u00ad\u0b95\u0bbf\u00ad\u0bb0\u0bb8\u0bbf\u0ba9\u0bcd \u0ba4\u0bb2\u0bc8\u0bb5\u0bb0\u0bcd \u0b8f.\u0b8e\u0bb2\u0bcd.\u0b8e\u0bae\u0bcd. \u0b85\u0ba4\u0bbe\u00ad\u0bb5\u0bc1\u0bb2\u0bcd\u0bb2\u0bbe, \u0b89\u0bb3\u0bcd\u00ad\u0bb3\u0bc2\u00ad\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0bae\u0bbe\u0b95\u0bbe\u0ba3 \u0b9a\u0baa\u0bc8\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u00ad\u0b9a\u00ad\u0bb0\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u00ad\u0ba4\u00ad\u0baa\u0bcb\u0ba4\u0bc1 \u0b9a\u0ba4\u0bcd\u00ad\u0ba4\u00ad\u0bae\u0bbf\u0bb2\u0bcd\u00ad\u0bb2\u0bbe\u0bae\u0bb2\u0bcd \u0ba4\u0ba9\u0ba4\u0bc1 \u0b8a\u0bb0\u0bc8 \u0bae\u0bbe\u0ba8\u00ad\u0b95\u0bb0 \u0b9a\u0baa\u0bc8\u00ad\u0baf\u0bbe\u0b95\u0bcd\u00ad\u0b95\u0bbf\u00ad\u0baf\u0ba4\u0bc1 \u0baa\u0bcb\u0bb2 \u0b95\u0bb2\u0bcd\u00ad\u0bae\u0bc1\u00ad\u0ba9\u0bc8\u0baf\u0bc8 (\u0b87\u0baa\u0bcd\u00ad\u0baa\u0bcb\u0ba4\u0bc1 \u0baa\u0bc7\u0b9a\u0baa\u0bcd\u00ad\u0baa\u00ad\u0b9f\u0bc1\u00ad\u0bb5\u0ba4\u0bc1 \u0baa\u0bcb\u0bb2\u0bcd) 4 \u0b86\u0b95 \u0baa\u0bbf\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0b9a\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u00ad\u0ba4\u00ad\u0bae\u00ad\u0bb0\u0bc1\u0ba4\u0bc1 \u0b89\u0bb3\u0bcd\u00ad\u0bb3\u0bbf\u0b9f\u0bcd\u0b9f \u0ba4\u0bae\u0bbf\u0bb4\u0bcd, \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0baa\u0bbf\u0bb0\u00ad\u0ba4\u0bc7\u00ad\u0b9a\u0b99\u0bcd\u00ad\u0b95\u00ad\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0ba9\u0bbf\u00ad\u0baf\u0bbe\u0ba9 \u0b89\u0bb3\u0bcd\u00ad\u0bb3\u0bc2\u00ad\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0b9a\u0baa\u0bc8\u00ad\u0b95\u0bb3\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95 \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf \u0b8e\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd. \u0b87\u0ba4\u0bb1\u0bcd\u00ad\u0b95\u0bbe\u0ba9 \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u00ad\u0ba4\u00ad\u0bae\u0bbe\u0ba9\u0bbf \u0b85\u0bb1\u0bbf\u00ad\u0bb5\u0bbf\u0ba4\u0bcd\u0ba4\u0bb2\u0bcd \u0ba4\u0baf\u0bbe\u00ad\u0bb0\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u00ad\u0ba4\u00ad\u0baa\u0bcb\u0ba4\u0bc1, \u0bae\u0bb1\u0bcd\u00ad\u0bb1\u0bc1\u00ad\u0bae\u0bca\u0bb0\u0bc1 \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0ba4\u0bb2\u0bc8\u0bb5\u0bb0\u0bcd \u0b92\u0bb0\u0bc1\u0bb5\u0bb0\u0bcd \u0b85\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u00ad\u0ba4\u0bc1\u00ad\u0bb5\u0bbf\u0b9f\u0bcd\u00ad\u0b9f\u00ad\u0ba4\u0bbe\u0b95 \u0b85\u0ba4\u0bbe\u00ad\u0bb5\u0bc1\u0bb2\u0bcd\u0bb2\u0bbe \u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b95\u0bc2\u0bb1\u0bbf\u0ba9\u0bbe\u0bb0\u0bcd.\n\n\u0baa\u0bbf\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b87\u0bb5\u0bcd\u00ad\u0bb5\u0bbf\u00ad\u0bb5\u00ad\u0b95\u0bbe\u00ad\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb8\u0bcd\u0bb0\u0bc0\u0bb2\u0b99\u0bcd\u0b95\u0bbe \u0bae\u0bc1\u0bb8\u0bcd\u0bb2\u0bbf\u0bae\u0bcd \u0b95\u0bbe\u0b99\u0bcd\u00ad\u0b95\u0bbf\u00ad\u0bb0\u0bb8\u0bc2\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bcd\u00ad\u0baa\u0bbf\u00ad\u0bb1\u0b95\u0bc1 \u0b85\u0b95\u0bbf\u0bb2 \u0b87\u0bb2\u0b99\u0bcd\u0b95\u0bc8 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bbe\u0b99\u0bcd\u00ad\u0b95\u0bbf\u00ad\u0bb0\u0bb8\u0bc2\u0bae\u0bcd \u0b95\u0bc8\u0baf\u0bbe\u0ba3\u0bcd\u00ad\u0b9f\u0ba9. \u0baa\u0bbf\u0bb0\u00ad\u0ba4\u00ad\u0bae\u00ad\u0bb0\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4 \u0bb0\u0ba3\u0bbf\u0bb2\u0bcd \u0bb5\u0bbf\u0b95\u0bcd\u00ad\u0b95\u0bbf\u00ad\u0bb0\u00ad\u0bae\u00ad\u0b9a\u0bbf\u0b99\u0bcd\u00ad\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u00ad\u0bb3\u0bc2\u00ad\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0b9a\u0baa\u0bc8\u0b95\u0bb3\u0bcd \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0baa\u0bc8\u0b9a\u0bb0\u0bcd \u0bae\u0bc1\u0bb8\u0bcd\u00ad\u0ba4\u00ad\u0baa\u0bbe\u0bb5\u0bc1\u0bae\u0bcd \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u00ad\u0ba9\u0bbf\u00ad\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0ba4\u0bb1\u0bcd\u00ad\u0b95\u0bbe\u0ba9 \u0bb5\u0bbe\u0b95\u0bcd\u00ad\u0b95\u0bc1\u00ad\u0bb1\u0bc1\u00ad\u0ba4\u0bbf\u0baf\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bbf\u0b9a\u0bcd \u0b9a\u0bc6\u0ba9\u0bcd\u00ad\u0bb1\u0bbf\u00ad\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd. \u0b86\u0ba9\u0bbe\u0bb2\u0bcd, \u0b85\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb1\u0bc8\u00ad\u0bb5\u0bc7\u0bb1\u0bcd\u00ad\u0bb1\u0baa\u0bcd\u00ad\u0baa\u00ad\u0b9f\u00ad\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8.\n\n\u0b87\u0ba4\u00ad\u0ba9\u0bc8\u00ad\u0baf\u00ad\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1, \u0b9a\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u0ba4\u0bae\u00ad\u0bb0\u0bc1\u0ba4\u0bc1 \u0bae\u0b95\u0bcd\u00ad\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b9c\u0ba9\u00ad\u0ba8\u0bbe\u00ad\u0baf\u0b95\u0baa\u0bcd \u0baa\u0bcb\u0bb0\u0bbe\u0b9f\u0bcd\u00ad\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bc0\u0bb1\u0bc1\u00ad\u0b95\u0bca\u0ba3\u0bcd\u00ad\u0b9f\u0bc6\u00ad\u0bb4\u0bc1\u0ba8\u0bcd\u00ad\u0ba4\u0ba9. \u0b9a\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u00ad\u0ba4\u00ad\u0bae\u00ad\u0bb0\u0bc1\u0ba4\u0bc1 \u0bae\u0b95\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bca\u0ba4\u0bc1\u00ad\u0b9c\u0ba9 \u0baa\u0bc6\u0bb0\u00ad\u0bae\u0bc1\u00ad\u0ba9\u0bb5\u0bbf\u0ba9\u0bcd \u0bb5\u0bc7\u0b9f\u0bcd\u00ad\u0baa\u0bbe\u0bb3\u0bb0\u0bcd \u0b95\u0bcb\u0b9f\u0bcd\u00ad\u0b9f\u0bbe\u00ad\u0baa\u0baf \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd \u0bb7\u00ad\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b86\u0ba4\u00ad\u0bb0\u00ad\u0bb5\u00ad\u0bb3\u0bbf\u0ba4\u0bcd\u00ad\u0ba4\u0ba9\u0bb0\u0bcd. \u0b87\u0ba8\u0bcd\u0ba4 \u0ba4\u0bb0\u0bc1\u00ad\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0ba4\u0bbe\u00ad\u0bb5\u0bc1\u0bb2\u0bcd\u0bb2\u0bbe \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b87\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b95\u0bcd\u00ad\u0b95\u0bb1\u0bc8 \u0b95\u0bbe\u0b9f\u0bcd\u00ad\u0b9f\u0bbf\u0ba9\u0bbe\u0bb0\u0bcd.\u00a0 \u00a0\u0b9a\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u00ad\u0ba4\u00ad\u0bae\u00ad\u0bb0\u0bc1\u00ad\u0ba4\u0bc1\u0b95\u0bcd\u00ad\u0b95\u0bbe\u0ba9 \u0b89\u0bb3\u0bcd\u00ad\u0bb3\u0bc2\u0bb0\u0bbe\u0b9f\u0bcd\u0b9a\u0bbf \u0b9a\u0baa\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u00ad\u0b95\u0baa\u0bcd\u00ad\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0bb0\u0bbe\u0b9c\u0baa\u0b95\u0bcd \u0bb7 \u0b86\u0b9f\u0bcd\u00ad\u0b9a\u0bbf\u00ad\u0baf\u0bbe\u00ad\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc2\u0bb1\u0bbf\u0ba9\u0bb0\u0bcd.\n\n\u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bc7\u0bb3\u0bc8\u00ad\u0baf\u0bbf\u00ad\u0bb2\u0bc7\u0baf\u0bc7 2020 \u0baa\u0bc6\u0baa\u0bcd\u00ad\u0bb0\u00ad\u0bb5\u00ad\u0bb0\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u00ad\u0ba8\u0bbe\u0b9f\u0bcd\u00ad\u0b9f\u00ad\u0bb2\u0bc1\u00ad\u0bb5\u0bb2\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bca\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bcd\u00ad\u0bb5\u0bbe\u0b95 \u0b85\u0bae\u0bc8\u0b9a\u0bcd\u0b9a\u0bb0\u0bcd \u0b9c\u0ba9\u0b95 \u0baa\u0ba3\u0bcd\u00ad\u0b9f\u0bbe\u0bb0 \u0ba4\u0bc6\u0ba9\u0bcd\u00ad\u0ba9\u00ad\u0b95\u0bcb\u00ad\u0ba9\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0bb5\u0bc6\u0bb3\u0bbf\u00ad\u0baf\u0bbf\u00ad\u0b9f\u0baa\u0bcd\u00ad\u0baa\u0b9f\u0bcd\u0b9f 2162/50 \u0b86\u0bae\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95 \u0b85\u0ba4\u0bbf\u00ad\u0bb5\u0bbf\u00ad\u0b9a\u0bc7\u0b9f \u0bb5\u0bb0\u0bcd\u0ba4\u0bcd\u00ad\u0ba4\u00ad\u0bae\u0bbe\u00ad\u0ba9\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0b8a\u0b9f\u0bbe\u0b95, 2022 \u0bae\u0bbe\u0bb0\u0bcd\u0b9a\u0bcd 20\u0b86\u0bae\u0bcd \u0ba4\u0bbf\u0b95\u0ba4\u0bbf \u0ba8\u0b9f\u0bc8\u00ad\u0bae\u0bc1\u00ad\u0bb1\u0bc8\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb0\u0bc1\u0bae\u0bcd \u0bb5\u0b95\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bbe\u0baf\u0bcd\u0ba8\u0bcd\u00ad\u0ba4\u00ad\u0bae\u00ad\u0bb0\u0bc1\u0ba4\u0bc1 \u0ba8\u0b95\u0bb0 \u0b9a\u0baa\u0bc8 \u0baa\u0bbf\u0bb0\u00ad\u0b95\u00ad\u0b9f\u0ba9\u0bae\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u00ad\u0baf\u0baa\u0bcd\u00ad\u0baa\u0b9f\u0bcd\u00ad\u0b9f\u0ba4\u0bc1."
