    "date_str": "2026-05-21",
    "description": "When welfare outruns growth: Lessons from Sri Lanka and Kerala",
    "url_metadata": "https://www.ft.lk/columns/When-welfare-outruns-growth-Lessons-from-Sri-Lanka-and-Kerala/4-792191",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1779317616.0,
    "chunk_id": "2026-05-21-dailyftlk-e8efca0c-0003",
