    "url_metadata": "https://www.tamilmirror.lk/cinema/\u0b95\u0bc2\u0b9a\u0bcd\u0b9a\u0bae\u0bbf\u0ba9\u0bcd\u0bb1\u0bbf-\u0b95\u0bc2\u0bb1\u0bbf\u0baf-\u0bae\u0bbf\u0baf\u0bbe-\u0b95\u0bb2\u0bbf\u0b83\u0baa\u0bbe/54-377233",
