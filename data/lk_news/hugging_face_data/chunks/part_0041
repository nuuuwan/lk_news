    "description": "NCE cautions continued Rupee depreciation will cause long-term negative impact",
    "url_metadata": "https://www.ft.lk/business/NCE-cautions-continued-Rupee-depreciation-will-cause-long-term-negative-impact/34-792203",
    "lang": "en",
    "newspaper_id": "dailyftlk",
