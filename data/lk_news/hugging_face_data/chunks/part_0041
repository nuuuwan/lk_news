    "description": "Building AI enterprises can rely on",
    "url_metadata": "https://www.ft.lk/columns/Building-AI-enterprises-can-rely-on/4-792053",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1779070608.0,
