    "description": "US to send 5,000 more troops to Poland, Trump says",
    "url_metadata": "https://www.dailymirror.lk/international/US-to-send-5-000-more-troops-to-Poland-Trump-says/107-340929",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1779427002.0,
    "chunk_id": "2026-05-22-dailymirrorlk-2ca4a6e4-0000",
    "chunk_index": 0,
