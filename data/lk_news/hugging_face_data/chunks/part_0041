    "num": "dailyftlk-afa81161",
    "date_str": "2026-05-28",
    "description": "\u201cThe Path of Freedom\u201d book launch tomorrow",
    "url_metadata": "https://www.ft.lk/news/The-Path-of-Freedom-book-launch-tomorrow/56-792603",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1779927222.0,
