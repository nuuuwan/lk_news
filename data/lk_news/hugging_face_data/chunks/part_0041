    "description": "SASSRI hosts landmark discussion on drones, AI and national defence",
    "url_metadata": "https://www.ft.lk/news/SASSRI-hosts-landmark-discussion-on-drones-AI-and-national-defence/56-792679",
    "lang": "en",
    "newspaper_id": "dailyftlk",
