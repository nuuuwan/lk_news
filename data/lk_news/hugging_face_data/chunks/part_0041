    "description": "Proposed oil palm expansion sparks economic and environmental debate",
    "url_metadata": "http://island.lk/proposed-oil-palm-expansion-sparks-economic-and-environmental-debate/",
    "lang": "en",
    "newspaper_id": "islandlk",
