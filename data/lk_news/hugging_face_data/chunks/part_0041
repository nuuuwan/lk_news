    "chunk_text": "\u0dc0\u0dc3\u0dbb 26\u0d9a\u0da7 \u0db4\u0dc3\u0dd4 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd6 \u0d85\u0db4\u0dd6\u0dbb\u0dd4 \u0dc4\u0db8\u0dd4\u0dc0\n\n\u0db8\u0dda\u0daf\u0dd2\u0db1\u0dc0\u0dbd \u0da0\u0dd3\u0dba\u0dda \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0dba\u0d9a \u0db1\u0db1\u0dd2\u0dbb\u0dad \u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0dc0\u0dca\u0dbd\u0dd0\u0da9\u0dca\u0db8\u0dd3\u0dbb\u0dca \u0db4\u0dd4\u0da7\u0dd2\u0db1\u0dca \u0dc4\u0dcf \u0da0\u0dd3\u0db1 \u0d89\u0d82\u0da2\u0dd3\u0db1\u0dda\u0dbb\u0dd4\u0dc0\u0dd9\u0d9a\u0dd4 \u0d85\u0dad\u0dbb \u0d85\u0db4\u0dd6\u0dbb\u0dd4 \u0dc4\u0db8\u0dd4\u0dc0\u0dd3\u0db8\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0dba.\u0db8\u0dd3\u0da7 \u0dc0\u0dc3\u0dbb \u0dc0\u0dc3\u0dbb 26 \u0d9a\u0da7 \u0db4\u0dd9\u0dbb \u0d92\u0db1\u0db8\u0dca 2026\u0daf\u0dd3\u00a0 \u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0dbd\u0dd9\u0dc3 \u0db4\u0dd4\u0da7\u0dd2\u0db1\u0dca \u0da0\u0dd2\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dc5 \u0db4\u0dc5\u0db8\u0dd4 \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba \u0db1\u0dcf\u0dba\u0d9a \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0dba\u0d9a\u0daf\u0dd3\u0db6\u0dd3\u0da2\u0dd2\u0d82\u0dc4\u0dd2 \u0db6\u0dd9\u0dba\u0dd2\u0dc4\u0dcf\u0dba\u0dd2 \u0d8b\u0daf\u0dca\u200d\u0dba\u0dcf\u0dba\u0dda\u0daf\u0dd3 \u0d92\u0dc0\u0d9a \u0d9a\u0dd4\u0da9\u0dcf \u0daf\u0dbb\u0dd4\u0dc0\u0dd9\u0d9a\u0dca \u0dc0\u0dd6 \u0db4\u0dd9\u0db1\u0dca\u0d9c\u0dca \u0d85\u0dad\u0dbb \u0dc4\u0db8\u0dd4\u0dc0\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0dba. \u0db8\u0dd9\u0db8 \u0dc4\u0db8\u0dd4\u0dc0\u0dda \u0da1\u0dcf\u0dba\u0dcf\u0dbb\u0dd6\u0db4\u0dba\u0d9a\u0dca\u0daf \u0dad\u0dc0\u0db8\u0dad\u0dca \u0db4\u0dc0\u0dad\u0dd3.\n\n\u0db8\u0dd9\u0dc0\u0dbb \u0db4\u0dd4\u0da7\u0dd2\u0db1\u0dca \u0da0\u0dd3\u0db1\u0dba\u0dda \u0dc3\u0dd2\u0daf\u0dd4\u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dda 25 \u0dc0\u0dd0\u0db1\u0dd2 \u0dc3\u0d82\u0da0\u0dcf\u0dbb\u0dba \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0daf\u0dd9\u0daf\u0dd9\u0db1\u0dcf \u0d85\u0dad\u0dbb \u0dc0\u0dd0\u0dc5\u0db3\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dd4, \u0db4\u0dd4\u0da7\u0dd2\u0db1\u0dca \u0d89\u0d82\u0da2\u0dd2\u0db1\u0dda\u0dbb\u0dd4\u0dc0\u0dbb\u0dba\u0dcf\u0da7\u00a0\"\u0d95\u0db1\u0dd1\u0db8 \u0dc0\u0dda\u0dbd\u0dcf\u0dc0\u0d9a\" \u0dbb\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0dc0\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0db6\u0dc0 \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd3\u0dba. \"\u0db8\u0db8 \u0db1\u0dd2\u0dc3\u0dd0\u0d9a\u0dc0\u0db8\u0d92\u0db1\u0dc0\u0dcf \" \u0db4\u0dd9\u0db1\u0dca\u0d9c\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0dad\u0dd4\u0dbb\u0dd4 \u0daf\u0dd4\u0db1\u0dca\u0db1\u0dda\u0dba."
  },
