    "description": "Three-wheeler fares likely to increase following fuel price hike",
    "url_metadata": "https://www.dailymirror.lk/breaking-news/Three-wheeler-fares-likely-to-increase-following-fuel-price-hike/108-341600",
    "lang": "en",
    "newspaper_id": "dailymirrorlk",
    "time_ut": 1780205285.0,
