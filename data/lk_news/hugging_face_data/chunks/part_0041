    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0b8a\u0bb5\u0bbe\u0bb5\u0bbf\u0bb2\u0bcd-5-\u0bae\u0bbe\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd-80-\u0b9a\u0bbf\u0bb1\u0bc1\u0bb5\u0bb0\u0bcd-\u0ba4\u0bc1\u0bb7\u0bcd\u0baa\u0bbf\u0bb0\u0baf\u0bcb\u0b95\u0bae\u0bcd/76-377638",
