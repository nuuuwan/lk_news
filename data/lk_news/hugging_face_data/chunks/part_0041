    "url_metadata": "https://www.ft.lk/columns/Sri-Lanka-s-energy-crisis-is-not-a-shortage-of-resources/4-792639",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1780009829.0,
    "chunk_id": "2026-05-29-dailyftlk-df24ea47-0001",
