    "chunk_text": "\u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a\u0da7 \u0d9c\u0ddc\u0da9 \u0db6\u0dcf\u0db1\u0dca\u0db1 \u0d86\u0db4\u0dd4 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dcf \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca\u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5\u0dc0\u0dbd\u0da7 \u0dc4\u0dbb\u0dc0\u0dcf \u0dba\u0dc0\u0dba\u0dd2\n\n\u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0d85\u0dc0\u0da7 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba\u0dda 05/22 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8\u0dca \u0d9a\u0dcf\u0dc5\u0dba\u0dda \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0d85\u0db0\u0dd2\u0d9a \u0dc0\u0dd0\u0dc3\u0dd2 \u0dc3\u0dc4\u0dd2\u0dad \u0d9a\u0dcf\u0dc5\u0d9c\u0dd4\u0dab\u0dd2\u0d9a\u00a0 \u0dad\u0dad\u0dca\u0dc0\u0dba \u0db1\u0dd2\u0dc3\u0dcf , \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0d9c\u0ddc\u0da9\u0db6\u0dd0\u0dc3\u0dca\u0dc3\u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dcf 09 \u0d9a\u0dca \u0db8\u0dad\u0dca\u0dad\u0dbd \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc3\u0dc4 \u0d89\u0db1\u0dca\u0daf\u0dd2\u0dba\u0dcf\u0dc0\u0dda \u0d9a\u0ddc\u0da0\u0dd2\u0db1\u0dca \u0dc3\u0dc4 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0dc0\u0dda\u0db1\u0dca\u0daf\u0dca\u200d\u0dbb\u0db8\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0dad\u0db8\u0db1\u0dca \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0dad\u0dca \u0db6\u0dc0 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dba \u0db7\u0dcf\u0dbb \u0db1\u0dd2\u0dbd\u0db0\u0dcf\u0dbb\u0dd3\u0dc0\u0dbb\u0dba\u0dcf 05/22 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8\u00a0 \u0db4\u0dd0\u0dc0\u0dc3\u0dd3\u0dba .\n\n\u0d92 \u0d85\u0db1\u0dd4\u0dc0 \u0d9a\u0da7\u0dcf\u0dbb\u0dca \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba\u0dda \u0daf\u0ddd\u0dc4\u0dcf \u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dd2\u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0d9c\u0ddc\u0da9\u0db6\u0dd0\u0dc3\u0dca\u0dc3\u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d9a\u0da7\u0dcf\u0dbb\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dcf 02 \u0d9a\u0dca , \u0dc3\u0dcf\u0da2\u0dcf \u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dd2\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d91\u0dba\u0dcf\u0dbb\u0dca \u0d87\u0dbb\u0dda\u0db6\u0dd2\u0dba\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dcf 02 \u0d9a\u0dca , \u0d85\u0db6\u0dd4\u0da9\u0dcf\u0db6\u0dd2 \u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dd2\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d89\u0da7\u0dd2\u0dc4\u0dcf\u0da9\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc3\u0dc4 \u0d9a\u0dd4\u0dc0\u0dda\u0da7\u0dca \u0dc3\u0dd2\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0da2\u0dc3\u0dd3\u0dbb\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0dc0\u0dc1\u0dba\u0dd9\u0db1\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dcf06 \u0d9a\u0dca\u00a0 \u0db8\u0dad\u0dca\u0dad\u0dbd \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0dc4\u0dbb\u0dc0\u0dcf \u0dba\u0dc0\u0dcf \u0dad\u0dd2\u0db6\u0dda .\n\n05/22 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8 03.45 \u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0d9c\u0ddc\u0da9\u0db6\u0dd0\u0dc3\u0dca\u0dc3\u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d9a\u0da7\u0dcf\u0dbb\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0d9a\u0dd2\u0dc0\u0dca.\u0d86\u0dbb\u0dca.- 662 \u0daf\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0dc3\u0dc4 \u0d85\u0dbd\u0dd4\u0dba\u0db8 02.35 \u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u00a0 \u0d9a\u0dd2\u0dc0\u0dca.\u0d86\u0dbb\u0dca.- 658 \u0daf\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0db8\u0dad\u0dca\u0dad\u0dbd \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda .\n\n\u0db8\u0dd3\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0dc3\u0dcf\u0da2\u0dcf \u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dd2\u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad 05/22 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8 02.30 \u0da7 \u0d9c\u0ddc\u0da9\u0db6\u0dd0\u0dc3\u0dca\u0dc3\u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d91\u0dba\u0dcf\u0dbb\u0dca \u0d87\u0dbb\u0dda\u0db6\u0dd2\u0dba\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0da2\u0dd3.9.- 587 \u0daf\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0dc3\u0dc4 \u0d85\u0dbd\u0dd4\u0dba\u0db8 04.00 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0da2\u0dd3.9.- 502 \u0daf\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0daf \u0db8\u0dad\u0dca\u0dad\u0dbd \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0dba\u0ddc\u0db8\u0dd4 \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda .\n\n\u0d91\u0dc3\u0dda\u0db8 \u0d85\u0db6\u0dd4\u0da9\u0dcf\u0db6\u0dd2 \u0db1\u0dd4\u0dc0\u0dbb \u0dc3\u0dd2\u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad 05/22\u00a0 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8 03.30 \u0da7 \u0d9c\u0ddc\u0da9\u0db6\u0dd0\u0dc3\u0dca\u0dc3\u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0d89\u0da7\u0dd2\u0dc4\u0dcf\u0da9\u0dca \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0d8a.\u0dc0\u0dba\u0dd2.- 394 \u0daf\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0dc3\u0dc4 \u0d9a\u0dd4\u0dc0\u0dda\u0da7\u0dca \u0dbb\u0dcf\u0da2\u0dca\u200d\u0dba\u0dba\u0dda \u0dc3\u0dd2\u0da7 05/22 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8 04.45 \u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2 \u0da2\u0dc3\u0dd3\u0dbb\u0dcf \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dc3\u0dda\u0dc0\u0dba\u0dda \u0da2\u0dda.9.- 551 \u0daf\u0dbb\u0db1 \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dba\u0dcf\u0db1\u0dba \u0daf \u0db8\u0dad\u0dca\u0dad\u0dbd \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0dc4\u0dbb\u0dc0\u0dcf \u0dba\u0dc0\u0dcf \u0dad\u0dd2\u0db6\u0dda .\n\n\u0db8\u0dd3\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 05/22 \u0daf\u0dd2\u0db1 \u0d85\u0dbd\u0dd4\u0dba\u0db8 04.45 \u0da7 \u0da9\u0dd4\u0db6\u0dcf\u0dba\u0dd2 \u0dc3\u0dd2\u0da7 \u0d9a\u0da7\u0dd4\u0db1\u0dcf\u0dba\u0d9a \u0d9c\u0dd4\u0dc0\u0db1\u0dca \u0dad\u0ddc\u0da7\u0dd4\u0db4\u0ddc\u0dc5 \u0dc0\u0dd9\u0dad \u0d9c\u0ddc\u0da9\u0db6\u0dd0\u0dc3\u0dca\u0dc3\u0dc0\u0dd3\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dd2\u0db6\u0dd6 \u0dc1\u0dca\u200d\u0dbb\u0d