    "num": "dailyftlk-e7942c64",
    "date_str": "2026-05-21",
    "description": "Beyond the Exchange Rate: Import dependency hurts exporters",
    "url_metadata": "https://www.ft.lk/columns/Beyond-the-Exchange-Rate-Import-dependency-hurts-exporters/4-792196",
