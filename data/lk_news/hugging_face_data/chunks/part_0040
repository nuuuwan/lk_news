    "num": "dailyftlk-ec29e381",
    "date_str": "2026-05-09",
    "description": "What the Aragalaya might mean to the NPP today",
    "url_metadata": "https://www.ft.lk/columns/What-the-Aragalaya-might-mean-to-the-NPP-today/4-791651",
    "lang": "en",
