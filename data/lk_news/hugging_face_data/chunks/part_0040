    "url_metadata": "https://www.ft.lk/business/BASL-begins-Online-Certificate-Course-in-Digital-Law/34-791452",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1777946891.0,
    "chunk_id": "2026-05-05-dailyftlk-2d49fddd-0000",
    "chunk_index": 0,
