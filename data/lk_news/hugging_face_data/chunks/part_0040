    "description": "\u0dc4\u0da2\u0dca \u0dc0\u0db1\u0dca\u0daf\u0db1\u0dcf\u0dc0 \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dc5\u0db8\u0dd4 \u0db1\u0da9\u0dba \u0db4\u0dd2\u0da7\u0dad\u0dca\u0dc0\u0dd9\u0dba\u0dd2",
    "url_metadata": "https://www.ada.lk/breaking_news/\u0dc4\u0da2\u0dca-\u0dc0\u0db1\u0dca\u0daf\u0db1\u0dcf\u0dc0-\u0dc3\u0db3\u0dc4\u0dcf-\u0db4\u0dc5\u0db8\u0dd4-\u0db1\u0da9\u0dba-\u0db4\u0dd2\u0da7\u0dad\u0dca\u0dc0\u0dd9\u0dba\u0dd2/11-422273",
