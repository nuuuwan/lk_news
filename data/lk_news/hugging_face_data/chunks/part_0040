    "doc_id": "2026-04-28-dailyftlk-5a9bafe1",
    "num": "dailyftlk-5a9bafe1",
    "date_str": "2026-04-28",
    "description": "When debt ratios don\u2019t tell the whole story",
    "url_metadata": "https://www.ft.lk/columns/When-debt-ratios-don-t-tell-the-whole-story/4-791173",
    "lang": "en",
    "newspaper_id": "dailyftlk",
