    "description": "US, Iran near deal to end conflict: Axios",
    "url_metadata": "https://www.ft.lk/news/US-Iran-near-deal-to-end-conflict-Axios/56-791572",
    "lang": "en",
    "newspaper_id": "dailyftlk",
