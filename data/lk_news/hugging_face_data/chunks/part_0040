    "chunk_text": "\u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dad\u0dd9\u0dbd\u0dca \u0dc4\u0dcf \u0da2\u0dd9\u0da7\u0dca \u0dba\u0dcf\u0db1\u0dcf \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0da0\u0dd3\u0db1\u0dba \u0d91\u0d9a\u0d9f \u0dc0\u0dd9\u0dba\u0dd2\n\n\u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0db6\u0ddd\u0dba\u0dd2\u0d82 \u0da2\u0dd9\u0da7\u0dca \u0dba\u0dcf\u0db1\u0dcf 200\u0d9a\u0dca \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7 \u0da0\u0dd3\u0db1 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0dc2\u0dd3 \u0da2\u0dd2\u0db1\u0dca\u0db4\u0dd2\u0db1\u0dca \u0d91\u0d9a\u0d9f \u0dc0\u0dd6 \u0db6\u0dc0 \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0da9\u0ddc\u0db1\u0dbd\u0dca\u0da9\u0dca \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0db4\u0dc0\u0dc3\u0dc3\u0dba\u0dd2.\n\n\" 200\u0d9a\u0dca, \u0d91\u0dad\u0db1 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0dbb\u0dd0\u0d9a\u0dd2\u0dba\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db8\u0dcf\u0dab\u0dba\u0d9a\u0dca \u0dad\u0dd2\u0db6\u0dd9\u0db1\u0dc0\u0dcf. \u0db6\u0ddd\u0dba\u0dd2\u0d82 \u0dc3\u0db8\u0dcf\u0d9c\u0db8\u0da7 \u0d95\u0db1 \u0dc0\u0dd4\u0dab\u0dda 150\u0dba\u0dd2. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 200\u0d9a\u0dca \u0dbd\u0dd0\u0db6\u0dd4\u0dab\u0dcf.\" \u0dba\u0dd0\u0dba\u0dd2 \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd2\u0dba.\n\n\u0db8\u0dda \u0d85\u0dad\u0dbb \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0\u0dd9\u0db1\u0dca \u0dad\u0dd9\u0dbd\u0dca \u0db8\u0dd2\u0dbd\u0daf\u0dd3 \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0da7\u0daf \u0da0\u0dd3\u0db1 \u0da2\u0db1\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0d91\u0d9a\u0d9c \u0dc0\u0dd4 \u0db6\u0dc0 \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0db4\u0dd0\u0dc0\u0dd0\u0dc3\u0dd2\u0dba.\u00a0 \"\u0d85\u0db4\u0dd2 \u0da7\u0dd9\u0d9a\u0dca\u0dc3\u0dcf\u0dc3\u0dca \u0dc3\u0dc4 \u0dbd\u0dd4\u0dc3\u0dd2\u0dba\u0dcf\u0db1\u0dcf \u0dc3\u0dc4 \u0d87\u0dbd\u0dc3\u0dca\u0d9a\u0dcf\u0dc0\u0da7 \u0da0\u0dd3\u0db1 \u0db1\u0dd0\u0dc0\u0dca \u0dba\u0dd0\u0dc0\u0dd3\u0db8 \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0dd9\u0db8\u0dd4,\" \u0d94\u0dc4\u0dd4 \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n\"\u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0dc3\u0dd0\u0db6\u0dc0\u0dd2\u0db1\u0dca\u0db8 \u0d85\u0dc0\u0dc1\u0dca\u200d\u0dba \u0d91\u0d9a\u0db8 \u0daf\u0dd9\u0dba \u0d91\u0dba\u0dba\u0dd2 - \u0db6\u0dbd\u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0dba,\" \u0da2\u0db1\u0dcf\u0db0\u0dd2\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dba\u0dcf \u0db4\u0dc0\u0dc3\u0dba\u0dd2. \"\u0d85\u0db4\u0da7 \u0d85\u0dc3\u0dd3\u0db8\u0dd2\u0dad \u0db6\u0dbd\u0dc1\u0d9a\u0dca\u0dad\u0dd2\u0dba\u0d9a\u0dca"
  },
