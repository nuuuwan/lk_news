    "description": "US-supported GeoAI Disaster Resilience Exhibition and Symposium opens to public in Colombo",
    "url_metadata": "https://www.ft.lk/news/US-supported-GeoAI-Disaster-Resilience-Exhibition-and-Symposium-opens-to-public-in-Colombo/56-791816",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1778547833.0,
