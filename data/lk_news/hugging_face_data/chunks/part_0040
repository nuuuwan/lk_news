    "description": "ADB backs Sri Lanka\u2019s 2026\u20132030 export roadmap as NEDP gains momentum",
    "url_metadata": "https://www.ft.lk/business/ADB-backs-Sri-Lanka-s-20262030-export-roadmap-as-NEDP-gains-momentum/34-791254",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1777425218.0,
    "chunk_id": "2026-04-29-dailyftlk-165e9218-0000",
