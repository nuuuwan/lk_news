    "description": "CoPF told Insolvency Bill can unlock Rs. 30 b distressed asset pipeline",
    "url_metadata": "https://www.ft.lk/business/CoPF-told-Insolvency-Bill-can-unlock-Rs-30-b-distressed-asset-pipeline/34-791392",
    "lang": "en",
    "newspaper_id": "dailyftlk",
