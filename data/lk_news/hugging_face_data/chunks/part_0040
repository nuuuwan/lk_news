    "date_str": "2026-05-14",
    "description": "52nd Annual Convocation of the Bar Association of Sri Lanka",
    "url_metadata": "https://www.ft.lk/news/52nd-Annual-Convocation-of-the-Bar-Association-of-Sri-Lanka/56-791895",
