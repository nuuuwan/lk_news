    "url_metadata": "https://www.ft.lk/news/UNICEF-welcomes-Sri-Lanka-moved-to-adopt-Global-Charter-on-Child-Care-Reforms/56-791659",
    "lang": "en",
    "newspaper_id": "dailyftlk",
