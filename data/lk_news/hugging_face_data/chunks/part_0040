    "chunk_text": "\u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0db6\u0dbd\u0dc0\u0dad\u0dca \u0d9a\u0da9\u0dcf \u0dc0\u0dd0\u0da7\u0dd2\u0db8\u0d9a\n\n\u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dbd\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba\u0d82\u0dc1\u0dba \u0dba\u0da7\u0dad\u0dda \u0db4\u0dcf\u0dbd\u0db1\u0dba \u0dc0\u0db1\u00a0\u00a0\u00a0 \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0d9a\u0ddc\u0da7\u0dca\u0da8\u0dcf\u0dc1\u00a017 \u0d9a \u00a0\u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca 1128 \u0dc3\u0daf\u0dc4\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca 5700 \u0d9a\u0dca \u0db4\u0db8\u0db1 \u0d85\u0da9\u0dd4 \u0db6\u0dc0 \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dbd\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dc0\u0dda \u0d8b\u0dc3\u0dc3\u0dca \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd2\u0dba\u0dd9\u0d9a\u0dca \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba.\n\n\u0db8\u0dda \u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0dba\u0da7 \u0d9c\u0dd9\u0db1 \u0dba\u0dd1\u0db8\u0dda\u00a0 \u0db6\u0dbb\u0db4\u0dad\u0dbd \u0d9c\u0dd0\u0da7\u0dbd\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0\u0daf \u0db4\u0dd0\u0dc0\u0dc3\u0dd2\u0dba. \u0daf\u0dd0\u0db1\u0da7 \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1 \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0db0\u0dcf\u0dbb\u0dc0\u0db1\u0dca \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0dae\u0db8\u0dd2\u0d9a \u0d85\u0d82\u0dc1\u0dba\u0da7 \u0dc3\u0dd2\u0d82\u0dc4\u0dbd\ufeff\u00a0 \u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 56 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dad\u0dbb \u0daf\u0dd9\u0db8\u0dbd \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 \u00a0528 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2.\u0d89\u0d82\u0d9c\u0dca\u200d\u0dbb\u0dd2\u0dc3\u0dd2 \u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 \u0dc3\u0dd2\u0d82\u0dc4\u0dbd \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0dc0\u0dbd\u0da7 98 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dad\u0dbb \u0daf\u0dd9\u0db8\u0dc5\u00a0\u00a0\u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u00a0\u0dc3\u0db3\u0dc4\u0dcf 178 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2.\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dc0 \u0d9c\u0dd4\u0dbb\u0dd4 \u0db4\u0dd4\u0dbb\u0db4\u0dca\u0db4\u0dcf\u0da9\u0dd4 \u0dc3\u0dd2\u0d82\u0dc4\u0dbd \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0daf\u0dc4\u0dcf 67 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dad\u0dbb \u0daf\u0dd9\u0db8\u0dc5 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0db3\u0dc4\u0dcf 119\u0dca \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2.\u0d9c\u0dab\u0dd2\u0dad\u0dba \u0dc3\u0dd2\u0d82\u0dc4\u0dbd \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0db3\u0dc4\u0dcf 94 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0dad\u0dbb \u0daf\u0dd9\u0db8\u0dc5 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0dc3\u0db3\u0dc4\u0dcf 356 \u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2.\n\n\u0daf\u0dd0\u0db1\u0da7\u00a0 \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dbd\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf\u0dc0 \u0dba\u0da7\u200d\u0dad\u0dda \u0d87\u0dad\u0dd2 \u0da2\u0dcf\u0dad\u0dd2\u0d9a \u0db4\u0dcf\u0dc3\u0dd0\u0dbd\u0dca\u0dc0\u0dbd\u0da7 \u0db4\u0dbd\u0dcf\u0dad\u0dca \u0dc3\u0db7\u0dcf \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca 58 \u0d9a\u0dca \u0d85\u0db1\u0dd4\u0dba\u0d9a\u0dca\u0dad\u0d9a\u0dbb \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb\u00a0 \u0dc0\u0dc3\u0dbb 10 \u0d9a \u0dc3\u0dda\u0dc0\u0dcf\u0dc0\u0db1\u0dca \u0d85\u0dc0\u0dc3\u0db1\u0dca \u0d9a\u0dbb \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0db4\u0dbd\u0dcf\u0dad\u0dca \u0dc0\u0dbd\u0da7 \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db8\u0dcf\u0dbb\u0dd4\u0dc0\u0dd2\u0db8\u0dd3 \u0dbd\u0dd0\u0db6 \u0dba\u0dd1\u0db8\u0da7 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca 60 \u0daf\u0dd9\u0db1\u0dd9\u0d9a\u0dca \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u00a0 \u0db6\u0dc0\u0daf \u0db4\u0dd0\u0dc0\u0dc3\u0dda .\u0db8\u0dd9\u0dba\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb \u0db4\u0dbd\u0dcf\u0dad\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0db4\u0dbb\u0dd2\u0db4\u0dcf\u0dbd\u0db1 \u0db1\u0dd2\u0dc5\u0db0\u0dcf\u0dbb\u0dd2\u0db1\u0dca 205 \u0d9a \u0d85\u0da9\u0dd4\u0dc0\u0d9a\u0dca\u0daf \u0db4\u0dc0\u0dad\u0dd2.\n\n\u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0dad\u0dad\u0dca\u0dc0\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0da7 \u0db4\u0db8\u0dab\u0d9a\u0dca \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca 500 \u0d9a \u0db4\u0db8\u0db1 \u0dc4\u0dd2\u0d9f\u0dba\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0db6\u0dc0\u00a0\u00a0 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0dda.\u0db8\u0dd9\u0db8 \u0dad\u0dad\u0dca\u0dc0\u0dba \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0dda\u00a0 \u0db4\u0dcf\u0dc3\u0dd0\u0dbd\u0dca \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf \u0d9c\u0dd9\u0db1 \u0dba\u0dd1\u0db8\u0da7 \u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2 \u0dad\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0d8b\u0daf\u0dcf\u0dc0\u0dd2\u00a0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0db8\u0dda \u0dad\u0dad\u0dca\u0dc0\u0dba \u0db8\u0dad \u0d9a\u0dbd\u0dcf\u0db4 \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1 \u0d85\u0db0\u0dca\u200d\u0dba\u0d9a\u0dca\u0dc2\u0d9a\u0dc0\u0dbb\u0dba\u0dcf \u0d87\u0dad\u0dd4\u0dbd\u0dd4 \u0dc3\u0db8\u0dc3\u0dca\u0dae\u00a0 \ufeff\u0d9a\u0dcf\u0dbb\u0dca\u0dba \u0db8\u0dab\u0dca\u0da9\u0dbd\u0dba \u0daf\u0dd0\u0da9\u0dd2 \u0d85\u0db4\u0dc4\u0dc3\u0dd4\u0dad\u0dcf\u0dc0\u0dba\u0d9a\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc0\u0dcf\u0dbb\u0dca\u0dad\u0dcf\u0dc0\u0dda.\n\n\u0db8\u0dd9\u0dba\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0dc3\u0db8\u0dc3\u0dca\u0dae \u0db4\u0dcf\u0dc3\u0dd0\u0dbd\u0dca\u00a0 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba \u0db4\u0dc0\u0dad\u0dca\u0dc0\u0dcf\u0d9c\u0dd9\u0db1 \u0dba\u0dd1\u0db8\u0da7 \u0db1\u0ddc\u0dc4\u0dd0\u0d9a\u0dd2\u0dc0 \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd0\u0db1\u0dca \u0d85\u0db1\u0dca\u0dad \u0d85\u0dc3\u0dbb\u0dab \u0dad\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0db8\u0dda \u0dc4\u0dda\u0dad\u0dd4\u0dc0 \u0db1\u0dd2\u0dc3\u0dcf \u0dc0\u0dd2\u0daf\u0dd4\u0dc4\u0dbd\u0dca\u0db4\u0dad\u0dd2\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0d91\u0d9a \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dba\u0dcf \u0dc0\u0dd2\u0dc2\u0dba\u0db1\u0dca \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0d89\u0d9c\u0dd0\u0db1\u0dca\u0dc0\u0dd2\u0db8\u0da7 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dba\u0ddc\u0daf\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0dad\u0dbb \u0d9a\u0dbd\u0dcf\u0db4 \u0d9a\u0dcf\u0dbb\u0dca\u0dba\u0dcf\u0dbd\u0dba \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0dc4\u0dbb \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dc0\u0dd9\u0db1\u0dad\u0dca \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0dbd\u0dc0\u0dbd\u0da7\u00a0 \u0daf\u0dd2\u0db1 \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0d85\u0db1\u0dd4\u0dba\u0dd4\u0d9a\u0dca\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dda.\u0db8\u0dda \u0d85\u0dad\u0dbb \u0dad\u0db8 \u0daf\u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0d9c\u0dda \u0d85\u0db0\u0dca\u200d\u0dba\u0dcf\u0db4\u0db1\u0dba \u0dc3\u0dcf\u0dbb\u0dca\u0dae\u0d9a \u0d9a\u0dbb\u0d9c\u0dd0\u0db1\u0dd2\u0db8\u0da7 \u0d9c\u0dd4\u0dbb\u0dd4\u0dc0\u0dbb\u0dd4\u0db1\u0dca \u0dbd\u0db6\u0dcf\u0daf\u0dd9\u0db1 \u0dbd\u0dd9\u0dc3 \u0d