    "description": "Cybersecurity is a shared responsibility: Lessons for public institutions in a digital era",
    "url_metadata": "https://www.ft.lk/columns/Cybersecurity-is-a-shared-responsibility-Lessons-for-public-institutions-in-a-digital-era/4-791608",
    "lang": "en",
    "newspaper_id": "dailyftlk",
