    "description": "Economic growth hinges on structural reforms and shock resilience",
    "url_metadata": "https://www.ft.lk/columns/Economic-growth-hinges-on-structural-reforms-and-shock-resilience/4-791884",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1778720999.0,
