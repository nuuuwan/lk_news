    "url_metadata": "https://www.ada.lk/breaking_news/\u0d85\u0da9\u0dd4-\u0db4\u0dd3\u0da9\u0db1-\u0d9a\u0dbd\u0dcf\u0db4\u0dba-\u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca/11-422464",
