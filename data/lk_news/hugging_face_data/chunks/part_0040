    "description": "\u0bae\u0b9e\u0bcd\u0b9a\u0bb3\u0bcd \u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf \u0bae\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1",
    "url_metadata": "https://www.tamilmirror.lk/\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0bae\u0b9e\u0bcd\u0b9a\u0bb3\u0bcd-\u0ba4\u0bc1\u0ba3\u0bcd\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1-\u0b85\u0ba9\u0bc1\u0bae\u0ba4\u0bbf-\u0bae\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1/175-376542",
