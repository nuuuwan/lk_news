    "url_metadata": "https://www.tamilmirror.lk/\u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bbf\u0b95\u0bb3\u0bcd/\u0bb5\u0bbf\u0b9c\u0baf\u0bcd\u0baf\u0bbf\u0ba9\u0bcd-108-\u0baa\u0bc7\u0bb0\u0bc1\u0bae\u0bcd-\u0b95\u0bc2\u0ba3\u0bcd\u0b9f\u0bcb\u0b9f\u0bc1-\u0bb0\u0bbe\u0b9c\u0bbf\u0ba9\u0bbe\u0bae\u0bbe-\u0b9a\u0bc6\u0baf\u0bcd\u0baf-\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bcd/175-376820",
