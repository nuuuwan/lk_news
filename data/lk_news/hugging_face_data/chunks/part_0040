    "description": "Trade and investment facilitation upgrade seen as needed for SL",
    "url_metadata": "http://island.lk/trade-and-investment-facilitation-upgrade-seen-as-needed-for-sl/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1778516880.0,
