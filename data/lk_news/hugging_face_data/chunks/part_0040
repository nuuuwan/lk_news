    "description": "Merit, Integrity, and the future of Sri Lanka Cricket",
    "url_metadata": "https://www.ft.lk/opinion/Merit-Integrity-and-the-future-of-Sri-Lanka-Cricket/14-791488",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1778006464.0,
    "chunk_id": "2026-05-06-dailyftlk-9139bfa1-0000",
    "chunk_index": 0,
