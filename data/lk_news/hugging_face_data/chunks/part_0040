    "url_metadata": "https://www.tamilmirror.lk/\u0bae\u0bb2\u0bc8\u0baf\u0b95\u0bae\u0bcd/\u0baa\u0ba3\u0bcd\u0b9f\u0bbe\u0bb0\u0bb5\u0bb3\u0bc8-\u0ba8\u0b95\u0bb0\u0bc8\u0b9a\u0bcd-\u0b9a\u0bc2\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4-\u0bb5\u0bc6\u0bb3\u0bcd\u0bb3\u0bae\u0bcd/76-376973",
