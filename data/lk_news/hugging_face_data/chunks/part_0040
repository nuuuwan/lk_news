    "description": "Pan Asia Bank partners in \u2018Life to Our Beaches\u2019 initiative",
    "url_metadata": "http://island.lk/pan-asia-bank-partners-in-life-to-our-beaches-initiative/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1777658940.0,
    "chunk_id": "2026-05-01-islandlk-13d62320-0000",
