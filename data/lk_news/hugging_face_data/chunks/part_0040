    "chunk_text": "\u0dc3\u0dd4\u0db1\u0dca\u0daf\u0dbb \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0d85\u0dc3\u0dd4\u0db1\u0daf\u0dbb \u0d9a\u0dc5 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0dc0\u0dc3\u0db1\u0dca\u0dad \u0dc3\u0dd0\u0dab\u0d9a\u0dd9\u0dc5\u0dd2\u0dba\n\n\u0d85\u0db4\u0dca\u200d\u0dbb\u0dda\u0dbd\u0dca \u0db8\u0dcf\u0dc3\u0dba\u0dda \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0db8\u0dc4\u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0d82\u0dc0\u0dd2\u0db0\u0dcf\u0db1\u0dba \u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd6 \u0dc0\u0dc3\u0db1\u0dca\u0dad \u0dc3\u0dd0\u0dab\u0d9a\u0dd9\u0dc5\u0dd2\u0dba \u0d8a\u0dba\u0dda (04) \u0daf\u0dd2\u0db1\u0dba\u0dd9\u0db1\u0dca \u0db1\u0dd2\u0db8\u0dcf \u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0dc0\u0dc3\u0db1\u0dca\u0dad \u0dc3\u0dd0\u0dab\u0d9a\u0dd9\u0dc5\u0dd2\u0dba \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a \u0d9a\u0da9 \u0d9a\u0dcf\u0db8\u0dbb \u0d89\u0daf\u0dd2\u0d9a\u0dbb \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd4 \u0db7\u0dd6\u0db8\u0dd2\u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dba \u0db8\u0dd4\u0dc5\u0dd4\u0db8\u0db1\u0dd2\u0db1\u0dca\u0db8 \u0d9a\u0dc3\u0dbd \u0dc0\u0dd2\u0db8\u0dcf\u0db1\u0dba\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0dad\u0dd2\u0db6\u0dd3\u0db8\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0db1\u0da7 \u0dbd\u0dd0\u0db6\u0dd2\u0dab.\n\n\u0db8\u0dcf\u0dc3\u0dba\u0d9a\u0dca \u0db4\u0dd4\u0dbb\u0dcf\u0dc0\u0da7 \u0d91\u0d9a\u0dad\u0dd4 \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0db1 \u0d9a\u0dc3\u0dbd \u0dc4\u0dcf \u0d9c\u0dab \u0d85\u0db4\u0daf\u0dca\u200d\u0dbb\u0dc0\u0dca\u200d\u0dba\u0dba\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0db6\u0ddd\u0dbb\u0d91\u0dc5\u0dd2\u0dba\u0dda \u0db8\u0dc4\u0db1\u0d9c\u0dbb \u0dc3\u0db7\u0dcf\u0dc0 \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0ddc\u0d9a\u0dbd \u0db4\u0dc3\u0dd4\u0db6\u0dd2\u0db8\u0d9a \u0d9a\u0dc3\u0dbd \u0dc0\u0dd2\u0dc1\u0