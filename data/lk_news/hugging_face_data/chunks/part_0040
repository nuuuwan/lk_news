    "description": "Revenue leakages at SriLankan Airlines",
    "url_metadata": "https://www.ft.lk/opinion/Revenue-leakages-at-SriLankan-Airlines/14-791285",
    "lang": "en",
    "newspaper_id": "dailyftlk",
