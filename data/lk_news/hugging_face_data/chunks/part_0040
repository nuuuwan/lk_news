    "description": "Pan Asia Bank equips customers with solutions to face energy crisis",
    "url_metadata": "https://www.ft.lk/business/Pan-Asia-Bank-equips-customers-with-solutions-to-face-energy-crisis/34-791346",
    "lang": "en",
    "newspaper_id": "dailyftlk",
