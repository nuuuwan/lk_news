    "description": "Planters seek coordinated response to stabilise tea production and key export markets",
    "url_metadata": "http://island.lk/planters-seek-coordinated-response-to-stabilise-tea-production-and-key-export-markets/",
    "lang": "en",
    "newspaper_id": "islandlk",
