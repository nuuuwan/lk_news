    "num": "dailyftlk-80f43ec5",
    "date_str": "2026-03-26",
    "description": "Can Hambantota International Port unlock Mattala\u2019s strategic potential?",
    "url_metadata": "https://www.ft.lk/columns/Can-Hambantota-International-Port-unlock-Mattala-s-strategic-potential/4-790075",
