    "description": "NTB partners NCE to strengthen support for Sri Lankan exporters",
    "url_metadata": "https://www.ft.lk/business/NTB-partners-NCE-to-strengthen-support-for-Sri-Lankan-exporters/34-789870",
    "lang": "en",
    "newspaper_id": "dailyftlk",
