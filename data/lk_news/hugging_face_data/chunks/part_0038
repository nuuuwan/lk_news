    "description": "\u0b86\u0b9f\u0bcd\u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0ba4\u0bcd \u0ba4\u0bbf\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bb3 \u0b9a\u0bc7\u0bb5\u0bc8 \u0bae\u0bc1\u0b9f\u0b95\u0bcd\u0b95\u0bae\u0bcd",
    "url_metadata": "https://www.virakesari.lk/article/242061",
    "lang": "ta",
    "newspaper_id": "virakesarilk",
    "time_ut": 1774591320.0,
