    "description": "Chandrasena affidavit alleges CIABOC statement obtained under duress",
    "url_metadata": "https://www.ft.lk/news/Chandrasena-affidavit-alleges-CIABOC-statement-obtained-under-duress/56-789794",
    "lang": "en",
    "newspaper_id": "dailyftlk",
