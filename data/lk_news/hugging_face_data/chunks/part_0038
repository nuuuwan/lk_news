    "description": "Taj Samudra Colombo supports stray dog feeding initiative",
    "url_metadata": "https://www.ft.lk/news/Taj-Samudra-Colombo-supports-stray-dog-feeding-initiative/56-789847",
    "lang": "en",
    "newspaper_id": "dailyftlk",
