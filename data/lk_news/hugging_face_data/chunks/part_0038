    "url_metadata": "https://www.ada.lk/breaking_news/\u0d89\u0db1\u0dca\u0db0\u0db1-\u0db1\u0dd1--\u0dc4\u0dd0\u0da7\u0db1\u0dca-\u0d89\u0db1\u0dca\u0db0\u0db1-\u0dc4\u0dbd\u0dca-\u0dc0\u0dc3\u0dba\u0dd2/11-421829",
