    "description": "The NPP Must Deliver Devolution & Economic Justice Now",
    "url_metadata": "https://www.colombotelegraph.com/index.php/the-npp-must-deliver-devolution-economic-justice-now/",
    "lang": "en",
    "newspaper_id": "colombotelegraphcom",
