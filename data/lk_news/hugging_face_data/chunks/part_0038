    "description": "Israel passes death penalty Bill targeting Palestinians",
    "url_metadata": "https://www.ft.lk/news/Israel-passes-death-penalty-Bill-targeting-Palestinians/56-790335",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1775003947.0,
