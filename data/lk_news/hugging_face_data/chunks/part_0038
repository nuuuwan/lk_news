    "chunk_text": "\u0dc4\u0ddd\u0db8\u0dd6\u0dc3\u0dca \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0d89\u0dbb\u0dcf\u0db1\u0dba\u0da7 \u0db4\u0dd0\u0dba 48 \u0d9a\u0dca \u0daf\u0dd9\u0dba\u0dd2\n\n\u0db4\u0dd0\u0dba 48 \u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0dc4\u0ddd\u0db8\u0dd6\u0dc3\u0dca \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb \u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba \"\u0dad\u0dbb\u0dca\u0da2\u0db1\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0dad\u0ddc\u0dbb\u0dc0\" \u0dc0\u0dd2\u0dc0\u0dd8\u0dad\u00a0 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d89\u0dbb\u0dcf\u0db1\u0dba \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0db1\u0ddc\u0d9a\u0dc5 \u0dc4\u0ddc\u0dad\u0dca \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0d89\u0dbb\u0dcf\u0db1\u0dba\u0dda \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb \"\u0db8\u0d9a\u0dcf \u0daf\u0db8\u0db1\" \u0db6\u0dc0\u00a0 \u0d87\u0db8\u0dd9\u0dbb\u0dd2\u0d9a\u0dcf\u0db1\u0dd4 \u0da2\u0db1\u0db4\u0dad\u0dd2 \u0da9\u0ddc\u0db1\u0dbd\u0dca\u0da9\u0dca \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0db4\u0dc0\u0dc3\u0dba\u0dd2.\n\n\"\u0db8\u0dd9\u0db8 \u0db1\u0dd2\u0dc1\u0dca\u0da0\u0dd2\u0dad \u0db8\u0ddc\u0dc4\u0ddc\u0dad\u0dda \u0dc3\u0dd2\u0da7 \u0db4\u0dd0\u0dba 48 \u0d9a\u0dca \u0d87\u0dad\u0dd4\u0dc5\u0dad \u0d89\u0dbb\u0dcf\u0db1\u0dba \u0dc4\u0ddd\u0db8\u0dd6\u0dc3\u0dca \u0dc3\u0db8\u0dd4\u0daf\u0dca\u200d\u0dbb \u0dc3\u0db1\u0dca\u0db0\u0dd2\u0dba \u0dc3\u0db8\u0dca\u0db4\u0dd6\u0dbb\u0dca\u0dab\u0dba\u0dd9\u0db1\u0dca\u0db8 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0db1\u0ddc\u0d9a\u0dc5\u0dc4\u0ddc\u0dad\u0dca, \u0d87\u0db8\u0dbb\u0dd2\u0d9a\u0dcf \u0d91\u0d9a\u0dca\u0dc3\u0dad\u0dca \u0da2\u0db1\u0db4\u0daf\u0dba \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0d9c\u0dda \u0dc0\u0dd2\u0dc0\u0dd2\u0db0 \u0db6\u0dbd\u0dcf\u0d9c\u0dcf\u0dbb\u0dc0\u0dbd\u0da7 \u0db4\u0dc4\u0dbb \u0daf\u0dd3 \u0dc0\u0dd2\u0db1\u0dcf\u0dc1 \u0d9a\u0dbb\u0db1\u0dd4 \u0d87\u0dad, \u0db4\u0dc5\u0db8\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd\u0dad\u0db8 \u0d91\u0d9a \u0dc3\u0db8\u0d9f \u0d86\u0dbb\u0db8\u0dca\u0db7 \u0dc0\u0dda\" \u0dba\u0dd0\u0dba\u0dd2 \u0da7\u0dca\u200d\u0dbb\u0db8\u0dca\u0db4\u0dca \u0dc3\u0dd2\u0dba \u0dc3\u0db8\u0dcf\u0da2 \u0db8\u0dcf\u0db0\u0dca\u200d\u0dba \u0d9c\u0dd2\u0dab\u0dd4\u0db8\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0db4\u0dc0\u0dc3\u0dba\u0dd2."
  },
