    "description": "\u0d85\u0dc0\u0d82\u0d9a\u0dc0\u0db8 \u0d9a\u0dd2\u0dba\u0db1\u0dc0\u0db1\u0db8\u0dca \u0db8\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dad\u0db8 \u0daf\u0dda \u0d89\u0dbb\u0dcf\u0db1\u0dba\u0dda \u0dad\u0dd9\u0dbd\u0dca \u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0dba\u0dd2",
