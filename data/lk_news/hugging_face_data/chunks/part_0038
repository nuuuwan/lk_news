    "chunk_text": "\u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb 50\u0d9a\u0dca \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0d9a\u0dbb\u0dba\u0dd2\n\n\u0db8\u0dcf\u0dbb\u0dca\u0dad\u0dd4 21 \u0dc0\u0db1 \u0daf\u0dd2\u0db1\u0da7 \u0dba\u0dd9\u0daf\u0dd3 \u0dad\u0dd2\u0db6\u0dd6 \u0da2\u0d9c\u0dad\u0dca \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0daf\u0dd2\u0db1\u0dba\u0da7 \u0dc3\u0db8\u0d9c\u0dcf\u0db8\u0dd3\u0dc0\u00a0 \u0dad\u0dc0\u0dad\u0dca \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb 50 \u0d9a\u0dca \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0dbd\u0dd9\u0dc3 \u0db1\u0db8\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0d91\u0dba\u0da7 \u0d85\u0daf\u0dcf\u0dc5 \u0d9c\u0dd0\u0dc3\u0da7\u0dca \u0db4\u0dad\u0dca\u200d\u0dbb\u0dba \u0d85\u0dad\u0dca\u0dc3\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8 \u0db4\u0dbb\u0dd2\u0dc3\u0dbb \u0d85\u0db8\u0dcf\u0dad\u0dca\u200d\u0dba \u0dc0\u0ddb\u0daf\u0dca\u200d\u0dba \u0daf\u0db8\u0dca\u0db8\u0dd2\u0d9a \u0db4\u0da7\u0db6\u0dd0\u0db3\u0dd2 \u0db8\u0dc4\u0dad\u0dcf\u0d9c\u0dda \u0db4\u0dca\u200d\u0dbb\u0db0\u0dcf\u0db1\u0dad\u0dca\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0d9a\u0dd9\u0dbb\u0dd2\u0dab\u0dd2.\n\n\u0db8\u0dd9\u0dc4\u0dd2\u0daf\u0dd3 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 12,989.73 \u0d9a\u0dca \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0dc0\u0dd6 \u0d85\u0dad\u0dbb \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 6255.77\u0d9a\u0dca, \u0db8\u0dcf\u0dad\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 275.811, \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 683.74 \u0d9a\u0dca, \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dda \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 2778.345 \u0dc3\u0dc4 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba/\u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dc0\u0dbd \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb \u0dc4\u0dd9\u0d9a\u0dca\u0da7\u0dba\u0dcf\u0dbb 2996.06 \u0dbb\u0d9a\u0dca\u0dc2\u0dd2\u0dad \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca \u0d9a\u0dd9\u0dbb\u0dd2\u0dab\u0dd2.\n\n\u0db8\u0dda\u0dc0\u0dcf\u00a0 \u0db4\u0dc4\u0dad\u0dbb\u0da7 \u0dc3\u0daf\u0dcf\u0dc4\u0dbb\u0dd2\u0dad \u0dad\u0dd9\u0dad\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb , \u0dc0\u0dd2\u0dba\u0dc5\u0dd2 \u0db8\u0ddd\u0dc3\u0db8\u0dca \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb,\u00a0 \u0d9a\u0db3\u0dd4\u0d9a\u0dbb \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb, \u0d9a\u0da9\u0ddc\u0dbd\u0dcf\u0db1 \u0dba\u0db1\u0dcf\u0daf\u0dd3 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0db8\u0db1\u0dca\u0dc0\u0dd2\u0dad\u0dba\u0dd2.\u00a0 \u0d92\u0dca \u0d85\u0db1\u0dd4\u0dc0 \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dd9\u0db1\u0dca \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb 22 \u0d9a\u0dca \u0db8\u0dcf\u0dad\u0dbb\u0dd2\u0db1\u0dca 12 \u0d9a\u0dca \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca\u0d9a\u0dba\u0dd9\u0db1\u0dca 11 \u0d9a\u0dca \u0dc4\u0dcf \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba\u0dd9\u0db1\u0dca \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb 05 \u0d9a\u0dca \u0dbd\u0dd9\u0dc3 \u0db8\u0dd9\u0db8 \u0dc0\u0db1\u0dcf\u0db1\u0dca\u0dad\u0dbb 50 \u0db