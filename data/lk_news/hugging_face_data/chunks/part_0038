    "description": "Spain closes airspace to US planes involved in war on Iran",
    "url_metadata": "https://www.ft.lk/news/Spain-closes-airspace-to-US-planes-involved-in-war-on-Iran/56-790295",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1774916701.0,
