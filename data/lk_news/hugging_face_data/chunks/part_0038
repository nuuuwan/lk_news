    "description": "Two-month aviation fuel buffer available: CAASL",
    "url_metadata": "https://www.ft.lk/business/Two-month-aviation-fuel-buffer-available-CAASL/34-790308",
    "lang": "en",
    "newspaper_id": "dailyftlk",
