    "description": "Pointlabs Technologies launch \u2018Anya\u2019 Sri Lanka\u2019s first AI-powered voice concierge platform for Standard Chartered Priority customers",
    "url_metadata": "https://www.ft.lk/business/Pointlabs-Technologies-launch-Anya-Sri-Lanka-s-first-AI-powered-voice-concierge-platform-for-Standard-Chartered-Priority-customers/34-790147",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1774568826.0,
