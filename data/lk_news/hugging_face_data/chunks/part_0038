    "description": "LankaPay ties up with BASL as Corporate Partner",
    "url_metadata": "https://www.ft.lk/business/LankaPay-ties-up-with-BASL-as-Corporate-Partner/34-790175",
    "lang": "en",
    "newspaper_id": "dailyftlk",
