    "description": "Sri Lanka to Host Landmark World Congress on Snakes in Kandy",
    "url_metadata": "http://island.lk/sri-lanka-to-host-landmark-world-congress-on-snakes-in-kandy/",
    "lang": "en",
    "newspaper_id": "islandlk",
    "time_ut": 1774095180.0,
    "chunk_id": "2026-03-21-islandlk-142da4f4-0002",
    "chunk_index": 2,
