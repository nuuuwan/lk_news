    "num": "dailyftlk-3f0757d2",
    "date_str": "2026-03-20",
    "description": "One year on: Progress, persistent gaps, and absence of governance action plan",
    "url_metadata": "https://www.ft.lk/opinion/One-year-on-Progress-persistent-gaps-and-absence-of-governance-action-plan/14-789804",
    "lang": "en",
    "newspaper_id": "dailyftlk",
