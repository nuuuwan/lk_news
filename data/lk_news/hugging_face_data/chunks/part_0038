    "description": "Blue Arc to manufacture containerised substations for export under BOI deal",
    "url_metadata": "https://www.ft.lk/business/Blue-Arc-to-manufacture-containerised-substations-for-export-under-BOI-deal/34-790142",
    "lang": "en",
    "newspaper_id": "dailyftlk",
    "time_ut": 1774567951.0,
