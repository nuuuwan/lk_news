    "description": "\u0db4\u0dd0\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0dad\u0dd4\u0dc5 \u0d9a\u0dd4\u0dc0\u0dda\u0da7\u0dba\u0dda \u0daf\u0dd9\u0dc0\u0dd0\u0db1\u0dd2 \u0dc0\u0dbb\u0dcf\u0dba\u0da7\u0dad\u0dca \u0db8\u0dd2\u0dc3\u0dba\u0dd2\u0dbd \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dba\u0d9a\u0dca",
    "url_metadata": "https://www.ada.lk/international/\u0db4\u0dd0\u0dba-\u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca-\u0dad\u0dd4\u0dc5-\u0d9a\u0dd4\u0dc0\u0dda\u0da7\u0dba\u0dda-\u0daf\u0dd9\u0dc0\u0dd0\u0db1\u0dd2-\u0dc0\u0dbb\u0dcf\u0dba\u0da7\u0dad\u0dca-\u0db8\u0dd2\u0dc3\u0dba\u0dd2\u0dbd-\u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dba\u0d9a\u0dca/3-421860",
